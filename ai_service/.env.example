# Copy to ai_service/.env. Process environment variables take precedence.
# Paths below are relative to ai_service/, regardless of the launch directory.
# Use a Bailian API key for chat and history summaries.
OPENAI_API_KEY=
# Optional override; otherwise use the Beijing default or workspace endpoint.
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-flash
OPENAI_MAX_TOKENS=2048
# Disable Qwen thinking for direct NPC replies. Other providers may require {}.
CHAT_EXTRA_BODY={"enable_thinking":false}

DASHSCOPE_API_KEY=
# Optional Beijing workspace ID; generates chat, embedding and rerank endpoints.
# DASHSCOPE_WORKSPACE_ID=
# Explicit endpoints override generated defaults; use the region matching your key.
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3.7-text-rerank
RERANK_ENABLED=true

# Conservative UTF-8 byte budgets, NOT tokenizer counts.
# Embedding API: 128000 tokens. Rerank API: 30000/item, 120000/request.
EMBEDDING_MAX_BYTES=128000
RERANK_MAX_BYTES=30000
RERANK_TOTAL_BYTES=120000

CHUNK_SIZE=3000
CHUNK_OVERLAP=200
RETRIEVAL_CANDIDATES=12
RETRIEVAL_TOP_K=3
KNOWLEDGE_MAX_CHARS=10000
HISTORY_MAX_CHARS=24000
VECTOR_CACHE_SIZE=512
VECTOR_CACHE_TTL=1800

# Match LPC AI_SERVER_HOST/PORT if you change these.
SERVER_HOST=127.0.0.1
SERVER_PORT=9999
# Embedding and rerank timeout; chat and summaries use independent limits.
API_TIMEOUT=20
# Chat waits for the complete non-streaming answer; all calls share REQUEST_TIMEOUT.
CHAT_TIMEOUT=60
SUMMARY_TIMEOUT=20
# Keep <=80; LPC shows a timeout after 90 seconds.
REQUEST_TIMEOUT=80
MAX_WORKERS=8
MAX_MESSAGE_CHARS=1000
MAX_RESPONSE_CHARS=1600
REQUEST_CACHE_SIZE=1024
REQUEST_CACHE_TTL=300
DEBUG=false

DATA_DIR=data
HELP_DIR=../help
NPC_ROLES_FILE=config/npc_roles.json
