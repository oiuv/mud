// Frozen world identity. No I/O, clock, player state, or random() calls.
#define WORLD_LIMIT 1000000000

int valid_world_id(mixed id) {
    int i, ch;

    if (!stringp(id) || sizeof(id) < 1 || sizeof(id) > 48) return 0;
    if (id[0] < 'a' || id[0] > 'z') return 0;
    for (i = 0; i < sizeof(id); i++) {
        ch = id[i];
        if ((ch < 'a' || ch > 'z') && (ch < '0' || ch > '9') && ch != '-') return 0;
    }
    return 1;
}

int valid_digest(mixed digest) {
    int i, ch;

    if (!stringp(digest) || sizeof(digest) != 64) return 0;
    for (i = 0; i < 64; i++) {
        ch = digest[i];
        if ((ch < '0' || ch > '9') && (ch < 'a' || ch > 'f')) return 0;
    }
    return 1;
}

// Byte-length framing is shared with the future Python content store.
string frame_fields(string *fields) {
    string result, field;

    result = "";
    foreach (field in fields)
        result += sprintf("%d:%s", sizeof(string_encode(field, "UTF-8")), field);
    return result;
}

private void validate_fields(mapping world) {
    mapping params;
    string field;
    string *names;

    names = ({ "world_id", "seed", "generator_version", "catalog_version", "catalog_digest",
        "content_version", "test_world", "parameters", "manifest_digest" });
    if (!mapp(world) || sizeof(world) != sizeof(names)) error("illusion: invalid manifest fields.\n");
    foreach (field in names)
        if (undefinedp(world[field])) error("illusion: missing manifest field " + field + ".\n");
    if (!valid_world_id(world["world_id"])) error("illusion: invalid world ID.\n");
    if (!intp(world["seed"]) || world["seed"] < 0 || world["seed"] > 2147483647)
        error("illusion: seed must be in 0..2147483647.\n");
    if (!intp(world["generator_version"]) || !intp(world["content_version"]) ||
        world["generator_version"] != 1 || world["content_version"] != 1)
        error("illusion: unsupported world version.\n");
    if (!valid_world_id(world["catalog_version"]) || !valid_digest(world["catalog_digest"]))
        error("illusion: invalid catalog identity.\n");
    if (!intp(world["test_world"]) || (world["test_world"] != 0 && world["test_world"] != 1))
        error("illusion: invalid test-world flag.\n");
    if ((strsrch(world["world_id"], "test-") == 0) != world["test_world"])
        error("illusion: test worlds require a test- ID; production must not use that prefix.\n");
    params = world["parameters"];
    if (!mapp(params) || sizeof(params) != 3 || !intp(params["coordinate_limit"]) ||
        !intp(params["chunk_size"]) || !intp(params["anchor_size"]) || params["coordinate_limit"] != WORLD_LIMIT ||
        params["chunk_size"] != 16 || params["anchor_size"] != 32)
        error("illusion: unsupported fact parameters.\n");
}

string manifest_digest(mapping world) {
    validate_fields(world);
    return hash("sha256", frame_fields(({ "illusion-manifest-v1", world["world_id"],
        sprintf("%d", world["seed"]), "1", world["catalog_version"], world["catalog_digest"], "1",
        sprintf("%d", world["test_world"]), "1000000000", "16", "32" })));
}

mapping validate_manifest(mapping world) {
    validate_fields(world);
    if (!valid_digest(world["manifest_digest"]) || world["manifest_digest"] != manifest_digest(world))
        error("illusion: manifest digest mismatch.\n");
    return copy(world);
}

mapping make_manifest(
    string id,
    int seed,
    int test_world,
    string catalog_version,
    string catalog_digest
) {
    mapping world;

    world = ([ "world_id": id, "seed": seed, "generator_version": 1,
        "catalog_version": catalog_version, "catalog_digest": catalog_digest,
        "content_version": 1, "test_world": test_world,
        "parameters": ([ "coordinate_limit": WORLD_LIMIT, "chunk_size": 16, "anchor_size": 32 ]),
        "manifest_digest": "" ]);
    world["manifest_digest"] = manifest_digest(world);
    return world;
}
