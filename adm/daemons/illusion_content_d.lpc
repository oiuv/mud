// Optional prose. No player output, model waits, ROOM references, or inventory changes.
inherit "/inherit/illusion/content";

#define WORLD_D "/adm/daemons/illusion_world_d"
#define CLIENT_D "/adm/daemons/ai_client_d"
#define CONTENT_ROOT "/data/illusion_world/content/"

private int enabled;
private mapping states = ([]);
private mapping visitors = ([]);
private mapping cache = ([]);
private string *cache_order = ({});

void create() { seteuid(getuid()); }

int query_enabled() { return enabled; }
mapping query_status() {
    mapping state;
    int pending;

    foreach (state in values(states)) if (state["request_id"]) pending++;
    return ([
        "enabled": enabled,
        "states": sizeof(states),
        "pending": pending,
        "cached": sizeof(cache)
    ]);
}

void set_enabled(int value) {
    string key;

    if (!objectp(previous_object()) || !is_root(previous_object()))
        error("illusion content: administrator authority required.\n");
    enabled = value ? 1 : 0;
    if (!enabled) {
        foreach (key in keys(states))
            if (stringp(states[key]["request_id"])) CLIENT_D->cancel_request(states[key]["request_id"]);
        states = ([]); visitors = ([]);
    }
}

private int chunk_coordinate(int value) {
    return value / 16 - (value < 0 && value % 16 ? 1 : 0);
}

private string content_path(mapping payload) {
    if (!valid_world_id(payload["world_id"]) || !intp(payload["x"]) || !intp(payload["y"]) ||
        payload["x"] < -1000000000 || payload["x"] > 1000000000 ||
        payload["y"] < -1000000000 || payload["y"] > 1000000000)
        error("illusion content: invalid path identity.\n");
    return sprintf("%s%s/%d_%d/%d_%d.json", CONTENT_ROOT, payload["world_id"],
        chunk_coordinate(payload["x"]), chunk_coordinate(payload["y"]), payload["x"], payload["y"]);
}

private int valid_description(mixed text) {
    buffer bytes;
    int i, value, count, lines;

    if (!stringp(text) || text == "" || strsrch(text, "```") >= 0 || strsrch(text, "<|") >= 0 ||
        strsrch(text, "[INST]") >= 0 || strsrch(text, "</") >= 0) return 0;
    bytes = string_encode(text, "UTF-8");
    if (sizeof(bytes) > 1800) return 0;
    for (i = 0; i < sizeof(bytes); i++) {
        value = bytes[i];
        if (value == 10) lines++;
        if ((value < 32 && value != 10) || value == 127) return 0;
        if (value == 194 && i + 1 < sizeof(bytes) && bytes[i + 1] < 160) return 0;
        // UTF-8 continuation bytes do not increment Unicode code-point length.
        if ((value & 192) != 128) count++;
        if (value == 226 && i + 2 < sizeof(bytes) &&
            ((bytes[i + 1] == 128 && bytes[i + 2] >= 139 && bytes[i + 2] <= 143) ||
                (bytes[i + 1] == 128 && bytes[i + 2] >= 170 && bytes[i + 2] <= 174) ||
                (bytes[i + 1] == 129 && bytes[i + 2] >= 160 && bytes[i + 2] <= 175))) return 0;
    }
    return count <= 360 && lines <= 2;
}

private string validate_snapshot(mapping payload, mixed snapshot) {
    string field, id;
    string *allowed;
    mapping mark;

    if (!mapp(snapshot) || sizeof(snapshot) != 9 || !intp(snapshot["schema_version"]) ||
        snapshot["schema_version"] != 1 || !valid_description(snapshot["description"]) ||
        !arrayp(snapshot["used_fact_ids"])) return 0;
    foreach (field in ({ "world_id", "manifest_digest", "facts_digest", "content_key" }))
        if (!stringp(snapshot[field]) || snapshot[field] != payload[field]) return 0;
    foreach (field in ({ "x", "y" }))
        if (!intp(snapshot[field]) || snapshot[field] != payload[field]) return 0;
    allowed = ({});
    foreach (mark in payload["facts"]["landmarks"]) allowed += ({ mark["id"] });
    foreach (id in snapshot["used_fact_ids"]) {
        if (!stringp(id) || member_array(id, allowed) < 0) return 0;
        allowed -= ({ id });
    }
    return snapshot["description"];
}

string read_description(mapping payload) {
    string path, key, text;
    mixed *info;
    mapping entry;
    mixed snapshot, err;

    path = content_path(payload); key = payload["content_key"];
    info = stat(path);
    if (!arrayp(info) || sizeof(info) < 2 || info[0] < 1 || info[0] > 4096) {
        map_delete(cache, key); cache_order -= ({ key }); return 0;
    }
    entry = cache[key];
    // Re-read same-second publications too: FluffOS mtimes have one-second precision.
    if (entry && entry["mtime"] == info[1] && entry["size"] == info[0] && entry["checked"] > info[1]) {
        cache_order -= ({ key }); cache_order += ({ key });
        return entry["text"];
    }
    err = catch {
        snapshot = json_decode(read_file(path));
        text = validate_snapshot(payload, snapshot);
    };
    if (err || !text) {
        if (!entry || entry["mtime"] != info[1]) debug_message("illusion content: invalid snapshot " + path);
        text = 0;
    }
    if (!entry && sizeof(cache_order) >= 256) {
        map_delete(cache, cache_order[0]); cache_order = cache_order[1..];
    }
    cache[key] = ([ "mtime": info[1], "size": info[0], "checked": time(), "text": text ]);
    cache_order -= ({ key }); cache_order += ({ key });
    return text;
}

int accept_response(string key, mapping response) {
    return response["type"] == "error" || (response["content_key"] == key &&
        member_array(
            response["status"],
            ({ "accepted", "pending", "ready", "retry_later", "failed" })
        ) >= 0);
}

void receive_response(string key, mapping response) {
    mapping state;

    state = states[key];
    if (!state || state["request_id"] != response["request_id"]) return;
    state["request_id"] = 0;
    state["next_at"] = time() + (response["status"] == "failed" ? 3600 : 60);
    state["status"] = response["type"] == "error" ? "retry_later" : response["status"];
}

void request_visit(object actor, mapping identity, mapping payload) {
    object room, visitor;
    string key, oldest, item;
    mapping result, state;
    mixed err;
    int pending;

    room = previous_object();
    if (!enabled || !objectp(actor) || !interactive(actor) || environment(actor) != room ||
        !WORLD_D->instance_owned_by(identity["world"], identity["instance"], actor) ||
        file_name(room) != WORLD_D->room_path(
            identity["world"],
            identity["x"],
            identity["y"],
            identity["instance"]
        ) ||
        payload["world_id"] != identity["world"] || payload["x"] != identity["x"] || payload["y"] != identity["y"])
        return;
    if (read_description(payload)) return;
    key = payload["content_key"]; state = states[key];
    if (state && (state["request_id"] || state["next_at"] > time())) return;
    foreach (visitor in keys(visitors))
        if (!objectp(visitor) || !interactive(visitor) || visitors[visitor]["until"] <= time()) map_delete(
            visitors,
            visitor
        );
    if (!visitors[actor]) {
        if (sizeof(visitors) >= 256) return;
        visitors[actor] = ([ "until": time() + 60, "keys": ([]) ]);
    }
    if (!visitors[actor]["keys"][key] && sizeof(visitors[actor]["keys"]) >= 6) return;
    foreach (item in keys(states)) {
        if (states[item]["request_id"]) pending++;
        else if (!oldest || states[item]["next_at"] < states[oldest]["next_at"]) oldest = item;
    }
    if (pending >= 32) return;
    if (!state && sizeof(states) >= 128) {
        if (!oldest || states[oldest]["next_at"] > time()) return;
        map_delete(states, oldest);
    }
    visitors[actor]["keys"][key] = 1;
    state = ([ "next_at": time() + 60, "status": "pending" ]); states[key] = state;
    if (sizeof(string_encode(json_encode(payload), "UTF-8")) > 6144) {
        state["status"] = "too_large"; return;
    }
    err = catch(result = CLIENT_D->send_request("world_describe", payload,
        (: receive_response, key :), ([ "timeout": 10, "retries": 1, "retry_delay": 3,
            "validator": (: accept_response, key :) ])));
    if (!err && mapp(result) && stringp(result["request_id"])) state["request_id"] = result["request_id"];
    else state["status"] = "retry_later";
}

void remove() {
    string key;

    foreach (key in keys(states))
        if (stringp(states[key]["request_id"])) CLIENT_D->cancel_request(states[key]["request_id"]);
}
