#include <ansi.h>

inherit F_CLEAN_UP;
#define WORLD_D "/adm/daemons/illusion_world_d"
#define CONTENT_D "/adm/daemons/illusion_content_d"

int main(object me, string arg) {
    string *parts;
    string id;
    mapping world, facts, status;
    mixed err;
    int seed, moved, x, y, production;

    if (!SECURITY_D->valid_grant(me, "(admin)")) return 0;
    seteuid(geteuid(me));
    parts = stringp(arg) ? explode(arg, " ") - ({ "" }) : ({});
    if (!sizeof(parts) || (sizeof(parts) == 1 && parts[0] == "status")) {
        printf(
            "新入口：%s；地形缓存：%d/64。\n",
            WORLD_D->query_active_world() || "关闭（旧幻境）",
            WORLD_D->query_cached_chunks()
        );
        printf(
            "场景创作：%s；内容状态：%O。\n",
            CONTENT_D->query_enabled() ? "开启" : "关闭",
            CONTENT_D->query_status()
        );
        return 1;
    }
    if ((sizeof(parts) == 2 || sizeof(parts) == 4) && parts[0] == "status") {
        if (sizeof(parts) == 4) {
            x = to_int(parts[2]); y = to_int(parts[3]);
            if (sprintf("%d", x) != parts[2] || sprintf("%d", y) != parts[3])
                return notify_fail("坐标必须是规范十进制整数。\n");
        }
        err = catch {
            world = WORLD_D->read_world(parts[1]);
            if (sizeof(parts) == 4) {
                facts = WORLD_D->query_room_facts(parts[1], x, y);
                if (!mapp(facts)) error("该坐标不是可进入房间。\n");
                status = CONTENT_D->query_room_status(CONTENT_D->narration_payload(world, facts));
            }
        };
        if (err) return notify_fail("查询失败：" + err);
        printf("世界清单：%O\n", world);
        if (status) {
            printf("房间事实：%O\n本地正文状态：%O\n", facts, status);
            write("本地状态不代表后台任务终态；可按 content_key 使用运维 CLI 查询持久任务。\n");
        }
        return 1;
    }
    if ((sizeof(parts) == 3 || (sizeof(parts) == 4 && parts[3] == "production")) && parts[0] == "init") {
        production = sizeof(parts) == 4;
        id = parts[1]; seed = to_int(parts[2]);
        if (sprintf("%d", seed) != parts[2]) return notify_fail("种子必须是规范十进制整数。\n");
        err = catch(world = WORLD_D->initialize_world(WORLD_D->catalog_manifest(
            id,
            seed,
            !production
        )));
        if (err) return notify_fail("创建世界失败：" + err);
        printf("世界 %s 已冻结，摘要 %s。\n", id, world["manifest_digest"]);
        write("初始化不会切换公共入口，也不会申请 AI 创作。\n");
        return 1;
    }
    if (sizeof(parts) == 2 && parts[0] == "enter") {
        err = catch(moved = WORLD_D->enter_world(me, parts[1]));
        if (err) return notify_fail("无法进入：" + err);
        if (!moved) return notify_fail("未能进入，仍停留在原处。\n");
        return 1;
    }
    if (sizeof(parts) == 2 && parts[0] == "entry") {
        err = catch(WORLD_D->set_active_world(parts[1] == "off" ? 0 : parts[1]));
        if (err) return notify_fail("入口设置失败：" + err);
        write("入口已切换并保存，不改变仍有效的在线实例；重启后校验清单并恢复设置。\n");
        return 1;
    }
    if (sizeof(parts) == 2 && parts[0] == "ai" && member_array(parts[1], ({ "on", "off" })) >= 0) {
        CONTENT_D->set_enabled(parts[1] == "on");
        write("场景创作申请开关已更新；已保存正文仍可读取。Python 服务须另行配置 WORLD_ENABLED。\n");
        return 1;
    }
    write(HIC "\n━━━━━━━━━━ 心魔幻境 · 管理指令 ━━━━━━━━━━\n" NOR
        "  仅限管理员使用。尖括号内为必填参数，输入时不带括号。\n\n"
        HIW "【查看状态】\n" NOR
        "  illusion status\n"
        "    查看公共入口、地形缓存和场景创作状态；不带参数时相同。\n"
        "  illusion status <世界ID>\n"
        "    查看指定世界的冻结清单。\n"
        "  illusion status <世界ID> <X> <Y>\n"
        "    查看指定坐标的房间事实和本地正文状态。\n"
        "    例：illusion status huanjing-v1 0 0\n\n"
        HIW "【创建世界】\n" NOR
        "  illusion init <test-世界ID> <种子>\n"
        "    创建测试世界。例：illusion init test-demo 12345\n"
        "  illusion init <世界ID> <种子> production\n"
        "    使用正式内容表创建世界。\n"
        "    例：illusion init huanjing-v2 12345 production\n"
        "    只初始化并冻结清单，不切换入口，也不申请场景创作。\n\n"
        HIW "【进入体验】\n" NOR
        "  illusion enter <世界ID>\n"
        "    自己进入指定世界，不改变玩家的公共入口。\n"
        "    例：illusion enter test-demo\n"
        "    返回起点后，可用 out 离开幻境。\n\n"
        HIW "【切换公共入口】\n" NOR
        "  illusion entry <世界ID>\n"
        "    将子虚道人的入口切换至已初始化的正式世界。\n"
        "    例：illusion entry huanjing-v1\n"
        "  illusion entry off\n"
        "    恢复旧幻境入口，不是关闭所有幻境。\n"
        "    设置会保存；切换不改变仍有效的在线实例。\n\n"
        HIW "【场景创作】\n" NOR
        "  illusion ai on\n"
        "    开启新描述的创作申请；AI 服务还须启用 WORLD_ENABLED。\n"
        "  illusion ai off\n"
        "    停止新申请，已保存的正文仍可读取。\n\n"
        HIY "【注意事项】\n" NOR
        "  种子和坐标使用十进制整数，如 12345、0、-2，不写前导零。\n"
        "  世界一经冻结，不能用同一 ID 改种子或内容表。\n"
        "  测试世界不能接入公共入口；正式切换前须完成备份与上线验收。\n"
        "  示例中的世界 ID 请按实际替换；再次查看本页：illusion help。\n\n");
    return 1;
}
