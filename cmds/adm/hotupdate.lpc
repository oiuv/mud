// 管理员手动热更新：仅替换程序，不销毁对象或重新执行 create()。
#include <runtime_config.h>

inherit F_CLEAN_UP;

private nosave int running;

private string program_path(string path) {
    if (strlen(path) > 4 && path[<4..] == ".lpc") return path[0..<5];
    if (strlen(path) > 2 && path[<2..] == ".c") return path[0..<3];
    return path;
}

private int administrator(object me) {
    return objectp(me) && interactive(me) && (is_root(me) || wiz_level(me) >= wiz_level("(admin)"));
}

private void check_target(object ob) {
    if (!objectp(ob)) error("目标原型已经消失，请重新预览。\n");
    if (ob == this_object()) error("不能通过本命令更新命令自身。\n");
    if (clonep(ob) || virtualp(ob) || query_replaced_program(ob))
        error("请指定普通原型的路径；虚拟对象及已 replace_program 的对象应指定实际程序。\n");
}

private object *ordered(object ob, mapping selected, mapping seen) {
    object *result;
    string path;

    path = file_name(ob);
    if (seen[path]) return ({});
    seen[path] = 1;
    result = ({});
    // An intermediate blueprint may be gone while its inheritors still retain its program.
    foreach (string parent in deep_inherit_list(ob)) {
        parent = program_path(parent);
        if (selected[parent]) result += ordered(selected[parent], selected, seen);
    }
    return result + ({ ob });
}

private object *make_plan(object target, int recursive) {
    object *candidates, *result;
    mapping selected, seen;
    string path;

    check_target(target);
    selected = ([ file_name(target): target ]);
    if (recursive) {
        // Filter before the driver's array limit is applied; never scan directories.
        candidates = objects((: !clonep($1) && !virtualp($1) :));
        if (sizeof(candidates) >= get_config(__MAX_ARRAY_SIZE__))
            error("已加载原型达到枚举上限，无法保证递归范围完整。\n");
        foreach (object ob in candidates) {
            if (inherits(file_name(target), ob)) {
                check_target(ob);
                selected[file_name(ob)] = ob;
            }
        }
    }
    seen = ([]);
    result = ({});
    foreach (path in sort_array(keys(selected), 1))
        result += ordered(selected[path], selected, seen);
    return result;
}

private void report(object me, string text) {
    if (objectp(me)) tell_object(me, text);
}

// Named callback: no closure tied to a program that may be updated.
protected void execute_plan(object me, object *plan, string *paths, int index,
    int total, string owner) {
    mixed err;
    string path;
    int count;

    path = paths[index];
    err = catch {
        if (!administrator(me) || geteuid(me) != owner)
            error("操作者离线或权限已改变。\n");
        seteuid(owner);
        check_target(plan[index]);
        if (find_object(path) != plan[index])
            error("计划中的原型已被其他更新替换，请重新预览。\n");
        count = recompile_object(plan[index]);
        if (count < 1) error("驱动未报告成功实例；请检查初始化错误，部分对象可能已改变。\n");
        total += count;
        index++;
        report(me, sprintf("热更新 %s：驱动报告成功更新 %d 个实例。\n", path, count));
        log_file("hotupdate", sprintf("%s %s updated %s: %d\n", ctime(time()), owner, path, count));
        if (index == sizeof(plan)) {
            running = 0;
            report(me, sprintf("热更新结束：%d 个程序，累计 %d 个成功实例。\n", index, total));
        } else {
            call_out("execute_plan", 0, me, plan, paths, index, total, owner);
        }
    };
    if (err) {
        running = 0;
        report(me, sprintf("热更新中止于 %s：%O\n已完成 %d 个程序、%d 个实例；不回滚已完成的更新。\n",
            path, err, index, total));
        // A failed log write must not leave the command permanently busy.
        catch(log_file(
            "hotupdate",
            sprintf("%s %s failed %s: %O\n", ctime(time()), owner, path, err)
        ));
    }
}

int main(object me, string arg) {
    string *args, *paths;
    string path;
    object target;
    object *plan;
    mixed err;
    int preview, recursive;

    if (!SECURITY_D->valid_grant(me, "(admin)") || !administrator(me)) return 0;
    if (running) return notify_fail("已有热更新正在执行，请等待结果。\n");
    seteuid(geteuid(me));
    args = stringp(arg) ? explode(arg, " ") - ({ "" }) : ({});
    foreach (string part in args) {
        if (part == "-n") preview = 1;
        else if (part == "-r") recursive = 1;
        else if (part[0] == '-' || path)
            return notify_fail("用法：hotupdate [-n] [-r] <文件|here>\n");
        else path = part;
    }
    if (!path) return notify_fail("用法：hotupdate [-n] [-r] <文件|here>\n");
    if (path == "here") {
        target = environment(me);
    } else {
        if (path == "me" || strsrch(path, "#") >= 0)
            return notify_fail("热更新按程序作用于整组实例，请明确指定原型路径，不能只更新一个玩家或克隆。\n");
        path = program_path(resolve_path(me->query("cwd"), path));
        target = find_object(path);
    }
    if (!target) return notify_fail("目标尚未加载；请先使用 load 或 update 加载，再进行热更新。\n");
    err = catch(plan = make_plan(target, recursive));
    if (err) return notify_fail(sprintf("无法生成热更新计划：%O\n", err));
    paths = map(plan, (: file_name($1) :));
    tell_object(me, sprintf("热更新顺序（%d 个已加载程序）：\n%s\n",
        sizeof(paths), implode(paths, "\n")));
    if (preview) {
        tell_object(me, "预览结束，未执行更新。实际执行会影响共享各程序的当前克隆。\n");
        return 1;
    }
    tell_object(me, "将在本次命令返回后热更新；保留状态，不重跑 create()，旧闭包须重新建立。\n");
    call_out("execute_plan", 0, me, plan, paths, 0, 0, geteuid(me));
    running = 1;
    return 1;
}

int help(object me) {
    write(@HELP
用法：hotupdate [-n] [-r] <文件|here>

仅管理员可用。-n 预览，不编译；-r 包含当前已加载的普通继承者，父类先于子类。
路径支持 .c、.lpc 或省略扩展名；here 指当前房间，必须是已加载的普通原型。
默认只更新目标程序及共享它的当前克隆，不自动更新父类或其他继承者。
修改父类时，使用 hotupdate -n -r <父类> 先检查范围，再去掉 -n 执行。

保留对象身份、环境、背包和各实例变量；不执行 create()。
修改 create() 中的描述、出口或初始属性仍需 update/updateall 重建或显式迁移。
旧闭包失效；有在途 AI 请求等回调的模块，应等待请求结束后再更新。
不支持 me、玩家名或 #克隆编号；更新玩家原型会影响共享该程序的整组玩家。
捕获到错误即停止后续程序，不回滚已完成的更新；初始化器失败可能丢失状态。
成功数以驱动返回为准；部分初始化失败可能不抛错，仍需检查错误日志与业务。
历史旧代克隆不保证更新，虚拟对象应通过其真实来源程序更新。
本命令不启动文件监控，也不改变 update/updateall 的重建行为。
HELP
    );
    return 1;
}
