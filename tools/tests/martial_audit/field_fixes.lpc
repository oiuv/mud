void check_qinna_message() {
    object who, target, observer;
    mapping action;
    string output;

    who = arena->actor(); target = arena->actor(); observer = arena->actor();
    who->set_skill("qinna-shibada", 31);
    target->set_name("验招对手", ({ "qinna-target" }));
    "/tests/control"->select_action(2);
    action = "/kungfu/skill/qinna-shibada"->query_action(who, 0);
    "/tests/control"->select_action(-1);
    check(mapp(action) && action["skill_name"] == "长虹经天" && action["force"] == 230,
        "MA-088 original action and force are unchanged");
    if (mapp(action))
        message_vision(replace_string(action["action"], "$l", "左腿"), who, target);
    output = remove_ansi(observer->query_temp("test/messages") || "");
    check(strsrch(output, "绊向验招对手的左腿") >= 0 && strsrch(output, "绊向的左腿") < 0,
        "MA-088 projected move names the intended target and limb");
    destruct(who); destruct(target); destruct(observer);
}

void check_learning_text() {
    object who;
    object skill;
    string msg;

    who = arena->actor();
    skill = load_object("/kungfu/skill/wuluo-zhang");
    who->set_skill("force", 0);
    check(!skill->valid_learn(who), "MA-139 force refusal remains");
    msg = query_fail_msg();
    check(stringp(msg) && strsrch(msg, "五罗轻烟掌") >= 0,
        "MA-139 force refusal names correct martial art");
    who->set_skill("force", 100);
    who->set("max_neili", 99);
    check(!skill->valid_learn(who), "MA-139 maximum neili refusal remains");
    msg = query_fail_msg();
    check(stringp(msg) && strsrch(msg, "五罗轻烟掌") >= 0,
        "MA-139 maximum neili refusal names correct martial art");
}

void check_perform_text() {
    object who, target, skill, arrows, observer;
    string name, text;
    int qty;

    observer = master()->query_connected_target();
    check(objectp(observer) && interactive(observer), "MA-140/141 real connected message observer");
    observer->move(arena);
    foreach (name in ({ "wuluo-zhang", "piaoxu-zhang" })) {
        who = arena->actor(); target = arena->actor(); arena->fight(who, target);
        who->set_skill(name, 200); who->map_skill("strike", name);
        who->prepare_skill("strike", name);
        who->set("neili", 1000);
        rolls(0);
        skill = load_object("/kungfu/skill/" + name + (name == "wuluo-zhang" ? "/bian" : "/piao"));
        observer->delete_temp("test/messages");
        check(skill->perform(who, target), "MA-140 original perform remains usable " + name);
        text = remove_ansi(observer->query_temp("test/messages") || "");
        debug_message(sprintf("FIELDS MA140 %s text=%O\n", name, text));
        check(strsrch(text, "凝神运气") >= 0 && strsrch(text, "干扰，。") < 0,
            "MA-140 failed feint has corrected martial wording " + name);
        check(who->query("neili") == 950, "MA-140 cost unchanged " + name);
    }
    who = arena->actor(); target = arena->actor(); arena->fight(who, target);
    who->set_skill("panlong-zhao", 200); who->map_skill("claw", "panlong-zhao");
    who->prepare_skill("claw", "panlong-zhao"); who->set("neili", 1000);
    target->set_skill("parry", 100000);
    rolls(0); skill = load_object("/kungfu/skill/panlong-zhao/tan");
    observer->delete_temp("test/messages");
    check(skill->perform(who), "MA-141 parried branch remains usable");
    text = remove_ansi(observer->query_temp("test/messages") || "");
    debug_message(sprintf("FIELDS MA141 parried text=%O\n", text));
    check(strsrch(text, "看破了") >= 0 && strsrch(text, "的看破") < 0,
        "MA-141 parried branch grammar");
    check(who->query("neili") == 950 && who->query_busy() == 3,
        "MA-141 parried branch original cost and busy");
    who = arena->actor(); target = arena->actor(); arena->fight(who, target);
    who->set_skill("panlong-zhao", 200); who->map_skill("claw", "panlong-zhao");
    who->prepare_skill("claw", "panlong-zhao"); who->set("neili", 1000);
    target->set_skill("parry", 0); target->map_skill("parry", 0);
    rolls(0);
    observer->delete_temp("test/messages");
    check(skill->perform(who), "MA-141 landed branch remains usable");
    text = remove_ansi(observer->query_temp("test/messages") || "");
    debug_message(sprintf("FIELDS MA141 landed text=%O\n", text));
    check(strsrch(text, "双爪") >= 0 && strsrch(text, "根本") >= 0 &&
        strsrch(text, "更本") < 0, "MA-141 landed branch corrected spelling");
    check(who->query("neili") == 850 && who->query_busy() == 1,
        "MA-141 landed branch original cost and busy");
    who = arena->actor(); target = arena->actor(); arena->fight(who, target);
    who->set_skill("xuanyuan-arrow", 200);
    arrows = new("/clone/weapon/arrow"); arrows->move(who);
    who->set_temp("handing", arrows);
    skill = load_object("/kungfu/skill/xuanyuan-arrow/baibu");
    foreach (qty in ({ 1, 2 })) {
        arrows->set_amount(qty); who->set("neili", 1000);
        check(!skill->perform(who, target), "MA-137 actual minimum rejects " + qty);
        text = query_fail_msg();
        check(stringp(text) && strsrch(text, "三支箭") >= 0,
            "MA-137 rejection states actual three-arrow minimum");
        check(arrows->query_amount() == qty && who->query("neili") == 1000,
            "MA-137 rejected attempt has no cost");
    }
    arrows->set_amount(3); rolls(0);
    check(skill->perform(who, target), "MA-137 actual minimum three accepted");
    check(arrows->query_amount() == 2 && who->query("neili") == 920,
        "MA-137 original one-arrow and eighty-neili cost retained");
}

void check_qingfu_text() {
    object who, target, skill;
    string text;

    who = arena->actor(); target = arena->actor();
    target->set_skill("qingfu-shenfa", 100);
    target->set_skill("dodge", 0);
    who->set_skill("count", 100);
    who->set_skill("dodge", 1000);
    skill = load_object("/kungfu/skill/qingfu-shenfa");
    "/tests/control"->reset(0, ({ 1, 99999, 0 }));
    check(!skill->valid_damage(who, target, 100, 0), "MA-126 first failed dodge remains damaging");
    text = remove_ansi("/adm/daemons/combatd"->query_bhinfo() || "");
    debug_message(sprintf("FIELDS MA126 branch0 text=%O limits=%O\n", text,
        "/tests/control"->query_limits()));
    check(strsrch(text, "精通易理") >= 0 && strsrch(text, "巧妙无方") < 0,
        "MA-126 first failed dodge description not overwritten by fallthrough");
    "/tests/control"->reset(0, ({ 1, 99999, 1 }));
    check(!skill->valid_damage(who, target, 100, 0), "MA-126 second failed dodge remains damaging");
    text = remove_ansi("/adm/daemons/combatd"->query_bhinfo() || "");
    debug_message(sprintf("FIELDS MA126 branch1 text=%O limits=%O\n", text,
        "/tests/control"->query_limits()));
    check(strsrch(text, "巧妙无方") >= 0 && strsrch(text, "精通易理") < 0,
        "MA-126 second failed dodge description retained");
}

void check_qingfu_dodge_entries() {
    object skill;
    string *names;
    string text;
    int i, j;

    skill = load_object("/kungfu/skill/qingfu-shenfa");
    names = ({ "福满乾坤", "五蝠献寿", "洞天福地", "云龙百蝠" });
    for (i = 0; i < sizeof(names); i++) {
        "/tests/control"->reset(0, ({ i }));
        text = skill->query_dodge_msg("左腿");
        check(strsrch(text, names[i]) >= 0 && strsrch(text, "。。") < 0,
            "MA-127 corrected independent dodge entry " + i);
        for (j = 0; j < sizeof(names); j++)
            if (j != i)
                check(strsrch(text, names[j]) < 0,
                    "MA-127 distinct dodge entries never concatenate " + i + "/" + j);
        check("/tests/control"->query_limits()[0] == 4,
            "MA-127 random selection covers four independent entries");
    }
}

void check_jiuyin_learning_message() {
    object who, skill;
    string *names, *labels;
    string text;
    int i, j;

    names = ({ "unarmed", "dodge", "force" });
    labels = ({ "基本拳脚", "基本轻功", "基本内功" });
    who = arena->actor();
    who->set("character", "光明磊落"); who->set("gender", "男性");
    who->set("str", 38); who->set("con", 34);
    who->set_skill("jiuyin-shengong", 200);
    who->set_skill("martial-cognize", 260);
    skill = load_object("/kungfu/skill/jiuyin-shengong");
    foreach (text in names) who->set_skill(text, 200);
    check(skill->valid_learn(who), "MA-002 all three actual basic prerequisites exactly met");
    for (i = 0; i < sizeof(names); i++) {
        who->set_skill(names[i], 199);
        check(!skill->valid_learn(who), "MA-002 actual deficient skill rejected " + names[i]);
        text = query_fail_msg();
        check(text == "你对" + labels[i] + "的理解还不够，无法继续领会更高深的九阴神功。\n",
            "MA-002 exact refusal names actual deficient prerequisite " + names[i]);
        for (j = 0; j < sizeof(labels); j++)
            if (j != i)
                check(strsrch(text, labels[j]) < 0,
                    "MA-002 refusal does not name other prerequisite " + names[i] + "/" + names[j]);
        check(strsrch(text, "基本掌法") < 0 && strsrch(text, "基本爪法") < 0,
            "MA-002 no stale strike or claw name from wrong array");
        who->set_skill(names[i], 200);
        check(skill->valid_learn(who), "MA-002 restore actual skill boundary passes " + names[i]);
    }
}

void run(object room) {
    arena = room;
    check_jiuyin_learning_message();
    check_skill_names();
    check_qinna_message();
    check_learning_text();
    check_perform_text();
    check_qingfu_text();
    check_qingfu_dodge_entries();
    check_growth_and_learning();
    check_jianjia_learning();
    check_qing();
    check_combine();
    check_character();
    check_guards_and_attacks();
    check_heal();
    check_resource_fields();
    check_conditions();
    check_rulai();
    check_guiyuan();
    check_break();
    check_snake();
    check_dynamic_actions();
    check_action_fields();
}

void run_closeout(object room) {
    arena = room;
    check_combine();
    check_skill_names();
    check_qinna_message();
    check_character();
    check_jianjia_learning();
    check_qingfu_text();
}
