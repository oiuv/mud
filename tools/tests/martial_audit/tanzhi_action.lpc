// Production skill and character action dispatch; no real accounts or saves.
void check(int ok, string label) { master()->check(ok, "tanzhi_action " + label); }

void cold_load() {
    object skill, who;
    mapping result;
    mixed err;
    string name;

    check(!this_player(), "cold load has no command player");
    err = catch(skill = load_object("/kungfu/skill/tanzhi-shentong"));
    check(!err && objectp(skill), "cold load succeeds without a player");
    if (!objectp(skill)) skill = find_object("/kungfu/skill/tanzhi-shentong");
    if (objectp(skill)) {
        "/tests/control"->reset(0, ({}));
        err = catch(name = skill->query_skill_name(0));
        check(!err && name == "划天裂地", "cold skill name query succeeds without a player");
        who = new("/tests/actor");
        "/tests/control"->reset(0, ({}));
        err = catch(result = skill->query_action(who, 0));
        check(!err && mapp(result) && result["force"] == 440, "cold action table is usable");
        destruct(who);
        destruct(skill);
    } else {
        check(0, "cold action table is usable");
    }
}

int load_skill(object loader) {
    loader->set_temp("test/loaded", load_object("/kungfu/skill/tanzhi-shentong"));
    return 1;
}

mapping extreme(object skill, object who, int high) {
    mapping result;
    int force, finger, dodge, parry, i, neili;
    int *expected, *limits;
    string *fields;

    force = who->query_skill("force", 1);
    finger = who->query_skill("finger", 1);
    dodge = who->query_skill("dodge", 1);
    parry = who->query_skill("parry", 1);
    neili = who->query("neili");
    "/tests/control"->reset(high, ({ 6 }));
    result = skill->query_action(who, 0);
    check(mapp(result) && result["skill_name"] == "极意", "selects extreme action");
    if (!mapp(result)) return ([]);
    fields = ({ "force", "attack", "dodge", "parry", "damage" });
    limits = ({ force, finger / 2, force / 3, parry / 3, finger / 2 });
    expected = ({ force / 2, finger / 4, dodge / 6, parry / 6, force / 4 });
    for (i = 0; i < sizeof(fields); i++)
        check(result[fields[i]] == expected[i] + (high && limits[i] > 0 ? limits[i] - 1 : 0),
            "current actor formula " + fields[i]);
    check(save_variable(({ 7 }) + limits) == save_variable("/tests/control"->query_limits()),
        "preserves selection and original random ranges");
    check(who->query("neili") == neili, "action adds no energy cost");
    return result;
}

void run(object suite) {
    object a, b, loader, skill, weapon;
    mapping first, result;
    string snapshot, basic;
    string *fields, *names;
    mixed *ordinary;
    int round, i, j;

    a = suite->actor();
    b = suite->actor();
    check(this_player() != a && this_player() != b, "command player is not either attacker");
    a->set_skill("force", 802);
    a->set_skill("finger", 606);
    a->set_skill("dodge", 414);
    a->set_skill("parry", 518);
    b->set_skill("force", 1606);
    b->set_skill("finger", 1014);
    b->set_skill("dodge", 822);
    b->set_skill("parry", 1226);
    for (round = 0; round < 2; round++) {
        skill = find_object("/kungfu/skill/tanzhi-shentong");
        if (objectp(skill)) destruct(skill);
        loader = round ? b : a;
        "/tests/control"->reset(0, ({}));
        check(loader->invoke((: load_skill, loader :)), "loads in selected actor context");
        skill = loader->query_temp("test/loaded");
        first = extreme(skill, a, 0);
        snapshot = save_variable(first);
        extreme(skill, b, 1);
        check(save_variable(first) == snapshot, "another actor preserves the previous result");
        extreme(skill, a, 1);
        extreme(skill, b, 0);
        first["force"] = -999;
        extreme(skill, a, 0);
    }
    a->set_skill("force", 1202);
    extreme(skill, a, 1);
    foreach (i in ({ 0, 1 })) {
        foreach (basic in ({ "force", "finger", "dodge", "parry" }))
            b->set_skill(basic, i);
        extreme(skill, b, 1);
    }
    fields = ({ "force", "attack", "parry", "dodge", "damage" });
    ordinary = ({
        ({ 440, 100, 50, 75, 131 }), ({ 410, 90, 65, 90, 103 }),
        ({ 420, 110, 65, 85, 121 }), ({ 400, 100, 70, 95, 98 }),
        ({ 430, 95, 45, 100, 105 }), ({ 450, 105, 65, 90, 130 })
    });
    names = ({ "划天裂地", "我心悠悠", "千夫所指", "弹指人生", "笑指天南", "擎天一指", "极意" });
    for (i = 0; i < sizeof(names); i++) {
        "/tests/control"->reset(0, ({ i }));
        check(skill->query_skill_name(0) == names[i], "all seven skill names remain unchanged");
        check(save_variable("/tests/control"->query_limits()) == save_variable(({ 7 })),
            "skill name lookup only selects a name");
        if (i == 6) continue;
        "/tests/control"->reset(0, ({ i }));
        result = skill->query_action(a, 0);
        for (j = 0; j < sizeof(fields); j++)
            check(result[fields[j]] == ordinary[i][j], "fixed action values remain unchanged");
        check(save_variable("/tests/control"->query_limits()) == save_variable(({ 7 })),
            "fixed action only consumes its selection draw");
    }
    a->set_skill("tanzhi-shentong", 300);
    a->map_skill("finger", "tanzhi-shentong");
    a->prepare_skill("finger", "tanzhi-shentong");
    a->reset_action();
    "/tests/control"->reset(0, ({ 6 }));
    result = a->query_action(0);
    check(mapp(result) && result["skill_name"] == "极意" && result["force"] == 601,
        "real unarmed character action entry succeeds");
    // Only the weapon type is needed to exercise the armed action dispatcher.
    weapon = new("/tests/sword");
    weapon->set("skill_type", "throwing");
    a->set_temp("weapon", weapon);
    a->map_skill("throwing", "tanzhi-shentong");
    a->reset_action();
    "/tests/control"->reset(0, ({ 6 }));
    result = a->query_action(0);
    check(mapp(result) && result["force"] == 601, "throwing dispatch retains finger-based formula");
    destruct(skill);
    load_object("/kungfu/skill/tanzhi-shentong");
    "/tests/control"->reset(0, ({ 6 }));
    result = a->query_action(0);
    check(mapp(result) && result["force"] == 601,
        "existing character action survives skill destruction and reload");
    a->delete_temp("weapon");
    destruct(weapon);
}
