void check(int ok, string label) { master()->check(ok, label); }

void check_storage(mixed *pair) {
    object actor, item, converter;
    mapping paths, data, result, records;
    int count;

    actor = new("/tests/actor");
    item = new(pair[1]);
    actor->store_item(actor, item, 1);
    check(
        !item && actor->depot_records()["item0"]["file"] == pair[1],
        "neck stored with canonical path"
    );
    actor->run_command("take 1 1");
    check(
        sizeof(all_inventory(actor)) == 1 && !sizeof(actor->depot_records()),
        "stored neck reconstructed"
    );
    foreach (item in all_inventory(actor)) destruct(item);
    paths = json_decode(read_file("/tests/migration_paths.json"));
    paths["/d/changan/npc/obj/cloth"] = "/d/items/cloth/buyi";
    paths["/d/city/npc/obj/caoxie"] = "/d/items/boots/caoxie";
    paths["/d/beijing/npc/obj/head"] = "/d/items/headwear/gangkui";
    paths["/d/city/obj/shoutao"] = "/d/items/hands/shoutao";
    converter = load_object("/tests/cloth_records");
    data = ([
        "item0": ([ "file": pair[0], "amount": 2, "id": "old neck", "name": "旧颈饰" ]),
        "item1": ([ "file": "/d/changan/npc/obj/cloth", "amount": 3, "id": "cloth", "name": "布衣" ]),
        "item2": ([ "file": "/d/city/npc/obj/caoxie", "amount": 4, "id": "sandals", "name": "草鞋" ]),
        "item3": ([ "file": "/d/beijing/npc/obj/head", "amount": 5, "id": "helmet", "name": "钢盔" ]),
        "item4": ([ "file": "/d/city/obj/shoutao", "amount": 6, "id": "shoutao", "name": "手套" ])
    ]);
    result = converter->convert(save_variable(data), "backpack", paths, ({}));
    records = restore_variable(result["value"]);
    check(result["changes"] == 5 && records["item0"]["amount"] == 2 &&
        records["item0"]["name"] == "旧颈饰", "five-family record conversion");
    write_file("/data/restored.o", "my_depot " + result["value"] + "\n", 1);
    actor->load_backup("/data/restored");
    actor->run_command("take 1 2"); actor->run_command("take 1 3"); actor->run_command("take 1 4"); actor->run_command("take 1 5"); actor->run_command("take 1 6");
    check(
        sizeof(all_inventory(actor)) == 20 && !sizeof(actor->depot_records()),
        "five-family saved quantities rebuilt"
    );
    foreach (item in all_inventory(actor)) {
        check(member_array(
            base_name(item),
            ({
                pair[1],
                "/d/items/cloth/buyi",
                "/d/items/boots/caoxie",
                "/d/items/headwear/gangkui",
                "/d/items/hands/shoutao"
            })
        ) >= 0,
            "restored canonical identity");
        if (base_name(item) == pair[1]) count++;
        destruct(item);
    }
    check(count == 2, "exact restored neck count");
    destruct(actor);
}

void clear_inventory(object actor) {
    object item;

    foreach (item in all_inventory(actor)) destruct(item);
}

void check_dynamic(object actor) {
    object npc, item;
    string file, prefix, expected, keyword;
    int stock;

    foreach (prefix in ({ "/tests/old", "" })) {
        foreach (file in ({ "/d/xiangyang/npc/wuxiuwen", "/kungfu/class/shaolin/dao-xiang" })) {
            npc = new(prefix + file); npc->set("huju_count", 20); npc->set("beixin_count", 2);
            actor->delete("family"); actor->select_npc(npc, "ask_me_1");
            actor->run_command("testnpc weibo");
            if (file == "/kungfu/class/shaolin/dao-xiang") {
                check(
                    !sizeof(all_inventory(actor)) && npc->query("huju_count") == 20,
                    "original sect restriction"
                );
                actor->set("family/family_name", "少林派");
                actor->run_command("testnpc weibo");
            }
            expected = prefix == "" ? "/d/items/neck/shaolin_weibo" : "/d/shaolin/obj/weibo";
            item = present("wei bo", actor);
            check(objectp(item) && base_name(item) == expected && item->query("shaolin") == 1 &&
                npc->query("huju_count") == 19, "original/new scarf issued with mark and stock");
            check(
                !present("weibo", actor) && present("bo", actor) == item,
                "original spaced aliases retained"
            );
            actor->run_command("testnpc weibo");
            check(sizeof(all_inventory(actor)) == 2 && npc->query("huju_count") == 18,
                "original present(name) behavior unchanged; no new duplicate-item rule");
            clear_inventory(actor);
            item = new("/clone/misc/cloth"); item->set_name(
                "护具",
                ({ "weibo" })
            ); item->move(actor, 1);
            actor->run_command("testnpc weibo");
            check(
                sizeof(all_inventory(actor)) == 1 && npc->query("huju_count") == 18,
                "actual matching held id refuses"
            );
            clear_inventory(actor);
            foreach (keyword in ({ "shoutao", "zhitao", "huwan", "huyao" })) {
                stock = npc->query("huju_count"); actor->run_command("testnpc " + keyword);
                expected = keyword == "shoutao" ? "/d/items/hands/shaolin_shoutao" : keyword == "zhitao" ? "/d/items/hands/shaolin_zhitao" : "/d/shaolin/obj/" + keyword;
                check(sizeof(all_inventory(actor)) == 1 && base_name(all_inventory(actor)[0]) == expected &&
                    npc->query("huju_count") == stock - 1, "other branch/shared stock " + keyword);
                clear_inventory(actor);
            }
            if (file == "/kungfu/class/shaolin/dao-xiang") {
                actor->run_command("testnpc sengxie");
                check(sizeof(all_inventory(actor)) == 1 &&
                    base_name(all_inventory(actor)[0]) == "/d/items/boots/shaolin_sengxie", "existing boots branch");
                clear_inventory(actor);
            }
            npc->set("huju_count", 0); actor->run_command("testnpc weibo");
            check(!sizeof(all_inventory(actor)), "empty shared stock refuses scarf");
            actor->select_npc(npc, "ask_me_2"); actor->run_command("testnpc beixin");
            check(sizeof(all_inventory(actor)) == 1 && base_name(all_inventory(actor)[0]) == "/d/items/cloth/tie_beixin2" &&
                npc->query("beixin_count") == 1, "vest independent stock retained");
            clear_inventory(actor); destruct(npc);
        }
    }
}

void check_jade(string prefix) {
    object room, father, daughter, actor, guard, jade, book;
    string id;

    room = new("/tests/room"); room->set("short", "萧家大厅");
    actor = new("/tests/quest_actor"); actor->move(room, 1);
    father = new(prefix + "/d/changan/npc/yuanwai"); father->set_name(
        "萧员外",
        ({ "xiao yuanwai" })
    ); father->move(room, 1);
    daughter = new(prefix + "/d/changan/npc/xiangxiang"); daughter->set_name(
        "湘湘",
        ({ "xiangxiang" })
    ); daughter->move(room, 1);
    daughter->check_rescure(actor);
    check(
        !daughter->query("leader") && !daughter->query_temp("no_return"),
        "jade required for rescue"
    );
    father->send_to_fight(father, actor); jade = present("yu pei", actor);
    check(objectp(jade) && jade->query("no_sell") == 1 && actor->save_count() == 1 &&
        base_name(jade) == (prefix == "" ? "/d/items/neck/yupei" : prefix + "/d/changan/npc/obj/yupei"), "jade issued and save requested");
    foreach (id in ({ "da shou", "huang yi" })) {
        guard = new("/tests/actor"); guard->set_name("守卫", ({ id })); guard->move(room, 1);
        daughter->check_rescure(actor);
        check(!daughter->query("leader"), "original guard blocks rescue " + id);
        destruct(guard);
    }
    daughter->set("leader", "other"); daughter->check_rescure(actor);
    check(daughter->query("leader") == "other", "existing rescuer not replaced");
    daughter->delete("leader"); daughter->check_rescure(actor);
    check(daughter->query("leader") == actor->query("id") && daughter->query_temp("no_return") == 1 &&
        daughter->recorded_commands()[0] == "follow " + actor->query("id"), "original leader/follow request");
    daughter->set_leader(actor);
    room->set("short", "别处"); father->check_daughter(father);
    check(daughter->query_leader() == actor, "return requires original hall");
    room->set("short", "萧家大厅"); jade->move(room, 1); father->check_daughter(father);
    check(daughter->query_leader() == actor, "return requires carried jade");
    jade->move(actor, 1); father->check_daughter(father);
    check(
        !daughter->query_leader() && !daughter->query_temp("no_return"),
        "return clears following state"
    );
    check(father->stop_callback("cry_daughter") >= 0 && father->stop_callback("announce_success") >= 0,
        "original delayed reunion/reward callbacks scheduled");
    check(
        !function_exists("announce_success", father),
        "existing missing callback is not a migration fix"
    );
    father->cry_daughter(father, daughter, actor, jade);
    book = present("book", father);
    check(
        !daughter && !jade && !present("yu pei", actor),
        "reunion consumes original jade and daughter"
    );
    check(objectp(book) && book->query("skill/name") == "pretending" &&
        member_array("give book to " + actor->query("id"), father->recorded_commands()) >= 0,
        "original book and give command reached; delivery not simulated");
    clear_inventory(father); clear_inventory(actor);
    destruct(father); destruct(actor); destruct(room);
}

void run() {
    object actor, room, item;
    string path;

    room = new("/tests/room"); actor = new("/tests/actor"); actor->move(room, 1);
    check_dynamic(actor); check_jade("/tests/old"); check_jade("");
    foreach (path in ({ "/tests/unknown/key", "/tests/unique", "/tests/noclone" })) {
        item = new(path); actor->store_item(actor, item, 1);
        check(objectp(item) && !sizeof(actor->depot_records()), "unknown/unique/no-clone refused");
        destruct(item);
    }
    foreach (path in ({ "/d/items/cloth/buyi", "/d/items/boots/caoxie", "/d/items/headwear/gangkui",
        "/d/items/hands/jinjie", "/d/items/neck/yupei", "/clone/cloth/qingyi" })) {
        item = new(path); actor->store_item(actor, item, 1);
        check(!item, "five families and physical storage coexist");
    }
    check(sizeof(actor->depot_records()) == 6, "distinct stored varieties retained");
    destruct(actor); destruct(room);
}
