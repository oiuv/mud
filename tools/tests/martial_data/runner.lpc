    ling_target_weapon = 0;
    if (current["parameters"]["collection_group"] == "gumu-needle-lifecycle")
        current["incidental_callbacks"] = ({});
    if (member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "gumu-npc-bout",
            "s1-sanyin", "s1-mizong",
            "emei-npc-bout",
            "mingjiao-npc-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive",
            "mingjiao-core",
            "mingjiao-qishang"
        })) != -1) {
        current["actions"] = ({});
        current["skill_loads"] = ({});
        passive_before = ([]);
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({
            "gumu-quanzhen",
            "gumu-temporal",
            "taohua-ding",
            "taohua-zhuan",
            "miao-study", "s1-panlong-tan", "s1-panlong", "s1-yunlong", "s1-dusha", "s1-dusha-lifecycle", "s1-qianye", "s1-sanyin", "s1-mizong",
            "taohua-direct",
            "s1-duan-perform",
