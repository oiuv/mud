        member_array(key, ({ "daijisi", "fanyao", "lengqian", "weiyixiao", "xiaozhao",
            "xiexun", "yangxiao", "yintianzheng", "zhangwuji" })) != -1 &&
        parameters["teacher"]["path"] == "/kungfu/class/mingjiao/" + key,
        "finite original Mingjiao teachers");
    if (mapp(parameters["room_properties"]))
        require(!sizeof(parameters["room_properties"]) ||
            (sizeof(parameters["room_properties"]) == 1 && parameters["room_properties"]["pigging"] == 1),
            "finite original learning-room refusal input");
    set(
        "pigging",
        mapp(parameters["room_properties"]) ? parameters["room_properties"]["pigging"] : 0
    );
    current["teacher_preparations"] = ({});
    current["skill_load_contexts"] = ({});
    taohua_learning_teachers = ([]);
    taohua_teacher_pending = key;
    require(players[0]->force_me("test_interface") && !taohua_teacher_pending &&
        objectp(taohua_learning_teachers[key]), "original teacher prepared in USER command context");
}

