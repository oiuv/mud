            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert" &&
        arrayp(current["skill_messages"]) && member_array(me, players) != -1)
        current["skill_messages"] += ({ ([ "side": member_array(me, players),
