        "same_room": environment(me) == environment(target), "target_living": living(target),
        "actor_neili": me->query("neili"),
        "metrics": ({ me->query_observation(), target->query_observation() }) ]) });
}

void observe_exercise(object me, string phase) {
    if (active && current["method"] == "exercise" && me == players[0])
        current["exercise_steps"] += ({ ([ "phase": phase, "state": snapshot(me),
            "elapsed": time_ns() / 1000000000.0 - started,
            "limit": me->query_current_neili_limit() ]) });
}

void observe_healing(object me, string phase) {
    if (active && current["method"] == "healing" && me == players[0])
        current["healing_steps"] += ({ ([ "phase": phase, "state": snapshot(me),
            "elapsed": time_ns() / 1000000000.0 - started ]) });
