int observe_taohua_zhuan_corpse(object victim, object killer, object corpse) {
    if (!active || !is_taohua_zhuan()) return 0;
    require(
        victim == players[1] && killer == players[0],
        "exact original ZHUAN corpse participants"
    );
    require(base_name(previous_object()) == "/adm/daemons/chard", "original CHARD corpse return");
    require(objectp(corpse) && !objectp(taohua_zhuan_corpse), "one original ZHUAN corpse");
    taohua_zhuan_corpse = corpse;
    return 1;
}

private void clear_taohua_zhuan_owned() {
    object item;
    if (objectp(taohua_zhuan_corpse)) {
        foreach (item in all_inventory(taohua_zhuan_corpse)) {
            require(
                item == taohua_zhuan_target_weapon,
                "only this sample's original weapon in corpse"
            );
            destruct(item);
        }
        destruct(taohua_zhuan_corpse);
    }
    taohua_zhuan_corpse = 0;
    taohua_zhuan_target_weapon = 0;
    taohua_zhuan_before = 0;
}

void require(int condition, string message) {
    if (!condition) error("DATA FAIL: " + message + "\n");
}

int needle_collection() {
    return member_array(current["parameters"]["collection_group"],
        ({ "gumu-throwing", "gumu-needle-lifecycle", "taohua-po" })) != -1;
}

private int is_mingjiao_remaining_perform() {
    return current["parameters"]["collection_group"] == "mingjiao-remaining-perform";
}

private int is_mingjiao_remaining_base() {
    return current["parameters"]["collection_group"] == "mingjiao-remaining-base";
}

void emit(mapping value) {
    require(write_file("/log/events.jsonl", json_encode(value) + "\n"), "write evidence");
}

mixed serializable(mixed value) {
    mapping result;
    mixed key;
    if (objectp(value)) return file_name(value);
    if (functionp(value)) return "<function>";
    if (arrayp(value)) return map(value, (: serializable :));
    if (!mapp(value)) return value;
    result = ([]);
    foreach (key in keys(value)) result[sprintf("%s", key)] = serializable(value[key]);
    return result;
}

// Exact instrument identity for the frozen music validators; read-only.
private mapping taohua_music_item(object item) {
    mapping result, instrument_spec;
    string input_id, play_fn;
    if (!objectp(item)) return ([ "missing": 1 ]);
    instrument_spec = current["parameters"]["instrument"];
    input_id = mapp(instrument_spec) && stringp(instrument_spec["input_id"]) ? instrument_spec["input_id"] : "xiao";
    play_fn = mapp(instrument_spec) && stringp(instrument_spec["play_fn"]) ? instrument_spec["play_fn"] : "play_xiao";
    result = ([
        "object": file_name(item), "program": base_name(item),
        "name": item->query("name"), "id": item->query("id"),
        "amount": item->query_amount(), "weight": item->query_weight(),
        "material": item->query("material"),
        "valid_as_xiao": item->id(input_id) ? 1 : 0,
        "input_id": input_id,
        "id_matches": item->id(input_id) ? 1 : 0,
        "play_owner": function_exists(play_fn, item),
        "environment": objectp(environment(item)) ? file_name(environment(item)) : "",
        "equipped": players[0] && players[0]->query_temp("weapon") == item ? "wielded"
        : item->query("never_wielded_marker"),
        "present_in_actor": players[0] && environment(item) == players[0] ? 1 : 0,
        "present_in_room": environment(item) == this_object() ? 1 : 0,
        "skill_type": item->query("skill_type"),
        "damage": item->query("weapon_prop/damage"),
        "flag": item->query("flag"),
        "consistence": item->query("consistence")
    ]);
    return result;
}

private mapping taohua_music_context() {
    mixed *names;
    object ob;
    names = ({});
    foreach (ob in all_inventory(this_object())) names += ({ file_name(ob) });
    return ([
        "room": ([ "object": file_name(this_object()),
            "no_fight": query("no_fight"), "skybook": query("skybook") ]),
        "instrument": taohua_music_item(taohua_music_instrument),
        "inventory": names
    ]);
}

void prepare_taohua_music(mapping parameters) {
    mapping prep;
    object instrument;
    string action;
    mixed accepted;

    instrument = new(parameters["instrument"]["program"]);
    require(objectp(instrument) &&
        instrument->id(stringp(parameters["instrument"]["input_id"])
            ? parameters["instrument"]["input_id"] : "xiao"), "original instrument");
    require(instrument->move(players[0]), "instrument carried before preparation");
    taohua_music_instrument = instrument;
    action = parameters["instrument"]["preparation_action"];
    prep = ([
        "action": action, "actor": file_name(players[0]),
        "before": ([ "actor": snapshot(players[0]), "instrument": taohua_music_item(instrument) ])
    ]);
    if (stringp(action) && action != "") {
        accepted = players[0]->force_me(action);
        require(intp(accepted) && accepted > 0, "original preparation command cost");
        prep["accepted"] = accepted;
    } else
        prep["accepted"] = instrument->query("carry_mode_has_no_command_cost");
    prep["after"] = ([
        "actor": snapshot(players[0]),
        "instrument": taohua_music_item(instrument)
    ]);
    current["music_preparation"] = prep;
    current["music_context_before"] = taohua_music_context();
    current["music_steps"] = ({});
    current["music_messages"] = ({});
}

void perform_taohua_music_steps(mapping parameters) {
    mapping step;
    string action, *actions;
    mixed accepted, reason;

    int msgCount;
    actions = arrayp(parameters["repeat_actions"]) ? parameters["repeat_actions"] : ({ parameters["action"] });
    foreach (action in actions) {
        msgCount = sizeof(current["music_messages"]);
        step = ([ "action": action, "actor": file_name(players[0]),
            "before": ({ snapshot(players[0]), snapshot(players[1]), snapshot(players[2]) }) ]);
        accepted = players[0]->force_me(action);
        step["accepted"] = accepted;
        step["after"] = ({ snapshot(players[0]), snapshot(players[1]), snapshot(players[2]) });
        if (parameters["collection_group"] == "public-music")
            step["messages"] = copy(current["music_messages"][msgCount..]);
        reason = players[0]->query_temp("notify_fail");
        step["reason"] = stringp(reason) && reason != "" ? reason : accepted > 0 ? "" : "原演奏命令未受理";
        current["music_steps"] += ({ step });
    }
    current["command_accepted"] = current["music_steps"][0]["accepted"];
    current["music_context_after"] = taohua_music_context();
    if (current["music_steps"][0]["accepted"] > 0) current["outcome"] = "observed";
    else {
        current["outcome"] = "refused";
        current["reason"] = current["music_steps"][0]["reason"];
    }
}

mapping equipment_snapshot(object item) {
    mapping result;
    if (!objectp(item)) return ([]);
    result = ([ "object": file_name(item), "program": base_name(item),
        "skill_type": item->query("skill_type"), "flag": item->query("flag"),
        "weight": item->query_weight(), "material": item->query("material"),
        "rigidity": item->query("rigidity"), "consistence": item->query("consistence"),
        "damage": item->query("weapon_prop/damage"), "no_wield": item->query("no_wield") ]);
    if (current["parameters"]["collection_group"] == "gumu-weapon-learning" ||
        member_array(current["parameters"]["teaching_profile"],
            ({
                "gumu-teachers",
                "gumu-special",
                "gumu-acquisition-learning",
                "gumu-item-acquisition",
                "gumu-recruit",
                "taohua-learning",
                "mingjiao-teachers"
            })) != -1)
        result["id"] = item->query("id");
    if (current["parameters"]["collection_group"] == "gumu-advanced")
        result += ([ "item_make": !!item->is_item_make(),
            "item_make_source": function_exists("is_item_make", item),
            "name": item->name(), "value": item->query("value") ]);
    if (needle_collection() || is_mingjiao_remaining_perform())
        result += ([ "amount": item->query_amount(),
            "daub": serializable(item->query_temp("daub") || ([])) ]);
    if (is_taohua_po()) result["stable"] = item->query("stable");
    if (member_array(current["parameters"]["collection_group"],
        ({
            "mingjiao-ling-perform",
            "mingjiao-jiuyang-direct",
            "mingjiao-jiuyang-remaining"
        })) != -1)
        result += ([ "stable": item->query("stable"), "is_item_make": !!item->is_item_make() ]);
    if (current["parameters"]["collection_group"] == "mingjiao-teachers")
        result += ([ "environment": objectp(environment(item)) ? file_name(environment(item)) : "",
            "equipped": item->query("equipped") ]);
    if (current["parameters"]["collection_group"] == "taohua-bihai")
        result += ([ "valid_as_xiao": item->valid_as_xiao(),
            "valid_as_xiao_source": function_exists("valid_as_xiao", item) ]);
    return result;
}

private void observe_ling_weapon(string phase) {
    mapping state;
    object carrier;
    if (current["parameters"]["collection_group"] != "mingjiao-ling-perform" ||
        current["parameters"]["ability"] != "xi" || !mapp(current["ling_equipment"])) return;
    require(member_array(phase, ({ "before", "immediate", "after" })) != -1,
        "exact holy transfer phase");
    state = equipment_snapshot(ling_target_weapon);
    if (objectp(ling_target_weapon)) {
        carrier = environment(ling_target_weapon);
        state["environment"] = objectp(carrier) ? file_name(carrier) : "";
        state["equipped"] = ling_target_weapon->query("equipped");
    }
    current["ling_equipment"]["target_weapon"][phase] = state;
}

int is_mingjiao_force_remaining() {
    return mapp(current) && mapp(current["parameters"]) && current["parameters"]["collection_group"] == "mingjiao-force-remaining";
}

mapping snapshot(object ob) {
    mapping result, effective;
    mixed learned;
    string key;
    object weapon, handing, cloth, secondary, opponent;
    if (!objectp(ob)) return ([ "missing": 1 ]);
    result = ([]);
    foreach (key in ({ "qi", "eff_qi", "max_qi", "jing", "eff_jing", "max_jing", "neili", "max_neili",
        "jingli", "max_jingli", "str", "int", "con", "dex", "age", "gender", "combat_exp", "jiali",
        "potential", "learned_points", "shen", "id" }))
        result[key] = ob->query(key);
    weapon = ob->query_temp("weapon");
    handing = ob->query_temp("handing");
    result["object"] = file_name(ob);
    result["userp"] = userp(ob);
    result["interactive"] = interactive(ob);
    result["playerp"] = playerp(ob);
    result["wizardp"] = wizardp(ob);
    result["living"] = living(ob);
    if (member_array(current["parameters"]["collection_group"],
        ({
            "quanzhen-defense",
            "s1-duan-members",
            "s1-duan-perform",
            "s1-piaoxu",
            "s1-yunlong", "s1-panlong", "s1-panlong-tan", "s1-dusha", "s1-qianye", "s1-sanyin", "s1-mizong"
        })) != -1) {
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
        result["mapped_unarmed"] = ob->query_skill_mapped("unarmed");
        result["mapped_parry"] = ob->query_skill_mapped("parry");
    }
    if (current["parameters"]["collection_group"] == "s1-duan-perform") {
        result["character"] = ob->query("character");
        result["duan_grants"] = ([ "man": serializable(ob->query("can_perform/jinyu-quan/man")),
            "bian": serializable(ob->query("can_perform/wuluo-zhang/bian")) ]);
    }
    if (current["parameters"]["collection_group"] == "s1-piaoxu") {
        result["character"] = ob->query("character");
        result["piao_grant"] = serializable(ob->query("can_perform/piaoxu-zhang/piao"));
    }
    if (current["parameters"]["collection_group"] == "s1-panlong-tan") {
        result["character"] = ob->query("character");
        result["tan_grant"] = serializable(ob->query("can_perform/panlong-zhao/tan"));
    }
    if (current["parameters"]["collection_group"] == "miao-study")
        result["tan_grant"] = serializable(ob->query("can_perform/panlong-zhao/tan"));
    if (current["parameters"]["collection_group"] == "s1-yunlong")
        result["character"] = ob->query("character");
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert") {
        result["not_living"] = ob->query("not_living");
        result["effective_int"] = ob->query_int();
        result["effective_dex"] = ob->query_dex();
        result["craze"] = ob->query_craze();
        result["max_craze"] = ob->query_max_craze();
        result["no_exert"] = ob->query_temp("no_exert");
        result["die_guard"] = ob->query_temp("die_guard");
        result["last_damage_from"] = serializable(ob->query("last_damage_from"));
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
        result["hostility"] = ([ "enemies": map(ob->query_enemy(), (: $1->query("id") :)),
            "killers": copy(ob->query_killer()), "wants": copy(ob->query_want()) ]);
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-public-force", "gumu-public-force", "mingjiao-public-force" })) != -1)
        result["not_living"] = ob->query("not_living");
    result["ghost"] = ob->is_ghost();
    result["busy"] = serializable(ob->query_busy());
    if (member_array(current["parameters"]["collection_group"],
        ({
            "gumu-zhi",
            "gumu-quanzhen",
            "taohua-direct",
            "taohua-control",
            "taohua-attack",
            "taohua-combo",
            "taohua-bihai",
            "taohua-passive",
            "taohua-force",
            "mingjiao-xinfa",
            "mingjiao-shengong",
            "mingjiao-shenghuo",
            "mingjiao-movement",
            "mingjiao-ling-learning",
            "mingjiao-ling-perform",
            "mingjiao-core",
            "mingjiao-qishang",
            "mingjiao-qkd",
            "mingjiao-jiuyang"
        })) != -1) {
        opponent = ob == players[0] ? players[1] : players[0];
        result["fighting_opponent"] = objectp(opponent) && !!ob->is_fighting(opponent);
    }
    result["skills"] = copy(ob->query_skills() || ([]));
    if (is_mingjiao_remaining_perform() || is_mingjiao_remaining_base() || is_mingjiao_force_remaining()) {
        learned = ob->query_learned();
        result["learned"] = copy(learned || ([]));
        result["learned_raw"] = serializable(learned);
        result["learned_kind"] = undefinedp(learned) ? "undefined" : mapp(learned) ? "mapping" : intp(learned) ? "int" : "other";
        result["effective_dex"] = ob->query_dex();
        result["effective_int"] = ob->query_int();
        result["character"] = ob->query("character");
        result["not_living"] = ob->query("not_living");
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
        opponent = ob == players[0] ? players[1] : players[0];
        result["fighting_opponent"] = objectp(opponent) && !!ob->is_fighting(opponent);
        result["killing_opponent"] = objectp(opponent) && !!ob->is_killing(opponent->query("id"));
    } else result["learned"] = copy(ob->query_learned() || ([]));
    result["force_attribute"] = ob->query("force");
    result["cultivation"] = ([]);
    if (member_array(current["parameters"]["collection_group"],
        ({ "mingjiao-combination", "mingjiao-npc-bout" })) != -1) {
        result["per"] = ob->query("per");
        foreach (key in ({ "character", "can_learn/yunv-xinjing/wall" }))
            result["cultivation"][key] = ob->query(key);
    }
    foreach (key in ({ "sex", "improve/neili", "breakup", "special_skill/mystery", "special_skill/divine",
        "special_skill/guimai", "special_skill/wuxing", "class", "family/family_name", "wudang-jiuyang", "immune/poison" }))
        result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert")
        foreach (key in ({ "character", "env/no_learn", "env/auto_regenerate", "reborn",
            "can_learn/jiuyang-shengong/enable_weapon", "doing", "tattoo/tattoo_str",
            "tattoo/tattoo_int", "tattoo/tattoo_con", "tattoo/tattoo_dex" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "shaolin-cultivation")
        foreach (key in ({ "guilty", "couple/have_couple", "shaolin-jiuyang" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "emei-cultivation")
        foreach (key in ({ "guilty", "emei-jiuyang" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "emei-yijin")
        foreach (key in ({ "character", "yijin-duangu" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-recovery", "gumu-recovery" })) != -1)
        foreach (key in ({ "special_skill/self", "character" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-healing", "emei-dispel", "emei-buffs", "gumu-public-force", "mingjiao-public-force",
            "gumu-healing", "gumu-dispel", "gumu-buffs" })) != -1)
        result["cultivation"]["character"] = ob->query("character");
    if (current["parameters"]["collection_group"] == "shaolin-backlash")
        result["cultivation"]["reborn"] = ob->query("reborn");
    result["nothing"] = ob->query("can_learn/dugu-jiujian/nothing");
    result["dugu_grants"] = ([ "qi": ob->query("can_perform/dugu/qi"),
        "po": ob->query("can_perform/dugu/po") ]);
    effective = ([]);
    foreach (key in keys(result["skills"])) effective[key] = ob->query_skill(key);
    result["effective_skills"] = effective;
    result["effective_con"] = ob->query_con();
    result["effective_str"] = ob->query_str();
    if (current["parameters"]["collection_group"] == "gumu-cultivation") {
        result["effective_int"] = ob->query_int();
        foreach (key in ({ "tattoo/tattoo_str", "reborn/str", "tattoo/tattoo_int",
            "reborn/int", "env/no_learn" }))
            result["cultivation"][key] = ob->query(key);
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "gumu-movement", "mingjiao-movement" })) != -1) {
        result["effective_int"] = ob->query_int();
        result["cultivation"]["env/no_learn"] = ob->query("env/no_learn");
    }
    if (current["parameters"]["collection_group"] == "mingjiao-movement") {
        result["cultivation"]["character"] = ob->query("character");
        result["cultivation"]["env/auto_regenerate"] = ob->query("env/auto_regenerate");
        result["craze"] = ob->query_craze();
        result["max_craze"] = ob->query_max_craze();
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "mingjiao-qkd", "mingjiao-jiuyang" })) != -1) {
        result["effective_int"] = ob->query_int();
        result["effective_dex"] = ob->query_dex();
        result["craze"] = ob->query_craze();
        result["max_craze"] = ob->query_max_craze();
        foreach (key in ({ "character", "env/no_learn", "env/auto_regenerate", "doing",
            "tattoo/tattoo_str", "reborn/str", "tattoo/tattoo_int", "reborn/int",
            "tattoo/tattoo_dex", "reborn/dex" }))
