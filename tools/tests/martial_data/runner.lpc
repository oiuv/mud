void observe_scene_lifecycle(object ob, string event, string phase) {
    if (!active || current["method"] != "scene" || !current["parameters"]["lifecycle"] ||
        ob != players[0]) return;
    current["scene_lifecycle"] += ({ ([ "event": event, "phase": phase,
        "elapsed": time_ns() / 1000000000.0 - started,
        "room": objectp(environment(ob)) ? base_name(environment(ob)) : "",
        "state": snapshot(ob), "deaths": ob->query("combat/dietimes"),
        "reason": ob->query_temp("die_reason") ]) });
}

void observe_scene_attack(object me, object target, object weapon, string skill,
    string phase, object caller) {
    if (!active || current["method"] != "scene") return;
    current["scene_attacks"] += ({ ([ "phase": phase, "step": current["scene_step"],
        "caller": objectp(caller) ? base_name(caller) : "",
        "actor_program": base_name(me), "target": member_array(target, players),
        "same_room": environment(me) == environment(target), "attack_skill": skill,
        "argument_weapon": equipment_snapshot(weapon),
        "actual_weapon": equipment_snapshot(me->query_temp("weapon")) ]) });
}

void observe_taiji(object me, object target, string phase) {
    mapping value;
    string key;
    if (!active || member_array(
        current["parameters"]["collection_group"],
        ({ "wudang-passive", "wudang-bout" })
    ) == -1) return;
    value = ([ "actor": member_array(me, players), "target": member_array(target, players),
        "phase": phase, "combat_time": me->query_temp("combat_time"),
        "action_flag": me->query_temp("action_flag"), "apply": ([]),
        "attack_index": sizeof(current["attacks"]),
        "elapsed": time_ns() / 1000000000.0 - started ]);
    foreach (key in ({ "attack", "parry", "unarmed_damage" }))
        value["apply"][key] = me->query_temp("apply/" + key);
    current["taiji_events"] += ({ value });
}

void observe_attack_round(object me, int before, int result) {
    if (is_npc_bout()) {
        observe_npc_bout_user_round(me, before, result);
        return;
    }
    if (!active || member_array(
        current["parameters"]["collection_group"],
        ({
            "wudang-passive",
            "wudang-bout",
            "shaolin-bout",
            "emei-bout",
            "gumu-bout",
            "quanzhen-bout",
            "huashan-bout",
            "mingjiao-bout",
            "taohua-bout",
            "gumu-bout-perform",
            "emei-bout-perform",
            "shaolin-bout-perform",
            "wudang-bout-perform"
        })
    ) == -1) return;
    current["attack_rounds"] += ({ ([ "actor": member_array(me, players), "before": before,
        "after": me->query_temp("combat_time"), "result": result,
        "elapsed": time_ns() / 1000000000.0 - started ]) });
}

void observe_defense(
    object me,
    object target,
    string skill,
    int damage,
    mixed result,
    string route
) {
    if (!active) return;
    if (route == "ordinary-dodge" && member_array(current["parameters"]["collection_group"],
        ({ "emei-shexing", "gumu-defense", "mingjiao-movement" })) == -1) return;
    if (active) current["defenses"] += ({ ([ "actor": member_array(me, players),
        "target": member_array(target, players), "skill": skill, "incoming": damage,
        "result": serializable(result), "route": route ]) });
}

void observe_selected_action(object me, object target, string usage, mapping action) {
    mapping frame, value;
    if (active && is_mingjiao_force_remaining()) {
        require(current["parameters"]["panel"] == "inherited-hit" && me == players[0] && target == players[1],
            "one original force control attack");
        current["actions"] += ({ ([ "actor": 0, "target": 1,
            "skill": me->query_skill_mapped(usage), "action": serializable(action) ]) });
        return;
    }
    if (active && current["parameters"]["collection_group"] == "mingjiao-jiuyang-remaining") {
        require(me == players[0] && target == players[1] &&
            current["parameters"]["ability"] == "jiu", "original Jiuyang selected action pair");
        current["actions"] += ({ ([ "attack_id": sizeof(current["actions"]) + 1,
            "actor": 0, "target": 1, "skill": me->query_skill_mapped(usage),
            "action": serializable(action), "before": ({ snapshot(me), snapshot(target) }) ]) });
        return;
    }
    if (active && current["parameters"]["collection_group"] == "mingjiao-shenghuo") {
        require(me == players[0] && target == players[1] && sizeof(shenghuo_attack_frames) < 2,
            "finite original holy attack recursion");
        frame = ([ "attack_id": ++shenghuo_attack_serial,
            "parent_attack_id": sizeof(shenghuo_attack_frames) ? shenghuo_attack_frames[<1]["attack_id"] : 0,
            "attack_depth": sizeof(shenghuo_attack_frames) + 1 ]);
        value = frame + ([ "actor": 0, "target": 1, "skill": me->query_skill_mapped(usage),
            "action": serializable(action), "before": ({ snapshot(me), snapshot(target) }) ]);
        shenghuo_attack_frames += ({ frame });
        current["actions"] += ({ value });
        return;
    }
    if (is_npc_bout()) {
        require(npc_bout_side(me) != -2 && npc_bout_side(target) != -2 && me != target,
            "original natural NPC action pair");
        current["actions"] += ({ ([ "actor": npc_bout_side(me), "actor_object": file_name(me),
            "target": npc_bout_side(target), "target_object": file_name(target),
            "skill": me->query_skill_mapped(usage), "action": serializable(action) ]) });
        return;
    }
    if (!active || member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "s1-sanyin", "s1-mizong",
            "taohua-attack",
            "taohua-combo",
            "mingjiao-core",
            "mingjiao-qishang",
            "mingjiao-movement",
            "mingjiao-qkd",
            "mingjiao-jiuyang",
            "mingjiao-jiuyang-remaining",
            "mingjiao-remaining-perform",
            "mingjiao-remaining-base"
        })) == -1) return;
    current["actions"] += ({ ([ "actor": member_array(me, players),
        "target": member_array(target, players), "skill": me->query_skill_mapped(usage),
        "action": serializable(action) ]) });
}

void begin_passive(object me, object target, string route) {
    mapping frame;
    if (active && is_mingjiao_force_remaining()) {
        require(current["parameters"]["panel"] == "inherited-hit" && me == players[0] &&
            target == players[1] && route == "force" && undefinedp(passive_before[route]),
            "finite inherited force hook entry");
        passive_before[route] = ({ snapshot(me), snapshot(target) });
        return;
    }
    if (active && current["parameters"]["collection_group"] == "mingjiao-shenghuo") {
        require(me == players[0] && target == players[1] && sizeof(shenghuo_passive_frames) < 2 &&
            member_array(route, ({ "force", "martial", "interface" })) != -1,
            "finite original holy passive recursion");
        frame = ([ "id": ++shenghuo_passive_serial,
            "parent_id": sizeof(shenghuo_passive_frames) ? shenghuo_passive_frames[<1]["id"] : 0,
            "depth": sizeof(shenghuo_passive_frames) + 1,
            "attack_id": sizeof(shenghuo_attack_frames) ? shenghuo_attack_frames[<1]["attack_id"] : 0,
            "route": route ]);
        current["passive_events"] += ({ frame + ([ "phase": "before" ]) });
        frame["before"] = ({ snapshot(me), snapshot(target) });
        shenghuo_passive_frames += ({ frame });
        return;
    }
    if (is_npc_bout()) {
        require(me == gumu_npc && target == players[0] && undefinedp(passive_before[route]),
            "natural NPC passive before");
        passive_before[route] = ({ npc_bout_state(me), npc_bout_state(target) });
        return;
    }
    if (!active || member_array(current["parameters"]["collection_group"],
        ({
            "public-special",
            "s1-mizong",
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive",
            "mingjiao-core",
            "mingjiao-qishang",
            "mingjiao-jiuyang",
            "mingjiao-jiuyang-remaining",
            "mingjiao-remaining-perform",
            "mingjiao-remaining-base"
        })) == -1) return;
    require(undefinedp(passive_before[route]), "passive observation is not nested");
    passive_before[route] = ({ snapshot(me), snapshot(target) });
}

void observe_passive(
    object me,
    object target,
    string skill,
    int damage,
    int factor,
    mixed result,
    string route
) {
    mapping frame, value;
    if (active && current["parameters"]["collection_group"] == "mingjiao-shenghuo") {
        require(me == players[0] && target == players[1] && sizeof(shenghuo_passive_frames),
            "matching original holy passive return");
        frame = shenghuo_passive_frames[<1];
        require(frame["route"] == route, "holy passive LIFO route");
        value = frame + ([ "actor": 0, "target": 1, "skill": skill, "incoming": damage,
            "factor": factor, "result": serializable(result),
            "neili_after": me->query("neili"), "target_eff_qi_after": target->query("eff_qi"),
            "target_busy_after": serializable(target->query_busy()),
            "after": ({ snapshot(me), snapshot(target) }) ]);
        current["passives"] += ({ value });
        map_delete(frame, "before");
        current["passive_events"] += ({ frame + ([ "phase": "after" ]) });
        shenghuo_passive_frames = sizeof(shenghuo_passive_frames) > 1 ? shenghuo_passive_frames[0..<2] : ({});
        return;
    }
    if (is_npc_bout()) {
        require(me == gumu_npc && target == players[0] && arrayp(passive_before[route]),
            "natural NPC passive return");
        current["passives"] += ({ ([ "actor": -1, "actor_object": file_name(me),
            "target": 0, "target_object": file_name(target), "skill": skill, "incoming": damage,
            "factor": factor, "result": serializable(result), "route": route,
            "before": passive_before[route], "after": ({
                npc_bout_state(me),
                npc_bout_state(target)
            }) ]) });
        npc_bout_count(me, route);
        map_delete(passive_before, route);
        return;
    }
    if (active) current["passives"] += ({ ([ "actor": member_array(me, players),
        "target": member_array(target, players), "skill": skill, "incoming": damage,
        "factor": factor, "result": serializable(result), "route": route,
        "neili_after": me->query("neili"), "target_eff_qi_after": target->query("eff_qi"),
        "target_busy_after": serializable(target->query_busy()) ]) });
    if (active && (is_mingjiao_force_remaining() || member_array(current["parameters"]["collection_group"],
        ({
            "public-special",
            "s1-mizong",
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive",
            "mingjiao-core",
            "mingjiao-qishang",
            "mingjiao-jiuyang",
            "mingjiao-jiuyang-remaining",
            "mingjiao-remaining-perform",
            "mingjiao-remaining-base"
        })) != -1)) {
        require(arrayp(passive_before[route]), "passive before snapshot exists");
        current["passives"][<1]["before"] = passive_before[route];
        current["passives"][<1]["after"] = ({ snapshot(me), snapshot(target) });
        if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-remaining")
            current["passives"][<1]["attack_id"] = sizeof(current["actions"]);
        map_delete(passive_before, route);
    }
}

void observe_dodge(object me, object target, int attack_type, int ap, int dp, string phase) {
    if (active) current["dodge_checks"] += ({ ([ "actor": member_array(me, players),
        "target": member_array(target, players), "type": attack_type, "ap": ap, "dp": dp,
