// Only the original command's two calls are observed; setup and other groups are excluded.
void observe_hubo_step(object me, string argument, string phase, int result, mixed reason) {
    mapping step;
    mixed *states;
    if (active && current["parameters"]["collection_group"] == "gumu-npc" &&
        me == gumu_npc && base_name(previous_object()) == "/cmds/skill/perform") {
        "/tests/npc_observer"->observe_gumu_step(me, argument, phase, result, reason);
        return;
    }
    if (!active || member_array(current["parameters"]["collection_group"],
        ({ "gumu-hubo", "gumu-temporal" })) == -1 ||
        !arrayp(current["before"]) || me != players[0] ||
        base_name(previous_object()) != "/cmds/skill/perform") return;
    states = ({ snapshot(players[0]), snapshot(players[1]) });
    if (current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "hubo-targets") states += ({ snapshot(players[2]) });
    if (phase == "before") {
        current["hubo_steps"] += ({ ([ "argument": argument,
            "before": states ]) });
        return;
    }
    require(phase == "after" && sizeof(current["hubo_steps"]), "matching original perform step");
    step = current["hubo_steps"][<1];
    require(step["argument"] == argument && undefinedp(step["after"]), "perform step matched once");
    step["accepted"] = result;
    step["reason"] = result || !stringp(reason) ? "" : reason;
    step["after"] = states;
}

void observe_hubo_busy(object me, mixed requested, string phase) {
    mapping call;
    int side;
    if (!active || member_array(current["parameters"]["collection_group"],
        ({ "gumu-hubo", "gumu-temporal" })) == -1 ||
        !arrayp(current["before"]) || !intp(requested)) return;
    side = member_array(me, players);
    if (side == -1) return;
    require(previous_object() == me, "original actor busy observation");
    if (phase == "before") {
        call = ([ "side": side, "caller_side": member_array(this_player(), players),
            "requested": requested, "before": serializable(me->query_busy()) ]);
        current["busy_calls"] += ({ call });
        return;
    }
    require(phase == "after" && sizeof(current["busy_calls"]), "matching original busy call");
    call = current["busy_calls"][<1];
    require(call["side"] == side && undefinedp(call["after"]), "busy call matched once");
    call["after"] = serializable(me->query_busy());
}

void observe_condition_tick(object me, string name, object daemon, string phase, int flag) {
    int side;
    if (!active || current["method"] != "condition") return;
    side = current["parameters"]["collection_group"] == "gumu-needle-lifecycle" ? 1 : 0;
    if (me != players[side]) return;
    current["condition_events"] += ({ ([ "phase": phase, "name": name,
        "daemon": base_name(daemon), "flag": flag, "state": snapshot(me),
        "elapsed": time_ns() / 1000000000.0 - started ]) });
    if (side) current["condition_events"][<1]["side"] = side;
}

void observe_lookup_message(object me, string type, string text) {
    if (active && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-defense", "emei-defense", "emei-shexing", "gumu-defense" })) != -1 &&
        arrayp(current["defense_messages"]) && member_array(me, players) != -1)
        current["defense_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "shaolin-backlash" &&
        me == players[0] && type == "write" && arrayp(current["backlash_messages"]))
        current["backlash_messages"] += ({ text });
    if (active && current["parameters"]["collection_group"] == "wudang-lookup" &&
        me == players[0] && type == "write" && arrayp(current["lookup_messages"]))
        current["lookup_messages"] += ({ text });
    if (active && current["parameters"]["collection_group"] == "gumu-hubo" &&
        current["method"] == "interface" &&
        current["parameters"]["interface"]["function"] == "skill_improved" &&
        me == players[0] && type == "tell_object" && arrayp(current["skill_messages"]))
        current["skill_messages"] += ({ text });
}

void observe_caught_error(mapping details) {
    mapping frame;
    mixed *trace;
    if (!active || current["parameters"]["collection_group"] != "wudang-lookup") return;
    trace = ({});
    foreach (frame in details["trace"] || ({}))
        trace += ({ ([
            "file": frame["file"],
            "line": frame["line"],
            "function": frame["function"]
        ]) });
    current["caught_error"] = ([ "error": details["error"], "trace": trace ]);
}

mapping lookup_snapshot(object ob) {
    object room;
    if (!objectp(ob)) return ([ "missing": 1 ]);
    room = environment(ob);
    return ([ "state": snapshot(ob), "room": room ? file_name(room) : "",
        "room_short": room ? room->short() : "", "name": ob->name(1),
        "place": ob->query("place") ]);
}

void prepare_lookup(mapping parameters) {
    string mode, key;
    mode = parameters["lookup_mode"];
    lookup_subject = players[1];
    if (member_array(mode, ({ "by-living", "no-environment" })) != -1) {
        lookup_subject = new("/tests/actor");
        lookup_subject->set_name("寻踪弟子", ({ "lookup_subject" }));
        lookup_subject->set("id", "lookup_subject");
        lookup_subject->enable_player();
        if (mode != "no-environment") lookup_subject->move(this_object());
        lookup_subject->stop_observation();
    }
    if (mode == "by-player") players[1]->enable_player();
    key = mode == "by-player" ? "right" : mode == "by-living" ? "lookup_subject" : file_name(lookup_subject);
    if (mode == "not-found") key = "missing_lookup_subject";
    if (mode == "no-quest") key = "";
    if (key != "") players[0]->set("quest/id", key);
    current["lookup"] = ([ "quest_id": key,
        "find_player": key == "" ? 0 : serializable(find_player(key)),
        "find_living": key == "" ? 0 : serializable(find_living(key)),
        "find_object": key == "" ? 0 : serializable(find_object(key)),
        "permission": players[0]->query("can_perform/wiz_test"),
        "before": lookup_snapshot(lookup_subject) ]);
    current["lookup_messages"] = ({});
}

void observe_callback(object me, string phase) {
    int side;
    string key;
    mixed *frames;
    object owner;
    if (is_taohua_ding()) {
        owner = previous_object();
        frames = call_stack(2);
        require(arrayp(frames) && sizeof(frames) > 1 && stringp(frames[1]),
            "actual DING callback stack");
        if (taohua_ding_callback(me, phase, owner, frames[1])) return;
    }
    side = member_array(me, players);
    if (active && side != -1) {
        key = current["parameters"]["collection_group"] == "gumu-needle-lifecycle" ? "incidental_callbacks" : "callbacks";
        current[key] += ({ ([ "side": side, "phase": phase,
            "elapsed": time_ns() / 1000000000.0 - started,
            "state": snapshot(me) ]) });
    }
}

