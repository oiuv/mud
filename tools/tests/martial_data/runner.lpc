void observe_caught_error(mapping details) {
    mapping frame;
    mixed *trace;
    if (!active || current["parameters"]["collection_group"] != "wudang-lookup") return;
    trace = ({});
    foreach (frame in details["trace"] || ({}))
        trace += ({ ([
            "file": frame["file"],
            "line": frame["line"],
            "function": frame["function"]
        ]) });
    current["caught_error"] = ([ "error": details["error"], "trace": trace ]);
}

mapping lookup_snapshot(object ob) {
    object room;
    if (!objectp(ob)) return ([ "missing": 1 ]);
    room = environment(ob);
    return ([ "state": snapshot(ob), "room": room ? file_name(room) : "",
        "room_short": room ? room->short() : "", "name": ob->name(1),
        "place": ob->query("place") ]);
}

void prepare_lookup(mapping parameters) {
    string mode, key;
    mode = parameters["lookup_mode"];
    lookup_subject = players[1];
    if (member_array(mode, ({ "by-living", "no-environment" })) != -1) {
        lookup_subject = new("/tests/actor");
        lookup_subject->set_name("寻踪弟子", ({ "lookup_subject" }));
        lookup_subject->set("id", "lookup_subject");
        lookup_subject->enable_player();
        if (mode != "no-environment") lookup_subject->move(this_object());
        lookup_subject->stop_observation();
    }
    if (mode == "by-player") players[1]->enable_player();
    key = mode == "by-player" ? "right" : mode == "by-living" ? "lookup_subject" : file_name(lookup_subject);
    if (mode == "not-found") key = "missing_lookup_subject";
    if (mode == "no-quest") key = "";
    if (key != "") players[0]->set("quest/id", key);
    current["lookup"] = ([ "quest_id": key,
        "find_player": key == "" ? 0 : serializable(find_player(key)),
        "find_living": key == "" ? 0 : serializable(find_living(key)),
        "find_object": key == "" ? 0 : serializable(find_object(key)),
        "permission": players[0]->query("can_perform/wiz_test"),
        "before": lookup_snapshot(lookup_subject) ]);
    current["lookup_messages"] = ({});
}

mapping qkd_queue_point() {
    mixed *entry;
    mapping *pending;
    pending = ({});
    require(active && current["parameters"]["collection_group"] == "mingjiao-qkd",
        "finite original QKD queue observation");
    foreach (entry in call_out_info()) {
        if (entry[0] != players[1] || entry[1] != "eval_function") continue;
        require(sizeof(entry) == 3 && intp(entry[2]), "native QKD timer tuple");
        pending += ({ ([ "owner": file_name(players[1]), "function": entry[1],
            "remaining": entry[2], "tuple_size": sizeof(entry) ]) });
    }
    return ([ "wall_time": time_ns() / 1000000000.0, "pending": pending,
        "fighting": ({ !!players[0]->is_fighting(players[1]),
            !!players[1]->is_fighting(players[0]) }) ]);
}

void observe_callback(object me, string phase) {
    int side;
    string key;
    mixed *frames;
    object owner;
    if (active && is_mingjiao_force_remaining()) {
        require(current["parameters"]["panel"] == "expiry" && me == players[0] && previous_object() == me,
            "original force expiry USER callback");
        if (phase == "before") begin_force_event("expiry");
        current["callbacks"] += ({ ([ "side": 0, "phase": phase,
            "elapsed": time_ns() / 1000000000.0 - started, "state": snapshot(me) ]) });
        if (phase == "after") {
            end_force_event("expiry");
            // The original eval_function and its remove_effect have returned.
            // Do not replace this with a call at the predicted delay.
            call_out("finish_sample", 0);
        }
        return;
    }
    if (is_taohua_ding()) {
        owner = previous_object();
        frames = call_stack(2);
        require(arrayp(frames) && sizeof(frames) > 1 && stringp(frames[1]),
            "actual DING callback stack");
        if (taohua_ding_callback(me, phase, owner, frames[1])) return;
    }
    side = member_array(me, players);
    if (active && side != -1) {
        key = current["parameters"]["collection_group"] == "gumu-needle-lifecycle" ? "incidental_callbacks" : "callbacks";
        current[key] += ({ ([ "side": side, "phase": phase,
            "elapsed": time_ns() / 1000000000.0 - started,
            "state": snapshot(me) ]) });
        if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert") {
            owner = previous_object();
            frames = call_stack(2);
            require(side == 0 && owner == me && base_name(me) == "/tests/actor" &&
                sizeof(frames) > 1 && frames[1] == "eval_function",
                "original bound Jiuyang exert callback wrapper");
            current[key][<1]["owner"] = file_name(owner);
            current[key][<1]["function"] = frames[1];
        }
        if (current["parameters"]["collection_group"] == "mingjiao-qkd") {
            owner = previous_object();
            frames = call_stack(2);
            require(side == 1 && owner == me && base_name(me) == "/tests/actor" &&
                sizeof(frames) > 1 && frames[1] == "eval_function",
                "original bound QKD callback wrapper");
            current[key][<1]["qkd"] = qkd_queue_point() + ([ "owner": file_name(owner),
                "function": frames[1], "states": ({
                    snapshot(players[0]),
                    snapshot(players[1])
                }) ]);
        }
    }
}

void observe_fireice_followup(object me, object target) {
