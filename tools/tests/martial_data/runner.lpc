mapping gumu_teacher_loaded_skills() {
    mapping result;
    string skill;
    result = ([]);
    foreach (skill in ({ "suxin-jian", "quanzhen-jian", "yinsuo-jinling",
        "sanwu-shou", "wudu-shenzhang", "sad-strike" }))
        result[skill] = objectp(find_object("/kungfu/skill/" + skill));
    return result;
}

mapping gumu_teacher_autonomy() {
    object blueprint;
    object *owners;
    mixed row;
    mapping result;
    require(objectp(gumu_teacher), "original Gumu teacher reference");
    blueprint = find_object(base_name(gumu_teacher));
    require(objectp(blueprint), "original Gumu teacher blueprint");
    owners = ({
        gumu_teacher,
        blueprint
    }) + deep_inventory(gumu_teacher) + deep_inventory(blueprint);
    result = ([ "heartbeat": query_heart_beat(gumu_teacher),
        "blueprint": file_name(blueprint), "blueprint_heartbeat": query_heart_beat(blueprint),
        "callbacks": ({}) ]);
    foreach (row in call_out_info())
        if (member_array(row[0], owners) != -1)
            result["callbacks"] += ({ ([ "object": file_name(row[0]),
                "function": serializable(row[1]), "delay": row[2]]) });
    return result;
}

void clear_gumu_teacher() {
    object item, holder;
    gumu_teacher_pending = 0;
    if (mapp(gumu_item_context))
        foreach (holder in values(gumu_item_context["carriers"])) if (objectp(holder))
            foreach (item in all_inventory(holder))
                if (base_name(item) == gumu_item_context["item"]) gumu_item_owned += ({ item });
    foreach (item in gumu_item_owned) if (objectp(item)) destruct(item);
    gumu_item_owned = ({});
    gumu_item_context = 0;
    if (objectp(gumu_previous_teacher)) {
        foreach (item in deep_inventory(gumu_previous_teacher)) destruct(item);
        destruct(gumu_previous_teacher);
    }
    gumu_previous_teacher = 0;
    // Also owns a successfully created NPC whose move failed before room cleanup.
    if (objectp(gumu_teacher)) {
        foreach (item in deep_inventory(gumu_teacher)) destruct(item);
        destruct(gumu_teacher);
    }
    gumu_teacher = 0;
}

// Only this finite acquisition profile prepares stock, holders and capacity.
// Every award still runs the original ask/NPC/MASTER_D/move/combined chain.
void prepare_gumu_items(mapping parameters) {
    mapping setup, prep;
    object item, holder, container;
    string role;
    require(parameters["teaching_profile"] == "gumu-item-acquisition", "scoped item preparation");
    setup = parameters["item_setup"];
    require(member_array(setup["item"], ({ "/d/gumu/obj/yufeng-zhen",
        "/d/gumu/obj/bingpo-zhen", "/clone/lonely/yinsuo" })) != -1, "reviewed acquisition item");
    gumu_item_context = ([ "item": setup["item"], "stock_key": setup["stock_key"],
        "carriers": ([ "student": players[0], "room": this_object() ]) ]);
    prep = ([ "scope": "explicit_preparation_not_natural_acquisition",
        "stock_key": setup["stock_key"], "stock_source": setup["stock_source"],
        "constructor_stock": 0, "reset": 0, "singleton": 0, "previous_teacher": 0 ]);
    current["item_preparation"] = prep;
    if (setup["item"] == "/clone/lonely/yinsuo") {
        require(!objectp(find_object(setup["item"])), "previous acquisition singleton cleaned");
        item = load_object(setup["item"]);
        gumu_item_owned += ({ item });
        require(objectp(item) && !clonep(item) && !environment(item), "original free singleton");
        if (setup["holder"] == "previous_teacher") {
            gumu_teacher_pending = 1;
            require(players[0]->force_me("test_interface") && !gumu_teacher_pending &&
                objectp(gumu_teacher), "first original singleton holder");
            prep["previous_teacher"] = copy(current["teacher_preparation"]);
            prep["previous_teacher"]["singleton_before_create"] = 0;
            prep["previous_teacher"]["singleton_after_create"] = serializable(environment(item));
            gumu_previous_teacher = gumu_teacher;
            gumu_item_context["carriers"]["previous_teacher"] = gumu_previous_teacher;
            gumu_teacher = 0;
        } else if (setup["holder"] != "cold") {
            role = replace_string(setup["holder"], "-container", "");
            require(member_array(role, ({ "student", "room", "peer", "outsider" })) != -1,
                "finite singleton holder");
            if (role == "peer" || role == "outsider") {
                players[1]->set("family/family_name", role == "peer" ? "古墓派" : "武当派");
                gumu_item_context["carriers"][role] = players[1];
            }
            holder = gumu_item_context["carriers"][role];
            if (strsrch(setup["holder"], "-container") != -1) {
                container = new("/inherit/item/item");
                gumu_item_owned += ({ container });
                container->set_name("试验收纳袋", ({ "acquisition bag" }));
                container->set_weight(0);
                container->set_max_encumbrance(1300);
                require(container->move(holder), "original item container placement");
                gumu_item_context["carriers"]["container"] = container;
                holder = container;
            }
            require(item->move(holder), "explicit original singleton placement");
        }
        prep["singleton"] = ([ "object": file_name(item), "clonep": clonep(item),
            "before_create": serializable(environment(item)) ]);
    } else if (setup["initial_room_amount"] > 0) {
        require(setup["item"] == "/d/gumu/obj/yufeng-zhen" && setup["initial_room_amount"] == 50,
            "finite initial room stack");
        item = new(setup["item"]);
        gumu_item_owned += ({ item });
        item->set_amount(setup["initial_room_amount"]);
        require(item->move(this_object()), "original initial room stack movement");
    }
    players[0]->set_max_encumbrance(players[0]->query_encumbrance() + setup["free_capacity"]);
}

void finish_gumu_item_preparation(mapping parameters) {
    mapping setup, prep;
    object item, weapon;
    setup = parameters["item_setup"];
    prep = current["item_preparation"];
    gumu_item_context["carriers"]["teacher"] = gumu_teacher;
    prep["teacher"] = file_name(gumu_teacher);
    prep["teacher_program"] = base_name(gumu_teacher);
    if (stringp(setup["stock_key"])) {
        prep["constructor_stock"] = gumu_teacher->query(setup["stock_key"]);
        if (setup["stock_source"] == "direct_reset") {
            prep["reset"] = ([ "calls": 1, "function": "reset",
                "owner": function_exists("reset", gumu_teacher), "object": file_name(gumu_teacher),
                "before": prep["constructor_stock"], "scope": "direct_interface_not_natural_refresh" ]);
            gumu_teacher->reset();
            prep["reset"]["after"] = gumu_teacher->query(setup["stock_key"]);
        } else gumu_teacher->set(setup["stock_key"], setup["stock"]);
    } else {
        item = find_object(setup["item"]);
        require(objectp(item), "same original singleton after constructor");
        weapon = gumu_teacher->query_temp("weapon");
        prep["singleton"]["after_create"] = serializable(environment(item));
        prep["singleton"]["fallback"] = objectp(weapon) && base_name(weapon) == "/clone/weapon/changbian";
    }
    require(present(parameters["teacher"]["id"], this_object()) == gumu_teacher,
        "exact original teacher resolves despite same-name holder");
}

void set_gumu_npc_observation(object ob) {
    require(active && (current["parameters"]["collection_group"] == "gumu-npc" || is_npc_bout()) &&
        base_name(previous_object()) == "/tests/npc_observer" && objectp(ob) &&
        clonep(ob) && base_name(ob) == current["parameters"]["npc"]["path"] && !objectp(gumu_npc),
        "exact original NPC observation reference");
    gumu_npc = ob;
}

int do_interface() {
    mapping spec, busy_call;
    mixed result, reason;
    if (!active || this_player() != players[0]) return 0;
    if (gumu_npc_pending) {
        gumu_npc_pending = 0;
        if (is_npc_bout()) {
            current["npc_observation"] = "/tests/npc_observer"->prepare_gumu_bout(
                current["parameters"]["npc"], players[0]);
            return 1;
        }
        require(current["method"] == "npc" &&
            current["parameters"]["collection_group"] == "gumu-npc", "scoped original Gumu NPC command");
        current["npc_observation"] = "/tests/npc_observer"->observe_gumu(
            current["parameters"]["npc"], players[0]);
        return 1;
    }
    if (gumu_teacher_pending) {
        gumu_teacher_pending = 0;
        require(current["method"] == "teaching" &&
            member_array(current["parameters"]["teaching_profile"],
                ({
                    "gumu-teachers",
                    "gumu-special",
                    "gumu-acquisition-learning", "gumu-item-acquisition", "gumu-recruit"
                })) != -1 && !objectp(gumu_teacher),
            "scoped original Gumu teacher preparation");
        require(userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "connected ordinary student creates original teacher");
        current["teacher_preparation"] = ([ "command": "test_interface",
            "entry_actor": file_name(this_player()), "before": snapshot(players[0]),
            "loaded_before": gumu_teacher_loaded_skills(), "initializer_actor": "not_observed" ]);
        // Original setup/enable_player may change the command giver inside create.
        // Entry/return identity is not evidence of the action table's first reader.
        gumu_teacher = new(current["parameters"]["teacher"]["path"]);
        require(objectp(gumu_teacher) && clonep(gumu_teacher), "original Gumu teacher clone");
        current["teacher_preparation"]["teacher"] = file_name(gumu_teacher);
        current["teacher_preparation"]["teacher_program"] = base_name(gumu_teacher);
        require(gumu_teacher->move(this_object()), "prepared teacher in observation room");
        current["teacher_preparation"]["autonomy_before"] = gumu_teacher_autonomy();
        evaluate(bind((: set_heart_beat, 0 :), gumu_teacher));
        current["teacher_preparation"]["autonomy_after"] = gumu_teacher_autonomy();
        current["teacher_preparation"]["teacher_state"] = snapshot(gumu_teacher);
        current["teacher_preparation"]["after"] = snapshot(players[0]);
        current["teacher_preparation"]["loaded_after"] = gumu_teacher_loaded_skills();
        current["teacher_preparation"]["return_actor"] = serializable(this_player());
        require(this_player() == players[0] && !query_heart_beat(gumu_teacher) &&
            !current["teacher_preparation"]["autonomy_after"]["blueprint_heartbeat"] &&
            !sizeof(current["teacher_preparation"]["autonomy_before"]["callbacks"]) &&
            !sizeof(current["teacher_preparation"]["autonomy_after"]["callbacks"]),
            "original teacher prepared without autonomous callbacks");
        return 1;
    }
    spec = current["parameters"]["interface"];
    require(mapp(spec) && member_array(
        spec["function"],
        ({
            "valid_learn",
            "valid_research",
            "valid_force",
            "can_learn",
            "do_effect",
            "difficult_level",
            "query_neili_improve",
            "query_neili_limit",
            "query_current_neili_limit",
            "query_effect_parry",
            "query_effect_dodge",
            "query_dodge_msg",
            "query_action",
            "query_parry_msg",
            "valid_enable",
            "type",
            "valid_learn_level",
            "valid_combine",
            "practice_skill",
            "valid_damage",
            "do_damage",
            "hit_ob",
            "remove_enemy",
            "remove_all_enemy",
            "start_busy",
            "skill_improved"
        })
    ) != -1,
        "configured observation interface");
    if (spec["function"] == "valid_research") {
        require(member_array(current["parameters"]["collection_group"],
            ({ "gumu-cultivation", "gumu-movement" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original research qualification");
        result = call_other(spec["object"], "valid_research", players[0]);
    } else if (spec["function"] == "valid_force") {
        require(current["parameters"]["collection_group"] == "gumu-cultivation" &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            stringp(spec["argument"]), "configured original force compatibility");
        result = call_other(spec["object"], "valid_force", spec["argument"]);
    } else if (spec["function"] == "can_learn") {
        require(current["parameters"]["collection_group"] == "gumu-cultivation" &&
            spec["object"] == "/cmds/skill/learn" &&
            spec["argument"] == current["parameters"]["skill"],
            "configured original public learning qualification");
        result = call_other(spec["object"], "can_learn", players[0], spec["argument"]);
    } else if (spec["function"] == "start_busy") {
        require(current["parameters"]["collection_group"] == "gumu-hubo" &&
            spec["object"] == "player" && !undefinedp(spec["player_side"]) &&
            member_array(spec["player_side"], ({ 0, 1 })) != -1 &&
            intp(spec["amount"]) && spec["amount"] >= 0,
            "configured original busy interface");
        result = call_other(players[spec["player_side"]], "start_busy", spec["amount"]);
        if (!spec["amount"]) {
            // The original zero request returned early. Read its actual state after that return.
            require(sizeof(current["busy_calls"]), "zero busy call observed");
            busy_call = current["busy_calls"][<1];
            require(busy_call["side"] == spec["player_side"] && busy_call["requested"] == 0 &&
                undefinedp(busy_call["after"]), "matching original zero busy return");
            busy_call["after"] = serializable(players[spec["player_side"]]->query_busy());
        }
    } else if (spec["function"] == "skill_improved") {
        require(current["parameters"]["collection_group"] == "gumu-hubo" &&
            spec["object"] == "/kungfu/skill/zuoyou-hubo", "configured original knowledge notification");
        result = call_other(spec["object"], "skill_improved", players[0]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "gumu-movement") {
        require(spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["argument"], ({ "dodge", "move", "parry" })) != -1,
            "configured original movement usage");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (member_array(spec["function"], ({ "valid_enable", "query_parry_msg" })) != -1) {
        require(member_array(current["parameters"]["collection_group"],
            ({ "shaolin-defense", "emei-defense", "emei-shexing", "gumu-defense" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original defense query");
        if (spec["function"] == "valid_enable") {
            require(member_array(spec["usage"], ({ "parry", "dodge", "move" })) != -1 ||
                (current["parameters"]["collection_group"] == "gumu-defense" &&
                    spec["object"] == "/kungfu/skill/tianluo-diwang" && spec["usage"] == "strike"),
                "configured defense usage");
            if (!undefinedp(spec["player_side"])) {
                require(current["parameters"]["collection_group"] == "gumu-defense" &&
                    spec["object"] == "/kungfu/skill/tianluo-diwang" && spec["player_side"] == 1,
                    "configured defender qualification query");
                result = call_other(spec["object"], "valid_enable", spec["usage"], players[1]);
            } else result = call_other(spec["object"], "valid_enable", spec["usage"]);
        } else
            result = call_other(
                spec["object"],
                "query_parry_msg",
                players[1]->query_temp("weapon")
            );
    } else if (spec["function"] == "do_effect") {
        require(current["parameters"]["collection_group"] == "shaolin-backlash" &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original force safety check");
        result = call_other(spec["object"], "do_effect", players[0]);
    } else if (spec["function"] == "valid_combine") {
        require(member_array(current["parameters"]["collection_group"],
            ({
                "wudang-combination",
                "shaolin-combination",
                "emei-combination",
                "gumu-combination"
            })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured combination query");
        result = call_other(spec["object"], "valid_combine", spec["combo"]);
    } else if (spec["function"] == "query_effect_dodge")
        result = call_other(spec["object"], "query_effect_dodge", players[0], players[1]);
    else if (spec["function"] == "query_dodge_msg")
        result = call_other(spec["object"], "query_dodge_msg", "胸口");
    else if (spec["function"] == "query_action") {
        require(current["parameters"]["collection_group"] == "emei-shexing" &&
            spec["object"] == "/kungfu/skill/shexing-lifan", "configured movement action query");
        result = call_other(
            spec["object"],
            "query_action",
            players[0],
            players[0]->query_temp("weapon")
        );
    } else if (spec["function"] == "type")
        result = call_other(spec["object"], "type");
    else if (member_array(spec["function"], ({ "valid_learn_level", "practice_skill" })) != -1)
        result = call_other(spec["object"], spec["function"], players[0]);
    else if (spec["function"] == "difficult_level")
        result = call_other(spec["object"], "difficult_level");
    else if (spec["function"] == "query_neili_improve")
        result = call_other(spec["object"], "query_neili_improve", players[0]);
    else if (member_array(
        spec["function"],
        ({ "query_neili_limit", "query_current_neili_limit" })
    ) != -1) {
        require(spec["object"] == "player", "real USER cultivation interface");
        result = call_other(players[0], spec["function"]);
    } else if (spec["function"] == "query_effect_parry")
        result = call_other(spec["object"], "query_effect_parry", players[0], players[1]);
    else if (spec["function"] == "valid_damage") {
        result = call_other(spec["object"], "valid_damage", players[0], players[1],
            spec["damage"], players[0]->query_temp("weapon"));
        observe_defense(
            players[0],
            players[1],
            current["parameters"]["skill"],
            spec["damage"],
            result,
            "interface"
        );
    } else if (spec["function"] == "do_damage") {
        require(spec["object"] == COMBAT_D, "original combat damage interface");
        require(
            undefinedp(spec["attack_type"]) || member_array(
                spec["attack_type"],
                ({ UNARMED_ATTACK, WEAPON_ATTACK })
            ) != -1,
            "configured attack type"
        );
        result = COMBAT_D->do_damage(
            players[0],
            players[1],
            undefinedp(spec["attack_type"]) ? WEAPON_ATTACK : spec["attack_type"],
            spec["damage"],
            50,
            ""
        );
    } else if (spec["function"] == "hit_ob" && spec["object"] == "/kungfu/skill/taiji-quan") {
        require(current["parameters"]["collection_group"] == "wudang-passive",
            "configured original Taiji passive interface");
        result = call_other(spec["object"], "hit_ob", players[0], players[1]);
    } else if (member_array(spec["function"], ({ "remove_enemy", "remove_all_enemy" })) != -1) {
        require(spec["object"] == "player" &&
            current["parameters"]["collection_group"] == "wudang-passive",
            "configured original combat cleanup");
        if (spec["function"] == "remove_enemy") result = players[0]->remove_enemy(players[1]);
        else result = players[0]->remove_all_enemy(1);
    } else if (spec["function"] == "hit_ob") {
        require(
            spec["object"] == "/kungfu/skill/xiantian-gong" ||
            (current["parameters"]["collection_group"] == "emei-jiuyin-passive" &&
                member_array(spec["object"], ({ "/kungfu/skill/jiuyin-baiguzhao",
                    "/kungfu/skill/cuixin-zhang" })) != -1) ||
            (spec["object"] == "/kungfu/skill/shenmen-jian" &&
                current["parameters"]["collection_group"] == "wudang-shenmen") ||
            (spec["object"] == "/kungfu/skill/yuxiao-jian" &&
                current["parameters"]["collection_group"] == "taohua-passive") ||
            (current["parameters"]["collection_group"] == "gumu-weapons" &&
                member_array(spec["object"], ({ "/kungfu/skill/xuantie-jian",
                    "/kungfu/skill/sanwu-shou", "/kungfu/skill/yunv-xinjing" })) != -1) ||
            (current["parameters"]["collection_group"] == "gumu-unarmed-attack" &&
                member_array(spec["object"], ({ "/kungfu/skill/meinv-quan",
                    "/kungfu/skill/tianluo-diwang", "/kungfu/skill/chilian-shenzhang",
                    "/kungfu/skill/wudu-shenzhang", "/kungfu/skill/sad-strike",
                    "/kungfu/skill/fireice-strike" })) != -1),
            "configured original passive interface"
        );
        begin_passive(players[0], players[1], "interface");
        result = call_other(
            spec["object"],
            "hit_ob",
            players[0],
            players[1],
            spec["damage"],
            spec["factor"]
        );
        observe_passive(
            players[0],
            players[1],
            explode(spec["object"], "/")[<1],
            spec["damage"],
            spec["factor"],
            result,
            "interface"
        );
    } else
        result = call_other(spec["object"], "valid_learn", players[0]);
    reason = query_notify_fail();
    current["interfaces"] += ({ ([ "object": spec["object"], "function": spec["function"],
        "result": serializable(result) ]) });
    if (spec["function"] == "valid_combine")
        current["interfaces"][<1]["combo"] = spec["combo"];
    if (!undefinedp(spec["player_side"]))
        current["interfaces"][<1]["player_side"] = spec["player_side"];
    if (!undefinedp(spec["argument"]))
        current["interfaces"][<1]["argument"] = spec["argument"];
    if (spec["function"] == "do_effect")
        current["interfaces"][<1]["implemented_by"] = function_exists(
            "do_effect",
            load_object(spec["object"])
        );
    if (spec["function"] == "query_effect_dodge")
        current["interfaces"][<1]["implemented_by"] = function_exists(
            "query_effect_dodge",
            load_object(spec["object"])
        );
    if (member_array(current["parameters"]["collection_group"],
        ({ "shaolin-defense", "emei-defense", "emei-shexing", "gumu-defense" })) != -1)
        current["interfaces"][<1]["implemented_by"] = function_exists(
            spec["function"], load_object(spec["object"]));
    if (current["parameters"]["collection_group"] == "gumu-hubo")
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[spec["player_side"]] : load_object(spec["object"]));
    if (current["parameters"]["collection_group"] == "gumu-cultivation")
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[0] : load_object(spec["object"]));
    if (member_array(current["parameters"]["collection_group"],
        ({ "gumu-movement", "gumu-weapon-learning", "gumu-unarmed-learning" })) != -1)
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            load_object(spec["object"]));
    current["outcome"] = member_array(
        spec["function"],
        ({ "valid_learn", "valid_research", "can_learn", "practice_skill" })
    ) != -1 && !result ? "refused" : "observed";
    if (current["outcome"] == "refused") current["reason"] = stringp(reason) ? reason : "学习接口未允许";
    return 1;
}

void init() { add_action("do_interface", "test_interface"); }

// Point observations still have no autonomous heartbeat. Bouts use the original
// USER heartbeat, including regeneration; only the chosen command is automated.
int strategy(object ob, int side) {
    if (is_npc_bout()) {
        require(!side && ob == players[0], "only the neutral USER heartbeat");
        ob->count_event("heartbeats");
        record_npc_bout_heartbeat(ob);
        return 1;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown" && side < 2 && ob == players[side]) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && current["method"] == "scene" &&
        current["parameters"]["lifecycle"] && current["parameters"]["observe_seconds"] > 0) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && promotion_waiting &&
        current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && side == 1 && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        if (side != 1 || current["method"] != "condition" || !current["parameters"]["ticks"])
            return 0;
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && member_array(
        current["method"],
        ({ "exercise", "healing", "condition" })
    ) != -1 && !side) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (!active || current["method"] != "bout") return 0;
    if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
        current["terminal"] = "time_limit";
        current["winner"] = -1;
        finish_sample();
        return 0;
    }
    ob->count_event("heartbeats");
    if (current["first_actor"] == -1) current["first_actor"] = side;
    if (!side && current["parameters"]["strategy"] == "perform" &&
        living(ob) && living(players[1]) && !ob->is_busy() &&
        ob->query("qi") >= 0 && players[1]->query("qi") >= 0) {
        ob->count_event("perform_attempts");
        ob->force_me(current["parameters"]["action"]);
    }
    return active;
}

void after_heartbeat(int side) {
    if (is_npc_bout()) {
        require(!side, "natural bout excludes bystander heartbeat");
        sample_busy();
        if (!current["second_started"] && objectp(gumu_npc)) {
            current["second_started"] = 1;
            evaluate(bind((: set_heart_beat, 1 :), gumu_npc));
        }
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle" && side == 1) {
        if (sizeof(current["condition_events"]) / 2 > sizeof(current["condition_heartbeats"])) {
            current["condition_heartbeats"] += ({ ([ "side": side, "state": snapshot(players[side]),
                "elapsed": time_ns() / 1000000000.0 - started ]) });
            if (sizeof(current["condition_heartbeats"]) == current["parameters"]["ticks"])
                finish_sample();
        }
        return;
    }
    if (active && current["method"] == "condition" && !side) {
        if (sizeof(current["condition_events"]) / 2 > sizeof(current["condition_heartbeats"])) {
            current["condition_heartbeats"] += ({ ([ "state": snapshot(players[0]),
                "elapsed": time_ns() / 1000000000.0 - started ]) });
            if (sizeof(current["condition_heartbeats"]) == current["parameters"]["ticks"])
                finish_sample();
        }
        return;
    }
    if (active && current["method"] == "healing" && !side) {
        if (current["parameters"]["halt_after"] && sizeof(current["healing_steps"]) &&
            !current["halt_accepted"]) {
            current["healing_halt"] = ([ "before": snapshot(players[0]) ]);
            current["halt_accepted"] = players[0]->force_me("halt");
            current["healing_halt"]["after"] = snapshot(players[0]);
            require(current["halt_accepted"], "original healing halt accepted");
        }
        // Preserve the game's pending marker, including MA-080; busy owns completion.
        if (!players[0]->is_busy()) {
            current["healing_terminal"] = current["halt_accepted"] ? "halted" : "busy_ended";
            finish_sample();
        }
        return;
    }
    if (active && current["method"] == "exercise" && !side) {
        if (current["parameters"]["halt_after"] && sizeof(current["exercise_steps"]) &&
            !current["halt_accepted"]) {
            current["halt_accepted"] = players[0]->force_me("halt");
            require(current["halt_accepted"], "original halt accepted");
        }
        if (!players[0]->is_busy() && !players[0]->query_temp("pending/exercise")) {
            current["exercise_terminal"] = current["halt_accepted"] ? "halted" : "completed";
            finish_sample();
        }
        return;
    }
    if (!active || current["method"] != "bout") return;
    sample_busy();
    if (!current["second_started"]) {
        require(side == current["first"], "actual opening initiative");
        current["second_started"] = 1;
        players[1 - side]->observation_heartbeat(1);
    }
}

void terminal(object ob, int side, string state) {
    if (is_npc_bout()) {
        require(!side && ob == players[0], "natural bout USER terminal return");
        call_out("finish_sample", 0);
        return;
    }
    if (active) current["terminals"] += ({ ([ "side": side, "state": state ]) });
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        current["outcome"] = "error";
        current["reason"] = "Original cooldown sequence ended with " + state;
        finish_sample();
        return;
    }
    if (active && current["method"] == "scene" && current["parameters"]["lifecycle"])
        stop_background_quests();
    if (active && side == 1 && state == "death" &&
        member_array(
            current["parameters"]["collection_group"],
            ({ "shaolin-palms", "shaolin-hands" })
        ) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        if (current["parameters"]["collection_group"] == "shaolin-hands")
            current["observation_terminal"] = "death";
        finish_sample();
        return;
    }
    if (active && current["method"] == "bout") {
        current["terminal"] = state;
        current["winner"] = 1 - side;
        finish_sample();
    }
}

void sample_busy() {
    float now, elapsed;
    int side;
    now = time_ns() / 1000000000.0;
    elapsed = now - observed;
    foreach (side in ({ 0, 1 })) {
        if (busy_state[side]) busy_seconds[side] += elapsed;
        if (is_npc_bout()) busy_state[side] = side ? players[0]->is_busy() : objectp(gumu_npc) && gumu_npc->is_busy();
        else busy_state[side] = objectp(players[side]) && players[side]->is_busy();
    }
    observed = now;
}

// Three original commands only. Waiting neither rewrites the game's timestamp
// nor invokes continue_action, start_busy, resource refills or automatic performs.
void perform_gumu_temporal(string phase) {
    mapping step;
    mixed reason;
    require(active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown" &&
        member_array(phase, ({ "initial", "early", "expired" })) != -1,
        "reviewed original cooldown sequence");
    step = ([ "phase": phase, "action": current["parameters"]["action"],
        "before": ({ snapshot(players[0]), snapshot(players[1]) }),
        "metrics_before": ({ players[0]->query_observation(), players[1]->query_observation() }),
        "launches_before": sizeof(current["launches"]), "directs_before": sizeof(current["directs"]) ]);
    current["temporal_steps"] += ({ step });
    step["accepted"] = players[0]->force_me(step["action"]);
    reason = players[0]->query_temp("notify_fail");
    step["reason"] = step["accepted"] || !stringp(reason) ? "" : reason;
    step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
    step["metrics_after"] = ({ players[0]->query_observation(), players[1]->query_observation() });
    step["launches_after"] = sizeof(current["launches"]);
    step["directs_after"] = sizeof(current["directs"]);
}

void poll_gumu_temporal() {
    int size, age;
    object ob;
    require(time_ns() / 1000000000.0 - started <= current["parameters"]["observe_seconds"],
        "original cooldown sequence observation window expired");
    foreach (ob in players[0..1])
        require(objectp(ob) && interactive(ob) && living(ob) && !ob->is_ghost() &&
            environment(ob) == this_object() && ob->query("qi") >= 0 && ob->query("jing") >= 0,
            "original cooldown sequence lost its live connected target");
    require(players[0]->is_fighting(players[1]) && players[1]->is_fighting(players[0]) &&
        players[0]->query("neili") >= 500, "original cooldown sequence lost combat or resources");
    size = sizeof(current["temporal_steps"]);
    require(size == 1 || size == 2, "original cooldown sequence phase");
    age = time() - players[0]->query_temp("last_perform/sad-strike/tuo");
    if (!players[0]->is_busy() && age > 0 && (size == 1 || age >= 60)) {
        require(size == 2 || age < 60, "early original cooldown boundary missed");
        perform_gumu_temporal(size == 1 ? "early" : "expired");
        require(current["temporal_steps"][<1]["accepted"] == (size == 2),
            "original cooldown phase did not produce its expected return");
        if (size == 2) {
            finish_sample();
            return;
        }
    }
    call_out("poll", 1);
}

void poll() {
    mapping state, step;
    if (is_npc_bout()) {
        sample_busy();
        if (sizeof(current["npc_bout"]["terminal_events"]) ||
            time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"])
            finish_sample();
        else call_out("poll", 1);
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        poll_gumu_temporal();
        return;
    }
    if (active && current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        observe_challenge();
        if (time_ns() / 1000000000.0 - formation_started >= current["parameters"]["observe_seconds"])
            finish_sample();
        else call_out("poll", 1);
        return;
    }
    if (active && promotion_waiting && current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        state = "/tests/teaching_observer"->finish_promotion_wait(players[0], promotion_teacher);
        require(time_ns() / 1000000000.0 - promotion_started < current["parameters"]["observe_seconds"],
            "original promotion fight/callback did not complete within observation window");
        if (state["promotion"]["teacher_fighting"] || state["promotion"]["student_fighting"] ||
            state["promotion"]["checking_pending"]) {
            call_out("poll", 1);
            return;
        }
        step = current["teaching"][<1];
        step["immediate_after"] = step["after"];
        step["after"] = state;
        step["wait_elapsed"] = time_ns() / 1000000000.0 - promotion_started;
        step["wait_messages"] = players[0]->end_teaching_messages();
        promotion_waiting = 0;
        players[0]->observation_heartbeat(0);
        advance_promotion();
        if (promotion_waiting) call_out("poll", 1);
        else finish_sample();
        return;
    }
    if (active && current["parameters"]["collection_group"] == "shaolin-hands" &&
        current["parameters"]["target_heartbeat"]) {
        // Zero effective resources do not guarantee death: retain the real state.
        if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
            current["observation_terminal"] = "window_complete";
            finish_sample();
        } else call_out("poll", 1);
        return;
    }
    if (active && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original target death heartbeat did not finish");
        call_out("poll", 1);
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original needle lifecycle did not complete before watchdog");
        call_out("poll", 1);
        return;
    }
    if (active && member_array(current["method"], ({ "exercise", "healing", "condition" })) != -1) {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original heartbeat action watchdog expired without completion");
        call_out("poll", 1);
        return;
    }
    if (!active || current["method"] != "bout") return;
    sample_busy();
    if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
        current["terminal"] = "time_limit";
        current["winner"] = -1;
        finish_sample();
    } else call_out("poll", 1);
}

// Continue the same student's original commands after the original NPC timer.
// The only autonomous player action is its normal heartbeat during fight.
void advance_promotion() {
    mapping parameters, expectation, step;
    string path;
    parameters = current["parameters"];
    while (promotion_index < sizeof(parameters["teaching_expectations"])) {
        expectation = parameters["teaching_expectations"][promotion_index++];
        path = expectation["teacher"]["path"];
        if (!objectp(promotion_teacher) || base_name(promotion_teacher) != path) {
            promotion_teacher = new(path);
            require(promotion_teacher->move(this_object()), "original promotion NPC in room");
        }
        step = "/tests/teaching_observer"->observe_command(players[0], promotion_teacher,
            expectation["action"], ({}), 0, 0, 1);
        current["teaching"] += ({ step });
        if (sizeof(step["after"]["promotion"]["items"]) > sizeof(step["before"]["promotion"]["items"]) ||
            step["after"]["master_id"] != step["before"]["master_id"])
            current["outcome"] = "observed";
        if (expectation["wait_fight"] && step["command_accepted"]) {
            promotion_waiting = 1;
            promotion_started = time_ns() / 1000000000.0;
            players[0]->begin_teaching_messages();
            players[0]->observation_heartbeat(1);
            return;
        }
    }
    if (current["outcome"] == "refused") current["reason"] = "原命令未取得信物或晋升，详见逐步记录";
}

void observe_challenge() {
    mapping state;
    state = "/tests/challenge_observer"->observe(players[0], challenge_teachers,
        current["parameters"]["challenge_rosters"]);
    state["elapsed"] = time_ns() / 1000000000.0 - formation_started;
    current["challenge_timeline"] += ({ state });
}

void start_challenge(mapping parameters) {
    mapping expectation, step;
    object teacher;
    string name, direction;
    int index, i;
    // The base fixture ran setup before its per-sample ID was assigned.
    // Use the original registration entry, not a replacement find_player.
    players[0]->enable_player();
    require(find_player(players[0]->query("id")) == players[0], "registered challenge player");
    "/tests/challenge_observer"->reset_sample();
    "/tests/formation_observer"->reset_sample();
    current["teaching"] = ({});
    current["challenge_walks"] = ({});
    current["challenge_timeline"] = ({});
    challenge_teachers = ({});
    formation_started = time_ns() / 1000000000.0;
    for (index = 0; index < 2; index++) {
        name = parameters["challenge_order"][index];
        teacher = "/tests/challenge_observer"->teacher(name);
        if (!index) require(
            players[0]->move(environment(teacher)),
            "initial original formation room"
        );
        expectation = parameters["teaching_expectations"][index];
        step = "/tests/teaching_observer"->observe_command(players[0], teacher,
            expectation["action"], ({}), 0, 0, 0, 0, expectation["formation"]);
        current["teaching"] += ({ step });
        require(step["after"]["formation"]["requested"] == 1, "original invitation accepted");
        challenge_teachers += ({ teacher });
        direction = name == "xuan-ku" ? "west" : "east";
        for (i = 0; i < (index ? 2 : 4); i++) {
            step = "/tests/challenge_observer"->walk(players[0], direction);
            current["challenge_walks"] += ({ step });
            require(step["before"] != step["after"], "original go reached next formation room");
        }
    }
    require(
        base_name(environment(players[0])) == "/d/shaolin/wuchang",
        "arrived at original field"
    );
    current["teaching"][<1]["immediate_after"] = current["teaching"][<1]["after"];
    current["outcome"] = "observed";
    players[0]->begin_teaching_messages();
    players[0]->observation_heartbeat(1);
    observe_challenge();
}

void perform_sample() {
    mapping parameters, step, expectation;
    string action, grant, room_key, saved_state;
    mixed reason;
    object teacher, restored_actor, ob;
    int result, launches, cycle, participant;
    parameters = current["parameters"];
    foreach (room_key in ({
        "no_fight",
        "skybook",
        "can_dazuo",
        "exercise_improve",
        "sleep_room"
    })) {
        delete(room_key);
        if (mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    foreach (room_key in ({ "practice_improve", "research_improve" })) {
        delete(room_key);
        if ((parameters["collection_group"] == "gumu-movement" ||
            (parameters["collection_group"] == "gumu-weapon-learning" && room_key == "practice_improve") ||
            (parameters["collection_group"] == "gumu-research" && room_key == "research_improve")) &&
            mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    foreach (room_key in ({
        "pigging",
        "can_practice_xiantie-jian",
        "can_practice_xuantie-jian"
    })) {
        delete(room_key);
        if ((parameters["collection_group"] == "gumu-weapon-learning" ||
            (parameters["collection_group"] == "gumu-research" && room_key == "pigging")) &&
            mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    if (parameters["collection_group"] == "gumu-weapon-learning")
        current["weapon_learning_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "practice_improve": query("practice_improve"),
            "can_practice_xiantie-jian": query("can_practice_xiantie-jian"),
            "can_practice_xuantie-jian": query("can_practice_xuantie-jian") ]);
    if (parameters["collection_group"] == "gumu-unarmed-learning") {
        foreach (room_key in ({ "pigging", "practice_improve" }))
            if (mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
                set(room_key, parameters["room"][room_key]);
        current["unarmed_learning_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "practice_improve": query("practice_improve") ]);
    }
    if (parameters["collection_group"] == "gumu-movement")
        current["movement_room"] = ([ "no_fight": query("no_fight"),
            "practice_improve": query("practice_improve"),
            "research_improve": query("research_improve") ]);
    if (parameters["collection_group"] == "gumu-research")
        current["research_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "research_improve": query("research_improve") ]);
    prepare_actor(0, parameters["actor"]);
    prepare_actor(1, parameters["target"]);
    if (is_npc_bout()) require(
        players[1]->move("/tests/bystander_room"),
        "natural bout bystander outside arena"
    );
    if (parameters["collection_group"] == "emei-jiuyin-learning") prepare_practice_materials(parameters);
    if (mapp(parameters["extra_target"])) {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-special",
                "shaolin-public-force",
                "gumu-exert"
                , "gumu-temporal"
            })) != -1 && sizeof(players) == 3,
            "configured third connected target");
        prepare_actor(2, parameters["extra_target"]);
        if (member_array(
            parameters["collection_group"],
            ({ "wudang-special", "gumu-temporal" })
        ) != -1) {
            players[0]->kill_ob(players[2]);
            players[2]->kill_ob(players[0]);
        }
        players[2]->observation_heartbeat(0);
        if (parameters["collection_group"] != "gumu-temporal") {
            current["extra_target_before"] = snapshot(players[2]);
            players[2]->start_observation(2);
        }
    }
    if (parameters["fighting"] && !parameters["powerup_before_combat"] && !is_npc_bout()) {
        if (parameters["collection_group"] == "taohua-combo" && parameters["nonlethal"]) {
            players[0]->fight_ob(players[1]);
            players[1]->fight_ob(players[0]);
        } else {
            players[0]->kill_ob(players[1]);
            players[1]->kill_ob(players[0]);
        }
    }
    players[0]->observation_heartbeat(0);
    players[1]->observation_heartbeat(0);
    if (parameters["target_state"] == "unconscious") {
        require(member_array(
            parameters["collection_group"],
            ({
                "wudang-special",
                "wudang-shenmen",
                "shaolin-public-force",
                "emei-shexing",
                "gumu-defense",
                "gumu-exert",
                "gumu-zhi",
                "gumu-quanzhen",
                "taohua-ding",
                "taohua-xiao",
                "taohua-po",
                "taohua-zhuan",
                "taohua-bihai"
            })
        ) != -1 &&
            (!parameters["fighting"] || member_array(parameters["collection_group"],
                ({
                    "gumu-zhi",
                    "gumu-quanzhen",
                    "taohua-ding",
                    "taohua-xiao",
                    "taohua-po",
                    "taohua-zhuan",
                    "taohua-bihai"
                })) != -1), "configured unconscious preparation");
        current["preparation"] = ([ "before": snapshot(players[1]) ]);
        players[1]->start_observation(1);
        players[1]->unconcious();
        players[1]->stop_observation();
        current["preparation"]["after"] = snapshot(players[1]);
        require(!living(players[1]) && !players[1]->is_ghost(), "original unconscious target");
        if (member_array(parameters["collection_group"],
            ({
                "gumu-exert",
                "gumu-zhi",
                "gumu-quanzhen",
                "taohua-ding",
                "taohua-xiao",
                "taohua-po",
                "taohua-zhuan",
                "taohua-bihai"
            })) != -1) {
            current["preparation"]["terminals"] = copy(current["terminals"]);
            current["terminals"] = ({});
        }
    }
    if (parameters["collection_group"] == "wudang-lookup") prepare_lookup(parameters);
    if (parameters["teaching_profile"] == "gumu-item-acquisition") prepare_gumu_items(parameters);
    if (member_array(parameters["teaching_profile"],
        ({
            "gumu-teachers",
            "gumu-special",
            "gumu-acquisition-learning",
            "gumu-item-acquisition",
            "gumu-recruit"
        })) != -1) {
        gumu_teacher_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_teacher_pending &&
            objectp(gumu_teacher), "original Gumu teacher prepared through student command");
    }
    if (parameters["teaching_profile"] == "gumu-item-acquisition") finish_gumu_item_preparation(parameters);
    current["before"] = ({ snapshot(players[0]), snapshot(players[1]) });
    if (is_taohua_zhuan()) {
        taohua_zhuan_target_weapon = players[1]->query_temp("weapon");
        taohua_zhuan_before = taohua_zhuan_death_before(players[1], players[0]);
    }
    if (is_taohua_po()) {
        needle_object = players[0]->query_temp("handing");
        taohua_po_target_weapon = players[1]->query_temp("weapon");
        current["po_equipment"] = ([
            "actor_room": file_name(environment(players[0])),
            "target_room": file_name(environment(players[1])), "target_weapon": ([]) ]);
        observe_taohua_po_weapon("before");
    }
    players[0]->start_observation(0);
    players[1]->start_observation(1);
    if (parameters["collection_group"] == "gumu-temporal" && mapp(parameters["extra_target"])) {
        current["extra_target_before"] = snapshot(players[2]);
        players[2]->start_observation(2);
    }
    started = time_ns() / 1000000000.0;
    if (mapp(fault) && fault["condition_id"] == current["condition_id"] && fault["index"] == current["index"]) {
        current["injected_fault"] = fault["stage"];
        if (fault["stage"] == "action") {
            players[0]->set_temp("fixture_fault_poison", 1);
            error("Injected collection action failure.\n");
        }
        if (fault["stage"] == "callback") call_out("injected_callback_error", 1);
    }
    if (parameters["not_applicable"] != "") {
        current["outcome"] = "not_applicable";
        current["reason"] = parameters["not_applicable"];
        return;
    }
    action = parameters["action"];
    if (is_npc_bout()) {
        require(
            environment(players[1]) != this_object(),
            "natural bout bystander remains outside arena"
        );
        gumu_npc_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_npc_pending && objectp(gumu_npc),
            "original natural NPC created by real USER command");
        gumu_npc->kill_ob(players[0]);
        players[0]->kill_ob(gumu_npc);
        players[0]->observation_heartbeat(0);
        evaluate(bind((: set_heart_beat, 0 :), gumu_npc));
        initialize_npc_bout();
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "gumu-npc") {
        require(current["method"] == "npc", "original Gumu NPC method");
        gumu_npc_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_npc_pending &&
            mapp(current["npc_observation"]), "original NPC observed through player command");
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "gumu-temporal" && parameters["temporal_kind"] == "tuo-cooldown") {
        perform_gumu_temporal("initial");
        current["command_accepted"] = current["temporal_steps"][0]["accepted"];
        require(current["command_accepted"] && sizeof(current["launches"]) == 1,
            "original cooldown sequence first command launched");
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "emei-npc") {
        require(current["method"] == "npc", "original NPC method");
        current["npc_observation"] = "/tests/npc_observer"->observe(parameters["npc"], players[0]);
        current["outcome"] = "observed";
        return;
    }
    if (parameters["powerup_before_combat"]) {
        require(parameters["collection_group"] == "emei-zhao" &&
            action == "perform strike.zhao", "reviewed original powerup prelude");
        step = ([ "action": "exert powerup", "before": current["before"],
            "launches_before": sizeof(current["launches"]) ]);
        step["accepted"] = players[0]->force_me("exert powerup");
        step["launches_after"] = sizeof(current["launches"]);
        step["reason"] = !step["accepted"] && sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "";
        if (!step["accepted"] && step["reason"] == "") {
            reason = players[0]->query_temp("notify_fail");
            step["reason"] = stringp(reason) && reason != "" ? reason : "原强化命令未受理";
        }
        step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        current["powerup"] = step;
        current["action_attempted"] = step["accepted"] ? 1 : 0;
        if (!step["accepted"]) {
            current["command_accepted"] = 0;
            current["outcome"] = "refused";
            current["reason"] = step["reason"];
            return;
        }
        if (parameters["fighting"]) {
            players[0]->kill_ob(players[1]);
            players[1]->kill_ob(players[0]);
            players[0]->observation_heartbeat(0);
            players[1]->observation_heartbeat(0);
        }
    }
    if (arrayp(parameters["prepare_commands"])) {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-combination",
                "shaolin-combination",
                "emei-combination",
                "gumu-combination",
                "taohua-combination"
            })) != -1 &&
            member_array(current["method"], ({ "prepare", "round" })) != -1,
            "configured original prepare sequence");
        current["prepare_steps"] = ({});
        launches = 0;
        foreach (expectation in parameters["prepare_commands"]) {
            action = expectation["action"];
            require(stringp(action) && strsrch(action, "prepare ") == 0,
                "original prepare command only");
            step = ([ "action": action, "before": snapshot(players[0]) ]);
            result = players[0]->force_me(action);
            reason = query_notify_fail();
            step["accepted"] = result;
            step["reason"] = result ? "" : stringp(reason) && reason != "" ? reason : "原准备命令未受理";
            step["after"] = snapshot(players[0]);
            current["prepare_steps"] += ({ step });
            if (result) launches++;
        }
        current["outcome"] = launches ? "observed" : "refused";
        if (current["method"] == "round") {
            COMBAT_D->fight(players[0], players[1]);
            current["outcome"] = "observed";
        } else if (!launches) current["reason"] = "原准备命令均未受理";
        return;
    }
    if (arrayp(parameters["buff_steps"])) {
        require(member_array(
            parameters["collection_group"],
            ({ "wudang-buffs", "shaolin-buffs", "emei-buffs", "gumu-buffs" })
        ) != -1 && !parameters["fighting"] &&
            sizeof(parameters["buff_steps"]) <= 6, "reviewed public buff sequence");
        current["buff_steps"] = ({});
        foreach (expectation in parameters["buff_steps"]) {
            step = ([ "operation": copy(expectation), "before": snapshot(players[0]) ]);
            if (!undefinedp(expectation["refill_neili"])) {
                require(member_array(expectation["refill_neili"], ({ 6000, 8000 })) != -1,
                    "explicit experimental refill");
                players[0]->set("neili", expectation["refill_neili"]);
            } else {
                action = expectation["command"];
                require(member_array(action, ({ "exert power", "exert tianmo" })) != -1,
                    "original public buff command");
                step["launches_before"] = sizeof(current["launches"]);
                step["refusals_before"] = sizeof(current["refusals"]);
                step["accepted"] = players[0]->force_me(action);
                step["launches_after"] = sizeof(current["launches"]);
                step["refusals_after"] = sizeof(current["refusals"]);
                step["reason"] = !step["accepted"] && step["refusals_after"] > step["refusals_before"] ? current["refusals"][<1]["reason"] : "";
            }
            step["after"] = snapshot(players[0]);
            current["buff_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        current["command_accepted"] = sizeof(current["launches"]) > 0;
        if (current["outcome"] == "refused") current["reason"] = current["buff_steps"][<1]["reason"];
        if (parameters["persistence_probe"]) {
            require(players[0]->observation_save_state(), "save isolated buff probe");
            saved_state = read_file("/data/buff_snapshot.o");
            restored_actor = new("/tests/actor");
            current["persistence"] = ([ "before": snapshot(restored_actor),
                "characters": strlen(saved_state), "sha256": hash("sha256", saved_state) ]);
            current["persistence"]["restored"] = restored_actor->observation_restore_state();
            restored_actor->stop_observation();
            current["persistence"]["after"] = snapshot(restored_actor);
            destruct(restored_actor);
        }
        return;
    }
    if (arrayp(parameters["repeat_actions"])) {
        require(member_array(
            parameters["collection_group"],
            ({ "wudang-special", "shaolin-exert", "emei-exert", "emei-jiuyin-buff", "gumu-exert" })
        ) != -1 && !parameters["fighting"] &&
            sizeof(parameters["repeat_actions"]) <= 4, "configured repeated exert sequence");
        current["repeat_steps"] = ({});
        foreach (action in parameters["repeat_actions"]) {
            require(member_array(action, parameters["collection_group"] == "gumu-exert" ?
                ({ "exert powerup" }) : parameters["collection_group"] == "shaolin-exert" ?
                ({
                    "exert powerup",
                    "exert tong"
                }) : parameters["collection_group"] == "emei-jiuyin-buff" ?
                ({
                    "exert powerup",
                    "exert shield",
                    "perform dodge.guiyuan"
                }) : ({ "exert powerup", "exert shield" })) != -1,
                "reviewed exert command");
            step = ([ "action": action, "before": snapshot(players[0]),
                "launches_before": sizeof(current["launches"]),
                "refusals_before": sizeof(current["refusals"]) ]);
            step["accepted"] = players[0]->force_me(action);
            step["after"] = snapshot(players[0]);
            step["launches_after"] = sizeof(current["launches"]);
            step["metrics"] = players[0]->query_observation();
            step["refusals_after"] = sizeof(current["refusals"]);
            step["reason"] = !step["accepted"] && step["refusals_after"] > step["refusals_before"] ? current["refusals"][<1]["reason"] : "";
            current["repeat_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        current["command_accepted"] = sizeof(current["launches"]) > 0;
        return;
    }
    if (current["method"] == "upgrade" &&
        member_array(
            parameters["collection_group"],
            ({ "quanzhen-study", "wudang-study", "gumu-research" })
        ) != -1) {
        grant = parameters["skill"];
        require(parameters["cycles"] == 1 && action == "research " + grant + " 1" &&
            parameters["primer"]["skill"] == grant && parameters["primer"]["amount"] == 10000000 &&
            parameters["primer"]["weak_mode"] == 1, "configured original research upgrade route");
        step = ([ "before": snapshot(players[0]), "action": action,
            "implemented_by": function_exists(
                "skill_improved",
                load_object("/kungfu/skill/" + grant)
            ) ]);
        players[0]->improve_skill(grant, 10000000, 1);
        step["primed"] = snapshot(players[0]);
        step["accepted"] = players[0]->force_me(action);
        step["after"] = snapshot(players[0]);
        current["upgrades"] = ({ step });
        current["outcome"] = step["after"]["skills"][grant] > step["before"]["skills"][grant] ? "observed" : "refused";
        if (current["outcome"] == "refused") current["reason"] = "原研究未触发升级，详见前后快照";
        return;
    }
    if (current["method"] == "upgrade") {
        require(parameters["collection_group"] == "huashan-upgrade" &&
            member_array(action, ({ "improve", "weak", "perform sword.jue" })) != -1,
            "configured original upgrade route");
        require(parameters["cycles"] >= 1 && parameters["cycles"] <= 2,
            "configured upgrade observations");
        current["upgrades"] = ({});
        for (cycle = 0; cycle < parameters["cycles"]; cycle++) {
            step = ([ "before": snapshot(players[0]) ]);
            // Prime progress through the original weak-mode API, never edit
            // learned[] or invoke the skill callback directly. Record the setup.
            players[0]->improve_skill("dugu-jiujian", 10000000, 1);
            step["primed"] = snapshot(players[0]);
            step["action"] = action;
            if (action == "perform sword.jue")
                step["accepted"] = players[0]->force_me(action);
            else
                players[0]->improve_skill("dugu-jiujian", 0, action == "weak");
            step["after"] = snapshot(players[0]);
            current["upgrades"] += ({ step });
        }
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "scene") {
        require(parameters["collection_group"] == "shaolin-fumo", "reviewed scene only");
        players[0]->enable_player();
        if (parameters["gifts"])
            require(
                players[0]->id(players[0]->query("id")),
                "gift recipient discoverable by original ID"
            );
        "/tests/scene_observer"->reset_sample();
        if (mapp(parameters["guardian_state"]))
            current["scene_setup"] = "/tests/scene_observer"->prepare_guardian(parameters["guardian_state"]);
        require(players[0]->move("/d/shaolin/qyping"), "initial scene position");
        current["scene_steps"] = ({});
        current["scene_attacks"] = ({});
        current["scene_step"] = 0;
        if (parameters["lifecycle"]) current["scene_lifecycle"] = ({});
        players[0]->begin_teaching_messages();
        if (parameters["companion"]) {
            players[1]->enable_player();
            require(
                players[1]->id(players[1]->query("id")),
                "companion discoverable by original ID"
            );
            require(players[1]->move("/d/shaolin/qyping"), "companion initial scene position");
            step = ([ "command": "go in", "before": "/tests/scene_observer"->observe(players[1]) ]);
            step["accepted"] = players[1]->force_me("go in");
            step["after"] = "/tests/scene_observer"->observe(players[1]);
            current["scene_companion_entry"] = step;
        }
        foreach (action in parameters["scene_steps"]) {
            require(member_array(action, ({ "in", "out" })) != -1, "reviewed original route");
            step = ([ "command": "go " + action,
                "before": "/tests/scene_observer"->observe(players[0]) ]);
            step["accepted"] = players[0]->force_me("go " + action);
            step["after"] = "/tests/scene_observer"->observe(players[0]);
            current["scene_steps"] += ({ step });
            current["scene_step"]++;
        }
        if (parameters["gifts"]) {
            current["scene_interactions"] = ({});
            foreach (step in parameters["gift_commands"]) {
                action = step["command"];
                participant = step["side"] || 0;
                require(participant == 0 || (participant == 1 && parameters["companion"]),
                    "configured gift participant");
                require(member_array(
                    explode(action, " ")[0],
                    ({ "ask", "give", "drop", "get" })
                ) != -1,
                    "reviewed original gift command");
                step = ([ "command": action,
                    "before": "/tests/scene_observer"->observe_gifts(
                        players[0],
                        parameters["companion"] ? players[1] : 0
                    ) ]);
                if (parameters["companion"]) step["side"] = participant;
                step["accepted"] = players[participant]->force_me(action);
                step["after"] = "/tests/scene_observer"->observe_gifts(
                    players[0],
                    parameters["companion"] ? players[1] : 0
                );
                current["scene_interactions"] += ({ step });
            }
        }
        if (parameters["lifecycle"] && parameters["observe_seconds"] > 0)
            players[0]->observation_heartbeat(1);
        else current["scene_messages"] = players[0]->end_teaching_messages();
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "teaching") {
        if (parameters["teaching_profile"] == "shaolin-challenge") {
            start_challenge(parameters);
            return;
        }
        if (parameters["teaching_profile"] == "shaolin-promotion") {
            current["teaching"] = ({});
            current["outcome"] = "refused";
            promotion_teacher = 0;
            promotion_index = promotion_waiting = 0;
            advance_promotion();
            return;
        }
        if (parameters["teaching_profile"] == "shaolin-formation")
            "/tests/formation_observer"->reset_sample();
        if (member_array(parameters["teaching_profile"],
            ({
                "gumu-teachers",
                "gumu-special",
                "gumu-acquisition-learning",
                "gumu-item-acquisition",
                "gumu-recruit"
            })) != -1) {
            teacher = gumu_teacher;
            require(objectp(teacher) && base_name(teacher) == parameters["teacher"]["path"] &&
                teacher->query("id") == parameters["teacher"]["id"] &&
                environment(teacher) == this_object(), "reuse exact original prepared teacher");
        } else {
            teacher = new(parameters["teacher"]["path"]);
            require(teacher->move(this_object()), "teacher in observation room");
        }
        current["teaching"] = ({});
        current["outcome"] = "refused";
        foreach (expectation in parameters["teaching_expectations"]) {
            // Only an explicitly source-pinned follow-up may change teacher.
            // Keep the same connected student and all original state.
            if (mapp(expectation["teacher"]) &&
                base_name(teacher) != expectation["teacher"]["path"]) {
                teacher = new(expectation["teacher"]["path"]);
                require(teacher->move(this_object()), "follow-up teacher in observation room");
            }
            step = "/tests/teaching_observer"->observe_command(players[0], teacher,
                expectation["action"] || action, parameters["monitored_grants"], expectation["offer"],
                parameters["tracked_item"], 0, parameters["tonsure_name"], parameters["formation"],
                parameters["teaching_profile"], gumu_item_context);
            current["teaching"] += ({ step });
            if (parameters["teaching_profile"] == "gumu-item-acquisition") {
                gumu_item_owned += "/tests/teaching_observer"->gumu_item_objects(gumu_item_context);
                if (step["item_after"]["stock"] < step["item_before"]["stock"] ||
                    (parameters["lesson"] == "yinsuo" &&
                        step["item_before"]["items"][0]["environment"] == file_name(teacher) &&
                        step["item_after"]["items"][0]["environment"] != file_name(teacher)))
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_profile"] == "shaolin-formation") {
                formation_teacher = teacher;
                formation_started = time_ns() / 1000000000.0;
                if (step["after"]["formation"]["requested"] > step["before"]["formation"]["requested"])
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_kind"] == "ordination" &&
                (step["after"]["tonsure"]["pending"] > step["before"]["tonsure"]["pending"] ||
                    (step["before"]["tonsure"]["recruitment"]["class"] != "bonze" &&
                        step["after"]["tonsure"]["recruitment"]["class"] == "bonze")))
                current["outcome"] = "observed";
            if (parameters["teaching_kind"] == "apprenticeship" &&
                step["after"]["master_id"] == parameters["teacher"]["id"] &&
                (step["before"]["master_id"] != step["after"]["master_id"] ||
                    step["before"]["master_name"] != step["after"]["master_name"]))
                current["outcome"] = "observed";
            if (parameters["teaching_kind"] == "letter_teaching" &&
                step["item_before"]["holder"] != file_name(players[0]) &&
                step["item_after"]["holder"] == file_name(players[0]))
                current["outcome"] = "observed";
            foreach (grant in parameters["monitored_grants"]) {
                if (arrayp(step["after"]["grants"][grant])) {
                    if (sizeof(step["after"]["grants"][grant] -
                        (step["before"]["grants"][grant] || ({}))))
                        current["outcome"] = "observed";
                } else if (step["after"]["grants"][grant] > step["before"]["grants"][grant])
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_kind"] == "ordinary_learning" ||
                parameters["teaching_profile"] == "gumu-acquisition-learning") {
                foreach (grant in keys(step["after"]["skills"]))
                    if (step["after"]["skills"][grant] > step["before"]["skills"][grant])
                        current["outcome"] = "observed";
                foreach (grant in keys(step["after"]["learned"]))
                    if (step["after"]["learned"][grant] > step["before"]["learned"][grant])
                        current["outcome"] = "observed";
            }
        }
        if (current["outcome"] == "refused") current["reason"] = parameters["teaching_kind"] == "apprenticeship" ? "原命令未建立新师承，详见逐步状态及消息" : "原教学未增加领悟或学习进度，详见逐步状态及消息";
        return;
    }
    if (current["method"] == "team") {
        set("exits", ([ "east": "/tests/team_room" ]));
        current["team_steps"] = ({});
        foreach (expectation in parameters["steps"]) {
            launches = sizeof(current["launches"]);
            step = "/tests/team_observer"->observe_command(players, expectation);
            step["launches_before"] = launches;
            step["launches_after"] = sizeof(current["launches"]);
            current["team_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        if (current["outcome"] == "refused")
            current["reason"] = sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "原组阵命令未发动刀阵，详见逐步记录";
        return;
    }
    if (parameters["collection_group"] == "gumu-needle-lifecycle") {
        require(parameters["seed_mode"] == "original_perform" && parameters["seed_side"] == 0 &&
            parameters["stop_combat_after_seed"] && action == parameters["seed_action"],
            "reviewed original needle seed");
        launches = sizeof(current["launches"]);
        current["command_accepted"] = players[0]->force_me(action);
        require(sizeof(current["launches"]) == launches + 1, "original needle seed launched");
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "condition") {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-condition",
                "emei-jiuyin-passive",
                "gumu-poison"
            })) != -1, "condition experiment");
        if (parameters["collection_group"] == "emei-jiuyin-passive" && parameters["seed_by_hit"]) {
            // This lifecycle reverses the roles: actor 0 receives the original palm passive.
            result = "/kungfu/skill/cuixin-zhang"->hit_ob(players[1], players[0], 100, 0);
            observe_passive(players[1], players[0], "cuixin-zhang", 100, 0, result, "interface");
        }
        if (parameters["collection_group"] == "gumu-poison" &&
            parameters["seed_mode"] == "original_perform") {
            require(parameters["seed_side"] == 1 && parameters["seed_action"] == "perform strike.shi" &&
                parameters["stop_combat_after_seed"], "reviewed original poison seed");
            launches = sizeof(current["launches"]);
            current["command_accepted"] = players[1]->force_me(parameters["seed_action"]);
            require(sizeof(current["launches"]) == launches + 1, "original poison seed launched");
            require(players[0]->query("special_skill/piyi") ||
                mapp(players[0]->query_condition("wudu_shenzhang")), "original poison applied");
            foreach (ob in players) {
                ob->remove_all_killer();
                ob->remove_all_enemy(1);
            }
            current["combat_stopped_after_seed"] = ({
                !players[0]->is_fighting(),
                !players[1]->is_fighting()
            });
            require(current["combat_stopped_after_seed"][0] &&
                current["combat_stopped_after_seed"][1], "isolated poison without combat");
        }
        current["outcome"] = "observed";
        if (parameters["ticks"] > 0) players[0]->observation_heartbeat(1);
        return;
    }
    if (current["method"] == "bout") {
        current["outcome"] = "observed";
        current["first"] = current["index"] % 2;
        current["first_actor"] = -1;
        current["second_started"] = 0;
        observed = started;
        busy_seconds = ({ 0.0, 0.0 });
        busy_state = ({ 0, 0 });
        players[current["first"]]->observation_heartbeat(1);
        return;
    }
    if (action == "ordinary") {
        COMBAT_D->do_attack(players[0], players[1], players[0]->query_temp("weapon"), TYPE_REGULAR);
        current["outcome"] = "observed";
    } else {
        launches = sizeof(current["launches"]);
        result = players[0]->force_me(action);
        current["command_accepted"] = result;
        if ((is_taohua_ding() || is_taohua_zhuan()) && !result && !sizeof(current["refusals"])) {
            reason = players[0]->query_temp("notify_fail");
            require(stringp(reason) && reason != "", "actual early DING command refusal");
            current["refusals"] += ({ ([ "actor": file_name(players[0]), "reason": reason ]) });
        }
        if (current["method"] == "exercise") {
            current["outcome"] = result ? "observed" : "refused";
            if (!result) {
                reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原打坐命令未受理";
            }
            return;
        }
        if (action == "test_interface") {
            require(sizeof(current["interfaces"]), "observation interface invoked");
            return;
        }
        if (current["method"] == "practice") {
            step = snapshot(players[0]);
            grant = parameters["skill"];
            current["outcome"] = step["skills"][grant] > current["before"][0]["skills"][grant] || step["learned"][grant] > current["before"][0]["learned"][grant] ? "observed" : "refused";
            if (current["outcome"] == "refused") {
                reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原练习没有增加技能或进度";
            }
            return;
        }
        if (current["method"] == "research") {
            // Original research command: acceptance alone can mean no study happened.
            current["outcome"] = players[0]->query("learned_points") > current["before"][0]["learned_points"] ? "observed" : "refused";
            if (current["outcome"] == "refused") {
                reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原研究未消耗潜能或增加学习进度";
            }
            return;
        }
        current["outcome"] = sizeof(current["launches"]) > launches ? "observed" : "refused";
        if (sizeof(current["launches"]) == launches)
            current["reason"] = sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "技能入口未返回成功";
        if (!sizeof(current["launches"]) && parameters["collection_group"] == "wudang-lookup" &&
            stringp(reason = players[0]->query_temp("notify_fail")))
            current["reason"] = reason;
    }
}

void observe_needle_hit(object weapon, object me, object victim, int damage_bonus) {
    if (!active || !needle_collection()) return;
    require(me == players[0] && victim == players[1], "needle participants");
    current["needle_hits"] += ({ ([ "actor": 0, "target": 1,
        "program": base_name(weapon), "object": file_name(weapon), "damage_bonus": damage_bonus ]) });
}

// Read the original skill timer and states only; never invoke or reschedule back().
void observe_needle_restore(object target, string phase, int delay) {
    mapping event;
    if (!active || current["parameters"]["collection_group"] != "gumu-needle-lifecycle" ||
        target != players[1]) return;
    event = ([ "program": base_name(previous_object()), "function": "back", "side": 1,
        "elapsed": time_ns() / 1000000000.0 - started ]);
    if (phase == "scheduled") {
        event["delay"] = delay;
        current["restore_schedule"] = event;
    } else {
        event["phase"] = phase;
        event["state"] = snapshot(target);
        current["callbacks"] += ({ event });
        if (phase == "after") call_out("finish_sample", 0);
    }
}

void finish_needle_seed() {
    object ob;
    if (!active) return;
    current["seed"] = ([ "method": "perform", "outcome": current["outcome"],
        "before": current["before"], "immediate": current["immediate"],
        "after": ({ snapshot(players[0]), snapshot(players[1]) }),
        "metrics": current["immediate_metrics"], "attacks": current["attacks"],
        "launches": current["launches"], "needle_hits": current["needle_hits"],
        "ammo_cleanup": ([ "checked": 1, "object_exists": objectp(needle_object),
            "handing_object": serializable(players[0]->query_temp("handing")) ]) ]);
    foreach (ob in players) {
        ob->remove_all_killer();
        ob->remove_all_enemy(1);
    }
    current["combat_stopped_after_seed"] = ({
        !players[0]->is_fighting(),
        !players[1]->is_fighting()
    });
    require(current["combat_stopped_after_seed"][0] && current["combat_stopped_after_seed"][1],
        "isolated original needle lifecycle without combat");
    if (current["parameters"]["lifecycle"] == "bingpo_restore") {
        require(mapp(current["restore_schedule"]) && players[1]->query_temp("bingpo"),
            "original cold debuff and timer observed");
    } else if (!current["parameters"]["ticks"]) {
        finish_sample();
        return;
    } else {
        require(mapp(players[1]->query_condition(current["parameters"]["condition_name"])),
            "original needle applied poison before heartbeat");
        players[1]->observation_heartbeat(1);
    }
    call_out("poll", 1);
}

void finish_sample() {
    object ob, previous_teacher;
    object *acquisition_owned;
    mapping step;
    if (!active) return;
    if (is_npc_bout()) finish_npc_bout_observation();
    if (current["parameters"]["collection_group"] == "gumu-npc") {
        // Also recover exact references after a failed constructor/move/closure.
        current["npc_observation"] = "/tests/npc_observer"->clear_gumu();
        gumu_npc = 0;
        gumu_npc_pending = 0;
    }
    if (current["method"] == "scene" && current["parameters"]["lifecycle"] &&
        current["parameters"]["observe_seconds"] > 0 && current["outcome"] != "error") {
        step = ([ "command": "go out", "before": "/tests/scene_observer"->observe(players[0]) ]);
        step["accepted"] = players[0]->force_me("go out");
        step["after"] = "/tests/scene_observer"->observe(players[0]);
        current["scene_followup"] = step;
        current["scene_messages"] = players[0]->end_teaching_messages();
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-challenge" && current["outcome"] != "error") {
        current["teaching"][<1]["after"] = "/tests/teaching_observer"->finish_challenge_wait(players[0]);
        current["challenge_messages"] = players[0]->end_teaching_messages();
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-formation" &&
        current["parameters"]["observe_seconds"] > 0 && current["outcome"] != "error") {
        current["teaching"][<1]["wait_after"] = "/tests/formation_observer"->observe(
            players[0], formation_teacher, current["parameters"]["formation"]);
        current["teaching"][<1]["wait_elapsed"] = time_ns() / 1000000000.0 - formation_started;
    }
    active = 0;
    remove_call_out("poll");
    remove_call_out("finish_sample");
    remove_call_out("finish_needle_seed");
    if (current["method"] == "bout" && current["outcome"] == "observed" &&
        current["parameters"]["collection_group"] != "gumu-npc-bout") {
        sample_busy();
        current["busy_seconds"] = busy_seconds;
    }
    current["elapsed"] = time_ns() / 1000000000.0 - started;
    if (current["parameters"]["collection_group"] == "gumu-throwing" || is_taohua_po())
        current["ammo_cleanup"] = ([ "checked": 1, "object_exists": objectp(needle_object),
            "handing_object": serializable(players[0]->query_temp("handing")) ]);
    if (current["parameters"]["collection_group"] != "gumu-npc-bout") {
        current["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        current["metrics"] = ({ objectp(players[0]) ? players[0]->query_observation() : ([]),
            objectp(players[1]) ? players[1]->query_observation() : ([]) });
    }
    observe_taohua_po_weapon("after");
    if (current["parameters"]["collection_group"] == "wudang-lookup") {
        current["lookup"]["after"] = lookup_snapshot(lookup_subject);
        if (member_array(lookup_subject, players) == -1) destruct(lookup_subject);
        lookup_subject = 0;
    }
    if (mapp(current["parameters"]["extra_target"])) {
        current["extra_target_after"] = snapshot(players[2]);
        current["extra_target_metrics"] = players[2]->query_observation();
    }
    current["dropped"] = ({});
    foreach (ob in all_inventory(this_object())) {
        if (member_array(ob, players) != -1) continue;
        current["dropped"] += ({ ([ "object": file_name(ob), "name": ob->name(),
            "type": ob->query("skill_type"), "no_wield": ob->query("no_wield") ]) });
        if (current["parameters"]["collection_group"] == "gumu-advanced")
            current["dropped"][<1]["value"] = ob->query("value");
    }
    foreach (ob in players) if (objectp(ob)) ob->stop_observation();
    if (member_array(current["parameters"]["teaching_profile"],
        ({
            "gumu-teachers",
            "gumu-special",
            "gumu-acquisition-learning",
            "gumu-item-acquisition",
            "gumu-recruit"
        })) != -1) {
        if (objectp(gumu_teacher) && current["outcome"] != "error")
            current["teacher_final"] = ([ "state": snapshot(gumu_teacher),
                "autonomy": gumu_teacher_autonomy() ]);
        if (current["parameters"]["teaching_profile"] == "gumu-item-acquisition") {
            previous_teacher = gumu_previous_teacher;
            acquisition_owned = copy(gumu_item_owned);
        }
        clear_gumu_teacher();
        current["teacher_cleanup"] = ([ "pending": gumu_teacher_pending,
            "object_exists": objectp(gumu_teacher) ]);
        if (current["parameters"]["teaching_profile"] == "gumu-item-acquisition")
            current["item_cleanup"] = ([ "previous_teacher_exists": objectp(previous_teacher),
                "owned_remaining": sizeof(filter(acquisition_owned, (: objectp :))),
                "singleton_exists": objectp(find_object("/clone/lonely/yinsuo")) ]);
    }
    map_delete(current, "parameters");
    emit(current);
    clear_taohua_zhuan_owned();
    debug_message("DATA SAVED");
    cursor++;
    if (current["outcome"] == "error") {
        debug_message("DATA SAMPLE ERROR");
        shutdown(1);
        return;
    }
    if (cursor % 20 == 0 || cursor == sizeof(jobs)) debug_message(sprintf(
        "DATA %d/%d",
        cursor,
        sizeof(jobs)
    ));
    // Yield between completed samples, below the driver's call_out(0) nesting limit.
    // No active combat, observation window or skill callback is shortened.
    call_out("advance", cursor % 100 == 0 ? 1 : 0);
}

int record_failure(mapping details) {
    if (!active) return 0;
    current["outcome"] = "error";
    current["reason"] = details["error"];
    current["error_trace"] = serializable(details["trace"]);
    finish_sample();
    return 1;
}

void injected_callback_error() {
    error("Injected collection callback failure.\n");
}

// Original death bookkeeping may lazy-load QUEST_D, whose scan starts these
// world generators. They are outside a two-player martial experiment. Stop only
// their original background timers; keep doKilled, death and skill callbacks.
void stop_background_quests() {
    object daemon;
    string name;
    current["background_stopped"] = ({});
    foreach (name in ({
        "capture",
        "deliver",
        "explore",
        "judge",
        "search",
        "shen",
        "supply",
        "trace"
    })) {
        daemon = find_object("/adm/daemons/quest/" + name);
        if (!objectp(daemon) || member_array(daemon, heart_beats()) == -1) continue;
        require(
            stringp(function_exists("stop", daemon)),
            "original world generator stop interface"
        );
        daemon->stop();
        require(member_array(daemon, heart_beats()) == -1, "background quest stopped");
        current["background_stopped"] += ({ base_name(daemon) });
    }
}

void advance() {
    mixed failure;
    int delay;
    object ob, item;
    clear_gumu_teacher();
    if (cursor == sizeof(jobs)) {
        debug_message("DATA COMPLETE");
        shutdown(0);
        return;
    }
    current = copy(jobs[cursor]);
    current["kind"] = "sample";
    current["launches"] = ({});
    current["refusals"] = ({});
    current["interfaces"] = ({});
    if (current["parameters"]["collection_group"] == "gumu-combination")
        current["prepare_steps"] = ({});
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-hubo", "gumu-temporal" })
    ) != -1) {
        current["hubo_steps"] = ({});
        current["busy_calls"] = ({});
        current["skill_messages"] = ({});
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "emei-npc", "gumu-npc", "gumu-npc-bout" })
    ) != -1)
        current["npc_direct"] = ({});
    if (current["parameters"]["collection_group"] == "gumu-temporal") current["temporal_steps"] = ({});
    if (member_array(current["parameters"]["collection_group"],
        ({ "shaolin-defense", "emei-defense", "emei-shexing", "gumu-defense" })) != -1)
        current["defense_messages"] = ({});
    if (current["parameters"]["collection_group"] == "shaolin-backlash")
        current["backlash_messages"] = ({});
    current["attacks"] = ({});
    current["defenses"] = ({});
    current["passives"] = ({});
    if (needle_collection()) {
        current["needle_hits"] = ({});
        needle_object = 0;
    }
    taohua_po_target_weapon = 0;
    if (current["parameters"]["collection_group"] == "gumu-needle-lifecycle")
        current["incidental_callbacks"] = ({});
    if (member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "gumu-npc-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive"
        })) != -1) {
        current["actions"] = ({});
        current["skill_loads"] = ({});
        passive_before = ([]);
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-quanzhen", "gumu-temporal", "taohua-ding", "taohua-zhuan", "taohua-direct" })
    ) != -1)
        current["directs"] = ({});
    current["dodge_checks"] = ({});
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "wudang-passive", "wudang-bout" })
    ) != -1) {
        current["taiji_events"] = ({});
    }
    if (member_array(current["parameters"]["collection_group"],
        ({
            "wudang-passive",
            "wudang-bout",
            "shaolin-bout",
            "emei-bout",
            "gumu-bout",
            "gumu-npc-bout"
        })) != -1)
        current["attack_rounds"] = ({});
    current["callbacks"] = ({});
    if (current["parameters"]["collection_group"] == "gumu-fireice")
        current["fireice_followups"] = ({});
    if (current["method"] == "exercise") current["exercise_steps"] = ({});
    if (current["method"] == "healing") current["healing_steps"] = ({});
    if (current["method"] == "condition" || member_array(current["parameters"]["collection_group"],
        ({ "gumu-poison", "gumu-needle-lifecycle" })) != -1) {
        current["condition_events"] = ({});
        current["condition_heartbeats"] = ({});
    }
    current["terminals"] = ({});
    current["reason"] = "";
    active = 1;
    started = time_ns() / 1000000000.0;
    foreach (ob in all_inventory(this_object())) {
        if (member_array(ob, players) == -1) {
            foreach (item in deep_inventory(ob)) destruct(item);
            destruct(ob);
        }
    }
    failure = catch {
        perform_sample();
        stop_background_quests();
    };
    if (failure) {
        current["outcome"] = "error";
        current["reason"] = sprintf("%O", failure);
        finish_sample();
        return;
    }
    current["immediate"] = ({ snapshot(players[0]), snapshot(players[1]) });
    observe_taohua_po_weapon("immediate");
    if (is_taohua_zhuan()) {
        if (players[1]->is_ghost())
            current["zhuan_death"] = taohua_zhuan_death_snapshot(players[1], players[0],
                taohua_zhuan_corpse, taohua_zhuan_target_weapon, taohua_zhuan_before);
        // The original command and death stack have fully returned; no later revival window.
        finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        players[0]->observation_heartbeat(1);
        players[1]->observation_heartbeat(1);
        call_out("poll", 1);
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        needle_object = players[0]->query_temp("handing");
        current["immediate_metrics"] = ({
            players[0]->query_observation(),
            players[1]->query_observation()
        });
        // Let the original empty-stack cleanup complete before starting the next observation stage.
        call_out("finish_needle_seed", 0);
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-throwing") {
        needle_object = players[0]->query_temp("handing");
        // Original set_amount(0) queued its own destruction during perform.
        // Observe after that callback, without ticking combat/conditions or destroying the item.
        call_out("finish_sample", 0);
        return;
    }
    if (is_taohua_po()) {
        // Keep the pre-command references; only the original zero-delay stack cleanup runs.
        call_out("finish_sample", 0);
        return;
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-fireice", "gumu-poison" })
    ) != -1)
        current["immediate_metrics"] = ({ players[0]->query_observation(),
            players[1]->query_observation() });
    if (current["method"] == "condition" && current["parameters"]["collection_group"] == "gumu-poison" &&
        current["parameters"]["ticks"] == 0) {
        finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "emei-jiuyin-learning")
        current["practice_materials_after"] = practice_material_snapshot();
    if (current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        call_out("poll", 1);
        return;
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        if (promotion_waiting) call_out("poll", 1);
        else finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "shaolin-hands")
        current["immediate_attack_count"] = sizeof(current["attacks"]);
    if (mapp(current["parameters"]["extra_target"]))
        current["extra_target_immediate"] = snapshot(players[2]);
    if (member_array(
        current["method"],
        ({ "bout", "exercise", "healing", "condition" })
    ) != -1 && current["outcome"] == "observed") {
        call_out("poll", 1);
        return;
    }
    delay = current["parameters"]["observe_seconds"];
    // Integer call_out deadlines are tick-aligned. Leave one tick so this
    // observation window cannot finish just before the requested elapsed time.
    if (delay > 0 && current["method"] == "scene" && current["parameters"]["lifecycle"]) delay++;
    if (current["outcome"] == "observed" && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        players[1]->observation_heartbeat(1);
        call_out("poll", 1);
        return;
    }
    if (delay > 0 && current["outcome"] == "observed") call_out("finish_sample", delay);
    else finish_sample();
}

void start() {
    mapping options;
    observation_run_id = sprintf("%d", time_ns());
    options = json_decode(read_file("/tests/options.json"));
    jobs = options["jobs"];
    fault = options["fault"];
    advance();
}

void connected(object ob) {
    mapping options;
    int expected;
    options = json_decode(read_file("/tests/options.json"));
    expected = options["connections"] || 2;
    require(member_array(expected, ({ 2, 3 })) != -1 && sizeof(players) < expected,
        "configured connections only");
    players += ({ ob });
    if (sizeof(players) == expected) call_out("start", 0);
}

void create() {
    set("short", "演武场");
    set("long", "青石铺地，四下空旷，正宜切磋武艺。\n");
    set("no_clean_up", 1);
}

