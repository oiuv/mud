            "mingjiao-qishang"
        })
    ) != -1)
        current["directs"] = ({});
    if (current["parameters"]["collection_group"] == "mingjiao-xinfa") {
        // This force slice makes no attacks. Record empty observed arrays explicitly.
        current["actions"] = ({});
        current["directs"] = ({});
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "mingjiao-movement", "mingjiao-qkd", "mingjiao-jiuyang" })) != -1) {
        current["actions"] = ({});
        current["directs"] = ({});
    }
    if (current["parameters"]["collection_group"] == "mingjiao-ling-learning") {
        current["actions"] = ({});
        current["directs"] = ({});
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "mingjiao-jiuyang-learning", "mingjiao-jiuyang-capacity",
            "mingjiao-jiuyang-research" })) != -1) {
        current["actions"] = ({});
        current["directs"] = ({});
        if (current["method"] == "interface") current["interface_steps"] = ({});
        current["skill_messages"] = ({});
    }
    if (member_array(current["parameters"]["collection_group"],
        ({
            "mingjiao-ling-perform",
            "mingjiao-jiuyang-direct",
            "mingjiao-jiuyang-remaining"
        })) != -1) {
        current["actions"] = ({});
        current["directs"] = ({});
        current["busy_calls"] = ({});
        current["skill_messages"] = ({});
        if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-remaining")
            passive_before = ([]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-shengong") {
        current["actions"] = ({});
        current["directs"] = ({});
    }
    if (current["parameters"]["collection_group"] == "mingjiao-shenghuo") {
        current["actions"] = ({});
        current["directs"] = ({});
        current["skill_loads"] = ({});
        current["busy_calls"] = ({});
        current["skill_messages"] = ({});
        current["passive_events"] = ({});
        shenghuo_attack_frames = ({});
        shenghuo_passive_frames = ({});
        shenghuo_attack_serial = 0;
        shenghuo_passive_serial = 0;
    }
    current["dodge_checks"] = ({});
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "wudang-passive", "wudang-bout" })
    ) != -1) {
        current["taiji_events"] = ({});
    }
    if (member_array(current["parameters"]["collection_group"],
        ({
            "wudang-passive",
            "wudang-bout",
            "shaolin-bout",
            "emei-bout",
            "gumu-bout",
            "gumu-npc-bout",
            "quanzhen-bout",
            "huashan-bout",
            "mingjiao-bout",
            "taohua-bout",
            "gumu-bout-perform",
            "emei-bout-perform",
            "shaolin-bout-perform",
            "wudang-bout-perform",
            "mingjiao-npc-bout", "emei-npc-bout"
        })) != -1)
        current["attack_rounds"] = ({});
    current["callbacks"] = ({});
    if (current["parameters"]["collection_group"] == "gumu-fireice" ||
        current["parameters"]["collection_group"] == "gumu-fireice-g6")
        current["fireice_followups"] = ({});
    if (current["method"] == "exercise") current["exercise_steps"] = ({});
    if (current["method"] == "healing") current["healing_steps"] = ({});
    if (current["method"] == "condition" || member_array(current["parameters"]["collection_group"],
        ({ "gumu-poison", "gumu-needle-lifecycle" })) != -1) {
        current["condition_events"] = ({});
        current["condition_heartbeats"] = ({});
    }
    current["terminals"] = ({});
    current["reason"] = "";
    active = 1;
    started = time_ns() / 1000000000.0;
    foreach (ob in all_inventory(this_object())) {
        if (member_array(ob, players) == -1) {
            foreach (item in deep_inventory(ob)) destruct(item);
            destruct(ob);
        }
    }
    failure = catch {
        perform_sample();
        if (current["parameters"]["collection_group"] == "mingjiao-shenghuo")
            require(!sizeof(shenghuo_attack_frames) && !sizeof(shenghuo_passive_frames),
                "original holy observation stacks fully returned");
        stop_background_quests();
    };
    if (current["parameters"]["collection_group"] == "mingjiao-shenghuo")
        current["stack_terminal"] = ([ "attacks": sizeof(shenghuo_attack_frames),
            "passives": sizeof(shenghuo_passive_frames) ]);
    if (member_array(current["parameters"]["collection_group"],
        ({
            "mingjiao-movement",
            "mingjiao-qkd",
            "mingjiao-jiuyang"
        })) != -1 && mapp(current["bhinfo"])) {
        current["bhinfo"]["after"] = serializable(COMBAT_D->query_bhinfo());
        COMBAT_D->clear_bhinfo();
        current["bhinfo"]["cleared"] = serializable(COMBAT_D->query_bhinfo());
    }
    if (failure) {
        current["outcome"] = "error";
        current["reason"] = sprintf("%O", failure);
        finish_sample();
        return;
    }
    current["immediate"] = ({ snapshot(players[0]), snapshot(players[1]) });
    observe_taohua_po_weapon("immediate");
    if (current["method"] == "yanlian" && current["yanlian_accepted"]) {
        // Busy loop poll already scheduled in perform_sample
        return;
    }
    if (is_mingjiao_force_remaining()) {
        current["immediate_metrics"] = ({
            players[0]->query_observation(),
            players[1]->query_observation()
        });
        if (current["outcome"] == "observed" && member_array(current["parameters"]["panel"],
            ({ "exercise", "healing", "expiry" })) != -1) {
            players[0]->observation_heartbeat(1);
            call_out("poll", 1);
        } else finish_sample();
        return;
    }
    if (is_mingjiao_remaining_base()) {
        current["immediate_metrics"] = ({
            players[0]->query_observation(),
            players[1]->query_observation()
        });
        if (current["method"] == "condition") {
            if (current["condition_seed"]["seeded"]) {
                players[1]->observation_heartbeat(1);
                call_out("poll", 1);
            } else finish_sample();
            return;
        }
    }
    if (is_mingjiao_remaining_perform()) {
        current["enemy_context"]["immediate"] = map(players[0]->query_enemy(),
            (: member_array($1, players) :));
        if (mapp(current["parameters"]["extra_target"]))
            current["extra_target_immediate"] = snapshot(players[2]);
        observe_remaining_perform_flower("immediate");
        if (current["parameters"]["ability"] == "hua") {
            // Original set_amount(0) already queued destruct_me. Only observe after its return.
            call_out("finish_sample", 0);
            return;
        }
    }
    if (is_jiuyang_fusion()) {
        start_jiuyang_fusion_wait();
        return;
    }
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert") {
        current["relation_context"]["immediate"] = jiuyang_exert_relations();
        if (mapp(current["parameters"]["extra_target"]))
            current["extra_target_immediate"] = snapshot(players[2]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-route") {
        advance_mingjiao_route();
        return;
    }
    observe_taohua_po_weapon("immediate");
    observe_ling_weapon("immediate");
    if (current["parameters"]["collection_group"] == "quanzhen-practice" &&
        current["parameters"]["target_busy_lifecycle"]) {
        players[0]->observation_heartbeat(0);
        players[1]->observation_heartbeat(0);
        current["busy_heartbeats"] = ({});
        if (current["outcome"] != "observed" || !players[1]->is_busy()) {
            current["busy_terminal"] = "not_applied";
            finish_sample();
        } else {
            current["busy_terminal"] = "waiting";
            players[1]->observation_heartbeat(1);
            call_out("poll", 1);
        }
        return;
    }
    if (current["parameters"]["collection_group"] == "mingjiao-qkd" && current["outcome"] == "observed") {
        require(mapp(current["qkd_queue"]) && current["parameters"]["callback_if_queued"],
            "declared conditional original callback observation");
        current["qkd_queue"]["immediate"] = qkd_queue_point();
        require(!sizeof(current["qkd_queue"]["before"]["pending"]) &&
            sizeof(current["qkd_queue"]["immediate"]["pending"]) <= 1,
            "only this action may schedule one original QKD callback");
        if (sizeof(current["qkd_queue"]["immediate"]["pending"])) call_out("finish_sample", 2);
        else finish_sample();
        return;
    }
    if (is_taohua_zhuan()) {
        if (players[1]->is_ghost())
            current["zhuan_death"] = taohua_zhuan_death_snapshot(players[1], players[0],
                taohua_zhuan_corpse, taohua_zhuan_target_weapon, taohua_zhuan_before);
        // The original command and death stack have fully returned; no later revival window.
        finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        players[0]->observation_heartbeat(1);
        players[1]->observation_heartbeat(1);
        call_out("poll", 1);
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        needle_object = players[0]->query_temp("handing");
        current["immediate_metrics"] = ({
            players[0]->query_observation(),
            players[1]->query_observation()
        });
        // Let the original empty-stack cleanup complete before starting the next observation stage.
        call_out("finish_needle_seed", 0);
        return;
    }
    if (current["parameters"]["collection_group"] == "gumu-throwing") {
        needle_object = players[0]->query_temp("handing");
        // Original set_amount(0) queued its own destruction during perform.
        // Observe after that callback, without ticking combat/conditions or destroying the item.
        call_out("finish_sample", 0);
        return;
    }
    if (is_taohua_po()) {
        // Keep the pre-command references; only the original zero-delay stack cleanup runs.
        call_out("finish_sample", 0);
        return;
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-fireice", "gumu-fireice-g6", "gumu-poison", "s1-dusha-lifecycle" })
    ) != -1)
        current["immediate_metrics"] = ({ players[0]->query_observation(),
            players[1]->query_observation() });
    if (current["method"] == "condition" && member_array(
        current["parameters"]["collection_group"], ({ "gumu-poison", "s1-dusha-lifecycle" })
    ) != -1 &&
        current["parameters"]["ticks"] == 0) {
        finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "emei-jiuyin-learning")
        current["practice_materials_after"] = practice_material_snapshot();
    if (current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        call_out("poll", 1);
        return;
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        if (promotion_waiting) call_out("poll", 1);
        else finish_sample();
        return;
    }
    if (current["parameters"]["collection_group"] == "shaolin-hands")
        current["immediate_attack_count"] = sizeof(current["attacks"]);
    if (mapp(current["parameters"]["extra_target"]))
        current["extra_target_immediate"] = snapshot(players[2]);
    if (member_array(
        current["method"],
        ({ "bout", "exercise", "healing", "condition" })
    ) != -1 && current["outcome"] == "observed") {
        call_out("poll", 1);
        return;
    }
    delay = current["parameters"]["observe_seconds"];
    // Integer call_out deadlines are tick-aligned. Leave one tick so this
    // observation window cannot finish just before the requested elapsed time.
    if (delay > 0 && current["method"] == "scene" && current["parameters"]["lifecycle"]) delay++;
    if (current["outcome"] == "observed" && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        players[1]->observation_heartbeat(1);
        call_out("poll", 1);
        return;
    }
    if (delay > 0 && current["outcome"] == "observed") call_out("finish_sample", delay);
    else finish_sample();
}

void start() {
    mapping options;
    observation_run_id = sprintf("%d", time_ns());
    options = json_decode(read_file("/tests/options.json"));
    jiuyang_fusion_watchdog_seconds = options["fusion_watchdog_seconds"];
    jobs = options["jobs"];
    fault = options["fault"];
    advance();
}

void connected(object ob) {
    mapping options;
    int expected;
    options = json_decode(read_file("/tests/options.json"));
    expected = options["connections"] || 2;
    require(member_array(expected, ({ 2, 3 })) != -1 && sizeof(players) < expected,
        "configured connections only");
    players += ({ ob });
    if (sizeof(players) == expected) call_out("start", 0);
}

void create() {
    set("short", "演武场");
    set("long", "青石铺地，四下空旷，正宜切磋武艺。\n");
    set("no_clean_up", 1);
}

