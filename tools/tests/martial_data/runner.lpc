void begin_passive(object me, object target, string route) {
    if (is_npc_bout()) {
        require(me == gumu_npc && target == players[0] && undefinedp(passive_before[route]),
            "natural NPC passive before");
        passive_before[route] = ({ npc_bout_state(me), npc_bout_state(target) });
        return;
    }
    if (!active || member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive"
        })) == -1) return;
    require(undefinedp(passive_before[route]), "passive observation is not nested");
    passive_before[route] = ({ snapshot(me), snapshot(target) });
}

void observe_passive(
    object me,
    object target,
    string skill,
    int damage,
    int factor,
    mixed result,
    string route
) {
    if (is_npc_bout()) {
        require(me == gumu_npc && target == players[0] && arrayp(passive_before[route]),
            "natural NPC passive return");
        current["passives"] += ({ ([ "actor": -1, "actor_object": file_name(me),
            "target": 0, "target_object": file_name(target), "skill": skill, "incoming": damage,
            "factor": factor, "result": serializable(result), "route": route,
            "before": passive_before[route], "after": ({
                npc_bout_state(me),
                npc_bout_state(target)
            }) ]) });
        npc_bout_count(me, route);
        map_delete(passive_before, route);
        return;
    }
    if (active) current["passives"] += ({ ([ "actor": member_array(me, players),
        "target": member_array(target, players), "skill": skill, "incoming": damage,
        "factor": factor, "result": serializable(result), "route": route,
        "neili_after": me->query("neili"), "target_eff_qi_after": target->query("eff_qi"),
        "target_busy_after": serializable(target->query_busy()) ]) });
    if (active && member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "taohua-attack",
            "taohua-combo",
            "taohua-passive"
        })) != -1) {
        require(arrayp(passive_before[route]), "passive before snapshot exists");
        current["passives"][<1]["before"] = passive_before[route];
        current["passives"][<1]["after"] = ({ snapshot(me), snapshot(target) });
        map_delete(passive_before, route);
    }
}

