void prepare_mingjiao_gift_items() {
    mapping setup, prep;
    object item, remote, container, owner;
    string holder;

    require(active && current["parameters"]["teaching_profile"] == "mingjiao-gift" &&
        this_player() == players[0] && userp(this_player()) && playerp(this_player()) &&
        interactive(this_player()) && !wizardp(this_player()), "ordinary gift preparation context");
    setup = current["parameters"]["item_setup"];
    holder = setup["holder"];
    require(setup["item"] == "/clone/lonely/huanlingjian" &&
        member_array(
            holder,
            ({ "unowned", "teacher", "player0", "player1", "remote", "player0-container" })
        ) != -1 &&
        member_array(setup["free_capacity"], ({ 3999, 4000 })) != -1 &&
        setup["container_program"] == "/clone/misc/bag" && setup["container_capacity"] == 4000,
        "finite gift placement and capacity inputs");
    prep = ([ "item": setup["item"], "holder": holder, "command": "test_interface",
        "entry_actor": file_name(this_player()), "singleton_loaded_before": objectp(find_object(setup["item"])),
        "players_before": ({ snapshot(players[0]), snapshot(players[1]) }) ]);
    remote = new(ROOM);
    mingjiao_gift_owned += ({ remote });
    mingjiao_gift_context = ([ "item": setup["item"], "carriers": ([ "player0": players[0],
        "player1": players[1], "teacher": taohua_learning_teachers["yangxiao"],
        "stage": this_object(), "remote": remote ]) ]);
    if (holder == "player0-container") {
        container = new(setup["container_program"]);
        require(objectp(container) && clonep(container) && container->query_weight() == 0,
            "original bag weight is not rewritten");
        container->set_max_encumbrance(setup["container_capacity"]);
        mingjiao_gift_owned += ({ container });
        mingjiao_gift_context["carriers"]["container"] = container;
    }
    item = load_object(setup["item"]);
    require(objectp(item) && !clonep(item) && base_name(item) == setup["item"] && !environment(item),
        "fresh unowned original weapon singleton");
    prep["initial_state"] = "/tests/teaching_observer"->mingjiao_gift_point(mingjiao_gift_context);
    if (objectp(container)) require(container->move(players[0]), "original bag placement");
    if (holder == "teacher") owner = taohua_learning_teachers["yangxiao"];
    else if (holder == "player0") owner = players[0];
    else if (holder == "player1") owner = players[1];
    else if (holder == "remote") owner = remote;
    else if (holder == "player0-container") owner = container;
    if (objectp(owner)) require(item->move(owner), "original singleton holder placement");
    players[0]->set_max_encumbrance(players[0]->query_encumbrance() + setup["free_capacity"]);
    prep["item_after"] = "/tests/teaching_observer"->mingjiao_gift_point(mingjiao_gift_context);
    prep["players_after"] = ({ snapshot(players[0]), snapshot(players[1]) });
    prep["return_actor"] = file_name(this_player());
    current["gift_preparation"] = prep;
}

void clear_mingjiao_gift() {
    mapping cleanup, state;
    object ob;
    string path;

    path = "/clone/lonely/huanlingjian";
    ob = find_object(path);
    if (objectp(ob)) destruct(ob);
    cleanup = ([
        "singleton": ([ "object": path, "exists_after": objectp(find_object(path)) ]),
        "owned": ({})
    ]);
    foreach (ob in mingjiao_gift_owned) {
        if (!objectp(ob)) error("Gift preparation object disappeared before cleanup.\n");
        state = ([ "object": file_name(ob), "program": base_name(ob) ]);
        destruct(ob);
        state["exists_after"] = objectp(ob);
        cleanup["owned"] += ({ state });
    }
    current["gift_cleanup"] = cleanup;
    mingjiao_gift_owned = ({});
    mingjiao_gift_context = 0;
    mingjiao_gift_pending = 0;
}

mapping mingjiao_book_room_state(object room) {
    require(objectp(room), "original book room exists");
    return ([ "object": file_name(room), "program": base_name(room),
        "no_fight": room->query("no_fight"), "pigging": room->query("pigging"),
        "xin_count": room->query("xin_count") ]);
}

// Explicit initial inputs, not a claim to have walked the secret passage or learned prerequisites.
void begin_mingjiao_route(mapping parameters) {
    if (parameters["route_mode"] == "cold")
        require(sizeof(jobs) == 1 && current["index"] == 0,
            "one first-load observation per independent driver");
    players[0]->enable_player();
    require(players[0]->id(players[0]->query("id")), "route USER discoverable by original ID");
    current["route_preparation"] = "/tests/route_observer"->prepare(players[0], parameters);
    current["route_steps"] = ({});
    mingjiao_route_cursor = 0;
    mingjiao_route_wait = 0;
    current["outcome"] = "observed";
}

void advance_mingjiao_route() {
    mapping step;
    mixed failure;
    int waiting;
    if (!active || current["parameters"]["collection_group"] != "mingjiao-route") return;
    waiting = 0;
    failure = catch {
        if (mapp(mingjiao_route_wait)) {
            current["route_steps"] += ({ "/tests/route_observer"->end_wait(
                players[0], mingjiao_route_wait) });
            mingjiao_route_wait = 0;
            mingjiao_route_cursor++;
        }
        while (mingjiao_route_cursor < sizeof(current["parameters"]["route_steps"])) {
            step = current["parameters"]["route_steps"][mingjiao_route_cursor];
            if (step["kind"] == "command") {
                current["route_steps"] += ({ "/tests/route_observer"->command_step(
                    players[0], step["action"]) });
                mingjiao_route_cursor++;
            } else {
                require(step["kind"] == "wait", "reviewed route step kind");
                mingjiao_route_wait = "/tests/route_observer"->begin_wait(
                    players[0],
                    step["seconds"]
                );
                waiting = 1;
                break;
            }
        }
        if (!waiting) current["route_final"] = "/tests/route_observer"->observe(players[0]);
        stop_background_quests();
    };
    if (failure) {
        current["outcome"] = "error";
        current["reason"] = sprintf("%O", failure);
        finish_sample();
    } else if (waiting) call_out("advance_mingjiao_route", step["seconds"]);
    else finish_sample();
}

void prepare_mingjiao_book_items() {
    mapping setup, prep;
    object book, owner;
    string holder;

    require(active && current["parameters"]["teaching_profile"] == "mingjiao-book" &&
        this_player() == players[0] && userp(this_player()) && playerp(this_player()) &&
        interactive(this_player()) && !wizardp(this_player()), "original book USER preparation");
    setup = current["parameters"]["book_setup"];
    require(mapp(setup) && sizeof(setup) == 4 &&
        member_array(setup["room"], ({ "/tests/runner", "/d/mingjiao/mishi" })) != -1 &&
        member_array(setup["holder"], ({ "cold", "student", "room" })) != -1 &&
        member_array(setup["free_capacity"], ({ 599, 600 })) != -1,
        "finite original book inputs");
    prep = current["book_preparation"];
    prep["entry_actor"] = file_name(this_player());
    prep["book_loaded_before"] = objectp(find_object("/clone/book/qiankun_book"));
    require(!prep["book_loaded_before"], "new sample starts without the previous book");
    prep["room_loaded_before"] = objectp(find_object(setup["room"]));
    mingjiao_book_room = setup["room"] == "/tests/runner" ? this_object() : load_object(setup["room"]);
    require(objectp(mingjiao_book_room) && !clonep(mingjiao_book_room), "original book location");
    prep["room_constructor_stock"] = mingjiao_book_room->query("xin_count");
    foreach (owner in players) if (objectp(owner))
        require(
            owner->move(mingjiao_book_room),
            "original movement to the configured book location"
        );
    mingjiao_book_context = ([ "books": ([ "qiankun_book": "/clone/book/qiankun_book" ]),
        "carriers": ([ "student": players[0], "right": players[1], "room": mingjiao_book_room ]) ]);
    holder = setup["holder"];
    if (holder != "cold") {
        book = load_object("/clone/book/qiankun_book");
        require(
            objectp(book) && !clonep(book) && !environment(book),
            "original book blueprint input"
        );
    }
    prep["initial_state"] = "/tests/teaching_observer"->mingjiao_book_point(mingjiao_book_context);
    if (setup["room"] == "/d/mingjiao/mishi") {
        require(intp(setup["stock"]) && member_array(setup["stock"], ({ 0, 1 })) != -1,
            "finite original stock input");
        mingjiao_book_room->set("xin_count", setup["stock"]);
    } else {
        require(!setup["stock"], "study has no original stock input");
        set("no_fight", current["parameters"]["room_setup"]["no_fight"]);
        set("pigging", current["parameters"]["room_setup"]["pigging"]);
    }
    if (holder != "cold") {
        owner = holder == "student" ? players[0] : mingjiao_book_room;
        require(book->move(owner), "original book placement");
    }
    players[0]->set_max_encumbrance(players[0]->query_encumbrance() + setup["free_capacity"]);
    prep["item_after"] = "/tests/teaching_observer"->mingjiao_book_point(mingjiao_book_context);
    prep["return_actor"] = file_name(this_player());
}

void prepare_mingjiao_book(mapping parameters) {
    require(parameters["teaching_profile"] == "mingjiao-book", "finite original book preparation");
    current["teacher_preparations"] = ({});
    taohua_learning_teachers = ([]);
    current["book_preparation"] = ([ "command": "test_interface", "setup": copy(parameters["book_setup"]),
        "players_before": ({ snapshot(players[0]), snapshot(players[1]) }) ]);
    mingjiao_book_pending = 1;
    require(players[0]->force_me("test_interface") && !mingjiao_book_pending &&
        mapp(mingjiao_book_context), "original book prepared through real student command");
    current["book_preparation"]["players_after"] = ({ snapshot(players[0]), snapshot(players[1]) });
}

void clear_mingjiao_book() {
    mapping cleanup;
    object book, item;
    string room_path, room_program;
    object *letters;

    if (!objectp(mingjiao_book_room)) {
        book = find_object("/clone/book/qiankun_book");
        if (objectp(book)) destruct(book);
        current["book_cleanup"] = ([ "preparation_incomplete": 1,
            "singleton": ([ "object": "/clone/book/qiankun_book",
                "exists_after": objectp(find_object("/clone/book/qiankun_book")) ]) ]);
        mingjiao_book_context = 0;
        mingjiao_book_pending = 0;
        return;
    }
    cleanup = ([ "letters": ({}) ]);
    letters = ({});
    foreach (item in deep_inventory(mingjiao_book_room))
        if (base_name(item) == "/d/mingjiao/obj/yixin") letters += ({ item });
    foreach (item in letters) {
        cleanup["letters"] += ({ ([ "object": file_name(item), "program": base_name(item) ]) });
        destruct(item);
        cleanup["letters"][<1]["exists_after"] = objectp(item);
    }
    book = find_object("/clone/book/qiankun_book");
    if (objectp(book)) destruct(book);
    cleanup["singleton"] = ([ "object": "/clone/book/qiankun_book",
        "exists_after": objectp(find_object("/clone/book/qiankun_book")) ]);
    foreach (item in players) if (objectp(item)) require(
        item->move(this_object()),
        "leave original book location"
    );
    cleanup["players_after_move"] = ({ snapshot(players[0]), snapshot(players[1]) });
    room_path = file_name(mingjiao_book_room);
    room_program = base_name(mingjiao_book_room);
    if (mingjiao_book_room != this_object()) {
        foreach (item in all_inventory(mingjiao_book_room)) destruct(item);
        destruct(mingjiao_book_room);
    } else {
        set("no_fight", 0);
        set("pigging", 0);
    }
    cleanup["room"] = ([ "object": room_path, "program": room_program,
        "exists_after": objectp(find_object(room_path)) ]);
    current["book_cleanup"] = cleanup;
    mingjiao_book_context = 0;
    mingjiao_book_room = 0;
    mingjiao_book_pending = 0;
}

// Finite original teacher pool, book singletons and one weak-mode progress prime.
void prepare_taohua_learning(mapping parameters) {
    mapping expectation, setup;
    string key, path, holder, role;
    object t, item, owner, container;
    string *keys;
    mapping books, pre;

    require(parameters["teaching_profile"] == "taohua-learning", "scoped learning preparation");
    current["learning_preparations"] = ({});
    keys = ({});
    foreach (expectation in parameters["teaching_expectations"]) {
        if (!stringp(expectation["teacher_key"])) continue;
        if (expectation["teacher_key"] == "assigned") {
            foreach (key in ({ "feng", "lu", "qu" }))
                if (member_array(key, keys) == -1) keys += ({ key });
        } else if (member_array(expectation["teacher_key"], keys) == -1)
            keys += ({ expectation["teacher_key"] });
    }
    taohua_learning_teachers = ([]);
    current["teacher_preparations"] = ({});
    foreach (key in keys) {
        taohua_teacher_pending = key;
        require(players[0]->force_me("test_interface") && !taohua_teacher_pending &&
            objectp(taohua_learning_teachers[key]),
            "original teacher prepared through student command");
    }
    if (mapp(parameters["actor"]["learned"]) && sizeof(parameters["actor"]["learned"])) {
        require(!mapp(parameters["actor"]["temp"]) ||
            !sizeof(keys(parameters["actor"]["learned"]) - ({ "chuixiao-jifa" })),
            "frozen single progress prime");
        require(parameters["actor"]["skills"]["chuixiao-jifa"] == 149 &&
            parameters["actor"]["learned"]["chuixiao-jifa"] == 22500,
            "original cross-book progress input");
        pre = snapshot(players[0]);
        players[0]->improve_skill("chuixiao-jifa", 56023, 1);
        current["learning_preparations"] += ({ ([ "actor": file_name(players[0]),
            "function": "improve_skill", "skill": "chuixiao-jifa", "amount": 56023,
            "weak_mode": 1, "before": pre ]) });
    }
    setup = parameters["book_setup"];
    taohua_book_owned = ({});
    taohua_book_context = 0;
    if (mapp(setup)) {
        books = ([]);
        foreach (key in setup["books"]) books[key] = "/clone/lonely/book/" + key;
        taohua_book_context = ([ "books": books, "carriers": ([
            "student": players[0], "room": this_object() ]) ]);
        foreach (key, t in taohua_learning_teachers) taohua_book_context["carriers"][key] = t;
        holder = setup["holder"];
        if (holder == "peer" || holder == "outsider") {
            players[1]->set("family/family_name", holder == "peer" ? "桃花岛" : "武当派");
            taohua_book_context["carriers"][holder] = players[1];
        }
        if (holder == "student" || holder == "room" || holder == "teacher" || holder == "cold" ||
            holder == "peer" || holder == "outsider")
            role = holder;
        else {
            require(strsrch(holder, "-container") != -1, "finite book holder");
            role = replace_string(holder, "-container", "");
            require(role == "student" || role == "outsider", "finite container owner");
            container = new("/inherit/item/item");
            taohua_book_owned += ({ container });
            container->set_name("试验书匣", ({ "book case" }));
            container->set_weight(100);
            container->set_max_encumbrance(100000);
            owner = role == "student" ? players[0] : players[1];
            if (role == "outsider") {
                players[1]->set("family/family_name", "武当派");
                taohua_book_context["carriers"]["outsider"] = players[1];
            }
            require(container->move(owner), "original book container placement");
            taohua_book_context["carriers"]["container"] = container;
            role = "container";
        }
        foreach (key, path in taohua_book_context["books"]) {
            if (holder == "cold") continue;
            item = load_object(path);
            require(objectp(item) && !clonep(item) && base_name(item) == path,
                "original book singleton");
            taohua_book_owned += ({ item });
            if (role == "container") owner = container;
            else if (role == "student") owner = players[0];
            else if (role == "room") owner = this_object();
            else if (role == "peer" || role == "outsider") owner = players[1];
            else {
                require(role == "teacher", "finite teacher holder");
                owner = taohua_learning_teachers[item->query("skill")["name"] == "count" || path == "/clone/lonely/book/hetu" || path == "/clone/lonely/book/luoshu" ? "qu" : "huang"];
                require(objectp(owner), "original book teacher prepared");
            }
            require(item->move(owner), "original singleton placement");
        }
        players[0]->set_max_encumbrance(players[0]->query_encumbrance() + setup["free_capacity"]);
    }
    taohua_book_setup = mapp(setup) ? ([ "holder": setup["holder"],
        "books": setup["books"]]): 0;
}

void finish_gumu_item_preparation(mapping parameters) {
    mapping setup, prep;
    object item, weapon;
    setup = parameters["item_setup"];
    prep = current["item_preparation"];
    gumu_item_context["carriers"]["teacher"] = gumu_teacher;
    prep["teacher"] = file_name(gumu_teacher);
    prep["teacher_program"] = base_name(gumu_teacher);
    if (stringp(setup["stock_key"])) {
        prep["constructor_stock"] = gumu_teacher->query(setup["stock_key"]);
        if (setup["stock_source"] == "direct_reset") {
            prep["reset"] = ([ "calls": 1, "function": "reset",
                "owner": function_exists(
                    "reset",
                    gumu_teacher
                ), "object": file_name(gumu_teacher),
                "before": prep["constructor_stock"], "scope": "direct_interface_not_natural_refresh" ]);
            gumu_teacher->reset();
            prep["reset"]["after"] = gumu_teacher->query(setup["stock_key"]);
        } else gumu_teacher->set(setup["stock_key"], setup["stock"]);
    } else {
        item = find_object(setup["item"]);
        require(objectp(item), "same original singleton after constructor");
        weapon = gumu_teacher->query_temp("weapon");
        prep["singleton"]["after_create"] = serializable(environment(item));
        prep["singleton"]["fallback"] = objectp(weapon) && base_name(weapon) == "/clone/weapon/changbian";
    }
    require(present(parameters["teacher"]["id"], this_object()) == gumu_teacher,
        "exact original teacher resolves despite same-name holder");
}

void set_gumu_npc_observation(object ob) {
    require(active && (current["parameters"]["collection_group"] == "gumu-npc" || is_npc_bout()) &&
        base_name(previous_object()) == "/tests/npc_observer" && objectp(ob) &&
        clonep(ob) && base_name(ob) == current["parameters"]["npc"]["path"] && !objectp(gumu_npc),
        "exact original NPC observation reference");
    gumu_npc = ob;
}

mixed *taohua_setup_mark() {
    require(active && current["parameters"]["collection_group"] == "taohua-npc",
        "scoped taohua setup mark");
    return ({ sizeof(current["attacks"]), sizeof(current["npc_direct"]) });
}

mixed *taohua_debug_attacks() {
    require(active && current["parameters"]["collection_group"] == "taohua-npc",
        "scoped taohua debug");
    return current["attacks"];
}

void taohua_trim_setup(mixed *mark) {
    require(active && current["parameters"]["collection_group"] == "taohua-npc" &&
        arrayp(mark) && sizeof(mark) == 2, "scoped taohua setup trim");
    while (sizeof(current["attacks"]) > mark[0])
        current["attacks"] = current["attacks"][0..sizeof(current["attacks"]) - 2];
    while (sizeof(current["npc_direct"]) > mark[1])
        current["npc_direct"] = current["npc_direct"][0..sizeof(current["npc_direct"]) - 2];
}

void set_taohua_npc_observation(object ob) {
    require(active && current["parameters"]["collection_group"] == "taohua-npc" &&
        base_name(previous_object()) == "/tests/npc_observer" && objectp(ob) &&
        clonep(ob) && base_name(ob) == current["parameters"]["npc"]["path"] && !objectp(taohua_npc),
        "exact original taohua NPC observation reference");
    taohua_npc = ob;
}

int do_interface() {
    mapping spec, busy_call, teacher_entry, load_point, interface_step;
    mixed result, reason;
    object teacher_created;
    string teacher_key, teacher_path, load_skill, load_argument;
    int message_start;
    if (is_jiuyang_fusion()) return do_jiuyang_fusion_interface();
    if (!active || this_player() != players[0]) return 0;
    if (gumu_npc_pending) {
        gumu_npc_pending = 0;
        if (is_npc_bout()) {
            if (current["parameters"]["collection_group"] == "emei-npc-bout") {
                current["npc_observation"] = "/tests/npc_observer"->prepare_emei_bout(
                    current["parameters"]["npc"], players[0]);
                return 1;
            }
            if (current["parameters"]["collection_group"] == "mingjiao-npc-bout") {
                current["skill_load_contexts"] = ({});
                foreach (load_skill in ({ "shenghuo-ling", "qishang-quan" })) {
                    load_argument = load_skill == "shenghuo-ling" ? "sword" : "cuff";
                    load_point = ([ "skill": load_skill, "actor": file_name(this_player()),
                        "already_loaded": objectp(find_object("/kungfu/skill/" + load_skill)),
                        "skills": copy(players[0]->query_skills()), "command": "test_interface",
                        "function": "valid_enable", "argument": load_argument ]);
                    load_point["result"] = SKILL_D(load_skill)->valid_enable(load_argument);
                    require(load_point["result"] == 1 && this_player() == players[0] &&
                        userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
                        !wizardp(this_player()), "original read-only skill load under connected USER");
                    current["skill_load_contexts"] += ({ load_point });
                }
                current["npc_observation"] = "/tests/npc_observer"->prepare_mingjiao_bout(
                    current["parameters"]["npc"], players[0]);
                current["npc_observation"]["preparation"]["skill_load_contexts"] = copy(current["skill_load_contexts"]);
                return 1;
            }
            current["npc_observation"] = "/tests/npc_observer"->prepare_gumu_bout(
                current["parameters"]["npc"], players[0]);
            return 1;
        }
        require(current["method"] == "npc" &&
            current["parameters"]["collection_group"] == "gumu-npc", "scoped original Gumu NPC command");
        current["npc_observation"] = "/tests/npc_observer"->observe_gumu(
            current["parameters"]["npc"], players[0]);
        return 1;
    }
    if (taohua_npc_pending) {
        taohua_npc_pending = 0;
        require(current["method"] == "npc" &&
            current["parameters"]["collection_group"] == "taohua-npc",
            "scoped original taohua NPC command");
        current["npc_observation"] = "/tests/npc_observer"->observe_taohua(
            current["parameters"]["npc"], players[0]);
        return 1;
    }
    if (mingjiao_book_pending) {
        mingjiao_book_pending = 0;
        prepare_mingjiao_book_items();
        return 1;
    }
    if (mingjiao_gift_pending) {
        mingjiao_gift_pending = 0;
        prepare_mingjiao_gift_items();
        return 1;
    }
    if (stringp(taohua_teacher_pending)) {
        teacher_key = taohua_teacher_pending;
        taohua_teacher_pending = 0;
        require(current["method"] == "teaching" &&
            member_array(current["parameters"]["teaching_profile"],
                ({
                    "taohua-learning",
                    "mingjiao-apprentice-learning",
                    "mingjiao-teachers", "mingjiao-recruit", "mingjiao-gift"
                })) != -1 &&
            !objectp(taohua_learning_teachers[teacher_key]), "scoped original teacher preparation");
        require(userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "connected ordinary student creates original teacher");
        teacher_path = "/kungfu/class/taohua/" + teacher_key;
        teacher_entry = ([ "key": teacher_key, "command": "test_interface",
            "entry_actor": file_name(this_player()), "initializer_actor": "not_observed",
            "before": snapshot(players[0]) ]);
        if (member_array(current["parameters"]["teaching_profile"],
            ({ "mingjiao-apprentice-learning", "mingjiao-recruit" })) != -1) {
            if (current["parameters"]["teaching_profile"] == "mingjiao-apprentice-learning")
                require(teacher_key == "zhangwuji", "single reviewed Mingjiao teacher");
            else require(member_array(teacher_key, ({ "daijisi", "fanyao", "lengqian", "weiyixiao",
                "xiaozhao", "xiexun", "yangxiao", "yintianzheng" })) != -1,
                "finite original recruitment teacher");
            teacher_path = "/kungfu/class/mingjiao/" + teacher_key;
            require(
                current["parameters"]["teacher"]["path"] == teacher_path,
                "original recruitment provider path"
            );
            // A level-zero student cannot use enable. This unchanged read-only original
            // interface loads the legacy action table under the real USER before NPC create.
            current["skill_load_context"] = ([ "actor": file_name(this_player()),
                "already_loaded": objectp(find_object("/kungfu/skill/shenghuo-ling")),
                "skills": copy(players[0]->query_skills()), "command": "test_interface",
                "function": "valid_enable", "argument": "sword" ]);
            current["skill_load_context"]["result"] = SKILL_D("shenghuo-ling")->valid_enable("sword");
            require(current["skill_load_context"]["result"] == 1 && this_player() == players[0],
                "original holy skill read in student context");
        }
        if (current["parameters"]["teaching_profile"] == "mingjiao-gift") {
            require(teacher_key == "yangxiao" && current["parameters"]["teacher"]["path"] ==
                "/kungfu/class/mingjiao/yangxiao", "original single gift teacher path");
            teacher_path = current["parameters"]["teacher"]["path"];
        }
        if (current["parameters"]["teaching_profile"] == "mingjiao-teachers") {
            require(teacher_path == "/kungfu/class/taohua/" + teacher_key &&
                current["parameters"]["teacher"]["path"] == "/kungfu/class/mingjiao/" + teacher_key,
                "reviewed teacher selected before original create");
            teacher_path = current["parameters"]["teacher"]["path"];
            foreach (load_skill in ({ "shenghuo-ling", "qishang-quan" })) {
                load_argument = load_skill == "shenghuo-ling" ? "sword" : "cuff";
                load_point = ([ "skill": load_skill, "actor": file_name(this_player()),
                    "already_loaded": objectp(find_object("/kungfu/skill/" + load_skill)),
                    "skills": copy(players[0]->query_skills()), "command": "test_interface",
                    "function": "valid_enable", "argument": load_argument ]);
                load_point["result"] = SKILL_D(load_skill)->valid_enable(load_argument);
                require(load_point["result"] == 1 && this_player() == players[0],
                    "original read-only skill load under connected USER");
                current["skill_load_contexts"] += ({ load_point });
            }
        }
        teacher_created = new(teacher_path);
        require(objectp(teacher_created) && clonep(teacher_created), "original teacher clone");
        require(teacher_created->move(this_object()), "teacher in observation room");
        taohua_learning_teachers[teacher_key] = teacher_created;
        teacher_entry["teacher"] = file_name(teacher_created);
        teacher_entry["teacher_program"] = base_name(teacher_created);
        teacher_entry["teacher_state"] = ([ "object": file_name(teacher_created),
            "id": teacher_created->query("id"), "living": living(teacher_created),
            "playerp": playerp(teacher_created),
            "skills": copy(teacher_created->query_skills() || ([])) ]);
        if (current["parameters"]["teaching_profile"] == "mingjiao-teachers") {
            if (mapp(current["parameters"]["teacher_properties"]) && sizeof(current["parameters"]["teacher_properties"])) {
                require(sizeof(current["parameters"]["teacher_properties"]) == 1 &&
                    current["parameters"]["teacher_properties"]["env/no_teach"] == 1,
                    "explicit original environment refusal input only");
                teacher_created->set("env/no_teach", 1);
            }
            teacher_entry["teacher_state"] = mingjiao_teacher_state(teacher_created);
        }
        if (member_array(
            current["parameters"]["teaching_profile"],
            ({ "mingjiao-recruit", "mingjiao-gift" })
        ) != -1)
            teacher_entry["teacher_state"] = mingjiao_teacher_state(teacher_created);
        teacher_entry["autonomy_before"] = taohua_teacher_autonomy(
            teacher_created,
            teacher_path
        );
        evaluate(bind((: set_heart_beat, 0 :), teacher_created));
        teacher_entry["autonomy_after"] = taohua_teacher_autonomy(
            teacher_created,
            teacher_path
        );
        teacher_entry["after"] = snapshot(players[0]);
        teacher_entry["return_actor"] = file_name(this_player());
        current["teacher_preparations"] += ({ teacher_entry });
        return 1;
    }
    if (gumu_teacher_pending) {
        gumu_teacher_pending = 0;
        require(current["method"] == "teaching" &&
            member_array(current["parameters"]["teaching_profile"],
                ({
                    "gumu-teachers",
                    "gumu-special",
                    "gumu-acquisition-learning", "gumu-item-acquisition", "gumu-recruit"
                })) != -1 && !objectp(gumu_teacher),
            "scoped original Gumu teacher preparation");
        require(userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "connected ordinary student creates original teacher");
        current["teacher_preparation"] = ([ "command": "test_interface",
            "entry_actor": file_name(this_player()), "before": snapshot(players[0]),
            "loaded_before": gumu_teacher_loaded_skills(), "initializer_actor": "not_observed" ]);
        // Original setup/enable_player may change the command giver inside create.
        // Entry/return identity is not evidence of the action table's first reader.
        gumu_teacher = new(current["parameters"]["teacher"]["path"]);
        require(objectp(gumu_teacher) && clonep(gumu_teacher), "original Gumu teacher clone");
        current["teacher_preparation"]["teacher"] = file_name(gumu_teacher);
        current["teacher_preparation"]["teacher_program"] = base_name(gumu_teacher);
        require(gumu_teacher->move(this_object()), "prepared teacher in observation room");
        current["teacher_preparation"]["autonomy_before"] = gumu_teacher_autonomy();
        evaluate(bind((: set_heart_beat, 0 :), gumu_teacher));
        current["teacher_preparation"]["autonomy_after"] = gumu_teacher_autonomy();
        current["teacher_preparation"]["teacher_state"] = snapshot(gumu_teacher);
        current["teacher_preparation"]["after"] = snapshot(players[0]);
        current["teacher_preparation"]["loaded_after"] = gumu_teacher_loaded_skills();
        current["teacher_preparation"]["return_actor"] = serializable(this_player());
        require(this_player() == players[0] && !query_heart_beat(gumu_teacher) &&
            !current["teacher_preparation"]["autonomy_after"]["blueprint_heartbeat"] &&
            !sizeof(current["teacher_preparation"]["autonomy_before"]["callbacks"]) &&
            !sizeof(current["teacher_preparation"]["autonomy_after"]["callbacks"]),
            "original teacher prepared without autonomous callbacks");
        return 1;
    }
    spec = current["parameters"]["interface"];
    if (is_mingjiao_remaining_base()) {
        require(mapp(spec) && spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["function"], ({ "valid_learn", "practice_skill", "hit_ob" })) != -1 &&
            userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "finite original remaining base USER interface");
        message_start = sizeof(current["skill_messages"]);
        interface_step = ([ "command": "test_interface", "entry_actor": file_name(this_player()),
            "before": snapshot(players[0]) ]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-capacity") {
        require(mapp(spec) &&
            ((spec["object"] == "/kungfu/skill/jiuyang-shengong" &&
                spec["function"] == "query_neili_improve") ||
                (spec["object"] == "player" && member_array(spec["function"],
                    ({ "query_neili_limit", "query_current_neili_limit" })) != -1)) &&
            userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "finite original Jiuyang capacity USER context");
        message_start = sizeof(current["skill_messages"]);
        interface_step = ([ "command": "test_interface", "entry_actor": file_name(this_player()),
            "before": snapshot(players[0]) ]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-learning") {
        require(mapp(spec) && spec["object"] == "/kungfu/skill/jiuyang-shengong" &&
            member_array(spec["function"], ({ "valid_learn", "difficult_level" })) != -1 &&
            userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "finite original Jiuyang learning USER context");
        message_start = sizeof(current["skill_messages"]);
        interface_step = ([ "command": "test_interface", "entry_actor": file_name(this_player()),
            "before": snapshot(players[0]) ]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-ling-learning") {
        require(spec["object"] == "/kungfu/skill/shenghuo-ling" &&
            userp(this_player()) && playerp(this_player()) && interactive(this_player()) &&
            !wizardp(this_player()), "original ordinary USER learning context");
        current["interface_context"] = ([ "entry_actor": file_name(this_player()),
            "loaded_before": objectp(find_object(spec["object"])) ]);
    }
    require(mapp(spec) && member_array(
        spec["function"],
        ({
            "valid_learn",
            "valid_research",
            "valid_force",
            "can_learn",
            "do_effect",
            "difficult_level",
            "query_neili_improve",
            "query_neili_limit",
            "query_current_neili_limit",
            "query_effect_parry",
            "query_effect_dodge",
            "query_dodge_msg",
            "query_action",
            "query_skill_name",
            "query_parry_msg",
            "valid_enable",
            "type",
            "valid_learn_level",
            "valid_combine",
            "practice_skill",
            "valid_damage",
            "do_damage",
            "hit_ob",
            "remove_enemy",
            "remove_all_enemy",
            "start_busy",
            "skill_improved"
        })
    ) != -1,
        "configured observation interface");
    if (spec["function"] == "query_skill_name")
        require(member_array(current["parameters"]["collection_group"],
            ({ "s1-yunlong", "s1-qianye", "s1-sanyin", "s1-mizong" })) != -1,
            "finite member name query observation");
    if (spec["function"] == "valid_research") {
        require(member_array(current["parameters"]["collection_group"],
            ({ "gumu-cultivation", "gumu-movement", "mingjiao-shengong" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original research qualification");
        result = call_other(spec["object"], "valid_research", players[0]);
    } else if (spec["function"] == "valid_force") {
        require(current["parameters"]["collection_group"] == "gumu-cultivation" &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            stringp(spec["argument"]), "configured original force compatibility");
        result = call_other(spec["object"], "valid_force", spec["argument"]);
    } else if (spec["function"] == "can_learn") {
        require(member_array(current["parameters"]["collection_group"],
            ({
                "gumu-cultivation",
                "taohua-force",
                "mingjiao-xinfa",
                "mingjiao-force-remaining"
            })) != -1 &&
            spec["object"] == "/cmds/skill/learn" &&
            spec["argument"] == current["parameters"]["skill"],
            "configured original public learning qualification");
        result = call_other(spec["object"], "can_learn", players[0], spec["argument"]);
    } else if (spec["function"] == "start_busy") {
        require(current["parameters"]["collection_group"] == "gumu-hubo" &&
            spec["object"] == "player" && !undefinedp(spec["player_side"]) &&
            member_array(spec["player_side"], ({ 0, 1 })) != -1 &&
            intp(spec["amount"]) && spec["amount"] >= 0,
            "configured original busy interface");
        result = call_other(players[spec["player_side"]], "start_busy", spec["amount"]);
        if (!spec["amount"]) {
            // The original zero request returned early. Read its actual state after that return.
            require(sizeof(current["busy_calls"]), "zero busy call observed");
            busy_call = current["busy_calls"][<1];
            require(busy_call["side"] == spec["player_side"] && busy_call["requested"] == 0 &&
                undefinedp(busy_call["after"]), "matching original zero busy return");
            busy_call["after"] = serializable(players[spec["player_side"]]->query_busy());
        }
    } else if (spec["function"] == "skill_improved") {
        require(current["parameters"]["collection_group"] == "gumu-hubo" &&
            spec["object"] == "/kungfu/skill/zuoyou-hubo", "configured original knowledge notification");
        result = call_other(spec["object"], "skill_improved", players[0]);
    } else if (spec["function"] == "query_skill_name" &&
        current["parameters"]["collection_group"] == "s1-mizong") {
        require(member_array(current["parameters"]["skill"],
            ({ "dashou-yin", "yujiamu-quan", "huoyan-dao" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] && intp(spec["argument"]) &&
            member_array(
                spec["argument"],
                ({ 0, 25, 30, 50, 60, 80, 90, 100, 120, 140, 160, 180, 250, 800 })
            ) != -1,
            "finite original Mizong name query");
        result = call_other(spec["object"], "query_skill_name", spec["argument"]);
    } else if (spec["function"] == "query_skill_name" &&
        current["parameters"]["collection_group"] == "s1-sanyin") {
        require(current["parameters"]["skill"] == "sanyin-wugongzhao" &&
            spec["object"] == "/kungfu/skill/sanyin-wugongzhao" && intp(spec["argument"]) &&
            member_array(
                spec["argument"],
                ({ 0, 29, 30, 59, 60, 89, 90, 119, 120, 199, 200, 800 })
            ) != -1,
            "finite original Sanyin name query");
        result = call_other(spec["object"], "query_skill_name", spec["argument"]);
    } else if (spec["function"] == "query_skill_name" &&
        current["parameters"]["collection_group"] == "s1-qianye") {
        require(current["parameters"]["skill"] == "qianye-shou" &&
            spec["object"] == "/kungfu/skill/qianye-shou" && intp(spec["argument"]) &&
            member_array(
                spec["argument"],
                ({ 0, 29, 30, 60, 90, 110, 130, 140, 150, 160, 800 })
            ) != -1,
            "finite original Qianye name query");
        result = call_other(spec["object"], "query_skill_name", spec["argument"]);
    } else if (spec["function"] == "query_skill_name" &&
        current["parameters"]["collection_group"] == "s1-yunlong") {
        require(member_array(
            current["parameters"]["skill"],
            ({ "yunlong-shou", "yunlong-zhua" })
        ) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            intp(spec["argument"]) && member_array(
                spec["argument"],
                ({ 0, 169, 170, 180, 800 })
            ) != -1,
            "finite original Yunlong name query");
        result = call_other(spec["object"], "query_skill_name", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-mizong") {
        require(member_array(current["parameters"]["skill"],
            ({ "dashou-yin", "yujiamu-quan", "huoyan-dao" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["argument"], ({ "hand", "cuff", "strike", "parry", "sword" })) != -1,
            "finite original Mizong usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-sanyin") {
        require(spec["object"] == "/kungfu/skill/sanyin-wugongzhao" &&
            member_array(spec["argument"], ({ "claw", "parry", "sword" })) != -1,
            "finite original Sanyin usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-qianye") {
        require(spec["object"] == "/kungfu/skill/qianye-shou" &&
            member_array(spec["argument"], ({ "hand", "parry", "sword" })) != -1,
            "finite original Qianye usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-dusha") {
        require(spec["object"] == "/kungfu/skill/dusha-zhang" &&
            member_array(spec["argument"], ({ "strike", "parry", "sword" })) != -1,
            "finite original Dusha usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-panlong") {
        require(spec["object"] == "/kungfu/skill/panlong-zhao" &&
            member_array(spec["argument"], ({ "claw", "parry", "sword" })) != -1,
            "finite original Panlong usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-yunlong") {
        require(member_array(
            current["parameters"]["skill"],
            ({ "yunlong-shou", "yunlong-zhua" })
        ) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["argument"], ({ "hand", "claw", "unarmed", "parry", "sword" })) != -1,
            "finite original Yunlong usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-piaoxu") {
        require(spec["object"] == "/kungfu/skill/piaoxu-zhang" &&
            member_array(spec["argument"], ({ "strike", "parry", "sword" })) != -1,
            "finite original Piaoxu usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "s1-duan-members") {
        require(member_array(
            current["parameters"]["skill"],
            ({ "jinyu-quan", "wuluo-zhang" })
        ) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["argument"], ({ "cuff", "strike", "parry", "sword" })) != -1,
            "finite original Duan member usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "mingjiao-shengong") {
        require(spec["object"] == "/kungfu/skill/shenghuo-shengong" &&
            member_array(spec["argument"], ({ "force", "dodge" })) != -1,
            "configured original holy force usage");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        current["parameters"]["collection_group"] == "mingjiao-ling-learning") {
        require(spec["object"] == "/kungfu/skill/shenghuo-ling" &&
            member_array(spec["argument"], ({ "sword", "parry", "force" })) != -1,
            "configured original holy weapon usage");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (spec["function"] == "valid_enable" &&
        member_array(current["parameters"]["collection_group"],
            ({ "gumu-movement", "mingjiao-movement" })) != -1) {
        require(spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["argument"], ({ "dodge", "move", "parry" })) != -1,
            "configured original movement usage");
        result = call_other(spec["object"], "valid_enable", spec["argument"]);
    } else if (current["parameters"]["collection_group"] == "mingjiao-jiuyang" &&
        spec["function"] == "valid_enable") {
        require(spec["object"] == "/kungfu/skill/jiuyang-shengong" &&
            member_array(
                spec["argument"],
                ({ "force", "unarmed", "parry", "sword", "blade", "dodge" })
            ) != -1 &&
            this_player() == players[0] && userp(this_player()) && !wizardp(this_player()),
            "finite original Jiuyang USER usage query");
        result = call_other(spec["object"], "valid_enable", spec["argument"], players[0]);
    } else if (current["parameters"]["collection_group"] == "mingjiao-qkd" &&
        member_array(spec["function"], ({ "valid_enable", "query_parry_msg" })) != -1) {
        require(spec["object"] == "/kungfu/skill/qiankun-danuoyi" &&
            ((spec["function"] == "valid_enable" &&
                member_array(spec["argument"], ({ "parry", "dodge" })) != -1) ||
                (spec["function"] == "query_parry_msg" && spec["argument"] == "胸口")),
            "finite original QKD query argument");
        result = call_other(spec["object"], spec["function"], spec["argument"]);
    } else if (member_array(spec["function"], ({ "valid_enable", "query_parry_msg" })) != -1) {
        require(member_array(current["parameters"]["collection_group"],
            ({ "shaolin-defense", "emei-defense", "emei-shexing", "gumu-defense" })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original defense query");
        if (spec["function"] == "valid_enable") {
            require(member_array(spec["usage"], ({ "parry", "dodge", "move" })) != -1 ||
                (current["parameters"]["collection_group"] == "gumu-defense" &&
                    spec["object"] == "/kungfu/skill/tianluo-diwang" && spec["usage"] == "strike"),
                "configured defense usage");
            if (!undefinedp(spec["player_side"])) {
                require(current["parameters"]["collection_group"] == "gumu-defense" &&
                    spec["object"] == "/kungfu/skill/tianluo-diwang" && spec["player_side"] == 1,
                    "configured defender qualification query");
                result = call_other(spec["object"], "valid_enable", spec["usage"], players[1]);
            } else result = call_other(spec["object"], "valid_enable", spec["usage"]);
        } else
            result = call_other(
                spec["object"],
                "query_parry_msg",
                players[1]->query_temp("weapon")
            );
    } else if (spec["function"] == "do_effect") {
        require(current["parameters"]["collection_group"] == "shaolin-backlash" &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured original force safety check");
        result = call_other(spec["object"], "do_effect", players[0]);
    } else if (spec["function"] == "valid_combine") {
        require(member_array(current["parameters"]["collection_group"],
            ({
                "wudang-combination",
                "shaolin-combination",
                "emei-combination",
                "gumu-combination",
                "quanzhen-combination",
                "huashan-combination",
                "slice-combination",
                "s1-panlong", "s1-dusha", "s1-qianye", "s1-sanyin", "s1-mizong",
                "s1-piaoxu",
                "s1-yunlong",
                "mingjiao-combination"
            })) != -1 &&
            spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"],
            "configured combination query");
        result = call_other(spec["object"], "valid_combine", spec["combo"]);
    } else if (spec["function"] == "query_effect_dodge")
        result = call_other(spec["object"], "query_effect_dodge", players[0], players[1]);
    else if (spec["function"] == "query_dodge_msg")
        result = call_other(spec["object"], "query_dodge_msg", "胸口");
    else if (spec["function"] == "query_action") {
        require(current["parameters"]["collection_group"] == "emei-shexing" &&
            spec["object"] == "/kungfu/skill/shexing-lifan", "configured movement action query");
        result = call_other(
            spec["object"],
            "query_action",
            players[0],
            players[0]->query_temp("weapon")
        );
    } else if (spec["function"] == "type")
        result = call_other(spec["object"], "type");
    else if (member_array(spec["function"], ({ "valid_learn_level", "practice_skill" })) != -1)
        result = call_other(spec["object"], spec["function"], players[0]);
    else if (spec["function"] == "difficult_level")
        result = call_other(spec["object"], "difficult_level");
    else if (spec["function"] == "query_neili_improve")
        result = call_other(spec["object"], "query_neili_improve", players[0]);
    else if (member_array(
        spec["function"],
        ({ "query_neili_limit", "query_current_neili_limit" })
    ) != -1) {
        require(spec["object"] == "player", "real USER cultivation interface");
        result = call_other(players[0], spec["function"]);
    } else if (spec["function"] == "query_effect_parry")
        result = call_other(spec["object"], "query_effect_parry", players[0], players[1]);
    else if (spec["function"] == "valid_damage") {
        result = call_other(spec["object"], "valid_damage", players[0], players[1],
            spec["damage"], players[0]->query_temp("weapon"));
        observe_defense(
            players[0],
            players[1],
            current["parameters"]["skill"],
            spec["damage"],
            result,
            "interface"
        );
    } else if (spec["function"] == "do_damage") {
        require(spec["object"] == COMBAT_D, "original combat damage interface");
        require(
            undefinedp(spec["attack_type"]) || member_array(
                spec["attack_type"],
                ({ UNARMED_ATTACK, WEAPON_ATTACK })
            ) != -1,
            "configured attack type"
        );
        result = COMBAT_D->do_damage(
            players[0],
            players[1],
            undefinedp(spec["attack_type"]) ? WEAPON_ATTACK : spec["attack_type"],
            spec["damage"],
            current["parameters"]["collection_group"] == "mingjiao-qkd" ? spec["percent"] : 50,
            ""
        );
    } else if (spec["function"] == "hit_ob" && spec["object"] == "/kungfu/skill/taiji-quan") {
        require(current["parameters"]["collection_group"] == "wudang-passive",
            "configured original Taiji passive interface");
        result = call_other(spec["object"], "hit_ob", players[0], players[1]);
    } else if (member_array(spec["function"], ({ "remove_enemy", "remove_all_enemy" })) != -1) {
        require(spec["object"] == "player" &&
            current["parameters"]["collection_group"] == "wudang-passive",
            "configured original combat cleanup");
        if (spec["function"] == "remove_enemy") result = players[0]->remove_enemy(players[1]);
        else result = players[0]->remove_all_enemy(1);
    } else if (spec["function"] == "hit_ob") {
        require(
            spec["object"] == "/kungfu/skill/xiantian-gong" ||
            (current["parameters"]["collection_group"] == "public-special" &&
                spec["object"] == "/kungfu/skill/qixian-wuxingjian") ||
            (current["parameters"]["collection_group"] == "s1-mizong" &&
                spec["object"] == "/kungfu/skill/huoyan-dao") ||
            (current["parameters"]["collection_group"] == "emei-jiuyin-passive" &&
                member_array(spec["object"], ({ "/kungfu/skill/jiuyin-baiguzhao",
                    "/kungfu/skill/cuixin-zhang" })) != -1) ||
            (spec["object"] == "/kungfu/skill/shenmen-jian" &&
                current["parameters"]["collection_group"] == "wudang-shenmen") ||
            (spec["object"] == "/kungfu/skill/yuxiao-jian" &&
                current["parameters"]["collection_group"] == "taohua-passive") ||
            (current["parameters"]["collection_group"] == "gumu-weapons" &&
                member_array(spec["object"], ({ "/kungfu/skill/xuantie-jian",
                    "/kungfu/skill/sanwu-shou", "/kungfu/skill/yunv-xinjing" })) != -1) ||
            (current["parameters"]["collection_group"] == "gumu-unarmed-attack" &&
                member_array(spec["object"], ({ "/kungfu/skill/meinv-quan",
                    "/kungfu/skill/tianluo-diwang", "/kungfu/skill/chilian-shenzhang",
                    "/kungfu/skill/wudu-shenzhang", "/kungfu/skill/sad-strike",
                    "/kungfu/skill/fireice-strike" })) != -1) ||
            (current["parameters"]["collection_group"] == "mingjiao-shenghuo" &&
                spec["object"] == "/kungfu/skill/shenghuo-shengong") ||
            (current["parameters"]["collection_group"] == "mingjiao-jiuyang" &&
                spec["object"] == "/kungfu/skill/jiuyang-shengong") ||
            (is_mingjiao_remaining_base() && member_array(spec["object"],
                ({ "/kungfu/skill/hanbing-mianzhang", "/kungfu/skill/yinfeng-dao",
                    "/kungfu/skill/tougu-zhen", "/kungfu/skill/xiaoyao-jian" })) != -1),
            "configured original passive interface"
        );
        begin_passive(players[0], players[1], "interface");
        result = call_other(
            spec["object"],
            "hit_ob",
            players[0],
            players[1],
            spec["damage"],
            spec["factor"]
        );
        observe_passive(
            players[0],
            players[1],
            explode(spec["object"], "/")[<1],
            spec["damage"],
            spec["factor"],
            result,
            "interface"
        );
    } else
        result = call_other(spec["object"], "valid_learn", players[0]);
    reason = query_notify_fail();
    current["interfaces"] += ({ ([ "object": spec["object"], "function": spec["function"],
        "result": serializable(result) ]) });
    if (is_mingjiao_force_remaining())
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[0] : load_object(spec["object"]));
    if (member_array(current["parameters"]["collection_group"],
        ({
            "mingjiao-jiuyang-learning",
            "mingjiao-jiuyang-capacity",
            "mingjiao-remaining-base"
        })) != -1) {
        require(this_player() == players[0], "Jiuyang interface returns under the original USER");
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[0] : load_object(spec["object"]));
        interface_step["return_actor"] = file_name(this_player());
        interface_step["after"] = snapshot(players[0]);
        interface_step["result"] = serializable(result);
        interface_step["implemented_by"] = current["interfaces"][<1]["implemented_by"];
        interface_step["reason"] = !result && stringp(reason) ? reason : "";
        interface_step["messages"] = copy(current["skill_messages"][message_start..]);
        current["interface_steps"] += ({ interface_step });
    }
    if (is_mingjiao_remaining_base() && spec["function"] == "hit_ob") {
        current["interfaces"][<1]["damage"] = serializable(spec["damage"]);
        current["interfaces"][<1]["factor"] = serializable(spec["factor"]);
    }
    if (current["parameters"]["collection_group"] == "mingjiao-ling-learning")
        current["interface_context"]["return_actor"] = serializable(this_player());
    if (spec["function"] == "valid_combine")
        current["interfaces"][<1]["combo"] = spec["combo"];
    if (!undefinedp(spec["player_side"]))
        current["interfaces"][<1]["player_side"] = spec["player_side"];
    if (!undefinedp(spec["argument"]))
        current["interfaces"][<1]["argument"] = spec["argument"];
    if (spec["function"] == "do_effect")
        current["interfaces"][<1]["implemented_by"] = function_exists(
            "do_effect",
            load_object(spec["object"])
        );
    if (spec["function"] == "query_effect_dodge")
        current["interfaces"][<1]["implemented_by"] = function_exists(
            "query_effect_dodge",
            load_object(spec["object"])
        );
    if (member_array(current["parameters"]["collection_group"],
        ({
            "shaolin-defense",
            "emei-defense",
            "emei-shexing",
            "gumu-defense",
            "mingjiao-movement",
            "mingjiao-qkd",
            "mingjiao-jiuyang"
        })) != -1)
        current["interfaces"][<1]["implemented_by"] = function_exists(
            spec["function"], load_object(spec["object"]));
    if (current["parameters"]["collection_group"] == "gumu-hubo")
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[spec["player_side"]] : load_object(spec["object"]));
    if (current["parameters"]["collection_group"] == "gumu-cultivation")
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[0] : load_object(spec["object"]));
    if (member_array(current["parameters"]["collection_group"],
        ({ "gumu-movement", "gumu-weapon-learning", "gumu-unarmed-learning",
            "mingjiao-ling-learning" })) != -1)
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            load_object(spec["object"]));
    if (member_array(current["parameters"]["collection_group"],
        ({ "taohua-force", "mingjiao-xinfa", "mingjiao-shengong" })) != -1)
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            spec["object"] == "player" ? players[0] : load_object(spec["object"]));
    if (current["parameters"]["collection_group"] == "mingjiao-shenghuo" ||
        (current["parameters"]["collection_group"] == "mingjiao-jiuyang" && spec["function"] == "hit_ob")) {
        current["interfaces"][<1]["damage"] = spec["damage"];
        current["interfaces"][<1]["factor"] = spec["factor"];
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            load_object(spec["object"]));
    }
    if (current["parameters"]["collection_group"] == "public-inherited") {
        require(spec["object"] == "/kungfu/skill/" + current["parameters"]["skill"] &&
            member_array(spec["function"], ({ "valid_learn", "type", "valid_learn_level" })) != -1,
            "configured inherited default interface");
        current["interfaces"][<1]["implemented_by"] = function_exists(spec["function"],
            load_object(spec["object"]));
    }
    current["outcome"] = member_array(
        spec["function"],
        ({ "valid_learn", "valid_research", "can_learn", "practice_skill" })
    ) != -1 && !result ? "refused" : "observed";
    if (current["outcome"] == "refused") current["reason"] = stringp(reason) ? reason : "学习接口未允许";
    return 1;
}

void init() { add_action("do_interface", "test_interface"); }  // Point observations still have no autonomous heartbeat. Bouts use the original
// USER heartbeat, including regeneration; only the chosen command is automated.
int strategy(object ob, int side) {
    if (active && current["parameters"]["collection_group"] == "quanzhen-practice" &&
        current["parameters"]["target_busy_lifecycle"]) {
        if (side != 1 || ob != players[1] || current["busy_terminal"] != "waiting") return 0;
        current["busy_heartbeats"] += ({ ([ "side": side, "driver_heartbeat": 1,
            "before": snapshot(ob), "elapsed_before": time_ns() / 1000000000.0 - started ]) });
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && current["parameters"]["collection_group"] == "composite-synthesis") {
        if (side || ob != players[0] || !current["yanlian_accepted"] ||
            current["outcome"] == "error") return 0;
        current["yanlian_steps"] += ({ ([
            "driver_heartbeat": 1,
            "step_before": ob->query_temp("pending/practice"),
            "busy_before": serializable(ob->query_busy()),
            "elapsed_before": time_ns() / 1000000000.0 - started
        ]) });
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && is_mingjiao_force_remaining()) {
        if (side || ob != players[0] || current["outcome"] != "observed" ||
            member_array(
                current["parameters"]["panel"],
                ({ "exercise", "healing", "expiry" })
            ) == -1) return 0;
        begin_force_event("heartbeat");
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && is_mingjiao_remaining_base()) {
        if (current["method"] != "condition" || side != 1 || ob != players[1] ||
            current["outcome"] == "error" || current["condition_terminal"] != "waiting") return 0;
        current["condition_heartbeats"] += ({ ([ "side": side, "before": snapshot(ob),
            "elapsed_before": time_ns() / 1000000000.0 - started,
            "wall_time_before": time(), "event_count_before": sizeof(current["condition_events"]) ]) });
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && is_jiuyang_fusion()) {
        if (side || ob != players[0] || current["method"] != "yanlian" ||
            current["outcome"] == "error") return 0;
        ob->count_event("heartbeats");
        return 1;
    }
    if (is_npc_bout()) {
        require(!side && ob == players[0], "only the neutral USER heartbeat");
        ob->count_event("heartbeats");
        record_npc_bout_heartbeat(ob);
        return 1;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown" && side < 2 && ob == players[side]) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && current["method"] == "scene" &&
        current["parameters"]["lifecycle"] && current["parameters"]["observe_seconds"] > 0) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && !side && promotion_waiting &&
        current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && side == 1 && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        if (side != 1 || current["method"] != "condition" || !current["parameters"]["ticks"])
            return 0;
        ob->count_event("heartbeats");
        return 1;
    }
    if (active && member_array(
        current["method"],
        ({ "exercise", "healing", "condition" })
    ) != -1 && !side) {
        ob->count_event("heartbeats");
        return 1;
    }
    if (!active || current["method"] != "bout") return 0;
    if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
        current["terminal"] = "time_limit";
        current["winner"] = -1;
        finish_sample();
        return 0;
    }
    ob->count_event("heartbeats");
    if (current["first_actor"] == -1) current["first_actor"] = side;
    if (!side && current["parameters"]["strategy"] == "perform" &&
        living(ob) && living(players[1]) && !ob->is_busy() &&
        ob->query("qi") >= 0 && players[1]->query("qi") >= 0) {
        ob->count_event("perform_attempts");
        ob->force_me(current["parameters"]["action"]);
    }
    return active;
}

void after_heartbeat(int side) {
    mapping busy_step;
    if (active && current["parameters"]["collection_group"] == "quanzhen-practice" &&
        current["parameters"]["target_busy_lifecycle"]) {
        require(
            side == 1 && sizeof(current["busy_heartbeats"]),
            "original gold lock target heartbeat"
        );
        busy_step = current["busy_heartbeats"][<1];
        busy_step["after"] = snapshot(players[1]);
        busy_step["elapsed"] = time_ns() / 1000000000.0 - started;
        if (!players[1]->is_busy()) {
            current["busy_terminal"] = "released";
            call_out("finish_sample", 0);
        }
        return;
    }
    if (active && current["parameters"]["collection_group"] == "composite-synthesis") {
        require(
            !side && sizeof(current["yanlian_steps"]),
            "original synthesis heartbeat completion"
        );
        current["yanlian_steps"][<1]["step_after"] = players[0]->query_temp("pending/practice");
        current["yanlian_steps"][<1]["busy_after"] = serializable(players[0]->query_busy());
        current["yanlian_steps"][<1]["elapsed"] = time_ns() / 1000000000.0 - started;
        return;
    }
    if (active && is_mingjiao_force_remaining()) {
        require(!side, "force actor-only original heartbeat");
        // Seal full natural HB before the separate original halt or terminal.
        end_force_event("heartbeat");
    }
    if (active && is_mingjiao_remaining_base() && current["method"] == "condition") {
        require(side == 1 && sizeof(current["condition_heartbeats"]),
            "remaining base victim original heartbeat completion");
        current["condition_heartbeats"][<1]["after"] = snapshot(players[side]);
        current["condition_heartbeats"][<1]["elapsed"] = time_ns() / 1000000000.0 - started;
        current["condition_heartbeats"][<1]["wall_time_after"] = time();
        current["condition_heartbeats"][<1]["event_count_after"] = sizeof(current["condition_events"]);
        if (current["outcome"] != "error" &&
            !mapp(players[side]->query_condition(current["parameters"]["requirements"]["condition_name"]))) {
            current["condition_terminal"] = "removed";
            current["condition_lifecycle_complete"] = 1;
            // Observe only after the full original USER heartbeat and its condition cleanup return.
            call_out("finish_sample", 0);
        }
        return;
    }
    if (active && is_jiuyang_fusion()) {
        if (!side && current["outcome"] != "error")
            call_out("settle_jiuyang_fusion_window", 0);
        return;
    }
    if (is_npc_bout()) {
        require(!side, "natural bout excludes bystander heartbeat");
        sample_busy();
        if (!current["second_started"] && objectp(gumu_npc)) {
            current["second_started"] = 1;
            evaluate(bind((: set_heart_beat, 1 :), gumu_npc));
        }
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle" && side == 1) {
        if (sizeof(current["condition_events"]) / 2 > sizeof(current["condition_heartbeats"])) {
            current["condition_heartbeats"] += ({ ([ "side": side, "state": snapshot(players[side]),
                "elapsed": time_ns() / 1000000000.0 - started ]) });
            if (sizeof(current["condition_heartbeats"]) == current["parameters"]["ticks"])
                finish_sample();
        }
        return;
    }
    if (active && current["method"] == "condition" && !side) {
        if (sizeof(current["condition_events"]) / 2 > sizeof(current["condition_heartbeats"])) {
            current["condition_heartbeats"] += ({ ([ "state": snapshot(players[0]),
                "elapsed": time_ns() / 1000000000.0 - started ]) });
            if (sizeof(current["condition_heartbeats"]) == current["parameters"]["ticks"]) {
                if (current["parameters"]["collection_group"] == "s1-dusha-lifecycle") {
                    current["condition_lifecycle_complete"] = !mapp(players[0]->query_condition("sha_poison"));
                    current["condition_terminal"] = current["condition_lifecycle_complete"] ? "removed" : "tick_limit";
                }
                finish_sample();
            }
        }
        return;
    }
    if (active && current["method"] == "healing" && !side) {
        if (current["parameters"]["halt_after"] && sizeof(current["healing_steps"]) &&
            !current["halt_accepted"]) {
            current["healing_halt"] = ([ "before": snapshot(players[0]) ]);
            if (is_mingjiao_force_remaining()) {
                current["halt_command_cost"] = players[0]->force_me("halt");
                current["halt_accepted"] = !!current["halt_command_cost"];
            } else current["halt_accepted"] = players[0]->force_me("halt");
            current["healing_halt"]["after"] = snapshot(players[0]);
            require(current["halt_accepted"], "original healing halt accepted");
        }
        // Preserve the game's pending marker, including MA-080; busy owns completion.
        if (!players[0]->is_busy()) {
            current["healing_terminal"] = current["halt_accepted"] ? "halted" : "busy_ended";
            finish_sample();
        }
        return;
    }
    if (active && current["method"] == "exercise" && !side) {
        if (current["parameters"]["halt_after"] && sizeof(current["exercise_steps"]) &&
            !current["halt_accepted"]) {
            if (is_mingjiao_force_remaining()) current["exercise_halt"] = ([ "before": snapshot(players[0]) ]);
            if (is_mingjiao_force_remaining()) {
                current["halt_command_cost"] = players[0]->force_me("halt");
                current["halt_accepted"] = !!current["halt_command_cost"];
            } else current["halt_accepted"] = players[0]->force_me("halt");
            if (is_mingjiao_force_remaining()) current["exercise_halt"]["after"] = snapshot(players[0]);
            require(current["halt_accepted"], "original halt accepted");
        }
        if (!players[0]->is_busy() && !players[0]->query_temp("pending/exercise")) {
            current["exercise_terminal"] = current["halt_accepted"] ? "halted" : "completed";
            finish_sample();
        }
        return;
    }
    if (!active || current["method"] != "bout") return;
    sample_busy();
    if (!current["second_started"]) {
        require(side == current["first"], "actual opening initiative");
        current["second_started"] = 1;
        players[1 - side]->observation_heartbeat(1);
    }
}

void terminal(object ob, int side, string state) {
    if (is_npc_bout()) {
        require(!side && ob == players[0], "natural bout USER terminal return");
        call_out("finish_sample", 0);
        return;
    }
    if (active) current["terminals"] += ({ ([ "side": side, "state": state ]) });
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        current["outcome"] = "error";
        current["reason"] = "Original cooldown sequence ended with " + state;
        finish_sample();
        return;
    }
    if (active && current["method"] == "scene" && current["parameters"]["lifecycle"])
        stop_background_quests();
    if (active && side == 1 && state == "death" &&
        member_array(
            current["parameters"]["collection_group"],
            ({ "shaolin-palms", "shaolin-hands" })
        ) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        if (current["parameters"]["collection_group"] == "shaolin-hands")
            current["observation_terminal"] = "death";
        finish_sample();
        return;
    }
    if (active && current["method"] == "bout") {
        current["terminal"] = state;
        current["winner"] = 1 - side;
        finish_sample();
    }
}

void sample_busy() {
    float now, elapsed;
    int side;
    now = time_ns() / 1000000000.0;
    elapsed = now - observed;
    foreach (side in ({ 0, 1 })) {
        if (busy_state[side]) busy_seconds[side] += elapsed;
        if (is_npc_bout()) busy_state[side] = side ? players[0]->is_busy() : objectp(gumu_npc) && gumu_npc->is_busy();
        else busy_state[side] = objectp(players[side]) && players[side]->is_busy();
    }
    observed = now;
}

// Three original commands only. Waiting neither rewrites the game's timestamp
// nor invokes continue_action, start_busy, resource refills or automatic performs.
void perform_gumu_temporal(string phase) {
    mapping step;
    mixed reason;
    require(active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown" &&
        member_array(phase, ({ "initial", "early", "expired" })) != -1,
        "reviewed original cooldown sequence");
    step = ([ "phase": phase, "action": current["parameters"]["action"],
        "before": ({ snapshot(players[0]), snapshot(players[1]) }),
        "metrics_before": ({
            players[0]->query_observation(),
            players[1]->query_observation()
        }),
        "launches_before": sizeof(current["launches"]), "directs_before": sizeof(current["directs"]) ]);
    current["temporal_steps"] += ({ step });
    step["accepted"] = players[0]->force_me(step["action"]);
    reason = players[0]->query_temp("notify_fail");
    step["reason"] = step["accepted"] || !stringp(reason) ? "" : reason;
    step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
    step["metrics_after"] = ({
        players[0]->query_observation(),
        players[1]->query_observation()
    });
    step["launches_after"] = sizeof(current["launches"]);
    step["directs_after"] = sizeof(current["directs"]);
}

void poll_gumu_temporal() {
    int size, age;
    object ob;
    require(time_ns() / 1000000000.0 - started <= current["parameters"]["observe_seconds"],
        "original cooldown sequence observation window expired");
    foreach (ob in players[0..1])
        require(objectp(ob) && interactive(ob) && living(ob) && !ob->is_ghost() &&
            environment(ob) == this_object() && ob->query("qi") >= 0 && ob->query("jing") >= 0,
            "original cooldown sequence lost its live connected target");
    require(players[0]->is_fighting(players[1]) && players[1]->is_fighting(players[0]) &&
        players[0]->query("neili") >= 500, "original cooldown sequence lost combat or resources");
    size = sizeof(current["temporal_steps"]);
    require(size == 1 || size == 2, "original cooldown sequence phase");
    age = time() - players[0]->query_temp("last_perform/sad-strike/tuo");
    if (!players[0]->is_busy() && age > 0 && (size == 1 || age >= 60)) {
        require(size == 2 || age < 60, "early original cooldown boundary missed");
        perform_gumu_temporal(size == 1 ? "early" : "expired");
        require(current["temporal_steps"][<1]["accepted"] == (size == 2),
            "original cooldown phase did not produce its expected return");
        if (size == 2) {
            finish_sample();
            return;
        }
    }
    call_out("poll", 1);
}

void poll() {
    mapping state, step;
    mixed busy;
    if (active && current["parameters"]["collection_group"] == "quanzhen-practice" &&
        current["parameters"]["target_busy_lifecycle"]) {
        if (current["busy_terminal"] != "waiting") return;
        if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
            current["outcome"] = "error";
            current["reason"] = "Original gold lock target busy did not expire before watchdog.";
            current["busy_terminal"] = "watchdog";
            finish_sample();
        } else call_out("poll", 1);
        return;
    }
    if (active && current["method"] == "yanlian" && current["yanlian_accepted"]) {
        // Poll observes only. The driver's USER heartbeat owns continue_action().
        busy = players[0]->query_busy();
        if (busy && time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"]) {
            call_out("poll", 1);
            return;
        }
        // Check skill state: distinguish busy timeout from get_finish failure
        state = snapshot(players[0]);
        if (state["skills"][current["parameters"]["skill"]] > 0) {
            current["outcome"] = "observed";
            current["reason"] = "";
            current["yanlian_terminal"] = "synthesized";
        } else if (busy) {
            // Busy loop still active after observe_seconds: timeout
            current["outcome"] = "error";
            current["reason"] = "test env timeout: yanlian busy loop requires game heartbeats";
            current["yanlian_terminal"] = "timeout";
        } else {
            current["outcome"] = "refused";
            if (!players[0]->query_temp("pending/practice")) {
                current["yanlian_terminal"] = "finish_refused";
                current["reason"] = "原演练完成，合成检查未通过，主技能未生成";
            } else {
                current["yanlian_terminal"] = "practice_stopped";
                current["reason"] = "原演练提前结束，未进入合成检查";
            }
        }
        finish_sample();
        return;
    }
    if (active && is_mingjiao_force_remaining()) {
        if (time_ns() / 1000000000.0 - started >= current["parameters"]["watchdog_seconds"]) {
            current["outcome"] = "error";
            current["reason"] = "Original force lifecycle watchdog expired without completion.";
            finish_sample();
        } else call_out("poll", 1);
        return;
    }
    if (active && is_mingjiao_remaining_base() && current["method"] == "condition") {
        if (current["condition_terminal"] != "waiting") return;
        if (time_ns() / 1000000000.0 - started >= current["parameters"]["requirements"]["watchdog_seconds"]) {
            current["outcome"] = "error";
            current["reason"] = "Original condition observation watchdog expired; lifecycle incomplete.";
            current["condition_terminal"] = "watchdog";
            current["condition_lifecycle_complete"] = 0;
            finish_sample();
        } else if (current["condition_terminal"] == "waiting") call_out("poll", 1);
        return;
    }
    if (is_npc_bout()) {
        sample_busy();
        if (sizeof(current["npc_bout"]["terminal_events"]) ||
            time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"])
            finish_sample();
        else call_out("poll", 1);
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-temporal" &&
        current["parameters"]["temporal_kind"] == "tuo-cooldown") {
        poll_gumu_temporal();
        return;
    }
    if (active && current["parameters"]["teaching_profile"] == "shaolin-challenge") {
        observe_challenge();
        if (time_ns() / 1000000000.0 - formation_started >= current["parameters"]["observe_seconds"])
            finish_sample();
        else call_out("poll", 1);
        return;
    }
    if (active && promotion_waiting && current["parameters"]["teaching_profile"] == "shaolin-promotion") {
        state = "/tests/teaching_observer"->finish_promotion_wait(
            players[0],
            promotion_teacher
        );
        require(time_ns() / 1000000000.0 - promotion_started < current["parameters"]["observe_seconds"],
            "original promotion fight/callback did not complete within observation window");
        if (state["promotion"]["teacher_fighting"] || state["promotion"]["student_fighting"] ||
            state["promotion"]["checking_pending"]) {
            call_out("poll", 1);
            return;
        }
        step = current["teaching"][<1];
        step["immediate_after"] = step["after"];
        step["after"] = state;
        step["wait_elapsed"] = time_ns() / 1000000000.0 - promotion_started;
        step["wait_messages"] = players[0]->end_teaching_messages();
        promotion_waiting = 0;
        players[0]->observation_heartbeat(0);
        advance_promotion();
        if (promotion_waiting) call_out("poll", 1);
        else finish_sample();
        return;
    }
    if (active && current["parameters"]["collection_group"] == "shaolin-hands" &&
        current["parameters"]["target_heartbeat"]) {
        // Zero effective resources do not guarantee death: retain the real state.
        if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
            current["observation_terminal"] = "window_complete";
            finish_sample();
        } else call_out("poll", 1);
        return;
    }
    if (active && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-palms", "shaolin-hands" })) != -1 &&
        current["parameters"]["target_heartbeat"]) {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original target death heartbeat did not finish");
        call_out("poll", 1);
        return;
    }
    if (active && current["parameters"]["collection_group"] == "gumu-needle-lifecycle") {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original needle lifecycle did not complete before watchdog");
        call_out("poll", 1);
        return;
    }
    if (active && member_array(
        current["method"],
        ({ "exercise", "healing", "condition" })
    ) != -1) {
        require(time_ns() / 1000000000.0 - started < current["parameters"]["observe_seconds"],
            "original heartbeat action watchdog expired without completion");
        call_out("poll", 1);
        return;
    }
    if (!active || current["method"] != "bout") return;
    sample_busy();
    if (time_ns() / 1000000000.0 - started >= current["parameters"]["observe_seconds"]) {
        current["terminal"] = "time_limit";
        current["winner"] = -1;
        finish_sample();
    } else call_out("poll", 1);
}

// Continue the same student's original commands after the original NPC timer.
// The only autonomous player action is its normal heartbeat during fight.
void advance_promotion() {
    mapping parameters, expectation, step;
    string path;
    parameters = current["parameters"];
    while (promotion_index < sizeof(parameters["teaching_expectations"])) {
        expectation = parameters["teaching_expectations"][promotion_index++];
        path = expectation["teacher"]["path"];
        if (!objectp(promotion_teacher) || base_name(promotion_teacher) != path) {
            promotion_teacher = new(path);
            require(promotion_teacher->move(this_object()), "original promotion NPC in room");
        }
        step = "/tests/teaching_observer"->observe_command(players[0], promotion_teacher,
            expectation["action"], ({}), 0, 0, 1);
        current["teaching"] += ({ step });
        if (sizeof(step["after"]["promotion"]["items"]) > sizeof(step["before"]["promotion"]["items"]) ||
            step["after"]["master_id"] != step["before"]["master_id"])
            current["outcome"] = "observed";
        if (expectation["wait_fight"] && step["command_accepted"]) {
            promotion_waiting = 1;
            promotion_started = time_ns() / 1000000000.0;
            players[0]->begin_teaching_messages();
            players[0]->observation_heartbeat(1);
            return;
        }
    }
    if (current["outcome"] == "refused") current["reason"] = "原命令未取得信物或晋升，详见逐步记录";
}

void observe_challenge() {
    mapping state;
    state = "/tests/challenge_observer"->observe(players[0], challenge_teachers,
        current["parameters"]["challenge_rosters"]);
    state["elapsed"] = time_ns() / 1000000000.0 - formation_started;
    current["challenge_timeline"] += ({ state });
}

void start_challenge(mapping parameters) {
    mapping expectation, step;
    object teacher;
    string name, direction;
    int index, i;
    // The base fixture ran setup before its per-sample ID was assigned.
    // Use the original registration entry, not a replacement find_player.
    players[0]->enable_player();
    require(find_player(players[0]->query("id")) == players[0], "registered challenge player");
    "/tests/challenge_observer"->reset_sample();
    "/tests/formation_observer"->reset_sample();
    current["teaching"] = ({});
    current["challenge_walks"] = ({});
    current["challenge_timeline"] = ({});
    challenge_teachers = ({});
    formation_started = time_ns() / 1000000000.0;
    for (index = 0; index < 2; index++) {
        name = parameters["challenge_order"][index];
        teacher = "/tests/challenge_observer"->teacher(name);
        if (!index) require(
            players[0]->move(environment(teacher)),
            "initial original formation room"
        );
        expectation = parameters["teaching_expectations"][index];
        step = "/tests/teaching_observer"->observe_command(players[0], teacher,
            expectation["action"], ({}), 0, 0, 0, 0, expectation["formation"]);
        current["teaching"] += ({ step });
        require(step["after"]["formation"]["requested"] == 1, "original invitation accepted");
        challenge_teachers += ({ teacher });
        direction = name == "xuan-ku" ? "west" : "east";
        for (i = 0; i < (index ? 2 : 4); i++) {
            step = "/tests/challenge_observer"->walk(players[0], direction);
            current["challenge_walks"] += ({ step });
            require(step["before"] != step["after"], "original go reached next formation room");
        }
    }
    require(
        base_name(environment(players[0])) == "/d/shaolin/wuchang",
        "arrived at original field"
    );
    current["teaching"][<1]["immediate_after"] = current["teaching"][<1]["after"];
    current["outcome"] = "observed";
    players[0]->begin_teaching_messages();
    players[0]->observation_heartbeat(1);
    observe_challenge();
}

// Observable advancement only: real skill/progress gain, permission grant,
// full recruitment, first book permission or an actual book acquisition.
private int taohua_learning_advanced(mapping step) {
    string key;
    mapping before, after, family_before, family_after, item, prior;
    object student;

    before = step["before"];
    after = step["after"];
    foreach (key in keys(after["skills"]))
        if (after["skills"][key] > before["skills"][key]) return 1;
    foreach (key in keys(after["learned"]))
        if (after["learned"][key] > (before["learned"][key] || 0)) return 1;
    foreach (key in keys(after["grants"]))
        if (after["grants"][key] > before["grants"][key]) return 1;
    family_before = before["recruitment"]["family"];
    family_after = after["recruitment"]["family"];
    if (!mapp(family_before)) family_before = ([]);
    if (!mapp(family_after)) family_after = ([]);
    if (stringp(family_after["master_id"]) &&
        family_after["master_id"] != (family_before["master_id"] || 0)) return 1;
    if (after["taohua"]["countbook"] > before["taohua"]["countbook"]) return 1;
    if (mapp(step["item_before"]) && mapp(step["item_after"])) {
        student = step["student"];
        foreach (item in step["item_after"]["items"]) {
            if (!item["exists"] || item["environment"] != student) continue;
            prior = 0;
            foreach (prior in step["item_before"]["items"])
                if (prior["key"] == item["key"]) break;
            if (!mapp(prior) || prior["key"] != item["key"] || !prior["exists"] ||
                prior["environment"] != student) return 1;
        }
    }
    return 0;
}

mixed *jiuyang_exert_relations() {
    mixed *result, *pairs;
    object ob, peer;
    int side, other, count;
    result = ({});
    count = mapp(current["parameters"]["extra_target"]) ? 3 : 2;
    for (side = 0; side < count; side++) {
        ob = players[side];
        pairs = ({});
        for (other = 0; other < count; other++) {
            if (other == side) continue;
            peer = players[other];
            pairs += ({ ([ "side": other, "fighting": !!ob->is_fighting(peer),
                "want": !!ob->is_want_kill(peer->query("id")),
                "killing": !!ob->is_killing(peer->query("id")) ]) });
        }
        result += ({ ([ "side": side,
            "enemies": map(ob->query_enemy(), (: member_array($1, players) :)),
            "want": copy(ob->query_want()), "killers": copy(ob->query_killer()),
            "pairs": pairs ]) });
    }
    return result;
}

void perform_jiuyang_exert_steps(mapping parameters) {
    mapping step;
    string action;
    mixed reason;
    object ob;
    int result;
    require(current["method"] == "exert" && arrayp(parameters["actions"]) &&
        sizeof(parameters["actions"]) > 0 && sizeof(parameters["actions"]) <= 2,
        "finite Jiuyang original command sequence");
    current["exert_steps"] = ({});
    current["command_accepted"] = 0;
    current["outcome"] = "refused";
    foreach (action in parameters["actions"]) {
        require(member_array(action, ({ "exert powerup", "exert shield", "exert roar",
            "exert powerup right", "exert shield right" })) != -1,
            "reviewed original Jiuyang exert action");
        step = ([ "action": action, "before": ({ snapshot(players[0]), snapshot(players[1]) }),
            "launch_start": sizeof(current["launches"]), "refusal_start": sizeof(current["refusals"]) ]);
        if (mapp(parameters["extra_target"])) step["extra_before"] = snapshot(players[2]);
        result = players[0]->force_me(action);
        step["accepted"] = result;
        require(result >= 0, "original command cost nonnegative");
        reason = "";
        if (!result) {
            reason = players[0]->query_temp("notify_fail");
            require(stringp(reason) && reason != "", "actual original exert refusal");
        }
        step["reason"] = reason;
        step["launch_end"] = sizeof(current["launches"]);
        step["refusal_end"] = sizeof(current["refusals"]);
        step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        if (mapp(parameters["extra_target"])) step["extra_after"] = snapshot(players[2]);
        current["exert_steps"] += ({ step });
        current["command_accepted"] += result;
        if (result) current["outcome"] = "observed";
        else current["reason"] = reason;
    }
    // The action is synchronous; subsequent waits observe only original bound callbacks.
    if (current["outcome"] == "observed") current["reason"] = "";
    foreach (ob in players) if (objectp(ob)) ob->observation_heartbeat(0);
}

// Finite additional force panels share the real actor, commands and observers.
void perform_force_remaining(mapping parameters) {
    mapping step, operation;
    string action, panel;
    mixed reason, result;
    int launches;
    panel = parameters["panel"];
    action = parameters["action"];
    require(member_array(panel, ({ "research", "exercise", "inherited-hit", "capacity",
        "expiry", "healing", "dispel", "repeat", "recovery" })) != -1,
        "finite force panel");
    if (panel == "inherited-hit") {
        require(
            current["method"] == "ordinary" && action == "ordinary",
            "single original force control attack"
        );
        current["ordinary_step"] = ([ "actor": 0, "target": 1, "type": TYPE_REGULAR,
            "caller_side": member_array(this_player(), players) ]);
        result = COMBAT_D->do_attack(
            players[0],
            players[1],
            players[0]->query_temp("weapon"),
            TYPE_REGULAR
        );
        current["ordinary_step"]["result"] = serializable(result);
        current["outcome"] = "observed";
        return;
    }
    current["command_context"] = ([ "action": action, "actor": file_name(players[0]),
        "force_me_source": function_exists("force_me", players[0]) ]);
    require(
        current["command_context"]["force_me_source"] == "/feature/command",
        "original USER force command owner"
    );
    if (panel == "repeat") {
        require(current["method"] == "exert" && sizeof(parameters["buff_steps"]) == 4,
            "four finite force repeat/refill operations");
        current["buff_steps"] = ({});
        current["command_accepted"] = 0;
        foreach (operation in parameters["buff_steps"]) {
            step = ([ "operation": copy(operation), "before": snapshot(players[0]) ]);
            if (!undefinedp(operation["refill_neili"])) {
                require(member_array(operation["refill_neili"], ({ 6000, 8000 })) != -1,
                    "explicit force experimental refill");
                players[0]->set("neili", operation["refill_neili"]);
            } else {
                require(member_array(
                    operation["command"],
                    ({ "exert power", "exert tianmo" })
                ) != -1,
                    "finite original force repeat command");
                step["launches_before"] = sizeof(current["launches"]);
                step["refusals_before"] = sizeof(current["refusals"]);
                result = players[0]->force_me(operation["command"]);
                require(intp(result) && result >= 0, "actual force repeat command cost");
                step["command_cost"] = result;
                step["accepted"] = !!result;
                current["command_accepted"] += result;
                step["launches_after"] = sizeof(current["launches"]);
                step["refusals_after"] = sizeof(current["refusals"]);
                reason = players[0]->query_temp("notify_fail");
                step["reason"] = !result && stringp(reason) ? reason : "";
            }
            step["after"] = snapshot(players[0]);
            current["buff_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        if (current["outcome"] == "refused") current["reason"] = current["buff_steps"][<1]["reason"];
        return;
    }
    if (panel == "research") {
        require(current["method"] == "research" && member_array(action,
            ({ "research shenghuo-xinfa 1", "research shenghuo-xinfa 3" })) != -1,
            "finite original heart-method research command");
        step = ([ "action": action, "entry_actor": file_name(players[0]),
            "before": ({ snapshot(players[0]), snapshot(players[1]) }),
            "metrics_before": ({
                players[0]->query_observation(),
                players[1]->query_observation()
            }) ]);
    } else if (panel == "exercise")
        require(current["method"] == "exercise" && member_array(action,
            ({ "exercise 9", "exercise 10", "exercise 100", "exercise 1000" })) != -1,
            "finite original force exercise command");
    else if (panel == "capacity")
        require(current["method"] == "interface" && action == "test_interface" &&
            ((parameters["interface"]["object"] == "/cmds/skill/learn" &&
                parameters["interface"]["function"] == "can_learn" &&
                member_array(
                    parameters["interface"]["argument"],
                    ({ "shenghuo-shengong", "huashan-xinfa" })
                ) != -1) ||
                (parameters["interface"]["object"] == "player" && member_array(parameters["interface"]["function"],
                    ({
                        "query_neili_limit",
                        "query_current_neili_limit"
                    })) != -1)), "finite original force capacity owner");
    else
        require(member_array(action, ({ "exert powerup", "exert shield", "exert heal", "exert inspire",
            "exert dispel", "exert dispel right", "exert recover", "exert regenerate" })) != -1,
            "finite original force exert command");
    launches = sizeof(current["launches"]);
    current["command_clock"] = ([ "wall_time_before": time() ]);
    if (panel == "research") step["wall_time_before"] = current["command_clock"]["wall_time_before"];
    result = players[0]->force_me(action);
    current["command_clock"]["wall_time_after"] = time();
    require(intp(result) && result >= 0, "actual original force command cost");
    current["command_accepted"] = result;
    reason = players[0]->query_temp("notify_fail");
    if (panel == "capacity") {
        require(sizeof(current["interfaces"]) == 1, "one original force capacity observation");
        return;
    }
    if (panel == "research") {
        step["wall_time_after"] = current["command_clock"]["wall_time_after"];
        step["return_actor"] = file_name(players[0]);
        step["accepted"] = result;
        step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        step["metrics_after"] = ({
            players[0]->query_observation(),
            players[1]->query_observation()
        });
        step["messages"] = copy(current["skill_messages"]);
        step["reason"] = !result && stringp(reason) ? reason : "";
        current["research_steps"] = ({ step });
        current["outcome"] = players[0]->query("learned_points") > current["before"][0]["learned_points"] ? "observed" : "refused";
    } else if (panel == "exercise") current["outcome"] = result ? "observed" : "refused";
    else current["outcome"] = sizeof(current["launches"]) > launches ? "observed" : "refused";
    if (current["outcome"] == "refused") {
        require(
            stringp(reason) && reason != "",
            "actual original force refusal/no-progress reason"
        );
        current["reason"] = reason;
    }
}

void perform_sample() {
    mapping parameters, step, expectation;
    string action, grant, room_key, saved_state, key;
    mixed reason;
    object teacher, restored_actor, ob, t;
    int result, launches, cycle, participant;
    parameters = current["parameters"];
    foreach (room_key in ({
        "no_fight",
        "skybook",
        "can_dazuo",
        "exercise_improve",
        "sleep_room",
        "quarrys"
    })) {
        delete(room_key);
        if (mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    foreach (room_key in ({ "practice_improve", "research_improve" })) {
        delete(room_key);
        if ((parameters["collection_group"] == "gumu-movement" ||
            parameters["collection_group"] == "taohua-force" ||
            (parameters["collection_group"] == "gumu-weapon-learning" && room_key == "practice_improve") ||
            (member_array(parameters["collection_group"],
                ({ "gumu-research", "mingjiao-jiuyang-research" })) != -1 &&
                room_key == "research_improve")) &&
            mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    foreach (room_key in ({
        "pigging",
        "can_practice_xiantie-jian",
        "can_practice_xuantie-jian"
    })) {
        delete(room_key);
        if ((parameters["collection_group"] == "gumu-weapon-learning" ||
            (member_array(parameters["collection_group"],
                ({
                    "gumu-research",
                    "mingjiao-jiuyang-research"
                })) != -1 && room_key == "pigging") ||
            (parameters["collection_group"] == "taohua-force" && room_key == "pigging")) &&
            mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
            set(room_key, parameters["room"][room_key]);
    }
    if (parameters["collection_group"] == "gumu-weapon-learning")
        current["weapon_learning_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "practice_improve": query("practice_improve"),
            "can_practice_xiantie-jian": query("can_practice_xiantie-jian"),
            "can_practice_xuantie-jian": query("can_practice_xuantie-jian") ]);
    if (parameters["collection_group"] == "gumu-unarmed-learning") {
        foreach (room_key in ({ "pigging", "practice_improve" }))
            if (mapp(parameters["room"]) && !undefinedp(parameters["room"][room_key]))
                set(room_key, parameters["room"][room_key]);
        current["unarmed_learning_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "practice_improve": query("practice_improve") ]);
    }
    if (member_array(
        parameters["collection_group"],
        ({ "gumu-movement", "mingjiao-movement", "mingjiao-ling-learning" })
    ) != -1)
        current["movement_room"] = ([ "no_fight": query("no_fight"),
            "practice_improve": query("practice_improve"),
            "research_improve": query("research_improve") ]);
    if (member_array(parameters["collection_group"],
        ({ "gumu-research", "mingjiao-jiuyang-research" })) != -1)
        current["research_room"] = ([ "no_fight": query("no_fight"),
            "pigging": query("pigging"), "research_improve": query("research_improve") ]);
    if (member_array(
        parameters["collection_group"],
        ({ "taohua-force", "mingjiao-xinfa", "mingjiao-shengong" })
    ) != -1) {
        current["movement_room"] = ([ "no_fight": query("no_fight"),
            "practice_improve": query("practice_improve"),
            "research_improve": query("research_improve") ]);
        if (current["method"] == "research")
            current["research_room"] = ([ "no_fight": query("no_fight"),
                "pigging": query("pigging"), "research_improve": query("research_improve") ]);
    }
    prepare_actor(0, parameters["actor"]);
    prepare_actor(1, parameters["target"]);
    if ((parameters["collection_group"] == "mingjiao-jiuyang-exert" ||
        is_mingjiao_remaining_perform()) && sizeof(players) == 3 &&
        !mapp(parameters["extra_target"]))
        require(players[2]->move("/tests/bystander_room"), "unused third USER outside roar room");
    if (is_npc_bout()) require(
        players[1]->move("/tests/bystander_room"),
        "natural bout bystander outside arena"
    );
    if (parameters["collection_group"] == "emei-jiuyin-learning") prepare_practice_materials(parameters);
    if (mapp(parameters["extra_target"])) {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-special",
                "shaolin-public-force",
                "gumu-exert"
                , "gumu-temporal"
                , "taohua-music"
                , "public-music"
                , "mingjiao-jiuyang-remaining"
                , "mingjiao-jiuyang-exert"
                , "mingjiao-remaining-perform"
                , "b30-perform"
            })) != -1 && sizeof(players) == 3,
            "configured third connected target");
        prepare_actor(2, parameters["extra_target"]);
        if (member_array(
            parameters["collection_group"],
            ({ "wudang-special", "gumu-temporal", "b30-perform" })
        ) != -1 || ((parameters["collection_group"] == "mingjiao-jiuyang-remaining" ||
            is_mingjiao_remaining_perform()) &&
            parameters["extra_target_fighting"])) {
            players[0]->kill_ob(players[2]);
            players[2]->kill_ob(players[0]);
            if (parameters["target_fighting_extra"]) {
                players[1]->kill_ob(players[2]);
                players[2]->kill_ob(players[1]);
            }
        }
        players[2]->observation_heartbeat(0);
        if (member_array(parameters["collection_group"],
            ({ "gumu-temporal", "mingjiao-jiuyang-remaining", "mingjiao-jiuyang-exert" })) == -1) {
            current["extra_target_before"] = snapshot(players[2]);
            players[2]->start_observation(2);
        }
    }
    if (parameters["fighting"] && !parameters["powerup_before_combat"] && !is_npc_bout()) {
        if (parameters["collection_group"] == "taohua-combo" && parameters["nonlethal"]) {
            players[0]->fight_ob(players[1]);
            players[1]->fight_ob(players[0]);
        } else {
            players[0]->kill_ob(players[1]);
            players[1]->kill_ob(players[0]);
        }
    }
    players[0]->observation_heartbeat(0);
    players[1]->observation_heartbeat(0);
    if (parameters["target_state"] == "unconscious") {
        require(member_array(
            parameters["collection_group"],
            ({
                "wudang-special",
                "wudang-shenmen",
                "shaolin-public-force",
                "emei-shexing",
                "gumu-defense",
                "quanzhen-defense",
                "s1-panlong-tan",
                "s1-duan-perform",
                "s1-piaoxu",
                "mingjiao-movement",
                "mingjiao-qkd",
                "mingjiao-jiuyang",
                "gumu-exert",
                "gumu-zhi",
                "gumu-quanzhen",
                "taohua-ding",
                "taohua-xiao",
                "taohua-po",
                "taohua-zhuan",
                "taohua-bihai",
                "taohua-music",
                "mingjiao-ling-perform",
                "mingjiao-shenghuo",
                "mingjiao-jiuyang-direct",
                "mingjiao-jiuyang-remaining",
                "mingjiao-jiuyang-exert",
                "mingjiao-remaining-perform"
            })
        ) != -1 &&
            (!parameters["fighting"] || member_array(parameters["collection_group"],
                ({
                    "s1-panlong-tan",
                    "s1-duan-perform",
                    "s1-piaoxu",
                    "gumu-zhi",
                    "gumu-quanzhen",
                    "taohua-ding",
                    "taohua-xiao",
                    "taohua-po",
                    "taohua-zhuan",
                    "taohua-bihai",
                    "mingjiao-ling-perform",
                    "mingjiao-shenghuo",
                    "mingjiao-jiuyang-direct",
                    "mingjiao-jiuyang-remaining",
                    "mingjiao-remaining-perform"
                })) != -1), "configured unconscious preparation");
        current["preparation"] = ([ "before": snapshot(players[1]) ]);
        players[1]->start_observation(1);
        players[1]->unconcious();
        players[1]->stop_observation();
        current["preparation"]["after"] = snapshot(players[1]);
        require(!living(players[1]) && !players[1]->is_ghost(), "original unconscious target");
        if (member_array(parameters["collection_group"],
            ({
                "s1-panlong-tan",
                "s1-duan-perform",
                "s1-piaoxu",
                "gumu-exert",
                "gumu-zhi",
                "gumu-quanzhen",
                "taohua-ding",
                "taohua-xiao",
                "taohua-po",
                "taohua-zhuan",
                "taohua-bihai",
                "taohua-music",
                "mingjiao-ling-perform",
                "mingjiao-shenghuo",
                "mingjiao-jiuyang-direct",
                "mingjiao-jiuyang-remaining",
                "mingjiao-jiuyang-exert",
                "mingjiao-remaining-perform"
            })) != -1) {
            current["preparation"]["terminals"] = copy(current["terminals"]);
            current["terminals"] = ({});
        }
    }
    if (parameters["collection_group"] == "wudang-lookup") prepare_lookup(parameters);
    if (parameters["teaching_profile"] == "gumu-item-acquisition") prepare_gumu_items(parameters);
    if (member_array(parameters["teaching_profile"],
        ({
            "gumu-teachers",
            "gumu-special",
            "gumu-acquisition-learning",
            "gumu-item-acquisition",
            "gumu-recruit"
        })) != -1) {
        gumu_teacher_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_teacher_pending &&
            objectp(gumu_teacher), "original Gumu teacher prepared through student command");
    }
    if (parameters["teaching_profile"] == "gumu-item-acquisition") finish_gumu_item_preparation(parameters);
    if (parameters["teaching_profile"] == "taohua-learning") prepare_taohua_learning(parameters);
    if (parameters["teaching_profile"] == "mingjiao-apprentice-learning")
        prepare_mingjiao_apprentice_learning(parameters);
    if (parameters["teaching_profile"] == "mingjiao-teachers") prepare_mingjiao_teachers(parameters);
    if (parameters["teaching_profile"] == "mingjiao-recruit") prepare_mingjiao_recruit(parameters);
    if (parameters["teaching_profile"] == "mingjiao-gift") prepare_mingjiao_gift(parameters);
    if (parameters["teaching_profile"] == "mingjiao-book") prepare_mingjiao_book(parameters);
    if (current["method"] == "music" && member_array(parameters["collection_group"],
        ({ "taohua-music", "public-music" })) != -1) prepare_taohua_music(parameters);
    current["before"] = ({ snapshot(players[0]), snapshot(players[1]) });
    if (is_mingjiao_remaining_base()) current["skill_messages"] = ({});
    if (is_mingjiao_remaining_perform()) {
        current["skill_messages"] = ({});
        current["enemy_context"] = ([ "before": map(players[0]->query_enemy(),
            (: member_array($1, players) :)) ]);
        observe_remaining_perform_flower("before");
    }
    if (parameters["collection_group"] == "mingjiao-jiuyang-exert") {
        current["skill_messages"] = ({});
        current["exert_room"] = ([ "no_fight": query("no_fight"), "skybook": query("skybook") ]);
        current["relation_context"] = ([ "before": jiuyang_exert_relations() ]);
        if (mapp(parameters["extra_target"])) current["extra_target_before"] = snapshot(players[2]);
    }
    if (member_array(parameters["collection_group"],
        ({ "mingjiao-jiuyang-learning", "mingjiao-jiuyang-capacity",
            "mingjiao-jiuyang-research" })) != -1)
        current["skill_messages"] = ({});
    if (member_array(parameters["collection_group"],
        ({ "mingjiao-jiuyang-direct", "mingjiao-jiuyang-remaining" })) != -1)
        current["skill_messages"] = ({});
    if (parameters["collection_group"] == "mingjiao-ling-perform") {
        current["skill_messages"] = ({});
        if (parameters["ability"] == "xi") {
            ling_target_weapon = players[1]->query_temp("weapon");
            current["ling_equipment"] = ([ "target_weapon": ([]) ]);
            observe_ling_weapon("before");
        }
    }
    if (parameters["collection_group"] == "mingjiao-shenghuo") current["skill_messages"] = ({});
    if (member_array(parameters["collection_group"],
        ({ "mingjiao-movement", "mingjiao-qkd", "mingjiao-jiuyang" })) != -1) {
        // Isolate the combat daemon's message buffer, not the skill's result or random path.
        COMBAT_D->clear_bhinfo();
        current["bhinfo"] = ([ "before": serializable(COMBAT_D->query_bhinfo()) ]);
    }
    if (parameters["collection_group"] == "mingjiao-qkd")
        current["qkd_queue"] = ([ "before": qkd_queue_point() ]);
    if (current["parameters"]["teaching_profile"] == "taohua-learning" &&
        sizeof(current["learning_preparations"] || ({})))
        current["learning_preparations"][0]["after"] = current["before"][0];
    if (is_taohua_zhuan()) {
        taohua_zhuan_target_weapon = players[1]->query_temp("weapon");
        taohua_zhuan_before = taohua_zhuan_death_before(players[1], players[0]);
    }
    if (is_taohua_po()) {
        needle_object = players[0]->query_temp("handing");
        taohua_po_target_weapon = players[1]->query_temp("weapon");
        current["po_equipment"] = ([
            "actor_room": file_name(environment(players[0])),
            "target_room": file_name(environment(players[1])), "target_weapon": ([]) ]);
        observe_taohua_po_weapon("before");
    }
    players[0]->start_observation(0);
    players[1]->start_observation(1);
    if (parameters["collection_group"] == "mingjiao-jiuyang-exert" && mapp(parameters["extra_target"]))
        players[2]->start_observation(2);
    if (parameters["collection_group"] == "mingjiao-jiuyang-remaining") {
        current["enemy_context"] = ([ "before": map(players[0]->query_enemy(),
            (: member_array($1, players) :)) ]);
        if (mapp(parameters["extra_target"])) {
            current["extra_target_before"] = snapshot(players[2]);
            players[2]->start_observation(2);
        }
    }
    if (parameters["collection_group"] == "gumu-temporal" && mapp(parameters["extra_target"])) {
        current["extra_target_before"] = snapshot(players[2]);
        players[2]->start_observation(2);
    }
    started = time_ns() / 1000000000.0;
    if (mapp(fault) && fault["condition_id"] == current["condition_id"] && fault["index"] == current["index"]) {
        current["injected_fault"] = fault["stage"];
        if (fault["stage"] == "action") {
            players[0]->set_temp("fixture_fault_poison", 1);
            error("Injected collection action failure.\n");
        }
        if (fault["stage"] == "callback") call_out("injected_callback_error", 1);
    }
    if (parameters["not_applicable"] != "") {
        current["outcome"] = "not_applicable";
        current["reason"] = parameters["not_applicable"];
        return;
    }
    action = parameters["action"];
    if (is_mingjiao_force_remaining()) {
        perform_force_remaining(parameters);
        return;
    }
    if (parameters["collection_group"] == "mingjiao-jiuyang-exert") {
        perform_jiuyang_exert_steps(parameters);
        return;
    }
    if (current["method"] == "music" && member_array(parameters["collection_group"],
        ({ "taohua-music", "public-music" })) != -1) {
        perform_taohua_music_steps(parameters);
        return;
    }
    if (is_npc_bout()) {
        require(
            environment(players[1]) != this_object(),
            "natural bout bystander remains outside arena"
        );
        gumu_npc_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_npc_pending && objectp(gumu_npc),
            "original natural NPC created by real USER command");
        gumu_npc->kill_ob(players[0]);
        players[0]->kill_ob(gumu_npc);
        players[0]->observation_heartbeat(0);
        evaluate(bind((: set_heart_beat, 0 :), gumu_npc));
        initialize_npc_bout();
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "gumu-npc") {
        require(current["method"] == "npc", "original Gumu NPC method");
        gumu_npc_pending = 1;
        require(players[0]->force_me("test_interface") && !gumu_npc_pending &&
            mapp(current["npc_observation"]), "original NPC observed through player command");
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "taohua-npc") {
        require(current["method"] == "npc", "original taohua NPC method");
        taohua_npc_pending = 1;
        require(players[0]->force_me("test_interface") && !taohua_npc_pending &&
            mapp(current["npc_observation"]), "original taohua NPC observed through player command");
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "gumu-temporal" && parameters["temporal_kind"] == "tuo-cooldown") {
        perform_gumu_temporal("initial");
        current["command_accepted"] = current["temporal_steps"][0]["accepted"];
        require(current["command_accepted"] && sizeof(current["launches"]) == 1,
            "original cooldown sequence first command launched");
        current["outcome"] = "observed";
        return;
    }
    if (parameters["collection_group"] == "emei-npc") {
        require(current["method"] == "npc", "original NPC method");
        current["npc_observation"] = "/tests/npc_observer"->observe(
            parameters["npc"],
            players[0]
        );
        current["outcome"] = "observed";
        return;
    }
    if (parameters["powerup_before_combat"]) {
        require(parameters["collection_group"] == "emei-zhao" &&
            action == "perform strike.zhao", "reviewed original powerup prelude");
        step = ([ "action": "exert powerup", "before": current["before"],
            "launches_before": sizeof(current["launches"]) ]);
        step["accepted"] = players[0]->force_me("exert powerup");
        step["launches_after"] = sizeof(current["launches"]);
        step["reason"] = !step["accepted"] && sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "";
        if (!step["accepted"] && step["reason"] == "") {
            reason = players[0]->query_temp("notify_fail");
            step["reason"] = stringp(reason) && reason != "" ? reason : "原强化命令未受理";
        }
        step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        current["powerup"] = step;
        current["action_attempted"] = step["accepted"] ? 1 : 0;
        if (!step["accepted"]) {
            current["command_accepted"] = 0;
            current["outcome"] = "refused";
            current["reason"] = step["reason"];
            return;
        }
        if (parameters["fighting"]) {
            players[0]->kill_ob(players[1]);
            players[1]->kill_ob(players[0]);
            players[0]->observation_heartbeat(0);
            players[1]->observation_heartbeat(0);
        }
    }
    if (arrayp(parameters["prepare_commands"])) {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-combination",
                "shaolin-combination",
                "emei-combination",
                "gumu-combination",
                "quanzhen-combination",
                "huashan-combination",
                "slice-combination",
                "taohua-combination"
                , "mingjiao-combination"
            })) != -1 &&
            member_array(current["method"], ({ "prepare", "round" })) != -1,
            "configured original prepare sequence");
        current["prepare_steps"] = ({});
        launches = 0;
        foreach (expectation in parameters["prepare_commands"]) {
            action = expectation["action"];
            require(stringp(action) && strsrch(action, "prepare ") == 0,
                "original prepare command only");
            step = ([ "action": action, "before": snapshot(players[0]) ]);
            result = players[0]->force_me(action);
            reason = query_notify_fail();
            step["accepted"] = result;
            step["reason"] = result ? "" : stringp(reason) && reason != "" ? reason : "原准备命令未受理";
            step["after"] = snapshot(players[0]);
            current["prepare_steps"] += ({ step });
            if (result) launches++;
        }
        current["outcome"] = launches ? "observed" : "refused";
        if (current["method"] == "round") {
            COMBAT_D->fight(players[0], players[1]);
            current["outcome"] = "observed";
        } else if (!launches) current["reason"] = "原准备命令均未受理";
        return;
    }
    if (arrayp(parameters["buff_steps"])) {
        require(member_array(
            parameters["collection_group"],
            ({ "wudang-buffs", "shaolin-buffs", "emei-buffs", "gumu-buffs" })
        ) != -1 && !parameters["fighting"] &&
            sizeof(parameters["buff_steps"]) <= 6, "reviewed public buff sequence");
        current["buff_steps"] = ({});
        foreach (expectation in parameters["buff_steps"]) {
            step = ([ "operation": copy(expectation), "before": snapshot(players[0]) ]);
            if (!undefinedp(expectation["refill_neili"])) {
                require(member_array(expectation["refill_neili"], ({ 6000, 8000 })) != -1,
                    "explicit experimental refill");
                players[0]->set("neili", expectation["refill_neili"]);
            } else {
                action = expectation["command"];
                require(member_array(action, ({ "exert power", "exert tianmo" })) != -1,
                    "original public buff command");
                step["launches_before"] = sizeof(current["launches"]);
                step["refusals_before"] = sizeof(current["refusals"]);
                step["accepted"] = players[0]->force_me(action);
                step["launches_after"] = sizeof(current["launches"]);
                step["refusals_after"] = sizeof(current["refusals"]);
                step["reason"] = !step["accepted"] && step["refusals_after"] > step["refusals_before"] ? current["refusals"][<1]["reason"] : "";
            }
            step["after"] = snapshot(players[0]);
            current["buff_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        current["command_accepted"] = sizeof(current["launches"]) > 0;
        if (current["outcome"] == "refused") current["reason"] = current["buff_steps"][<1]["reason"];
        if (parameters["persistence_probe"]) {
            require(players[0]->observation_save_state(), "save isolated buff probe");
            saved_state = read_file("/data/buff_snapshot.o");
            restored_actor = new("/tests/actor");
            current["persistence"] = ([ "before": snapshot(restored_actor),
                "characters": strlen(saved_state), "sha256": hash("sha256", saved_state) ]);
            current["persistence"]["restored"] = restored_actor->observation_restore_state();
            restored_actor->stop_observation();
            current["persistence"]["after"] = snapshot(restored_actor);
            destruct(restored_actor);
        }
        return;
    }
    if (arrayp(parameters["repeat_actions"])) {
        require(member_array(
            parameters["collection_group"],
            ({ "wudang-special", "shaolin-exert", "emei-exert", "emei-jiuyin-buff", "gumu-exert",
                "taohua-force", "mingjiao-xinfa", "mingjiao-shengong" })
        ) != -1 && !parameters["fighting"] &&
            sizeof(parameters["repeat_actions"]) <= 4, "configured repeated exert sequence");
        current["repeat_steps"] = ({});
        foreach (action in parameters["repeat_actions"]) {
            require(member_array(action, parameters["collection_group"] == "gumu-exert" ?
                ({ "exert powerup" }) : parameters["collection_group"] == "shaolin-exert" ?
                ({
                    "exert powerup",
                    "exert tong"
                }) : parameters["collection_group"] == "emei-jiuyin-buff" ?
                ({
                    "exert powerup",
                    "exert shield",
                    "perform dodge.guiyuan"
                }) : ({ "exert powerup", "exert shield" })) != -1,
                "reviewed exert command");
            step = ([ "action": action, "before": snapshot(players[0]),
                "launches_before": sizeof(current["launches"]),
                "refusals_before": sizeof(current["refusals"]) ]);
            step["accepted"] = players[0]->force_me(action);
            step["after"] = snapshot(players[0]);
            step["launches_after"] = sizeof(current["launches"]);
            step["metrics"] = players[0]->query_observation();
            step["refusals_after"] = sizeof(current["refusals"]);
            step["reason"] = !step["accepted"] && step["refusals_after"] > step["refusals_before"] ? current["refusals"][<1]["reason"] : "";
            current["repeat_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        current["command_accepted"] = sizeof(current["launches"]) > 0;
        return;
    }
    if (current["method"] == "upgrade" &&
        member_array(
            parameters["collection_group"],
            ({ "quanzhen-study", "wudang-study", "gumu-research" })
        ) != -1) {
        grant = parameters["skill"];
        require(parameters["cycles"] == 1 && action == "research " + grant + " 1" &&
            parameters["primer"]["skill"] == grant && parameters["primer"]["amount"] == 10000000 &&
            parameters["primer"]["weak_mode"] == 1, "configured original research upgrade route");
        step = ([ "before": snapshot(players[0]), "action": action,
            "implemented_by": function_exists(
                "skill_improved",
                load_object("/kungfu/skill/" + grant)
            ) ]);
        players[0]->improve_skill(grant, 10000000, 1);
        step["primed"] = snapshot(players[0]);
        step["accepted"] = players[0]->force_me(action);
        step["after"] = snapshot(players[0]);
        current["upgrades"] = ({ step });
        current["outcome"] = step["after"]["skills"][grant] > step["before"]["skills"][grant] ? "observed" : "refused";
        if (current["outcome"] == "refused") current["reason"] = "原研究未触发升级，详见前后快照";
        return;
    }
    if (current["method"] == "upgrade") {
        require(parameters["collection_group"] == "huashan-upgrade" &&
            member_array(action, ({ "improve", "weak", "perform sword.jue" })) != -1,
            "configured original upgrade route");
        require(parameters["cycles"] >= 1 && parameters["cycles"] <= 2,
            "configured upgrade observations");
        current["upgrades"] = ({});
        for (cycle = 0; cycle < parameters["cycles"]; cycle++) {
            step = ([ "before": snapshot(players[0]) ]);
            // Prime progress through the original weak-mode API, never edit
            // learned[] or invoke the skill callback directly. Record the setup.
            players[0]->improve_skill("dugu-jiujian", 10000000, 1);
            step["primed"] = snapshot(players[0]);
            step["action"] = action;
            if (action == "perform sword.jue")
                step["accepted"] = players[0]->force_me(action);
            else
                players[0]->improve_skill("dugu-jiujian", 0, action == "weak");
            step["after"] = snapshot(players[0]);
            current["upgrades"] += ({ step });
        }
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "scene") {
        if (parameters["collection_group"] == "miao-study") {
            require(parameters["room"] == "/d/zhongzhou/miaojia_shufang" &&
                member_array(
                    action,
                    ({ "canwu shu", "canwu wall", "canwu tu", "think tu", "think shu" })
                ) != -1,
                "finite original Miao room command");
            players[0]->enable_player();
            step = ([
                "room_before": base_name(environment(players[0])),
                "before": snapshot(players[0])
            ]);
            step["move_result"] = players[0]->move("/d/zhongzhou/miaojia_shufang");
            require(step["move_result"], "initial original Miao study position");
            step["room_after"] = base_name(environment(players[0]));
            step["after"] = snapshot(players[0]);
            current["study_setup"] = step;
            ob = environment(players[0]);
            grant = parameters["ability"] == "canwu" ? "do_canwu" : "do_think";
            step = ([ "command": action, "room": base_name(ob),
                "function_owner": function_exists(grant, ob), "before": snapshot(players[0]) ]);
            players[0]->begin_teaching_messages();
            result = players[0]->force_me(action);
            step["messages"] = players[0]->end_teaching_messages();
            step["accepted"] = result;
            step["after"] = snapshot(players[0]);
            reason = players[0]->query_temp("notify_fail");
            if (!result) require(
                stringp(reason) && reason != "",
                "actual original Miao study refusal"
            );
            step["reason"] = result ? "" : reason;
            current["study_step"] = step;
            current["command_accepted"] = result;
            current["reason"] = step["reason"];
            current["outcome"] = result ? "observed" : "refused";
            return;
        }
        if (parameters["collection_group"] == "mingjiao-route") {
            begin_mingjiao_route(parameters);
            return;
        }
        require(parameters["collection_group"] == "shaolin-fumo", "reviewed scene only");
        players[0]->enable_player();
        if (parameters["gifts"])
            require(
                players[0]->id(players[0]->query("id")),
                "gift recipient discoverable by original ID"
            );
        "/tests/scene_observer"->reset_sample();
        if (mapp(parameters["guardian_state"]))
            current["scene_setup"] = "/tests/scene_observer"->prepare_guardian(parameters["guardian_state"]);
        require(players[0]->move("/d/shaolin/qyping"), "initial scene position");
        current["scene_steps"] = ({});
        current["scene_attacks"] = ({});
        current["scene_step"] = 0;
        if (parameters["lifecycle"]) current["scene_lifecycle"] = ({});
        players[0]->begin_teaching_messages();
        if (parameters["companion"]) {
            players[1]->enable_player();
            require(
                players[1]->id(players[1]->query("id")),
                "companion discoverable by original ID"
            );
            require(players[1]->move("/d/shaolin/qyping"), "companion initial scene position");
            step = ([
                "command": "go in",
                "before": "/tests/scene_observer"->observe(players[1])
            ]);
            step["accepted"] = players[1]->force_me("go in");
            step["after"] = "/tests/scene_observer"->observe(players[1]);
            current["scene_companion_entry"] = step;
        }
        foreach (action in parameters["scene_steps"]) {
            require(member_array(action, ({ "in", "out" })) != -1, "reviewed original route");
            step = ([ "command": "go " + action,
                "before": "/tests/scene_observer"->observe(players[0]) ]);
            step["accepted"] = players[0]->force_me("go " + action);
            step["after"] = "/tests/scene_observer"->observe(players[0]);
            current["scene_steps"] += ({ step });
            current["scene_step"]++;
        }
        if (parameters["gifts"]) {
            current["scene_interactions"] = ({});
            foreach (step in parameters["gift_commands"]) {
                action = step["command"];
                participant = step["side"] || 0;
                require(participant == 0 || (participant == 1 && parameters["companion"]),
                    "configured gift participant");
                require(member_array(
                    explode(action, " ")[0],
                    ({ "ask", "give", "drop", "get" })
                ) != -1,
                    "reviewed original gift command");
                step = ([ "command": action,
                    "before": "/tests/scene_observer"->observe_gifts(
                        players[0],
                        parameters["companion"] ? players[1] : 0
                    ) ]);
                if (parameters["companion"]) step["side"] = participant;
                step["accepted"] = players[participant]->force_me(action);
                step["after"] = "/tests/scene_observer"->observe_gifts(
                    players[0],
                    parameters["companion"] ? players[1] : 0
                );
                current["scene_interactions"] += ({ step });
            }
        }
        if (parameters["lifecycle"] && parameters["observe_seconds"] > 0)
            players[0]->observation_heartbeat(1);
        else current["scene_messages"] = players[0]->end_teaching_messages();
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "teaching") {
        if (member_array(parameters["teaching_profile"],
            ({
                "taohua-learning",
                "mingjiao-apprentice-learning",
                "mingjiao-teachers",
                "mingjiao-recruit", "mingjiao-gift", "mingjiao-book"
            })) != -1) {
            current["teaching"] = ({});
            current["outcome"] = "refused";
            foreach (expectation in parameters["teaching_expectations"]) {
                key = expectation["teacher_key"];
                if (key == "assigned") {
                    teacher = 0;
                    foreach (t in values(taohua_learning_teachers))
                        if (t->query("name") == players[0]->query_temp("taohua/master")) teacher = t;
                    require(objectp(teacher), "assignment resolves a prepared teacher");
                } else if (stringp(key)) {
                    teacher = taohua_learning_teachers[key];
                    require(objectp(teacher), "prepared original teacher");
                } else teacher = 0;
                if (!stringp(expectation["action"])) {
                    require(expectation["teacher_key"] == "assigned" && objectp(teacher),
                        "assigned step builds the original apprentice command");
                    action = "apprentice " + teacher->query("id");
                } else action = expectation["action"];
                step = "/tests/teaching_observer"->observe_command(players[0], teacher, action,
                    parameters["monitored_grants"], 0, 0, 0, 0, 0,
                    parameters["teaching_profile"], parameters["teaching_profile"] == "mingjiao-gift" ? mingjiao_gift_context : 0,
                    ([ "book_context": parameters["teaching_profile"] == "mingjiao-book" ? mingjiao_book_context : taohua_book_context,
                        "book_path": stringp(expectation["book"]) &&
                        expectation["command_kind"] == "study" ?
                        (parameters["teaching_profile"] == "mingjiao-book" ? "/clone/book/qiankun_book" :
                            "/clone/lonely/book/" + expectation["book"]) : 0 ]));
                current["teaching"] += ({ step });
                if (parameters["teaching_profile"] == "mingjiao-apprentice-learning") {
                    // Successful prerequisite recruitment is not a successful tested learn.
                    if (parameters["teaching_kind"] == "ordinary-learning") {
                        if (expectation["command_kind"] == "learn" &&
                            (step["after"]["skills"]["shenghuo-ling"] > step["before"]["skills"]["shenghuo-ling"] ||
                                step["after"]["learned"]["shenghuo-ling"] > step["before"]["learned"]["shenghuo-ling"]))
                            current["outcome"] = "observed";
                    } else if (step["after"]["recruitment"]["family"]["master_id"] == "zhang wuji" &&
                        step["before"]["recruitment"]["family"]["master_id"] != "zhang wuji")
                        current["outcome"] = "observed";
                } else if (parameters["teaching_profile"] == "mingjiao-recruit") {
                    if (step["after"]["recruitment"]["family"]["master_id"] == parameters["teacher"]["id"] &&
                        step["after"]["recruitment"]["family"]["master_name"] == parameters["teacher"]["name"] &&
                        (step["before"]["recruitment"]["family"]["master_id"] != parameters["teacher"]["id"] ||
                            step["before"]["recruitment"]["family"]["master_name"] != parameters["teacher"]["name"]))
                        current["outcome"] = "observed";
                } else if (parameters["teaching_profile"] == "mingjiao-gift") {
                    if (step["item_before"]["items"][0]["environment"] != step["item_after"]["items"][0]["environment"])
                        current["outcome"] = "observed";
                } else if (parameters["teaching_profile"] == "mingjiao-book") {
                    key = "qiankun-danuoyi";
                    if (step["after"]["skills"][key] > step["before"]["skills"][key] ||
                        step["after"]["learned"][key] > step["before"]["learned"][key] ||
                        step["item_before"]["items"][0]["exists"] != step["item_after"]["items"][0]["exists"] ||
                        step["item_before"]["items"][0]["environment"] != step["item_after"]["items"][0]["environment"])
                        current["outcome"] = "observed";
                } else if (parameters["teaching_profile"] == "mingjiao-teachers") {
                    key = parameters["skill"];
                    if (step["after"]["skills"][key] > step["before"]["skills"][key] ||
                        step["after"]["learned"][key] > step["before"]["learned"][key])
                        current["outcome"] = "observed";
                } else if (taohua_learning_advanced(step)) current["outcome"] = "observed";
            }
            if (current["outcome"] == "refused" && parameters["teaching_profile"] == "mingjiao-gift")
                current["reason"] = "原询问未交付物品，详见逐步归属及消息";
            else if (current["outcome"] == "refused")
                current["reason"] = member_array(parameters["teaching_kind"],
                    ({
                        "recruit",
                        "apprenticeship"
                    })) != -1 ? "原命令未建立新师承，详见逐步状态及消息" : "原教学未增加领悟或学习进度，详见逐步状态及消息";
            return;
        }
        if (parameters["teaching_profile"] == "shaolin-challenge") {
            start_challenge(parameters);
            return;
        }
        if (parameters["teaching_profile"] == "shaolin-promotion") {
            current["teaching"] = ({});
            current["outcome"] = "refused";
            promotion_teacher = 0;
            promotion_index = promotion_waiting = 0;
            advance_promotion();
            return;
        }
        if (parameters["teaching_profile"] == "shaolin-formation")
            "/tests/formation_observer"->reset_sample();
        if (member_array(parameters["teaching_profile"],
            ({
                "gumu-teachers",
                "gumu-special",
                "gumu-acquisition-learning",
                "gumu-item-acquisition",
                "gumu-recruit"
            })) != -1) {
            teacher = gumu_teacher;
            require(objectp(teacher) && base_name(teacher) == parameters["teacher"]["path"] &&
                teacher->query("id") == parameters["teacher"]["id"] &&
                environment(teacher) == this_object(), "reuse exact original prepared teacher");
        } else {
            teacher = new(parameters["teacher"]["path"]);
            require(teacher->move(this_object()), "teacher in observation room");
        }
        current["teaching"] = ({});
        current["outcome"] = "refused";
        foreach (expectation in parameters["teaching_expectations"]) {
            // Only an explicitly source-pinned follow-up may change teacher.
            // Keep the same connected student and all original state.
            if (mapp(expectation["teacher"]) &&
                base_name(teacher) != expectation["teacher"]["path"]) {
                teacher = new(expectation["teacher"]["path"]);
                require(teacher->move(this_object()), "follow-up teacher in observation room");
            }
            step = "/tests/teaching_observer"->observe_command(players[0], teacher,
                expectation["action"] || action, parameters["monitored_grants"], expectation["offer"],
                parameters["tracked_item"], 0, parameters["tonsure_name"], parameters["formation"],
                parameters["teaching_profile"], gumu_item_context);
            current["teaching"] += ({ step });
            if (parameters["teaching_profile"] == "gumu-item-acquisition") {
                gumu_item_owned += "/tests/teaching_observer"->gumu_item_objects(gumu_item_context);
                if (step["item_after"]["stock"] < step["item_before"]["stock"] ||
                    (parameters["lesson"] == "yinsuo" &&
                        step["item_before"]["items"][0]["environment"] == file_name(teacher) &&
                        step["item_after"]["items"][0]["environment"] != file_name(teacher)))
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_profile"] == "shaolin-formation") {
                formation_teacher = teacher;
                formation_started = time_ns() / 1000000000.0;
                if (step["after"]["formation"]["requested"] > step["before"]["formation"]["requested"])
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_kind"] == "ordination" &&
                (step["after"]["tonsure"]["pending"] > step["before"]["tonsure"]["pending"] ||
                    (step["before"]["tonsure"]["recruitment"]["class"] != "bonze" &&
                        step["after"]["tonsure"]["recruitment"]["class"] == "bonze")))
                current["outcome"] = "observed";
            if (parameters["teaching_kind"] == "apprenticeship" &&
                step["after"]["master_id"] == parameters["teacher"]["id"] &&
                (step["before"]["master_id"] != step["after"]["master_id"] ||
                    step["before"]["master_name"] != step["after"]["master_name"]))
                current["outcome"] = "observed";
            if (parameters["teaching_kind"] == "letter_teaching" &&
                step["item_before"]["holder"] != file_name(players[0]) &&
                step["item_after"]["holder"] == file_name(players[0]))
                current["outcome"] = "observed";
            foreach (grant in parameters["monitored_grants"]) {
                if (arrayp(step["after"]["grants"][grant])) {
                    if (sizeof(step["after"]["grants"][grant] -
                        (step["before"]["grants"][grant] || ({}))))
                        current["outcome"] = "observed";
                } else if (step["after"]["grants"][grant] > step["before"]["grants"][grant])
                    current["outcome"] = "observed";
            }
            if (parameters["teaching_kind"] == "ordinary_learning" ||
                parameters["teaching_profile"] == "gumu-acquisition-learning") {
                foreach (grant in keys(step["after"]["skills"]))
                    if (step["after"]["skills"][grant] > step["before"]["skills"][grant])
                        current["outcome"] = "observed";
                foreach (grant in keys(step["after"]["learned"]))
                    if (step["after"]["learned"][grant] > step["before"]["learned"][grant])
                        current["outcome"] = "observed";
            }
        }
        if (current["outcome"] == "refused") current["reason"] = parameters["teaching_kind"] == "apprenticeship" ? "原命令未建立新师承，详见逐步状态及消息" : "原教学未增加领悟或学习进度，详见逐步状态及消息";
        return;
    }
    if (current["method"] == "team") {
        set("exits", ([ "east": "/tests/team_room" ]));
        current["team_steps"] = ({});
        foreach (expectation in parameters["steps"]) {
            launches = sizeof(current["launches"]);
            step = "/tests/team_observer"->observe_command(players, expectation);
            step["launches_before"] = launches;
            step["launches_after"] = sizeof(current["launches"]);
            current["team_steps"] += ({ step });
        }
        current["outcome"] = sizeof(current["launches"]) ? "observed" : "refused";
        if (current["outcome"] == "refused")
            current["reason"] = sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "原组阵命令未发动刀阵，详见逐步记录";
        return;
    }
    if (parameters["collection_group"] == "gumu-needle-lifecycle") {
        require(parameters["seed_mode"] == "original_perform" && parameters["seed_side"] == 0 &&
            parameters["stop_combat_after_seed"] && action == parameters["seed_action"],
            "reviewed original needle seed");
        launches = sizeof(current["launches"]);
        current["command_accepted"] = players[0]->force_me(action);
        require(sizeof(current["launches"]) == launches + 1, "original needle seed launched");
        current["outcome"] = "observed";
        return;
    }
    if (is_mingjiao_remaining_base() && current["method"] == "condition") {
        expectation = parameters["requirements"];
        require(expectation["seed_attempts"] == 1 && expectation["seed_side"] == 0 &&
            expectation["victim_side"] == 1 && expectation["heartbeat_side"] == 1 &&
            expectation["stop_combat_after_seed"] && !expectation["preset_condition"] &&
            expectation["watchdog_seconds"] == 600 && member_array(expectation["condition_name"],
                ({ "ice_poison", "yinfeng_dao", "tougu_zhen" })) != -1,
            "one original ordinary poison seed and unaccelerated victim lifecycle");
        current["ordinary_step"] = ([ "actor": 0, "target": 1, "type": TYPE_REGULAR,
            "caller_side": member_array(this_player(), players) ]);
        result = COMBAT_D->do_attack(
            players[0],
            players[1],
            players[0]->query_temp("weapon"),
            TYPE_REGULAR
        );
        current["ordinary_step"]["result"] = serializable(result);
        reason = players[1]->query_condition(expectation["condition_name"]);
        foreach (ob in players[0..1]) {
            ob->remove_all_killer();
            ob->remove_all_enemy(1);
        }
        current["condition_seed"] = ([ "condition_name": expectation["condition_name"],
            "state": serializable(reason), "seeded": mapp(reason),
            "combat_stopped_after_seed": ({
                !players[0]->is_fighting(),
                !players[1]->is_fighting()
            }),
            "enemy_counts": ({
                sizeof(players[0]->query_enemy()),
                sizeof(players[1]->query_enemy())
            }),
            "killer_counts": ({
                sizeof(players[0]->query_killer()),
                sizeof(players[1]->query_killer())
            }),
            "elapsed": time_ns() / 1000000000.0 - started ]);
        require(!sizeof(players[0]->query_enemy()) && !sizeof(players[1]->query_enemy()) &&
            !sizeof(players[0]->query_killer()) && !sizeof(players[1]->query_killer()),
            "original seed combat stopped without condition edits");
        current["condition_terminal"] = mapp(reason) ? "waiting" : "no_seed";
        current["condition_lifecycle_complete"] = 0;
        current["outcome"] = "observed";
        return;
    }
    if (current["method"] == "condition") {
        require(member_array(parameters["collection_group"],
            ({
                "wudang-condition",
                "emei-jiuyin-passive",
                "gumu-poison", "s1-dusha-lifecycle"
            })) != -1, "condition experiment");
        if (parameters["collection_group"] == "s1-dusha-lifecycle") {
            require(parameters["seed_mode"] == "original_hit_ob" &&
                parameters["seed_side"] == 1 && parameters["condition_name"] == "sha_poison" &&
                member_array(parameters["seed_incoming"], ({ 0, 100 })) != -1 &&
                member_array(parameters["ticks"], ({ 0, 1, 2 })) != -1,
                "finite original Dusha callback seed");
            ob = load_object("/kungfu/skill/dusha-zhang");
            step = ([ "object": "/kungfu/skill/dusha-zhang", "function": "hit_ob",
                "function_owner": function_exists("hit_ob", ob), "actor": 1, "target": 0,
                "incoming": parameters["seed_incoming"], "factor": 0,
                "before": ({ snapshot(players[0]), snapshot(players[1]) }) ]);
            result = ob->hit_ob(players[1], players[0], parameters["seed_incoming"], 0);
            observe_passive(players[1], players[0], "dusha-zhang",
                parameters["seed_incoming"], 0, result, "interface");
            reason = players[0]->query_condition("sha_poison");
            step += ([ "result": serializable(result), "state": serializable(reason),
                "seeded": mapp(reason), "after": ({
                    snapshot(players[0]),
                    snapshot(players[1])
                }) ]);
            current["condition_seed"] = step;
            current["condition_lifecycle_complete"] = 0;
            current["condition_terminal"] = mapp(reason) ? "waiting" : "no_seed";
            require((parameters["ticks"] > 0) == mapp(reason), "declared Dusha seed boundary");
        }
        if (parameters["collection_group"] == "emei-jiuyin-passive" && parameters["seed_by_hit"]) {
            // This lifecycle reverses the roles: actor 0 receives the original palm passive.
            result = "/kungfu/skill/cuixin-zhang"->hit_ob(players[1], players[0], 100, 0);
            observe_passive(
                players[1],
                players[0],
                "cuixin-zhang",
                100,
                0,
                result,
                "interface"
            );
        }
        if (parameters["collection_group"] == "gumu-poison" &&
            parameters["seed_mode"] == "original_perform") {
            require(parameters["seed_side"] == 1 && parameters["seed_action"] == "perform strike.shi" &&
                parameters["stop_combat_after_seed"], "reviewed original poison seed");
            launches = sizeof(current["launches"]);
            current["command_accepted"] = players[1]->force_me(parameters["seed_action"]);
            require(
                sizeof(current["launches"]) == launches + 1,
                "original poison seed launched"
            );
            require(players[0]->query("special_skill/piyi") ||
                mapp(players[0]->query_condition("wudu_shenzhang")), "original poison applied");
            foreach (ob in players) {
                ob->remove_all_killer();
                ob->remove_all_enemy(1);
            }
            current["combat_stopped_after_seed"] = ({
                !players[0]->is_fighting(),
                !players[1]->is_fighting()
            });
            require(current["combat_stopped_after_seed"][0] &&
                current["combat_stopped_after_seed"][1], "isolated poison without combat");
        }
        current["outcome"] = "observed";
        if (parameters["ticks"] > 0) players[0]->observation_heartbeat(1);
        return;
    }
    if (current["method"] == "bout") {
        current["outcome"] = "observed";
        current["first"] = current["index"] % 2;
        current["first_actor"] = -1;
        current["second_started"] = 0;
        observed = started;
        busy_seconds = ({ 0.0, 0.0 });
        busy_state = ({ 0, 0 });
        players[current["first"]]->observation_heartbeat(1);
        return;
    }
    if (parameters["collection_group"] == "mingjiao-jiuyang-learning" &&
        current["method"] == "interface") {
        require(action == "test_interface" &&
            member_array(parameters["interface_repetitions"], ({ 1, 2 })) != -1,
            "finite Jiuyang original interface repetitions");
        current["command_accepted"] = 0;
        for (launches = 0; launches < parameters["interface_repetitions"]; launches++) {
            result = players[0]->force_me(action);
            require(result > 0 && sizeof(current["interfaces"]) == launches + 1,
                "one original Jiuyang interface per USER command");
            current["command_accepted"] += result;
        }
        foreach (step in current["interfaces"])
            if (step["result"]) {
                current["outcome"] = "observed";
                current["reason"] = "";
            }
        return;
    }
    if (is_jiuyang_fusion()) {
        perform_jiuyang_fusion();
        return;
    }
    if (parameters["collection_group"] == "mingjiao-jiuyang-research") {
        require(current["method"] == "research" && arrayp(parameters["actions"]) &&
            sizeof(parameters["actions"]) > 0 && sizeof(parameters["actions"]) <= 2 &&
            parameters["observe_seconds"] == 0, "finite original Jiuyang research commands");
        require(userp(players[0]) && playerp(players[0]) && interactive(players[0]) &&
            living(players[0]) && !wizardp(players[0]) &&
            function_exists("force_me", players[0]) == "/feature/command" &&
            players[0]->find_command("research") == "/cmds/skill/research.c",
            "original research through the real USER command owner");
        current["research_steps"] = ({});
        current["command_accepted"] = 0;
        foreach (action in parameters["actions"]) {
            require(member_array(action, ({ "research jiuyang-shengong 0",
                "research jiuyang-shengong 1", "research jiuyang-shengong 3",
                "research jiuyang-shengong 101" })) != -1, "reviewed original research action");
            launches = sizeof(current["skill_messages"]);
            step = ([ "action": action, "entry_actor": file_name(players[0]),
                "before": ({ snapshot(players[0]), snapshot(players[1]) }),
                "metrics_before": ({ players[0]->query_observation(),
                    players[1]->query_observation() }) ]);
            step["wall_time_before"] = time();
            result = players[0]->force_me(action);
            step["wall_time_after"] = time();
            require(intp(result) && result >= 0 && objectp(players[0]) &&
                userp(players[0]) && playerp(players[0]) && interactive(players[0]) &&
                living(players[0]) && !wizardp(players[0]), "original research returned to same USER");
            step["return_actor"] = file_name(players[0]);
            require(
                step["return_actor"] == step["entry_actor"],
                "research USER identity preserved"
            );
            step["accepted"] = result;
            step["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
            step["metrics_after"] = ({ players[0]->query_observation(),
                players[1]->query_observation() });
            step["messages"] = sizeof(current["skill_messages"]) > launches ? current["skill_messages"][launches..] : ({});
            reason = players[0]->query_temp("notify_fail");
            require(result || (stringp(reason) && reason != ""), "actual research refusal reason");
            step["reason"] = result ? "" : reason;
            current["research_steps"] += ({ step });
            current["command_accepted"] += result;
        }
        current["outcome"] = players[0]->query("learned_points") > current["before"][0]["learned_points"] ? "observed" : "refused";
        if (current["outcome"] == "refused") {
            reason = players[0]->query_temp("notify_fail");
            require(stringp(reason) && reason != "", "actual no-progress research reason");
            current["reason"] = reason;
        }
        return;
    }
    if (action == "ordinary") {
        if (is_mingjiao_remaining_base())
            current["ordinary_step"] = ([ "actor": 0, "target": 1, "type": TYPE_REGULAR,
                "caller_side": member_array(this_player(), players) ]);
        result = COMBAT_D->do_attack(
            players[0],
            players[1],
            players[0]->query_temp("weapon"),
            TYPE_REGULAR
        );
        if (is_mingjiao_remaining_base())
            current["ordinary_step"]["result"] = serializable(result);
        current["outcome"] = "observed";
    } else {
        launches = sizeof(current["launches"]);
        if (is_mingjiao_remaining_perform())
            current["command_context"] = ([ "action": action, "actor": file_name(players[0]),
                "force_me_source": function_exists("force_me", players[0]) ]);
        if (is_mingjiao_remaining_base()) {
            current["command_context"] = ([ "action": action, "actor": file_name(players[0]),
                "force_me_source": function_exists("force_me", players[0]) ]);
            if (current["method"] == "practice") {
                current["command_context"]["command_source"] = players[0]->find_command("practice");
                require(current["command_context"]["force_me_source"] == "/feature/command" &&
                    current["command_context"]["command_source"] == "/cmds/skill/practice.c",
                    "original public practice USER command");
                current["practice_step"] = ([ "before": ({
                    snapshot(players[0]),
                    snapshot(players[1])
                }) ]);
            }
        }
        result = players[0]->force_me(action);
        current["command_accepted"] = result;
        if (is_mingjiao_remaining_base() && current["method"] == "practice") {
            reason = players[0]->query_temp("notify_fail");
            current["practice_step"]["accepted"] = result;
            current["practice_step"]["reason"] = !result && stringp(reason) ? reason : "";
            current["practice_step"]["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        }
        if ((is_taohua_ding() || is_taohua_zhuan() ||
            current["parameters"]["collection_group"] == "s1-duan-perform" ||
            current["parameters"]["collection_group"] == "s1-piaoxu" ||
            current["parameters"]["collection_group"] == "s1-panlong-tan" ||
            current["parameters"]["collection_group"] == "mingjiao-shenghuo" ||
            current["parameters"]["collection_group"] == "mingjiao-ling-perform" ||
            current["parameters"]["collection_group"] == "mingjiao-jiuyang-direct" ||
            current["parameters"]["collection_group"] == "mingjiao-jiuyang-remaining" ||
            is_mingjiao_remaining_perform()) &&
            !result && !sizeof(current["refusals"])) {
            reason = players[0]->query_temp("notify_fail");
            require(stringp(reason) && reason != "", "actual early DING command refusal");
            current["refusals"] += ({ ([ "actor": file_name(players[0]), "reason": reason ]) });
        }
        if (current["method"] == "exercise") {
            current["outcome"] = result ? "observed" : "refused";
            if (!result) {
                reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原打坐命令未受理";
            }
            return;
        }
        if (action == "test_interface") {
            require(sizeof(current["interfaces"]), "observation interface invoked");
            return;
        }
        if (current["method"] == "practice") {
            step = snapshot(players[0]);
            grant = parameters["skill"];
            current["outcome"] = step["skills"][grant] > current["before"][0]["skills"][grant] || step["learned"][grant] > current["before"][0]["learned"][grant] ? "observed" : "refused";
            if (current["outcome"] == "refused") {
                reason = players[0]->query_temp("notify_fail");
                if (!stringp(reason) || reason == "") reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原练习没有增加技能或进度";
            }
            return;
        }
        if (current["method"] == "yanlian") {
            // yanlian synthesis: command accepted + busy loop completes → main skill created
            debug_message("YANLIAN: result=" + result + " action=" + action);
            if (!result) {
                current["outcome"] = "refused";
                reason = players[0]->query_temp("notify_fail");
                if (!stringp(reason) || reason == "") reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原演练命令未受理";
                return;
            }
            // Command accepted; poll until busy loop completes
            current["yanlian_accepted"] = 1;
            current["yanlian_clock"] = "original-user-heartbeat";
            current["yanlian_steps"] = ({});
            players[0]->observation_heartbeat(1);
            call_out("poll", 1);
            return;
        }
        if (current["method"] == "research") {
            // Original research command: acceptance alone can mean no study happened.
            current["outcome"] = players[0]->query("learned_points") > current["before"][0]["learned_points"] ? "observed" : "refused";
            if (current["outcome"] == "refused") {
                reason = players[0]->query_temp("notify_fail");
                if (!stringp(reason) || reason == "") reason = query_notify_fail();
                current["reason"] = stringp(reason) && reason != "" ? reason : "原研究未消耗潜能或增加学习进度";
            }
            return;
        }
        current["outcome"] = sizeof(current["launches"]) > launches ? "observed" : "refused";
        if (sizeof(current["launches"]) == launches)
            current["reason"] = sizeof(current["refusals"]) ? current["refusals"][<1]["reason"] : "技能入口未返回成功";
        if (!sizeof(current["launches"]) && parameters["collection_group"] == "wudang-lookup" &&
            stringp(reason = players[0]->query_temp("notify_fail")))
            current["reason"] = reason;
    }
}

void observe_needle_hit(object weapon, object me, object victim, int damage_bonus) {
    if (!active || (!needle_collection() && !is_mingjiao_remaining_perform())) return;
    if (is_mingjiao_remaining_perform()) {
        if (current["parameters"]["ability"] != "hua") return;
        require(weapon == remaining_perform_flower &&
            base_name(weapon) == "/clone/weapon/flower_leaf", "same original flower hit_ob");
    }
    require(me == players[0] && victim == players[1], "needle participants");
    current["needle_hits"] += ({ ([ "actor": 0, "target": 1,
        "program": base_name(weapon), "object": file_name(weapon), "damage_bonus": damage_bonus ]) });
}

// Read the original skill timer and states only; never invoke or reschedule back().
void observe_needle_restore(object target, string phase, int delay) {
    mapping event;
    if (!active || current["parameters"]["collection_group"] != "gumu-needle-lifecycle" ||
        target != players[1]) return;
    event = ([ "program": base_name(previous_object()), "function": "back", "side": 1,
        "elapsed": time_ns() / 1000000000.0 - started ]);
    if (phase == "scheduled") {
        event["delay"] = delay;
        current["restore_schedule"] = event;
    } else {
        event["phase"] = phase;
        event["state"] = snapshot(target);
        current["callbacks"] += ({ event });
        if (phase == "after") call_out("finish_sample", 0);
    }
}

void finish_needle_seed() {
    object ob;
    if (!active) return;
    current["seed"] = ([ "method": "perform", "outcome": current["outcome"],
        "before": current["before"], "immediate": current["immediate"],
        "after": ({ snapshot(players[0]), snapshot(players[1]) }),
        "metrics": current["immediate_metrics"], "attacks": current["attacks"],
        "launches": current["launches"], "needle_hits": current["needle_hits"],
        "ammo_cleanup": ([ "checked": 1, "object_exists": objectp(needle_object),
            "handing_object": serializable(players[0]->query_temp("handing")) ]) ]);
    foreach (ob in players) {
        ob->remove_all_killer();
        ob->remove_all_enemy(1);
    }
    current["combat_stopped_after_seed"] = ({
        !players[0]->is_fighting(),
        !players[1]->is_fighting()
    });
    require(current["combat_stopped_after_seed"][0] && current["combat_stopped_after_seed"][1],
        "isolated original needle lifecycle without combat");
    if (current["parameters"]["lifecycle"] == "bingpo_restore") {
        require(mapp(current["restore_schedule"]) && players[1]->query_temp("bingpo"),
            "original cold debuff and timer observed");
    } else if (!current["parameters"]["ticks"]) {
        finish_sample();
        return;
    } else {
        require(mapp(players[1]->query_condition(current["parameters"]["condition_name"])),
            "original needle applied poison before heartbeat");
        players[1]->observation_heartbeat(1);
    }
    call_out("poll", 1);
}

void poll_yanlian_synthesis() {
    mapping step;
    string grant;
    mixed busy;
    if (!active || current["method"] != "yanlian") { finish_sample(); return; }
    busy = players[0]->query_busy();
    if (busy) { call_out("poll_yanlian_synthesis", 1); return; }
    // Busy loop finished; check skill state
    step = snapshot(players[0]);
    grant = current["parameters"]["skill"];
    if (step["skills"][grant] > 0) {
        current["outcome"] = "observed";
        current["reason"] = "";
    } else {
        current["outcome"] = "refused";
        current["reason"] = "演练结束但主技能未生成，详见技能状态";
    }
    finish_sample();
}

void finish_sample() {
    object ob, previous_teacher, item;
    object *acquisition_owned;
    mapping step, cleanup_singletons;
    string cleanup_name, cleanup_path;
    if (!active) return;
    if (is_jiuyang_fusion()) clear_jiuyang_fusion_observation();
    if (is_npc_bout()) finish_npc_bout_observation();
    if (current["parameters"]["collection_group"] == "gumu-npc") {
        // Also recover exact references after a failed constructor/move/closure.
        current["npc_observation"] = "/tests/npc_observer"->clear_gumu();
        gumu_npc = 0;
        gumu_npc_pending = 0;
    }
    if (current["method"] == "scene" && current["parameters"]["lifecycle"] &&
        current["parameters"]["observe_seconds"] > 0 && current["outcome"] != "error") {
        step = ([
            "command": "go out",
            "before": "/tests/scene_observer"->observe(players[0])
        ]);
        step["accepted"] = players[0]->force_me("go out");
        step["after"] = "/tests/scene_observer"->observe(players[0]);
        current["scene_followup"] = step;
        current["scene_messages"] = players[0]->end_teaching_messages();
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-challenge" && current["outcome"] != "error") {
        current["teaching"][<1]["after"] = "/tests/teaching_observer"->finish_challenge_wait(players[0]);
        current["challenge_messages"] = players[0]->end_teaching_messages();
    }
    if (current["parameters"]["teaching_profile"] == "shaolin-formation" &&
        current["parameters"]["observe_seconds"] > 0 && current["outcome"] != "error") {
        current["teaching"][<1]["wait_after"] = "/tests/formation_observer"->observe(
            players[0], formation_teacher, current["parameters"]["formation"]);
        current["teaching"][<1]["wait_elapsed"] = time_ns() / 1000000000.0 - formation_started;
    }
    if (current["parameters"]["collection_group"] == "mingjiao-qkd" && mapp(current["qkd_queue"]))
        current["qkd_queue"]["final"] = qkd_queue_point();
    active = 0;
    remove_call_out("poll");
    remove_call_out("finish_sample");
    remove_call_out("finish_needle_seed");
    remove_call_out("advance_mingjiao_route");
    if (current["method"] == "bout" && current["outcome"] == "observed" &&
        !is_npc_bout_group()) {
        sample_busy();
        current["busy_seconds"] = busy_seconds;
    }
    current["elapsed"] = time_ns() / 1000000000.0 - started;
    if (current["parameters"]["collection_group"] == "gumu-throwing" || is_taohua_po())
        current["ammo_cleanup"] = ([ "checked": 1, "object_exists": objectp(needle_object),
            "handing_object": serializable(players[0]->query_temp("handing")) ]);
    if (!is_npc_bout_group()) {
        current["after"] = ({ snapshot(players[0]), snapshot(players[1]) });
        current["metrics"] = ({ objectp(players[0]) ? players[0]->query_observation() : ([]),
            objectp(players[1]) ? players[1]->query_observation() : ([]) });
    }
    observe_taohua_po_weapon("after");
    observe_ling_weapon("after");
    observe_remaining_perform_flower("after");
    if (current["parameters"]["collection_group"] == "wudang-lookup") {
        current["lookup"]["after"] = lookup_snapshot(lookup_subject);
        if (member_array(lookup_subject, players) == -1) destruct(lookup_subject);
        lookup_subject = 0;
    }
    if (mapp(current["parameters"]["extra_target"])) {
        current["extra_target_after"] = snapshot(players[2]);
        current["extra_target_metrics"] = players[2]->query_observation();
    }
    if ((current["parameters"]["collection_group"] == "mingjiao-jiuyang-remaining" ||
        is_mingjiao_remaining_perform()) && mapp(current["enemy_context"]))
        current["enemy_context"]["after"] = map(players[0]->query_enemy(),
            (: member_array($1, players) :));
    if (current["parameters"]["collection_group"] == "mingjiao-jiuyang-exert")
        current["relation_context"]["after"] = jiuyang_exert_relations();
    current["dropped"] = ({});
    foreach (ob in all_inventory(this_object())) {
        if (member_array(ob, players) != -1) continue;
        current["dropped"] += ({ ([ "object": file_name(ob), "name": ob->name(),
            "type": ob->query("skill_type"), "no_wield": ob->query("no_wield") ]) });
        if (current["parameters"]["collection_group"] == "gumu-advanced")
            current["dropped"][<1]["value"] = ob->query("value");
    }
    foreach (ob in players) if (objectp(ob)) ob->stop_observation();
    if (current["parameters"]["collection_group"] == "mingjiao-route") {
        current["route_cleanup"] = "/tests/route_observer"->cleanup(players[0]);
        mingjiao_route_wait = 0;
        mingjiao_route_cursor = 0;
    }
    if (current["parameters"]["teaching_profile"] == "mingjiao-book") clear_mingjiao_book();
    if (current["parameters"]["teaching_profile"] == "mingjiao-gift") clear_mingjiao_gift();
    if (member_array(current["parameters"]["teaching_profile"],
        ({
            "taohua-learning",
            "mingjiao-apprentice-learning",
            "mingjiao-teachers",
            "mingjiao-recruit", "mingjiao-gift", "mingjiao-book"
        })) != -1) {
        current["teacher_cleanups"] = ({});
        if (mapp(taohua_learning_teachers)) foreach (
            cleanup_name,
            ob in taohua_learning_teachers
        ) {
            cleanup_path = file_name(ob);
            foreach (item in deep_inventory(ob)) destruct(item);
            destruct(ob);
            current["teacher_cleanups"] += ({ ([ "object": cleanup_path, "pending": 0,
                "object_exists": objectp(ob) ]) });
        }
        taohua_learning_teachers = 0;
        if (current["parameters"]["teaching_profile"] == "mingjiao-teachers") set("pigging", 0);
        if (mapp(taohua_book_setup)) {
            if (arrayp(taohua_book_owned))
                foreach (ob in taohua_book_owned) if (objectp(ob)) destruct(ob);
            cleanup_singletons = ([]);
            foreach (cleanup_name in taohua_book_setup["books"]) {
                cleanup_path = "/clone/lonely/book/" + cleanup_name;
                if (objectp(find_object(cleanup_path))) destruct(find_object(cleanup_path));
                cleanup_singletons[cleanup_path] = objectp(find_object(cleanup_path)) ? 1 : 0;
            }
            current["item_cleanup"] = ([ "owned_remaining":
                arrayp(taohua_book_owned) ? sizeof(filter(
                    taohua_book_owned,
                    (: objectp :)
                )) : 0,
                "singletons": cleanup_singletons ]);
        }
        taohua_book_owned = ({});
        taohua_book_context = 0;
        taohua_book_setup = 0;
    }
    if (member_array(current["parameters"]["teaching_profile"],
        ({
            "gumu-teachers",
            "gumu-special",
            "gumu-acquisition-learning",
            "gumu-item-acquisition",
            "gumu-recruit"
        })) != -1) {
        if (objectp(gumu_teacher) && current["outcome"] != "error")
            current["teacher_final"] = ([ "state": snapshot(gumu_teacher),
                "autonomy": gumu_teacher_autonomy() ]);
        if (current["parameters"]["teaching_profile"] == "gumu-item-acquisition") {
            previous_teacher = gumu_previous_teacher;
            acquisition_owned = copy(gumu_item_owned);
        }
        clear_gumu_teacher();
        current["teacher_cleanup"] = ([ "pending": gumu_teacher_pending,
            "object_exists": objectp(gumu_teacher) ]);
        if (current["parameters"]["teaching_profile"] == "gumu-item-acquisition")
            current["item_cleanup"] = ([ "previous_teacher_exists": objectp(previous_teacher),
                "owned_remaining": sizeof(filter(acquisition_owned, (: objectp :))),
                "singleton_exists": objectp(find_object("/clone/lonely/yinsuo")) ]);
    }
    map_delete(current, "parameters");
    emit(current);
    clear_taohua_zhuan_owned();
    debug_message("DATA SAVED");
    cursor++;
    if (current["outcome"] == "error") {
        debug_message("DATA SAMPLE ERROR");
        shutdown(1);
        return;
    }
    if (cursor % 20 == 0 || cursor == sizeof(jobs)) debug_message(sprintf(
        "DATA %d/%d",
        cursor,
        sizeof(jobs)
    ));
    // Yield between completed samples, below the driver's call_out(0) nesting limit.
    // No active combat, observation window or skill callback is shortened.
    call_out("advance", cursor % 100 == 0 ? 1 : 0);
}

int record_failure(mapping details) {
    if (!active) return 0;
    current["outcome"] = "error";
    current["reason"] = details["error"];
    current["error_trace"] = serializable(details["trace"]);
    if (is_jiuyang_fusion()) {
        // Preserve the original failing stack; only dispose after it unwinds.
        call_out("finish_jiuyang_fusion_error", 0);
        return 1;
    }
    if (is_mingjiao_remaining_base() && current["method"] == "condition") {
        current["condition_terminal"] = "error";
        current["condition_lifecycle_complete"] = 0;
        call_out("finish_sample", 0);
        return 1;
    }
    finish_sample();
    return 1;
}

void injected_callback_error() {
    error("Injected collection callback failure.\n");
}

// Original death bookkeeping may lazy-load QUEST_D, whose scan starts these
// world generators. They are outside a two-player martial experiment. Stop only
// their original background timers; keep doKilled, death and skill callbacks.
void stop_background_quests() {
    object daemon;
    string name;
    current["background_stopped"] = ({});
    foreach (name in ({
        "capture",
        "deliver",
        "explore",
        "judge",
        "search",
        "shen",
        "supply",
        "trace"
    })) {
        daemon = find_object("/adm/daemons/quest/" + name);
        if (!objectp(daemon) || member_array(daemon, heart_beats()) == -1) continue;
        require(
            stringp(function_exists("stop", daemon)),
            "original world generator stop interface"
        );
        daemon->stop();
        require(member_array(daemon, heart_beats()) == -1, "background quest stopped");
        current["background_stopped"] += ({ base_name(daemon) });
    }
}

