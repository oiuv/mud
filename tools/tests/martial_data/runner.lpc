        arrayp(current["skill_messages"]) && member_array(me, players) != -1)
        current["skill_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && member_array(current["parameters"]["collection_group"],
        ({ "mingjiao-jiuyang-learning", "mingjiao-jiuyang-capacity",
            "mingjiao-jiuyang-research" })) != -1 &&
        arrayp(current["skill_messages"]) && member_array(me, players) != -1)
        current["skill_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "mingjiao-ling-perform" &&
        arrayp(current["skill_messages"]) && member_array(me, players) != -1)
        current["skill_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "mingjiao-shenghuo" &&
        arrayp(current["skill_messages"]) && member_array(me, players) != -1)
        current["skill_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "public-music" &&
        arrayp(current["music_messages"]) && member_array(me, players) != -1)
        current["music_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && member_array(current["parameters"]["collection_group"],
        ({
            "shaolin-defense",
            "emei-defense",
            "emei-shexing",
            "gumu-defense",
            "mingjiao-movement",
            "mingjiao-qkd",
            "mingjiao-jiuyang"
        })) != -1 &&
        arrayp(current["defense_messages"]) && member_array(me, players) != -1)
        current["defense_messages"] += ({ ([ "side": member_array(me, players),
            "type": type, "text": text ]) });
    if (active && current["parameters"]["collection_group"] == "shaolin-backlash" &&
        me == players[0] && type == "write" && arrayp(current["backlash_messages"]))
        current["backlash_messages"] += ({ text });
    if (active && current["parameters"]["collection_group"] == "wudang-lookup" &&
        me == players[0] && type == "write" && arrayp(current["lookup_messages"]))
