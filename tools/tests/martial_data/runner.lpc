int observe_taohua_zhuan_corpse(object victim, object killer, object corpse) {
    if (!active || !is_taohua_zhuan()) return 0;
    require(
        victim == players[1] && killer == players[0],
        "exact original ZHUAN corpse participants"
    );
    require(base_name(previous_object()) == "/adm/daemons/chard", "original CHARD corpse return");
    require(objectp(corpse) && !objectp(taohua_zhuan_corpse), "one original ZHUAN corpse");
    taohua_zhuan_corpse = corpse;
    return 1;
}

private void clear_taohua_zhuan_owned() {
    object item;
    if (objectp(taohua_zhuan_corpse)) {
        foreach (item in all_inventory(taohua_zhuan_corpse)) {
            require(
                item == taohua_zhuan_target_weapon,
                "only this sample's original weapon in corpse"
            );
            destruct(item);
        }
        destruct(taohua_zhuan_corpse);
    }
    taohua_zhuan_corpse = 0;
    taohua_zhuan_target_weapon = 0;
    taohua_zhuan_before = 0;
}

void require(int condition, string message) {
    if (!condition) error("DATA FAIL: " + message + "\n");
}

int needle_collection() {
    return member_array(current["parameters"]["collection_group"],
        ({ "gumu-throwing", "gumu-needle-lifecycle", "taohua-po" })) != -1;
}

void emit(mapping value) {
    require(write_file("/log/events.jsonl", json_encode(value) + "\n"), "write evidence");
}

mixed serializable(mixed value) {
    mapping result;
    mixed key;
    if (objectp(value)) return file_name(value);
    if (functionp(value)) return "<function>";
    if (arrayp(value)) return map(value, (: serializable :));
    if (!mapp(value)) return value;
    result = ([]);
    foreach (key in keys(value)) result[sprintf("%s", key)] = serializable(value[key]);
    return result;
}

mapping equipment_snapshot(object item) {
    mapping result;
    if (!objectp(item)) return ([]);
    result = ([ "object": file_name(item), "program": base_name(item),
        "skill_type": item->query("skill_type"), "flag": item->query("flag"),
        "weight": item->query_weight(), "material": item->query("material"),
        "rigidity": item->query("rigidity"), "consistence": item->query("consistence"),
        "damage": item->query("weapon_prop/damage"), "no_wield": item->query("no_wield") ]);
    if (current["parameters"]["collection_group"] == "gumu-weapon-learning" ||
        member_array(current["parameters"]["teaching_profile"],
            ({
                "gumu-teachers",
                "gumu-special",
                "gumu-acquisition-learning",
                "gumu-item-acquisition",
                "gumu-recruit"
            })) != -1)
        result["id"] = item->query("id");
    if (current["parameters"]["collection_group"] == "gumu-advanced")
        result += ([ "item_make": !!item->is_item_make(),
            "item_make_source": function_exists("is_item_make", item),
            "name": item->name(), "value": item->query("value") ]);
    if (needle_collection())
        result += ([ "amount": item->query_amount(),
            "daub": serializable(item->query_temp("daub") || ([])) ]);
    if (is_taohua_po()) result["stable"] = item->query("stable");
    if (current["parameters"]["collection_group"] == "taohua-bihai")
        result += ([ "valid_as_xiao": item->valid_as_xiao(),
            "valid_as_xiao_source": function_exists("valid_as_xiao", item) ]);
    return result;
}

mapping snapshot(object ob) {
    mapping result, effective;
    string key;
    object weapon, handing, cloth, secondary, opponent;
    if (!objectp(ob)) return ([ "missing": 1 ]);
    result = ([]);
    foreach (key in ({ "qi", "eff_qi", "max_qi", "jing", "eff_jing", "max_jing", "neili", "max_neili",
        "jingli", "str", "int", "con", "dex", "age", "gender", "combat_exp", "jiali",
        "potential", "learned_points", "shen", "id" }))
        result[key] = ob->query(key);
    weapon = ob->query_temp("weapon");
    handing = ob->query_temp("handing");
    result["object"] = file_name(ob);
    result["userp"] = userp(ob);
    result["interactive"] = interactive(ob);
    result["playerp"] = playerp(ob);
    result["wizardp"] = wizardp(ob);
    result["living"] = living(ob);
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-public-force", "gumu-public-force" })) != -1)
        result["not_living"] = ob->query("not_living");
    result["ghost"] = ob->is_ghost();
    result["busy"] = serializable(ob->query_busy());
    if (member_array(current["parameters"]["collection_group"],
        ({
            "gumu-zhi",
            "gumu-quanzhen",
            "taohua-direct",
            "taohua-control",
            "taohua-attack",
            "taohua-combo",
            "taohua-bihai",
            "taohua-passive"
        })) != -1) {
        opponent = ob == players[0] ? players[1] : players[0];
        result["fighting_opponent"] = objectp(opponent) && !!ob->is_fighting(opponent);
    }
    result["skills"] = copy(ob->query_skills() || ([]));
    result["learned"] = copy(ob->query_learned() || ([]));
    result["force_attribute"] = ob->query("force");
    result["cultivation"] = ([]);
    foreach (key in ({ "sex", "improve/neili", "breakup", "special_skill/mystery", "special_skill/divine",
        "special_skill/guimai", "special_skill/wuxing", "class", "family/family_name", "wudang-jiuyang", "immune/poison" }))
        result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "shaolin-cultivation")
        foreach (key in ({ "guilty", "couple/have_couple", "shaolin-jiuyang" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "emei-cultivation")
        foreach (key in ({ "guilty", "emei-jiuyang" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "emei-yijin")
        foreach (key in ({ "character", "yijin-duangu" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-recovery", "gumu-recovery" })) != -1)
        foreach (key in ({ "special_skill/self", "character" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(current["parameters"]["collection_group"],
        ({ "emei-healing", "emei-dispel", "emei-buffs", "gumu-public-force",
            "gumu-healing", "gumu-dispel", "gumu-buffs" })) != -1)
        result["cultivation"]["character"] = ob->query("character");
    if (current["parameters"]["collection_group"] == "shaolin-backlash")
        result["cultivation"]["reborn"] = ob->query("reborn");
    result["nothing"] = ob->query("can_learn/dugu-jiujian/nothing");
    result["dugu_grants"] = ([ "qi": ob->query("can_perform/dugu/qi"),
        "po": ob->query("can_perform/dugu/po") ]);
    effective = ([]);
    foreach (key in keys(result["skills"])) effective[key] = ob->query_skill(key);
    result["effective_skills"] = effective;
    result["effective_con"] = ob->query_con();
    result["effective_str"] = ob->query_str();
    if (current["parameters"]["collection_group"] == "gumu-cultivation") {
        result["effective_int"] = ob->query_int();
        foreach (key in ({ "tattoo/tattoo_str", "reborn/str", "tattoo/tattoo_int",
            "reborn/int", "env/no_learn" }))
            result["cultivation"][key] = ob->query(key);
    }
    if (current["parameters"]["collection_group"] == "gumu-movement") {
        result["effective_int"] = ob->query_int();
        result["cultivation"]["env/no_learn"] = ob->query("env/no_learn");
    }
    if (current["parameters"]["collection_group"] == "gumu-research") {
        result["effective_int"] = ob->query_int();
        result["effective_dex"] = ob->query_dex();
        foreach (key in ({ "character", "env/no_learn", "tattoo/tattoo_str", "reborn/str",
            "tattoo/tattoo_dex", "reborn/dex" }))
            result["cultivation"][key] = ob->query(key);
    }
    if (current["parameters"]["collection_group"] == "gumu-weapon-learning") {
        result["effective_dex"] = ob->query_dex();
        result["effective_int"] = ob->query_int();
        foreach (key in ({ "character", "tattoo/tattoo_dex", "reborn/dex", "env/no_learn" }))
            result["cultivation"][key] = ob->query(key);
    }
    if (current["parameters"]["collection_group"] == "gumu-unarmed-learning") {
        result["effective_int"] = ob->query_int();
        foreach (key in ({
            "character",
            "tattoo/tattoo_str",
            "reborn/str",
            "env/no_learn",
            "doing"
        }))
            result["cultivation"][key] = ob->query(key);
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (current["parameters"]["collection_group"] == "taohua-direct") {
        foreach (key in ({ "character", "can_perform/canglang-zhi/tao",
            "can_perform/pikong-zhang/dai", "can_perform/luoying-shenzhang/zhuan",
            "can_perform/yuxiao-jian/tian" }))
            result["cultivation"][key] = ob->query(key);
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (current["parameters"]["collection_group"] == "taohua-control") {
        foreach (key in ({ "character", "can_perform/lanhua-shou/fu",
            "can_perform/luoying-shenjian/sui" }))
            result["cultivation"][key] = ob->query(key);
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (member_array(current["parameters"]["collection_group"],
        ({ "taohua-attack", "taohua-passive", "taohua-combination" })) != -1) {
        result["cultivation"]["character"] = ob->query("character");
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (current["parameters"]["collection_group"] == "taohua-bihai") {
        result["cultivation"]["can_perform/yuxiao-jian/bihai"] = ob->query("can_perform/yuxiao-jian/bihai");
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (current["parameters"]["collection_group"] == "taohua-combo") {
        foreach (key in ({ "character", "can_perform/xuanfeng-tui/kuang",
            "can_perform/lanhua-shou/fei" }))
            result["cultivation"][key] = ob->query(key);
        result["killing_opponent"] = objectp(opponent) && !!ob->is_killing(opponent->query("id"));
        result["preparation_order"] = keys(ob->query_skill_prepare() || ([]));
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (member_array(current["parameters"]["teaching_profile"],
        ({
            "gumu-teachers",
            "gumu-special",
            "gumu-acquisition-learning",
            "gumu-item-acquisition",
            "gumu-recruit"
        })) != -1) {
        result["effective_int"] = ob->query_int();
        result["effective_dex"] = ob->query_dex();
        foreach (key in ({ "character", "family/master_id", "family/master_name",
            "special_skill/tiandao", "special_skill/qinzong", "betrayer/times", "env/no_learn" }))
            result["cultivation"][key] = ob->query(key);
    }
    if (current["parameters"]["collection_group"] == "gumu-exert") {
        result["is_character"] = ob->is_character();
        result["cultivation"]["character"] = ob->query("character");
        if (ob == players[0])
            result["powers"] = ([
                "attack": COMBAT_D->skill_power(ob, "unarmed", SKILL_USAGE_ATTACK, 0),
                "dodge": COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE, 0),
                "parry": COMBAT_D->skill_power(ob, "parry", SKILL_USAGE_DEFENSE, 0)
            ]);
    }
    if (current["parameters"]["collection_group"] == "gumu-advanced") {
        result["effective_dex"] = ob->query_dex();
        result["cultivation"]["character"] = ob->query("character");
    }
    if (current["parameters"]["collection_group"] == "gumu-unarmed") {
        result["cultivation"]["character"] = ob->query("character");
        result["perform_grant"] = serializable(ob->query("can_perform/" +
            current["parameters"]["skill"] + "/" + current["parameters"]["ability"]));
    }
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-combo", "gumu-temporal" })
    ) != -1) {
        foreach (key in ({ "character", "static/marry", "couple/id", "couple/name",
            "can_perform/chilian-shenzhang/lian", "can_perform/chiilian-shenzhang/lian",
            "can_perform/sad-strike/xiao", "can_perform/sad-strike/tuo" }))
            result["cultivation"][key] = ob->query(key);
        result["clock_seconds"] = time();
    }
    if (current["parameters"]["collection_group"] == "gumu-fireice")
        foreach (key in ({ "character", "can_perform/fireice-strike/binghuo" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(
        current["parameters"]["collection_group"],
        ({ "gumu-hubo", "gumu-temporal" })
    ) != -1)
        foreach (key in ({ "character", "special_skill/qinzong", "special_skill/tiandao",
            "can_perform/tianluo-diwang/wang" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "gumu-poison")
        foreach (key in ({ "character", "can_perform/wudu-shenzhang/shi", "special_skill/piyi" }))
            result["cultivation"][key] = ob->query(key);
    if (member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout",
            "gumu-npc-bout"
        })) != -1)
        foreach (key in ({ "character", "can_learn/yunv-xinjing/wall" }))
            result["cultivation"][key] = ob->query(key);
    if (is_npc_bout()) {
        secondary = ob->query_temp("secondary_weapon");
        result["secondary_weapon"] = secondary ? secondary->query("skill_type") : "none";
        result["secondary_weapon_details"] = equipment_snapshot(secondary);
    }
    if (current["parameters"]["collection_group"] == "gumu-bout" || is_npc_bout())
        result["per"] = ob->query("per");
    if (current["parameters"]["collection_group"] == "gumu-zhi")
        result["cultivation"]["can_perform/sanwu-shou/zhi"] = ob->query("can_perform/sanwu-shou/zhi");
    if (current["parameters"]["collection_group"] == "gumu-quanzhen")
        foreach (key in ({ "can_perform/quanzhen-jian/chan", "can_perform/quanzhen-jian/ding",
            "can_perform/quanzhen-jian/hua", "can_perform/quanzhen-jian/lian" }))
            result["cultivation"][key] = ob->query(key);
    if (current["parameters"]["collection_group"] == "gumu-unarmed-attack")
        foreach (key in ({ "tattoo/tattoo_str", "reborn/str", "special_skill/piyi" }))
            result["cultivation"][key] = ob->query(key);
    if (needle_collection() && !is_taohua_po())
        foreach (key in ({ "character", "special_skill/piyi", "can_perform/yufeng-zhen/ying",
            "can_perform/bingpo-shenzhen/bing" }))
            result["cultivation"][key] = ob->query(key);
    result["mappings"] = copy(ob->query_skill_map() || ([]));
    result["preparations"] = copy(ob->query_skill_prepare() || ([]));
    if (member_array(
        current["parameters"]["collection_group"],
        ({
            "wudang-combination",
            "shaolin-combination",
            "emei-combination",
            "gumu-combination",
            "emei-jiuyin-buff",
            "taohua-combination",
            "wudang-bout",
            "shaolin-bout",
            "emei-bout",
            "gumu-bout",
            "gumu-npc-bout",
            "shaolin-sword",
            "shaolin-weapons",
            "shaolin-fists",
            "shaolin-palms",
            "shaolin-fingers",
            "shaolin-hands"
        })
    ) != -1) {
        result["preparation_order"] = keys(ob->query_skill_prepare() || ([]));
        result["effective_dex"] = ob->query_dex();
    }
    result["temp"] = serializable(ob->query_entire_temp_dbase());
    if (current["parameters"]["collection_group"] == "emei-jiuyin") {
        result["jiuyin_grants"] = ([]);
        foreach (key in ({ "can_perform/jiuyin-baiguzhao", "can_perform/jiuyin-baiguzhao/duo",
            "can_perform/cuixin-zhang/cui", "can_perform/yinlong-bian/zhu" }))
            result["jiuyin_grants"][key] = serializable(ob->query(key));
    }
    result["conditions"] = serializable(ob->query_condition());
    if (current["parameters"]["collection_group"] == "emei-jiuyin-passive")
        result["cultivation"]["special_skill/piyi"] = ob->query("special_skill/piyi");
    if (member_array(current["parameters"]["collection_group"],
        ({ "shaolin-public-force", "gumu-exert", "gumu-temporal" })) != -1)
        result["hostility"] = ([ "enemies": map(ob->query_enemy(), (: $1->query("id") :)),
            "killers": copy(ob->query_killer()), "wants": copy(ob->query_want()) ]);
    if (current["parameters"]["collection_group"] == "gumu-temporal")
        result["environment"] = objectp(environment(ob)) ? file_name(environment(ob)) : "";
    result["weapon"] = weapon ? weapon->query("skill_type") : "none";
    result["weapon_damage"] = weapon ? weapon->query("weapon_prop/damage") : 0;
    result["weapon_flag"] = weapon ? weapon->query("flag") : 0;
    result["weapon_details"] = equipment_snapshot(weapon);
    result["handing"] = handing ? handing->query("skill_type") : "none";
    result["handing_details"] = equipment_snapshot(handing);
    result["ammunition"] = handing ? handing->query_amount() : 0;
    if (current["parameters"]["collection_group"] == "shaolin-hands") {
        cloth = test_clothes[ob == players[0] ? 0 : 1];
        result["cloth"] = objectp(cloth) ? ([ "object": file_name(cloth),
            "name": cloth->query("name"), "value": cloth->query("value"),
            "armor": cloth->query("armor_prop/armor"),
            "equipped": ob->query_temp("armor/cloth") == cloth,
            "location": environment(cloth) == ob ? "actor" :
            environment(cloth) == this_object() ? "room" : "other" ]): ([]);
    }
    result = taohua_xiao_snapshot(ob, result);
    result = taohua_po_snapshot(ob, result);
    result = taohua_zhuan_snapshot(ob, result);
    return taohua_ding_snapshot(ob, result);
}

mixed *practice_material_snapshot() {
    mixed *result;
    object item;
    result = ({});
    foreach (item in practice_materials) {
        require(objectp(item), "original practice material still exists");
        result += ({ ([ "object": file_name(item), "program": base_name(item),
            "location": environment(item) == this_object() ? "room" :
            environment(item) == players[0] ? "actor" : "other",
            "used": !!item->query_temp("clawed_by_jiuyin"),
            "cut": !!item->query("been_cut/head"), "long": item->query("long") ]) });
    }
    return result;
}

void prepare_practice_materials(mapping parameters) {
    mapping config;
    object item;
    practice_materials = ({});
    require(parameters["collection_group"] == "emei-jiuyin-learning", "explicit material fixture");
    foreach (config in parameters["materials"]) {
        require(
            member_array(config["kind"], ({ "head", "corpse" })) != -1,
            "original material class"
        );
        item = new("/clone/misc/" + config["kind"]);
        if (config["bone"]) {
            require(config["kind"] == "head", "original head bone transition");
            item->finish_eat();
        }
        if (config["cut"]) item->set("been_cut/head", 1);
        if (config["used"]) item->set_temp("clawed_by_jiuyin", 1);
        require(item->move(config["carried"] ? players[0] : this_object()), "material placement");
        practice_materials += ({ item });
    }
    current["practice_room"] = ([
        "no_fight": !!query("no_fight"),
        "sleep_room": !!query("sleep_room")
    ]);
    current["practice_materials_before"] = practice_material_snapshot();
}

void prepare_actor(int side, mapping config) {
    object ob, old, weapon, item, held;
    string key, load_usage;
    mixed value;
    mapping descriptor, load;
    old = players[side];
    old->stop_observation();
    if (!side && current["parameters"]["teaching_profile"] == "shaolin-tonsure")
        NAME_D->remove_name(old->query("name"), old->query("id"));
    ob = new(!side && member_array(current["method"], ({ "teaching", "scene" })) != -1 ?
        "/tests/teaching_actor" : "/tests/actor");
    require(efun::exec(ob, old), "transfer connection");
    players[side] = ob;
    foreach (item in all_inventory(old)) destruct(item);
    destruct(old);
    ob->set("id", side == 2 ? "third" : side ? "right" : "left");
    if (current["method"] == "team")
        ob->set_name(side ? "右阵弟子" : "左阵弟子", ({ side ? "right" : "left" }));
    else if (current["parameters"]["named_participants"] ||
        current["parameters"]["collection_group"] == "gumu-temporal")
        ob->set_name(side == 2 ? "旁试弟子" : side ? "右试弟子" : "左试弟子",
            ({ side == 2 ? "third" : side ? "right" : "left" }));
    ob->move(this_object());
    if (is_taohua_ding()) require(present(side ? "right" : "left", this_object()) == ob,
        "original DING input resolves to exact USER");
    if (is_taohua_xiao()) {
        require(ob->id(side ? "right" : "left"), "original XIAO input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original XIAO input resolves to exact USER");
    }
    if (is_taohua_po()) {
        require(ob->id(side ? "right" : "left"), "original PO input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original PO input resolves to exact USER");
    }
    if (is_taohua_zhuan()) {
        require(ob->id(side ? "right" : "left"), "original ZHUAN input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original ZHUAN input resolves to exact USER");
    }
    if (current["parameters"]["collection_group"] == "taohua-direct") {
        require(ob->id(side ? "right" : "left"), "original DIRECT input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original DIRECT input resolves to exact USER");
    }
    if (current["parameters"]["collection_group"] == "taohua-control") {
        require(ob->id(side ? "right" : "left"), "original CONTROL input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original CONTROL input resolves to exact USER");
    }
    if (current["parameters"]["collection_group"] == "taohua-combo") {
        require(ob->id(side ? "right" : "left"), "original COMBO input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original COMBO input resolves to exact USER");
    }
    if (current["parameters"]["collection_group"] == "taohua-bihai") {
        require(ob->id(side ? "right" : "left"), "original BIHAI input alias");
        require(present(side ? "right" : "left", this_object()) == ob,
            "original BIHAI input resolves to exact USER");
    }
    if (side && current["parameters"]["collection_group"] == "gumu-temporal") {
        require(ob->id(side == 2 ? "third" : "right"), "original temporal target input alias");
        require(present(side == 2 ? "third" : "right", this_object()) == ob,
            "original temporal target resolves to prepared actor");
    }
    foreach (key, value in config["properties"] || ([])) ob->set(key, value);
    if (!side && current["parameters"]["teaching_profile"] == "shaolin-tonsure")
        NAME_D->map_name(ob->query("name"), ob->query("id"));
    foreach (key, value in config["skills"] || ([])) ob->set_skill(key, value);
    if (!side && member_array(current["parameters"]["collection_group"],
        ({
            "gumu-weapons",
            "gumu-unarmed-attack",
            "gumu-zhi",
            "gumu-quanzhen",
            "gumu-bout"
        })) != -1) {
        foreach (descriptor in current["parameters"]["capture_skill_loads"]) {
            key = descriptor["skill"];
            if (!mapp(original_skill_loads[key])) {
                require(!objectp(find_object("/kungfu/skill/" + key)), "first original skill load");
                // No mappings yet: reading this snapshot cannot load the pending skill.
                load = descriptor + ([ "load_id": observation_run_id + ":" + key,
                    "run_id": observation_run_id, "state": snapshot(ob),
                    "command": "enable parry " + key ]);
                require(ob->force_me(load["command"]), "original dynamic skill enable context");
                require(
                    objectp(find_object("/kungfu/skill/" + key)),
                    "original dynamic skill loaded"
                );
                original_skill_loads[key] = load;
            } else
                require(
                    objectp(find_object("/kungfu/skill/" + key)),
                    "retain original shared skill"
                );
            current["skill_loads"] += ({ serializable(original_skill_loads[key]) });
        }
    }
    if ((side == 0 && current["parameters"]["collection_group"] == "gumu-unarmed" &&
        current["parameters"]["skill"] == "wudu-shenzhang") ||
        (current["parameters"]["collection_group"] == "gumu-poison" &&
            side == (current["method"] == "condition" ? 1 : 0)) ||
        (side == 1 && current["parameters"]["collection_group"] == "gumu-defense" &&
            current["parameters"]["skill"] == "wudu-shenzhang")) {
        // Before query_skill_mapped() loads the skill to check valid_enable().
        // Its legacy global action table reads this_player() during first load.
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/wudu-shenzhang")),
            "skills": copy(ob->query_skills()), "command": "enable parry wudu-shenzhang" ]);
        require(ob->force_me("enable parry wudu-shenzhang"), "original Wudu enable context");
        require(objectp(find_object("/kungfu/skill/wudu-shenzhang")), "original Wudu loaded");
        if (current["parameters"]["collection_group"] == "gumu-defense")
            ob->map_skill("parry");
    }
    if (!side && current["parameters"]["collection_group"] == "gumu-weapon-learning" &&
        member_array(current["parameters"]["skill"],
            ({ "suxin-jian", "quanzhen-jian", "yinsuo-jinling", "sanwu-shou" })) != -1) {
        // These legacy action tables require the original player's first-load context.
        key = current["parameters"]["skill"];
        load_usage = member_array(
            key,
            ({ "suxin-jian", "quanzhen-jian" })
        ) != -1 ? "sword" : "whip";
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/" + key)),
            "skills": copy(ob->query_skills()), "command": "enable " + load_usage + " " + key ]);
        require(ob->force_me(current["skill_load_context"]["command"]),
            "original weapon learning enable context");
        require(
            objectp(find_object("/kungfu/skill/" + key)),
            "original weapon learning skill loaded"
        );
        ob->map_skill(load_usage);
    }
    if (!side && current["parameters"]["collection_group"] == "gumu-unarmed-learning" &&
        member_array(current["parameters"]["skill"], ({ "wudu-shenzhang", "sad-strike" })) != -1) {
        // Use an existing original usage; ordinary learning actors have no basic parry.
        key = current["parameters"]["skill"];
        load_usage = key == "wudu-shenzhang" ? "strike" : "unarmed";
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/" + key)),
            "skills": copy(ob->query_skills()), "command": "enable " + load_usage + " " + key ]);
        require(ob->force_me(current["skill_load_context"]["command"]),
            "original unarmed learning enable context");
        require(
            objectp(find_object("/kungfu/skill/" + key)),
            "original unarmed learning skill loaded"
        );
        ob->map_skill(load_usage);
    }
    if (!side && current["parameters"]["collection_group"] == "gumu-research" &&
        member_array(current["parameters"]["skill"], ({ "suxin-jian", "quanzhen-jian",
            "yinsuo-jinling", "sanwu-shou", "wudu-shenzhang", "sad-strike" })) != -1) {
        key = current["parameters"]["skill"];
        load_usage = current["parameters"]["usage"];
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/" + key)),
            "skills": copy(ob->query_skills()), "command": "enable " + load_usage + " " + key ]);
        require(ob->force_me(current["skill_load_context"]["command"]),
            "original research enable context");
        require(objectp(find_object("/kungfu/skill/" + key)), "original research skill loaded");
        ob->map_skill(load_usage);
    }
    if (!side && current["parameters"]["teaching_profile"] == "gumu-teachers" &&
        member_array(current["parameters"]["skill"], ({ "suxin-jian", "quanzhen-jian",
            "yinsuo-jinling", "sanwu-shou", "wudu-shenzhang", "sad-strike" })) != -1) {
        key = current["parameters"]["skill"];
        load_usage = member_array(
            key,
            ({ "suxin-jian", "quanzhen-jian" })
        ) != -1 ? "sword" : member_array(
            key,
            ({ "yinsuo-jinling", "sanwu-shou" })
        ) != -1 ? "whip" : key == "wudu-shenzhang" ? "strike" : "unarmed";
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/" + key)),
            "skills": copy(ob->query_skills()), "command": "enable " + load_usage + " " + key ]);
        require(ob->force_me(current["skill_load_context"]["command"]),
            "original teacher learning enable context");
        require(
            objectp(find_object("/kungfu/skill/" + key)),
            "original teacher learning skill loaded"
        );
        ob->map_skill(load_usage);
    }
    if (!side && is_taohua_ding()) {
        require(ob->force_me("enable finger tanzhi-shentong"), "original DING enable context");
        ob->map_skill("finger");
    }
    if (!side && is_taohua_xiao()) {
        require(ob->force_me("enable finger tanzhi-shentong"), "original XIAO enable context");
        ob->map_skill("finger");
    }
    if (!side && is_taohua_po()) {
        require(ob->force_me("enable finger tanzhi-shentong"), "original PO enable context");
        ob->map_skill("finger");
    }
    if (!side && is_taohua_zhuan()) {
        require(ob->force_me("enable finger tanzhi-shentong"), "original ZHUAN enable context");
        ob->map_skill("finger");
    }
    foreach (key, value in config["mappings"] || ([])) {
        ob->map_skill(key, value);
        require(ob->query_skill_mapped(key) == value, "effective skill mapping");
    }
    foreach (key, value in config["preparations"] || ([])) ob->prepare_skill(key, value);
    if (side == 0 && member_array(current["parameters"]["collection_group"],
        ({ "shaolin-additional", "shaolin-weapon-learning" })) != -1 &&
        current["parameters"]["skill"] == "qingyun-bian") {
        // Run before wield/reset_action can load this legacy shared skill object.
        current["skill_load_context"] = ([ "actor": file_name(ob),
            "already_loaded": objectp(find_object("/kungfu/skill/qingyun-bian")),
            "max_neili": ob->query("max_neili"), "shen": ob->query("shen") ]);
        ob->map_skill("whip");
        require(ob->force_me("enable whip qingyun-bian"), "original Qingyun enable context");
    }
    ob->set_temp("apply/armor", 100);
    if (side < 2) test_clothes[side] = 0;
    if (mapp(config["cloth"])) {
        require(current["parameters"]["collection_group"] == "shaolin-hands" && side == 1,
            "explicit test clothing");
        item = new("/tests/cloth");
        item->set("armor_prop/armor", config["cloth"]["armor"]);
        require(item->move(ob) && item->wear() && ob->query_temp("armor/cloth") == item,
            "original clothing wear");
        test_clothes[side] = item;
    }
    if (mapp(config["handing_equipment"])) {
        require(current["parameters"]["collection_group"] == "taohua-bihai" && side == 0 &&
            member_array(config["handing_equipment"]["type"], ({ "xsword", "sword" })) != -1,
            "explicit BIHAI held instrument");
        held = new("/tests/" + config["handing_equipment"]["type"]);
        require(held->move(ob) && ob->force_me("hand practice weapon") &&
            ob->query_temp("handing") == held && !ob->query_temp("weapon") &&
            environment(held) == ob, "original BIHAI hand before primary weapon");
    }
    if (mapp(config["equipment"])) {
        if (config["equipment"]["item_make"]) {
            require(current["parameters"]["collection_group"] == "gumu-advanced" &&
                member_array(config["equipment"]["type"], ({ "sword", "hammer" })) != -1,
                "explicit crafted test weapon");
            weapon = new("/tests/crafted_" + config["equipment"]["type"]);
            require(weapon->is_item_make(), "original crafted weapon identity");
        } else if (is_taohua_po()) {
            require((side == 0 && config["equipment"]["hold"] &&
                member_array(config["equipment"]["program"],
                    ({ "/d/items/throwing/taohua_ban", "/tests/sword" })) != -1) ||
                (side == 1 && config["equipment"]["type"] == "sword" &&
                    !config["equipment"]["hold"]), "explicit original PO equipment");
            weapon = new(side == 0 ? config["equipment"]["program"] : "/tests/sword");
            if (side == 0 && config["equipment"]["type"] == "throwing") {
                require(intp(config["equipment"]["amount"]) && config["equipment"]["amount"] > 0,
                    "positive initial PO ammunition");
                weapon->set_amount(config["equipment"]["amount"]);
            }
        } else if (needle_collection()) {
            require(side == 0 && member_array(config["equipment"]["program"],
                ({ "/d/gumu/obj/yufeng-zhen", "/d/gumu/obj/bingpo-zhen",
                    "/tests/throwing", "/tests/sword" })) != -1, "explicit original needle");
            weapon = new(config["equipment"]["program"]);
            if (config["equipment"]["type"] == "throwing") {
                require(intp(config["equipment"]["amount"]) &&
                    config["equipment"]["amount"] > 0, "positive initial ammunition");
                weapon->set_amount(config["equipment"]["amount"]);
            }
        } else weapon = new("/tests/" + config["equipment"]["type"]);
        if (!undefinedp(config["equipment"]["weight"])) {
            require(current["parameters"]["collection_group"] == "gumu-advanced" &&
                intp(config["equipment"]["weight"]) && config["equipment"]["weight"] > 0 &&
                intp(config["equipment"]["value"]) && config["equipment"]["value"] > 0,
                "explicit test weight and value");
            weapon->set_weight(config["equipment"]["weight"]);
            weapon->set("value", config["equipment"]["value"]);
        }
        if (!undefinedp(config["equipment"]["id"])) {
            require(current["parameters"]["collection_group"] == "gumu-weapon-learning" &&
                side == 0 && stringp(config["equipment"]["id"]), "explicit learning weapon id");
            weapon->set("id", config["equipment"]["id"]);
        }
        // Only the explicitly configured test item's material is varied.
        foreach (key, value in config["equipment"]["properties"] || ([])) {
            require(key == "material" && stringp(value), "configured test material");
            weapon->set(key, value);
        }
        require(weapon->move(ob), "equipment inventory");
        if (!undefinedp(config["equipment"]["slot"]))
            require(member_array(current["parameters"]["collection_group"],
                ({ "gumu-unarmed-learning", "taohua-zhuan" })) != -1 &&
                side == 0 && config["equipment"]["type"] == "sword" && !config["equipment"]["hold"] &&
                member_array(config["equipment"]["slot"], ({ "weapon", "secondary_weapon" })) != -1,
                "explicit unarmed learning weapon slot");
        if (config["equipment"]["hold"]) {
            if (weapon->query("skill_type") == "throwing")
                require(!weapon->wield(), "ammunition cannot be wielded");
            require(ob->force_me("hand " + (config["equipment"]["hand_id"] || "jinshe zhui")),
                "hand ammunition");
            require(
                ob->query_temp("handing") == weapon && !ob->query_temp("weapon"),
                "held not wielded"
            );
        } else if (config["equipment"]["slot"] == "secondary_weapon") {
            // Diagnostic placement only: no wield(), flag rewrite, or primary weapon apply.
            ob->set_temp("secondary_weapon", weapon);
            require(ob->query_temp("secondary_weapon") == weapon && !ob->query_temp("weapon"),
                "diagnostic secondary weapon without primary");
        } else require(weapon->wield() && ob->query_temp("weapon") == weapon, "weapon wielded");
    }
    if (current["parameters"]["collection_group"] == "taohua-bihai") {
        require(ob->query_temp("handing") == held && ob->query_temp("weapon") == weapon,
            "exact BIHAI held and primary slots");
        if (objectp(held))
            require(held != weapon && environment(held) == ob,
                "distinct owned BIHAI instrument preserved after wield");
    }
    if (config["busy"]) {
        if (member_array(current["parameters"]["collection_group"],
            ({ "gumu-hubo", "gumu-quanzhen", "gumu-temporal" })) != -1 ||
            (!side && current["parameters"]["teaching_profile"] == "gumu-recruit"))
            ob->restore_busy(({ config["busy"], 0 }));
        else ob->start_busy(config["busy"]);
    }
    foreach (key, value in config["temp"] || ([])) {
        require((is_taohua_ding() && key == "no_perform" && value == 1) ||
            (!side && current["parameters"]["teaching_profile"] == "gumu-recruit" &&
                key == "quest" && mapp(value) && sizeof(value) == 1 && value["next_level"] == 3) ||
            (intp(value) &&
                ((current["parameters"]["collection_group"] == "gumu-combo" && side == 0 &&
                    key == "apply/attack") ||
                    (member_array(current["parameters"]["collection_group"],
                        ({ "gumu-zhi", "gumu-quanzhen" })) != -1 && side == 0 &&
                        key == "apply/attack" && value == 17) ||
                    (current["parameters"]["collection_group"] == "gumu-hubo" && side == 0 &&
                        key == "no_perform" && value == 1) ||
                    (current["parameters"]["collection_group"] == "gumu-cultivation" && side == 0 && value > 0 &&
                        member_array(key, ({ "apply/str", "apply/int" })) != -1) ||
                    (current["parameters"]["collection_group"] == "gumu-weapon-learning" && side == 0 &&
                        key == "apply/dex" && value == 1) ||
                    (current["parameters"]["collection_group"] == "gumu-unarmed-learning" && side == 0 &&
                        key == "apply/str") ||
                    (current["parameters"]["collection_group"] == "gumu-exert" && side == 0 &&
                        ((member_array(key, ({ "powerup", "no_exert" })) != -1 && value == 1) ||
                            (member_array(
                                key,
                                ({ "apply/attack", "apply/defense", "apply/unarmed_damage" })
                            ) != -1 && value > 0))) ||
                    (current["parameters"]["collection_group"] == "gumu-poison" &&
                        side == (current["method"] == "condition" ? 0 : 1) && key == "nopoison") ||
                    (current["parameters"]["collection_group"] == "gumu-unarmed-attack" &&
                        side == 1 && key == "nopoison" && value == 1) ||
                    (needle_collection() && !is_taohua_po() && side == 1 &&
                        member_array(key, ({ "nopoison", "bingpo", "apply/attack", "apply/dodge",
                            "apply/parry" })) != -1) ||
                    (current["parameters"]["collection_group"] == "gumu-advanced" && side == 0 &&
                        member_array(key, ({ "apply/attack", "apply/str" })) != -1) ||
                    (current["parameters"]["teaching_profile"] == "shaolin-recruit" && side == 0 &&
                        member_array(
                            key,
                            ({ "have_letter", "apprentice_ok", "valid_in_fumoquan" })
                        ) != -1) ||
                    (current["parameters"]["collection_group"] == "wudang-passive" &&
                        member_array(key, ({ "combat_time", "action_flag", "apply/attack", "apply/parry",
                            "apply/unarmed_damage" })) != -1) ||
                    (current["parameters"]["collection_group"] == "shaolin-backlash" && side == 0 && key == "no_exert") ||
                    (current["parameters"]["collection_group"] == "emei-jiuyin-buff" && side == 0 &&
                        member_array(key, ({ "powerup", "shield", "gui_yuan", "no_exert", "no_perform",
                            "str", "dex", "apply/attack", "apply/armor", "apply/force", "apply/dodge",
                            "apply/damage", "apply/unarmed_damage", "apply/str", "apply/dex" })) != -1) ||
                    (current["parameters"]["collection_group"] == "shaolin-exert" && side == 0 &&
                        member_array(
                            key,
                            ({ "powerup", "no_exert", "apply/attack", "apply/defense" })
                        ) != -1) ||
                    (member_array(current["parameters"]["collection_group"],
                        ({ "emei-exert", "emei-zhao" })) != -1 && side == 0 &&
                        member_array(
                            key,
                            ({
                                "powerup",
                                "no_exert",
                                "apply/attack",
                                "apply/dodge",
                                "apply/damage"
                            })
                        ) != -1) ||
                    (current["parameters"]["collection_group"] == "wudang-special" &&
                        member_array(
                            key,
                            ({ "apply/attack", "apply/defense", "apply/armor" })
                        ) != -1) ||
                    (current["parameters"]["collection_group"] == "shaolin-sword" && side == 1 &&
                        member_array(
                            key,
                            ({ "powerup", "damo_qingxin", "apply/attack", "apply/defense" })
                        ) != -1) ||
                    (current["parameters"]["collection_group"] == "shaolin-weapons" && side == 0 &&
                        member_array(
                            key,
                            ({ "cbd_sheshen", "zg_zuida", "sl_leidong", "powerup" })
                        ) != -1) ||
                    (current["parameters"]["collection_group"] == "shaolin-additional" && side == 0 && key == "zhen_yan") ||
                    (current["parameters"]["collection_group"] == "shaolin-fists" && side == 0 && key == "jingang") ||
                    (current["parameters"]["collection_group"] == "shaolin-palms" && side == 0 &&
                        member_array(key, ({ "brz_feng", "action_flag" })) != -1) ||
                    (member_array(
                        current["parameters"]["collection_group"],
                        ({ "wudang-healing", "shaolin-healing", "emei-healing", "gumu-healing" })
                    ) != -1 && key == "tianmo" && value == 1) ||
                    (!side && current["parameters"]["teaching_profile"] == "gumu-recruit" &&
                        key == "apply/per" && value == 20))),
            "configured starting state");
        ob->set_temp(key, value);
    }
    if (side == 0 && current["parameters"]["collection_group"] == "gumu-combo" &&
        !undefinedp(current["parameters"]["cooldown_age_seconds"])) {
        value = current["parameters"]["cooldown_age_seconds"];
        require(current["parameters"]["ability"] == "tuo" && intp(value) && value >= 0,
            "explicit cooldown age relative to original clock");
        ob->set_temp("last_perform/sad-strike/tuo", time() - value);
    }
    foreach (key, value in config["conditions"] || ([])) {
        require((member_array(current["parameters"]["collection_group"],
            ({
                "wudang-dispel",
                "wudang-condition",
                "shaolin-dispel",
                "emei-dispel",
                "gumu-dispel"
            })) != -1 &&
            member_array(
                key,
                ({ "drunk", "ill_kesou", "freezing", "damo_luanqi", "bandaged" })
            ) != -1) || (current["parameters"]["collection_group"] == "shaolin-weapons" &&
            side == 0 && key == "drunk" && intp(value) && value > 0) ||
            (current["parameters"]["collection_group"] == "emei-jiuyin-passive" &&
                key == "cuixin_zhang" && mapp(value)) ||
            (current["parameters"]["collection_group"] == "gumu-poison" &&
                side == (current["method"] == "condition" ? 0 : 1) &&
                key == "wudu_shenzhang" && mapp(value)) ||
            (current["parameters"]["collection_group"] == "gumu-exert" &&
                side == 0 && key == "exert_drug" && value == 10) ||
            (member_array(current["parameters"]["collection_group"],
                ({ "shaolin-public-force", "gumu-exert" })) != -1 &&
                current["parameters"]["ability"] == "roar" && side > 0 && key == "die_guard" && value == 100),
            "explicit initial condition");
        // Original dispel/update may mutate the mapping, never the saved input.
        ob->apply_condition(key, serializable(value));
    }
    ob->observation_heartbeat(0);
    require(
        userp(ob) && interactive(ob) && playerp(ob) && !wizardp(ob),
        "unprivileged player identity"
    );
}

void observe_attack(object me, object target, int attack_type, int result, int damage) {
    mapping value, prepared;
    object weapon;
    string usage;
    int flag;
    if (is_npc_bout()) {
        require(npc_bout_side(me) != -2 && npc_bout_side(target) != -2 && me != target,
            "exact natural NPC attack pair");
        npc_bout_count(
            me,
            result == RESULT_HIT ? "hit" : result == RESULT_DODGE ? "dodge" : "parry"
        );
        if (attack_type == TYPE_QUICK) npc_bout_count(me, "quick");
        if (attack_type == TYPE_RIPOSTE) npc_bout_count(me, "riposte");
    }
    if (!is_npc_bout() || me != gumu_npc) {
        me->count_event(result == RESULT_HIT ? "hit" : result == RESULT_DODGE ? "dodge" : "parry");
        if (attack_type == TYPE_QUICK) me->count_event("quick");
        if (attack_type == TYPE_RIPOSTE) me->count_event("riposte");
    }
    if (active) {
        value = ([ "actor": member_array(me, players),
            "target": member_array(target, players), "type": attack_type,
            "result": result, "damage": damage ]);
        if (is_npc_bout()) {
            value["actor_object"] = file_name(me);
            value["target_object"] = file_name(target);
        }
        if (current["parameters"]["collection_group"] == "gumu-npc") {
            require(
                me == gumu_npc && target == players[0],
                "exact original NPC attack owner and target"
            );
            value["actor_object"] = file_name(me);
            value["actor_program"] = base_name(me);
            value["target_object"] = file_name(target);
            value["apply_attack"] = me->query_temp("apply/attack");
        }
        if (current["parameters"]["teaching_profile"] == "shaolin-challenge") {
            value["actor_program"] = base_name(me);
            value["target_program"] = base_name(target);
            value["elapsed"] = time_ns() / 1000000000.0 - formation_started;
        }
        if (member_array(
            current["parameters"]["collection_group"],
            ({
                "wudang-combination",
                "shaolin-combination",
                "emei-combination",
                "gumu-combination",
                "gumu-quanzhen",
                "taohua-combination",
                "wudang-bout",
                "shaolin-bout",
                "emei-bout",
                "gumu-bout",
                "taohua-combo"
            })
        ) != -1) {
            prepared = me->query_skill_prepare() || ([]);
            weapon = me->query_temp("weapon");
            flag = me->query_temp("action_flag");
            usage = weapon ? weapon->query("skill_type") : sizeof(prepared) ? keys(prepared)[sizeof(prepared) == 2 ? flag : 0] : "unarmed";
            value["action_flag"] = flag;
            value["attack_usage"] = usage;
            value["attack_skill"] = me->query_skill_mapped(usage);
        }
        if (member_array(current["parameters"]["collection_group"],
            ({ "gumu-zhi", "gumu-quanzhen", "taohua-combo" })) != -1)
            value["apply_attack"] = me->query_temp("apply/attack");
        if (current["parameters"]["collection_group"] == "taohua-combo") {
            value["apply_unarmed_damage"] = me->query_temp("apply/unarmed_damage");
            value["neili"] = me->query("neili");
        }
        if (current["parameters"]["collection_group"] == "gumu-quanzhen") {
            weapon = me->query_temp("weapon");
            value["weapon"] = objectp(weapon) ? weapon->query("skill_type") : "none";
            value["weapon_object"] = objectp(weapon) ? file_name(weapon) : "";
        }
        current["attacks"] += ({ value });
    }
}

varargs void observe_direct(object me, object target, int type, int damage, int percent) {
    object weapon;
    if (is_npc_bout()) {
        require(me == gumu_npc && target == players[0], "original natural NPC direct pair");
        npc_bout_count(me, "direct");
        current["npc_direct"] += ({ ([ "actor": -1, "actor_object": file_name(me),
            "target": 0, "target_object": file_name(target), "type": type,
            "damage": damage, "percent": percent ]) });
    } else me->count_event("direct");
    if (active && current["parameters"]["collection_group"] == "emei-npc")
        current["npc_direct"] += ({ ([ "actor_program": base_name(me),
            "target": member_array(target, players) ]) });
    if (active && current["parameters"]["collection_group"] == "gumu-npc") {
        require(
            me == gumu_npc && target == players[0],
            "exact original NPC direct owner and target"
        );
        current["npc_direct"] += ({ ([ "actor": member_array(me, players),
            "actor_object": file_name(me), "actor_program": base_name(me),
            "target": member_array(target, players), "target_object": file_name(target),
            "type": type, "damage": damage, "percent": percent ]) });
    }
    if (active && member_array(current["parameters"]["collection_group"],
        ({
            "gumu-quanzhen",
            "gumu-temporal",
            "taohua-ding",
            "taohua-zhuan",
            "taohua-direct"
        })) != -1) {
        weapon = me->query_temp("weapon");
        current["directs"] += ({ ([ "actor": member_array(me, players),
            "target": member_array(target, players), "type": type, "damage": damage,
            "percent": percent, "weapon": objectp(weapon) ? weapon->query("skill_type") : "none",
            "weapon_object": objectp(weapon) ? file_name(weapon) : "" ]) });
    }
}

