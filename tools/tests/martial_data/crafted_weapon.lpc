// Only the isolated launcher substitutes the weapon category. No save/restore or crafting occurs.
#include <weapon.h>
inherit AXE;
inherit F_ITEMMAKE;

void create() {
    if (clonep()) set_default_object(__FILE__);
    set_name("演武兵器", ({ "practice weapon" }));
    set("unit", "柄");
    set_weight(3000);
    init_axe(50);
    setup();
}
