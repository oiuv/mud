// Test fixture: xuanyuan arrow for xuanyuan-arrow/baibu perform.
// Only the isolated launcher loads this; no game source changes.
#include <weapon.h>
inherit THROWING;

int is_arrow() { return 1; }

void create() {
    if (clonep()) set_default_object(__FILE__);
    set_name("轩辕箭", ({ "xuanyuan arrow", "xuanyuan", "arrow" }));
    set("id", "xuanyuan arrow");
    set("unit", "支");
    // base_weight is per-unit; set_amount() computes total = amount * base_weight.
    set("base_weight", 4);
    // init_throwing/setup return early on clones; set properties explicitly.
    set("weapon_prop/damage", 50);
    set("flag", 8);  // POINTED
    set("no_wield", "暗器不是用来装备的。\n");
    set("skill_type", "throwing");
    set("consistence", 100);
    set_amount(50);
}
