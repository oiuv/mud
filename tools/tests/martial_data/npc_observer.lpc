// Original objects in the isolated copy only. No replacement NPC or forced random.
private object gumu_npc, gumu_companion, gumu_target;
private object *gumu_owned = ({});
private mapping gumu_result;
private mapping gumu_bout_owned;
private string *gumu_bout_items = ({});
private string *gumu_bout_corpses = ({});
private int mingjiao_bout;
private int emei_bout;

mapping state(object ob) {
    mapping result, properties, item_state;
    object item, weapon;
    string key;
    mixed callback;
    mixed *inventory, *callbacks;
    properties = ([]);
    foreach (key in ({ "str", "int", "con", "dex", "qi", "eff_qi", "max_qi",
        "jing", "eff_jing", "max_jing", "neili", "max_neili", "jiali", "combat_exp",
        "gender", "family", "chat_chance_combat" })) properties[key] = ob->query(key);
    inventory = ({});
    foreach (item in all_inventory(ob)) {
        item_state = ([ "program": base_name(item), "name": item->query("name"),
            "skill_type": item->query("skill_type"), "equipped": item->query("equipped"),
            "weapon_prop": copy(item->query("weapon_prop") || ([])),
            "armor_prop": copy(item->query("armor_prop") || ([])) ]);
        inventory += ({ item_state });
    }
    callbacks = ({});
    foreach (callback in ob->query("chat_msg_combat") || ({}))
        callbacks += ({ sprintf("%O", callback) });
    weapon = ob->query_temp("weapon");
    result = ([ "program": base_name(ob), "name": ob->name(), "clone": clonep(ob),
        "userp": userp(ob), "playerp": playerp(ob), "living": living(ob),
        "properties": properties, "skills": copy(ob->query_skills() || ([])),
        "mappings": copy(ob->query_skill_map() || ([])),
        "preparations": copy(ob->query_skill_prepare() || ([])),
        "inventory": inventory, "weapon": weapon ? weapon->query("skill_type") : "none",
        "combat_callbacks": callbacks, "busy": ob->query_busy(),
        "temp": "/tests/runner"->serializable(ob->query_entire_temp_dbase()),
        "effective_str": ob->query_str(), "effective_dex": ob->query_dex() ]);
    return result;
}

mapping observe(mapping config, object target) {
    object npc, item;
    mapping result;
    mixed *callbacks;
    int index;
    if (strsrch(config["path"], "/kungfu/class/emei/") != 0 ||
        !interactive(target) || !userp(target) || wizardp(target))
        error("Original NPC observation requires reviewed source and connected player.\n");
    npc = new(config["path"]);
    if (!npc->move(environment(target))) error("Original NPC move failed.\n");
    result = ([ "before": state(npc), "called": 0 ]);
    index = config["callback_index"];
    if (index >= 0) {
        callbacks = npc->query("chat_msg_combat");
        if (config["path"] != "/kungfu/class/emei/zhou" || index >= 8 ||
            !arrayp(callbacks) || sizeof(callbacks) != 8 || !functionp(callbacks[index]))
            error("Unreviewed original NPC callback.\n");
        npc->kill_ob(target);
        target->kill_ob(npc);
        result["called"] = 1;
        result["callback_index"] = index;
        result["result"] = evaluate(callbacks[index]);
        target->remove_enemy(npc);
        target->remove_killer(npc);
        npc->remove_enemy(target);
        npc->remove_killer(target);
    }
    result["after"] = state(npc);
    foreach (item in all_inventory(npc)) destruct(item);
    destruct(npc);
    result["destroyed"] = !objectp(npc);
    return result;
}

// Narrow original-Gumu observation. The Emei snapshot/entry above is unchanged.
string *gumu_loaded_skills() {
    string skill;
    string *result;
    result = ({});
    foreach (skill in ({ "suxin-jian", "quanzhen-jian", "yinsuo-jinling",
        "sanwu-shou", "wudu-shenzhang", "sad-strike" }))
        if (objectp(find_object("/kungfu/skill/" + skill))) result += ({ "/kungfu/skill/" + skill });
    return result;
}

mixed *gumu_callbacks(object *owners) {
    mixed row;
    mixed *result;
    result = ({});
    foreach (row in call_out_info())
        if (objectp(row[0]) && member_array(row[0], owners) != -1)
            result += ({ ([ "owner": file_name(row[0]),
                "function": "/tests/runner"->serializable(row[1]), "remaining": row[2]]) });
    return result;
}

mapping gumu_state(object ob) {
    mapping result, item_state;
    object item, weapon;
    mixed fun;
    string key;
    result = state(ob);
    result["object"] = file_name(ob);
    result["interactive"] = interactive(ob);
    result["wizardp"] = wizardp(ob);
    result["learned"] = copy(ob->query_learned() || ([]));
    foreach (key in ({ "id", "potential", "couple/id", "static/marry" }))
        result["properties"][key] = ob->query(key);
    result["inventory"] = ({});
    foreach (item in all_inventory(ob)) {
        item_state = ([ "object": file_name(item), "program": base_name(item),
            "name": item->query("name"), "clone": clonep(item),
            "environment": file_name(environment(item)),
            "skill_type": item->query("skill_type"), "equipped": item->query("equipped"),
            "consistence": item->query("consistence"),
            "weapon_prop": copy(item->query("weapon_prop") || ([])),
            "armor_prop": copy(item->query("armor_prop") || ([])) ]);
        result["inventory"] += ({ item_state });
    }
    weapon = ob->query_temp("weapon");
    result["weapon_object"] = objectp(weapon) ? file_name(weapon) : "";
    weapon = ob->query_temp("secondary_weapon");
    result["secondary_weapon_object"] = objectp(weapon) ? file_name(weapon) : "";
    result["combat_callback_owners"] = ({});
    foreach (fun in ob->query("chat_msg_combat") || ({}))
        result["combat_callback_owners"] += ({ functionp(fun) ?
            "/tests/runner"->serializable(function_owner(fun)) : "" });
    result["callouts"] = gumu_callbacks(({ ob }));
    return result;
}

mapping clear_gumu() {
    object ob, item;
    object *remaining;
    mapping cleanup;
    string name;
    int index;
    if (base_name(previous_object()) != "/tests/runner" && previous_object() != this_object())
        error("Scoped original Gumu cleanup only.\n");
    if (!objectp(gumu_npc) && !objectp(gumu_companion) && !sizeof(gumu_owned)) return gumu_result;
    cleanup = ([ "enemies_removed": 1, "objects": ({}), "remaining_callbacks": ({}) ]);
    foreach (ob in ({ gumu_npc, gumu_companion })) {
        if (!objectp(ob)) continue;
        evaluate(bind((: set_heart_beat, 0 :), ob));
        if (objectp(gumu_target)) {
            gumu_target->remove_enemy(ob);
            gumu_target->remove_killer(ob);
            ob->remove_enemy(gumu_target);
            ob->remove_killer(gumu_target);
            if (gumu_target->is_fighting(ob) || ob->is_fighting(gumu_target))
                cleanup["enemies_removed"] = 0;
        }
        foreach (item in deep_inventory(ob))
            if (member_array(item, gumu_owned) == -1) gumu_owned += ({ item });
    }
    // The exact references include the original singleton only after the original
    // constructor moved it into one of this sample's two NPCs. Never seize it.
    remaining = copy(gumu_owned);
    for (index = sizeof(gumu_owned) - 1; index >= 0; index--) {
        ob = gumu_owned[index];
        if (!objectp(ob)) continue;
        name = file_name(ob);
        destruct(ob);
        cleanup["objects"] += ({ ([ "object": name, "destroyed": !objectp(ob) ]) });
    }
    cleanup["remaining_callbacks"] = gumu_callbacks(remaining);
    if (mapp(gumu_result)) {
        gumu_result["cleanup"] = cleanup;
        gumu_result["destroyed"] = !objectp(gumu_npc) && !objectp(gumu_companion);
    }
    gumu_npc = 0;
    gumu_companion = 0;
    gumu_target = 0;
    gumu_owned = ({});
    return gumu_result;
}

void observe_gumu_step(object me, string argument, string phase, int accepted, mixed reason) {
    mapping step;
    if (base_name(previous_object()) != "/tests/runner" || me != gumu_npc || !mapp(gumu_result))
        error("Scoped original NPC dual command observation.\n");
    if (phase == "before") {
        gumu_result["steps"] += ({ ([ "argument": argument, "actor_object": file_name(me),
            "target_object": file_name(gumu_target), "before": gumu_state(me) ]) });
        return;
    }
    if (phase != "after" || !sizeof(gumu_result["steps"])) error("Unmatched NPC dual command.\n");
    step = gumu_result["steps"][<1];
    if (step["argument"] != argument || !undefinedp(step["after"])) error("Duplicate NPC dual command.\n");
    step["accepted"] = accepted;
    step["reason"] = accepted || !stringp(reason) ? "" : reason;
    step["after"] = gumu_state(me);
}

// Shared original construction. No combat closure or heartbeat is run here.
mapping prepare_gumu(mapping config, object target) {
    object silver, blueprint;
    object *autonomous;
    mixed absent;
    mapping prep, silver_state;
    if (base_name(previous_object()) != "/tests/runner" ||
        member_array(config["path"], ({ "/kungfu/class/gumu/li", "/kungfu/class/gumu/lin",
            "/kungfu/class/gumu/longnv", "/kungfu/class/gumu/yang" })) == -1 ||
        this_player() != target || !interactive(target) || !userp(target) || !playerp(target) || wizardp(target))
        error("Original Gumu NPC requires reviewed source and real player context.\n");
    if (objectp(gumu_npc) || objectp(gumu_companion) || sizeof(gumu_owned))
        error("Prior original NPC observation not cleaned.\n");
    gumu_target = target;
    // The host JSON decoder maps null to LPC zero. called/index and NPC/silver
    // context distinguish these explicit absent observations from real results.
    absent = json_decode("null");
    prep = ([ "entry_player": file_name(this_player()), "initializer_actor": "not_observed",
        "loaded_before": gumu_loaded_skills(), "created_npcs": ({}) ]);
    gumu_result = ([ "preparation": prep, "steps": ({}), "silver": absent,
        "room": file_name(environment(target)), "target_object": file_name(target),
        "called": 0, "callback_index": config["callback_index"], "callback_owner": "",
        "callback_repr": "", "result": absent ]);
    if (config["path"] == "/kungfu/class/gumu/longnv") {
        silver = find_object("/clone/lonely/yinsuo");
        if (objectp(silver) && environment(silver)) error("Do not take externally occupied silver.\n");
        if (config["silver_state"] == "occupied") {
            gumu_companion = new(config["path"]);
            gumu_owned += ({ gumu_companion }) + deep_inventory(gumu_companion);
            prep["created_npcs"] += ({ file_name(gumu_companion) });
            if (!gumu_companion->move("/tests/team_room")) error("Original companion move failed.\n");
            evaluate(bind((: set_heart_beat, 0 :), gumu_companion));
            silver = find_object("/clone/lonely/yinsuo");
            if (!objectp(silver) || environment(silver) != gumu_companion)
                error("Original companion did not obtain the original singleton.\n");
        } else if (config["silver_state"] != "free") error("Unreviewed silver state.\n");
        silver_state = ([ "object": "/clone/lonely/yinsuo", "clone": 0,
            "state": config["silver_state"], "initial_environment": objectp(silver) && environment(silver) ?
            file_name(environment(silver)) : "", "companion_before": objectp(gumu_companion) ?
            gumu_state(gumu_companion) : absent, "companion_after": absent,
            "companion_room": objectp(gumu_companion) ? file_name(environment(gumu_companion)) : "" ]);
        gumu_result["silver"] = silver_state;
    }
    gumu_npc = new(config["path"]);
    gumu_owned += ({ gumu_npc }) + deep_inventory(gumu_npc);
    prep["created_npcs"] += ({ file_name(gumu_npc) });
    "/tests/runner"->set_gumu_npc_observation(gumu_npc);
    if (!gumu_npc->move(environment(target))) error("Original Gumu NPC move failed.\n");
    prep["npc_heartbeat_before"] = query_heart_beat(gumu_npc);
    evaluate(bind((: set_heart_beat, 0 :), gumu_npc));
    prep["npc_heartbeat_paused"] = query_heart_beat(gumu_npc);
    blueprint = find_object(config["path"]);
    prep["blueprint_heartbeat"] = query_heart_beat(blueprint);
    autonomous = ({ gumu_npc, blueprint }) + deep_inventory(gumu_npc) + deep_inventory(blueprint);
    if (objectp(gumu_companion)) autonomous += ({ gumu_companion }) + deep_inventory(gumu_companion);
    prep["constructor_callbacks"] = gumu_callbacks(autonomous);
    prep["returned_player"] = "/tests/runner"->serializable(this_player());
    prep["loaded_after"] = gumu_loaded_skills();
    if (prep["npc_heartbeat_paused"] || prep["blueprint_heartbeat"] ||
        sizeof(prep["constructor_callbacks"])) error("Original NPC autonomous preparation is not immediate.\n");
    gumu_result["before"] = gumu_state(gumu_npc);
    if (mapp(silver_state)) {
        silver = find_object("/clone/lonely/yinsuo");
        if (!objectp(silver) || clonep(silver) ||
            environment(silver) != (objectp(gumu_companion) ? gumu_companion : gumu_npc))
            error("Original silver/fallback ownership differs.\n");
        silver_state["clone"] = clonep(silver);
        silver_state["before_environment"] = file_name(environment(silver));
    }
    return gumu_result;
}

mapping capture_gumu(int index) {
    object silver;
    mapping silver_state;
    mixed absent;
    absent = json_decode("null");
    gumu_result["after"] = objectp(gumu_npc) ? gumu_state(gumu_npc) : absent;
    gumu_result["execution"] = ([ "target_active_after": objectp(gumu_target) &&
        objectp(gumu_npc) && living(gumu_target) &&
        environment(gumu_target) == environment(gumu_npc) && gumu_target->query("qi") >= 0 &&
        gumu_target->query("jing") >= 0 && (index < 0 || gumu_npc->is_fighting(gumu_target)) ]);
    silver_state = gumu_result["silver"];
    if (mapp(silver_state)) {
        silver = find_object("/clone/lonely/yinsuo");
        silver_state["after_environment"] = objectp(silver) && environment(silver) ? file_name(environment(silver)) : "";
        silver_state["companion_after"] = objectp(gumu_companion) ? gumu_state(gumu_companion) : absent;
    }
    return gumu_result;
}

mapping observe_gumu(mapping config, object target) {
    mixed *callbacks;
    int index;
    prepare_gumu(config, target);
    index = config["callback_index"];
    if (index >= 0) {
        callbacks = gumu_npc->query("chat_msg_combat");
        if (!arrayp(callbacks) || index >= sizeof(callbacks) || !functionp(callbacks[index]) ||
            function_owner(callbacks[index]) != gumu_npc) error("Unreviewed original Gumu callback.\n");
        gumu_npc->kill_ob(target);
        target->kill_ob(gumu_npc);
        gumu_result["called"] = 1;
        gumu_result["callback_owner"] = file_name(function_owner(callbacks[index]));
        gumu_result["callback_repr"] = sprintf("%O", callbacks[index]);
        gumu_result["result"] = evaluate(callbacks[index]);
    }
    capture_gumu(index);
    clear_gumu();
    return gumu_result;
}

// The following staged API is for the separate natural-NPC bout only. It is not
// registered in the collector yet; existing immediate observations keep their shape.
mapping gumu_bout_state(object ob) {
    mapping result, skills, mappings, effective, effective_mappings, prepared;
    string key;
    string *skill_keys;
    if (!objectp(ob)) return 0;
    result = gumu_state(ob);
    result["ghost"] = ob->is_ghost();
    result["conditions"] = "/tests/runner"->serializable(ob->query_condition());
    if (mingjiao_bout || emei_bout) {
        skills = ob->query_skills() || ([]);
        mappings = ob->query_skill_map() || ([]);
        prepared = ob->query_skill_prepare() || ([]);
        effective = ([]);
        effective_mappings = ([]);
        skill_keys = keys(skills);
        foreach (key in keys(mappings)) {
            effective_mappings[key] = ob->query_skill_mapped(key);
            if (member_array(key, skill_keys) == -1) skill_keys += ({ key });
        }
        foreach (key in skill_keys) effective[key] = ob->query_skill(key);
        result["effective_mappings"] = effective_mappings;
        result["effective_skills"] = effective;
        result["preparation_order"] = keys(prepared);
    }
    return result;
}

// Separate fixed entries authorize the nine Mingjiao programs or Zhou only.
// Reuse original construction/ownership/capture/cleanup, never assign NPC input.
private mapping prepare_original_bout(mapping config, object target, int is_emei) {
    mapping prep;
    object blueprint, ob;
    object *autonomous;
    string name, skill;
    string *load_skills;
    mixed failure;
    if (base_name(previous_object()) != "/tests/runner" || config["callback_index"] != -1 ||
        (is_emei ? config["path"] != "/kungfu/class/emei/zhou" :
            member_array(config["path"], ({ "/kungfu/class/mingjiao/daijisi",
                "/kungfu/class/mingjiao/fanyao", "/kungfu/class/mingjiao/lengqian",
                "/kungfu/class/mingjiao/weiyixiao", "/kungfu/class/mingjiao/xiaozhao",
                "/kungfu/class/mingjiao/xiexun", "/kungfu/class/mingjiao/yangxiao",
                "/kungfu/class/mingjiao/yintianzheng", "/kungfu/class/mingjiao/zhangwuji" })) == -1) ||
        this_player() != target || !interactive(target) || !userp(target) ||
        !playerp(target) || wizardp(target))
        error("Original NPC bout requires reviewed source and real player context.\n");
    if (objectp(gumu_npc) || objectp(gumu_companion) || sizeof(gumu_owned))
        error("Prior original NPC observation not cleaned.\n");
    mingjiao_bout = !is_emei;
    emei_bout = is_emei;
    load_skills = is_emei ? ({ "jiuyin-baiguzhao", "cuixin-zhang", "shexing-lifan",
        "yijin-duangu", "yinlong-bian" }) : ({ "qishang-quan", "shenghuo-ling" });
    gumu_target = target;
    prep = ([ "entry_player": file_name(this_player()), "initializer_actor": "not_observed",
        "loaded_before": ({}), "loaded_after": ({}), "created_npcs": ({}) ]);
    foreach (skill in load_skills)
        if (objectp(find_object("/kungfu/skill/" + skill)))
            prep["loaded_before"] += ({ "/kungfu/skill/" + skill });
    gumu_result = ([ "preparation": prep, "room": file_name(environment(target)),
        "target_object": file_name(target) ]);
    failure = catch {
        gumu_npc = new(config["path"]);
        gumu_owned += ({ gumu_npc }) + deep_inventory(gumu_npc);
        prep["created_npcs"] += ({ file_name(gumu_npc) });
        "/tests/runner"->set_gumu_npc_observation(gumu_npc);
        if (!gumu_npc->move(environment(target))) error("Original Mingjiao NPC move failed.\n");
        prep["npc_heartbeat_before"] = query_heart_beat(gumu_npc);
        evaluate(bind((: set_heart_beat, 0 :), gumu_npc));
        prep["npc_heartbeat_paused"] = query_heart_beat(gumu_npc);
        blueprint = find_object(config["path"]);
        prep["blueprint_heartbeat"] = query_heart_beat(blueprint);
        autonomous = ({
            gumu_npc,
            blueprint
        }) + deep_inventory(gumu_npc) + deep_inventory(blueprint);
        prep["constructor_callbacks"] = gumu_callbacks(autonomous);
        prep["returned_player"] = "/tests/runner"->serializable(this_player());
        foreach (skill in load_skills)
            if (objectp(find_object("/kungfu/skill/" + skill)))
                prep["loaded_after"] += ({ "/kungfu/skill/" + skill });
        if (prep["npc_heartbeat_paused"] || prep["blueprint_heartbeat"] ||
            sizeof(prep["constructor_callbacks"])) error("Original NPC autonomous preparation is not immediate.\n");
        gumu_bout_owned = ([]);
        gumu_bout_items = ({});
        gumu_bout_corpses = ({});
        foreach (ob in gumu_owned) {
            name = file_name(ob);
            gumu_bout_owned[name] = ob;
            if (ob != gumu_npc) gumu_bout_items += ({ name });
        }
        gumu_result["before"] = gumu_bout_state(gumu_npc);
    };
    if (failure) {
        clear_gumu();
        mingjiao_bout = 0;
        emei_bout = 0;
        error(stringp(failure) ? failure : sprintf("%O", failure));
    }
    return gumu_result;
}

mapping prepare_mingjiao_bout(mapping config, object target) {
    return prepare_original_bout(config, target, 0);
}

// Exact Zhou entry; shared construction never assigns NPC attributes or gear.
mapping prepare_emei_bout(mapping config, object target) {
    return prepare_original_bout(config, target, 1);
}

mapping prepare_gumu_bout(mapping config, object target) {
    object ob;
    mixed failure;
    string name;
    int index;
    if (base_name(previous_object()) != "/tests/runner" || config["callback_index"] != -1)
        error("Natural NPC bout preparation cannot select a closure.\n");
    if (objectp(gumu_npc) || objectp(gumu_companion) || sizeof(gumu_owned))
        error("Prior original NPC observation not cleaned.\n");
    failure = catch { prepare_gumu(config, target); };
    if (failure) {
        // Preparation has not enabled autonomous combat. Reuse the immediate
        // cleanup for any references already created before a setup/move error.
        clear_gumu();
        error(stringp(failure) ? failure : sprintf("%O", failure));
    }
    gumu_bout_owned = ([]);
    gumu_bout_items = ({});
    gumu_bout_corpses = ({});
    // Preserve exact names before destruction invalidates object references.
    foreach (ob in gumu_owned) gumu_bout_owned[file_name(ob)] = ob;
    for (index = sizeof(gumu_owned) - 1; index >= 0; index--) {
        name = file_name(gumu_owned[index]);
        if (member_array(name, gumu_result["preparation"]["created_npcs"]) == -1)
            gumu_bout_items += ({ name });
    }
    gumu_result["before"] = gumu_bout_state(gumu_npc);
    if (mapp(gumu_result["silver"])) {
        gumu_result["silver"]["companion_before"] = gumu_bout_state(gumu_companion);
        gumu_result["silver"]["companion_heartbeat"] = objectp(gumu_companion) ? query_heart_beat(gumu_companion) : 0;
    }
    return gumu_result;
}

object query_gumu_bout_actor() {
    if (base_name(previous_object()) != "/tests/runner" || !mapp(gumu_bout_owned))
        error("Scoped natural NPC bout actor only.\n");
    return gumu_npc;
}

// The runner supplies only the actual make_corpse return observed at CHARD.
// This does not search the room or take ownership of arbitrary dropped objects.
void own_gumu_bout_corpse(object corpse) {
    if (base_name(previous_object()) != "/tests/runner" || !mapp(gumu_bout_owned) ||
        !objectp(corpse) || !clonep(corpse) || base_name(corpse) != "/clone/misc/corpse")
        error("Exact original corpse return only.\n");
    gumu_bout_owned[file_name(corpse)] = corpse;
    if (member_array(file_name(corpse), gumu_bout_corpses) == -1)
        gumu_bout_corpses += ({ file_name(corpse) });
}

mapping capture_gumu_bout() {
    if (base_name(previous_object()) != "/tests/runner" || !mapp(gumu_bout_owned))
        error("Scoped natural NPC bout capture only.\n");
    capture_gumu(-1);
    gumu_result["after"] = gumu_bout_state(gumu_npc);
    if (mapp(gumu_result["silver"]))
        gumu_result["silver"]["companion_after"] = gumu_bout_state(gumu_companion);
    return gumu_result;
}

mapping clear_gumu_bout() {
    mapping cleanup, existence;
    object ob;
    object *owners;
    string name;
    int existed;
    if (base_name(previous_object()) != "/tests/runner")
        error("Scoped natural NPC bout cleanup only.\n");
    if (!mapp(gumu_bout_owned)) return gumu_result;
    cleanup = ([ "enemies_removed": 1, "objects": ({}), "remaining_callbacks": ({}) ]);
    foreach (ob in ({ gumu_npc, gumu_companion })) {
        if (!objectp(ob)) continue;
        evaluate(bind((: set_heart_beat, 0 :), ob));
        if (objectp(gumu_target)) {
            gumu_target->remove_enemy(ob);
            gumu_target->remove_killer(ob);
            ob->remove_enemy(gumu_target);
            ob->remove_killer(gumu_target);
            if (gumu_target->is_fighting(ob) || ob->is_fighting(gumu_target)) cleanup["enemies_removed"] = 0;
        }
    }
    owners = values(gumu_bout_owned);
    existence = ([]);
    foreach (name in keys(gumu_bout_owned)) existence[name] = objectp(gumu_bout_owned[name]);
    // As with immediate cleanup, remove original inventory leaves first. Then
    // remove returned corpses and finally original NPCs, never arbitrary room items.
    foreach (name in gumu_bout_items + gumu_bout_corpses +
        gumu_result["preparation"]["created_npcs"]) {
        ob = gumu_bout_owned[name];
        existed = existence[name];
        if (objectp(ob)) destruct(ob);
        cleanup["objects"] += ({ ([ "object": name, "existed_before_cleanup": existed,
            "destroyed": !objectp(ob) ]) });
    }
    cleanup["remaining_callbacks"] = gumu_callbacks(owners);
    gumu_result["cleanup"] = cleanup;
    gumu_result["destroyed"] = !objectp(gumu_npc) && !objectp(gumu_companion);
    gumu_npc = 0;
    gumu_companion = 0;
    gumu_target = 0;
    gumu_owned = ({});
    gumu_bout_owned = 0;
    gumu_bout_items = ({});
    gumu_bout_corpses = ({});
    mingjiao_bout = 0;
    emei_bout = 0;
    return gumu_result;
}

// Scoped precondition for the taohua observer; mirrors the runner require apply.
private void taohua_require(int condition, string message) {
    if (!condition) error(message + "\n");
}

// Exact original taohua NPC observation. The Gumu/Emei observers above are unchanged.
private object taohua_npc, taohua_companion, taohua_target;
private object *taohua_owned = ({});
private mapping taohua_result;

string *taohua_loaded_skills() {
    string skill;
    string *result;
    result = ({});
    foreach (skill in get_dir("/kungfu/skill/")) {
        if (strsrch(skill, ".c") < 0 && strsrch(skill, ".lpc") < 0) continue;
        skill = replace_string(replace_string(skill, ".lpc", ""), ".c", "");
        if (objectp(find_object("/kungfu/skill/" + skill)))
            result += ({ "/kungfu/skill/" + skill });
    }
    return result;
}

mixed *taohua_callouts(object ob) {
    mixed row;
    mixed *result;
    result = ({});
    foreach (row in call_out_info())
        if (objectp(row[0]) && row[0] == ob)
            result += ({ ([ "owner": file_name(row[0]),
                "function": "/tests/runner"->serializable(row[1]), "remaining": row[2]]) });
    return result;
}

private mapping taohua_item_state(object item, int after, string kind) {
    mapping result;
    result = ([ "object": file_name(item), "program": base_name(item),
        "name": item->query("name"), "clone": clonep(item),
        "environment": objectp(environment(item)) ? file_name(environment(item)) : "",
        "skill_type": item->query("skill_type"), "equipped": item->query("equipped"),
        "consistence": item->query("consistence"),
        "weapon_prop": copy(item->query("weapon_prop") || ([])),
        "armor_prop": copy(item->query("armor_prop") || ([])) ]);
    result["amount"] = item->query_amount();
    result["weight"] = item->query_weight();
    return result;
}

private mapping taohua_state(object ob, mapping cfg, int after, string kind) {
    mapping result, properties;
    object item, weapon;
    string key;
    mixed fun;
    mixed *inventory, *callbacks, *owners;
    int hand_level, level;
    if (!objectp(ob)) return json_decode("null");
    properties = ([]);
    foreach (key in ({ "str", "int", "con", "dex", "qi", "eff_qi", "max_qi",
        "jing", "eff_jing", "max_jing", "neili", "max_neili", "jiali", "combat_exp",
        "gender", "shen", "id", "name", "chat_chance_combat", "potential", "family" }))
        properties[key] = ob->query(key);
    inventory = ({});
    foreach (item in all_inventory(ob))
        inventory += ({ taohua_item_state(item, after, kind) });
    callbacks = ({});
    owners = ({});
    foreach (fun in ob->query("chat_msg_combat") || ({})) {
        callbacks += ({ sprintf("%O", fun) });
        owners += ({ file_name(ob) });
    }
    weapon = ob->query_temp("weapon");
    foreach (key in ({ "unarmed", "cuff", "finger", "strike", "hand", "claw" })) {
        level = ob->query_skill(key);
        if (level > hand_level) hand_level = level;
    }
    result = ([ "object": file_name(ob), "program": base_name(ob), "name": ob->name(),
        "clone": clonep(ob), "userp": userp(ob), "playerp": playerp(ob),
        "interactive": interactive(ob), "wizardp": wizardp(ob), "living": living(ob),
        "properties": properties, "skills": copy(ob->query_skills() || ([])),
        "mappings": copy(ob->query_skill_map() || ([])),
        "preparations": copy(ob->query_skill_prepare() || ([])),
        "learned": copy(ob->query_learned() || ([])),
        "inventory": inventory,
        "weapon": weapon ? weapon->query("skill_type") : "none",
        "weapon_object": objectp(weapon) ? file_name(weapon) : "",
        "secondary_weapon_object": objectp(ob->query_temp("secondary_weapon")) ?
        file_name(ob->query_temp("secondary_weapon")) : "",
        "handing_object": objectp(ob->query_temp("handing")) ? file_name(ob->query_temp("handing")) : "",
        "combat_callbacks": callbacks,
        "combat_callback_owners": owners,
        "busy": ob->query_busy(),
        "callouts": taohua_callouts(ob),
        "temp": "/tests/runner"->serializable(ob->query_entire_temp_dbase()),
        "effective_str": ob->query_str(), "effective_dex": ob->query_dex() ]);
    return result;
}

private mapping taohua_handle_probe(
    object npc,
    string fun,
    int index,
    object target,
    int probe_before
) {
    mapping timer;
    mixed *row, *after;
    object owner_ob;
    int probe_after, handle, remaining, delay, candidate;
    string owner, timer_fun;
    delay = -1;
    owner = "";
    owner_ob = 0;
    timer_fun = fun;
    after = call_out_info();
    foreach (row in after) {
        if (objectp(row[0]) && stringp(row[1]) &&
            member_array(row[1], ({ "ding_end", "cuixin_end" })) != -1) {
            taohua_require(delay < 0, "one original pending skill timer");
            delay = row[2];
            owner_ob = row[0];
            timer_fun = row[1];
            owner = function_exists(row[1], row[0]) || "";
        }
    }
    if (delay < 0) return 0;
    taohua_require(stringp(owner), "original timer owner program");
    probe_after = call_out("taohua_noop", 999);
    remove_call_out("taohua_noop");
    handle = 0;
    for (candidate = probe_before + 1; candidate < probe_after; candidate++) {
        remaining = evaluate(bind((: find_call_out :), owner_ob), candidate);
        if (remaining == delay) {
            taohua_require(!handle, "one original pending call_out handle");
            handle = candidate;
        }
    }
    taohua_require(handle, "original call_out return handle found between probes");
    remaining = evaluate(bind((: remove_call_out :), owner_ob), handle);
    taohua_require(
        remaining >= 0 && remaining <= delay,
        "original handle removed with remaining delay"
    );
    timer = ([ "owner": owner, "function": timer_fun,
        "actor_object": file_name(npc), "target_object": file_name(target),
        "handle": handle, "delay": delay, "fired": 0,
        "removed_remaining": remaining,
        "remaining_after": taohua_callouts(owner_ob) ]);
    return timer;
}

mapping observe_taohua(mapping config, object target) {
    object item, victim;
    int probe_mark, index, occupied;
    mixed *setup_mark;
    mapping prep, timer, singleton_state, cleanup;
    mixed *callbacks, *rows;
    mixed absent;
    string key, path;
    if (base_name(previous_object()) != "/tests/runner" ||
        strsrch(config["path"], "/kungfu/class/taohua/") != 0 ||
        this_player() != target || !interactive(target) || !userp(target) ||
        !playerp(target) || wizardp(target))
        error("Original taohua NPC requires reviewed source and real player context.\n");
    if (objectp(taohua_npc) || objectp(taohua_companion) || sizeof(taohua_owned))
        error("Prior original NPC observation not cleaned.\n");
    absent = json_decode("null");
    taohua_target = target;
    prep = ([ "entry_player": file_name(this_player()), "initializer_actor": "not_observed",
        "loaded_before": taohua_loaded_skills(), "created_npcs": ({}) ]);
    taohua_result = ([ "preparation": prep, "steps": ({}), "room": file_name(environment(target)),
        "target_object": file_name(target), "called": 0,
        "callback_index": config["callback_index"], "callback_owner": "", "callback_repr": "",
        "result": absent, "effect_callouts": ({}), "singletons": ({}) ]);
    occupied = config["singleton_state"] == "occupied";
    if (member_array(config["id"], ({ "huang", "chen" })) != -1) {
        path = config["id"] == "huang" ? "/clone/lonely/yuxiao" : "/clone/lonely/book/zhenjing2";
        item = find_object(path);
        if (occupied) {
            taohua_require(config["id"] == "huang" && !objectp(item),
                "occupied jade only with unclaimed original singleton");
            taohua_companion = new(config["path"]);
            taohua_owned += ({ taohua_companion }) + deep_inventory(taohua_companion);
            prep["created_npcs"] += ({ file_name(taohua_companion) });
            if (!taohua_companion->move("/tests/team_room"))
                error("Original companion move failed.\n");
            evaluate(bind((: set_heart_beat, 0 :), taohua_companion));
            item = find_object(path);
            if (!objectp(item) || environment(item) != taohua_companion)
                error("Original companion did not obtain the original singleton.\n");
        } else if (objectp(item) && environment(item))
            error("Do not take externally occupied original singleton.\n");
        singleton_state = ([ "object": path, "clone": objectp(item) ? clonep(item) : 0,
            "state": occupied ? "occupied" : "free",
            "initial_environment": objectp(item) && environment(item) ?
            file_name(environment(item)) : "",
            "companion_before": objectp(taohua_companion) ?
            taohua_state(taohua_companion, config, 0, "loadout") : absent,
            "companion_after": absent,
            "companion_room": objectp(taohua_companion) ?
            file_name(environment(taohua_companion)) : "" ]);
    }
    taohua_npc = new(config["path"]);
    taohua_owned += ({ taohua_npc }) + deep_inventory(taohua_npc);
    prep["created_npcs"] += ({ file_name(taohua_npc) });
    "/tests/runner"->set_taohua_npc_observation(taohua_npc);
    if (!taohua_npc->move(environment(target))) error("Original taohua NPC move failed.\n");
    // Fixed high-resource experiment input: re-apply the reviewed original
    // property table, then top qi/jing/neili to their declared maxima before
    // any measurement window opens.
    foreach (key in keys(config["original"]["props"]))
        taohua_npc->set(key, config["original"]["props"][key]);
    taohua_npc->set("qi", taohua_npc->query("max_qi"));
    taohua_npc->set("eff_qi", taohua_npc->query("max_qi"));
    taohua_npc->set("jing", taohua_npc->query("max_jing"));
    taohua_npc->set("eff_jing", taohua_npc->query("max_jing"));
    taohua_npc->set("neili", taohua_npc->query("max_neili"));
    if (objectp(taohua_companion)) {
        taohua_companion->set("qi", taohua_companion->query("max_qi"));
        taohua_companion->set("eff_qi", taohua_companion->query("max_qi"));
        taohua_companion->set("jing", taohua_companion->query("max_jing"));
        taohua_companion->set("eff_jing", taohua_companion->query("max_jing"));
        taohua_companion->set("neili", taohua_companion->query("max_neili"));
    }
    prep["npc_heartbeat_before"] = query_heart_beat(taohua_npc);
    evaluate(bind((: set_heart_beat, 0 :), taohua_npc));
    prep["npc_heartbeat_paused"] = query_heart_beat(taohua_npc);
    prep["blueprint_heartbeat"] = query_heart_beat(find_object(config["path"]));
    prep["constructor_callbacks"] = taohua_callouts(taohua_npc);
    if (objectp(taohua_companion))
        prep["constructor_callbacks"] += taohua_callouts(taohua_companion);
    prep["returned_player"] = "/tests/runner"->serializable(this_player());
    prep["loaded_after"] = taohua_loaded_skills();
    if (prep["npc_heartbeat_paused"] || prep["blueprint_heartbeat"] ||
        sizeof(prep["constructor_callbacks"]))
        error("Original NPC autonomous preparation is not immediate.\n");
    index = config["callback_index"];
    if (index >= 0) {
        callbacks = taohua_npc->query("chat_msg_combat") || ({});
        taohua_require(arrayp(callbacks) && index < sizeof(callbacks) && functionp(callbacks[index]),
            "Unreviewed original taohua callback.
");
        taohua_result["called"] = 1;
        taohua_result["callback_owner"] = file_name(taohua_npc);
        taohua_result["callback_repr"] = sprintf("%O", callbacks[index]);
        probe_mark = call_out("taohua_noop", 999);
        setup_mark = "/tests/runner"->taohua_setup_mark();
        taohua_npc->kill_ob(target);
        target->kill_ob(taohua_npc);
        // fight_ob re-arms the USER heartbeat; keep the original command window
        // free of autonomous target strikes.
        target->observation_heartbeat(0);
        // The original kill_ob/fight setup strikes belong to preparation, not
        // the measured command window: trim those setup events and restore the
        // fixed high-resource start before the observed closure runs.
        "/tests/runner"->taohua_trim_setup(setup_mark);
        taohua_npc->set("qi", taohua_npc->query("max_qi"));
        taohua_npc->set("eff_qi", taohua_npc->query("max_qi"));
        taohua_npc->set("jing", taohua_npc->query("max_jing"));
        taohua_npc->set("eff_jing", taohua_npc->query("max_jing"));
        taohua_npc->set_busy(0);
        target->set("neili", target->query("max_neili"));
        target->set_busy(0);
    }
    taohua_result["before"] = taohua_state(taohua_npc, config, 0, config["effect"]);
    if (mapp(singleton_state)) {
        item = find_object(path);
        taohua_require(objectp(item) && !clonep(item), "original singleton identity");
        taohua_require(environment(item) == (objectp(taohua_companion) ? taohua_companion : taohua_npc),
            "original singleton ownership after construction");
        singleton_state["before_environment"] = file_name(environment(item));
    }
    if (index >= 0) {
        taohua_result["result"] = evaluate(callbacks[index]);
        timer = taohua_handle_probe(taohua_npc,
            config["effect"] == "ding" ? "ding_end" : "cuixin_end",
            index, target, probe_mark);
        if (mapp(timer)) taohua_result["effect_callouts"] = ({ timer });
    }
    taohua_result["after"] = taohua_state(taohua_npc, config, 1, config["effect"]);
    taohua_result["execution"] = ([ "target_active_after": objectp(target) &&
        living(target) && environment(target) == environment(taohua_npc) ]);
    if (mapp(singleton_state)) {
        item = find_object(path);
        singleton_state["after_environment"] = objectp(item) && environment(item) ? file_name(environment(item)) : "";
        singleton_state["companion_after"] = objectp(taohua_companion) ? taohua_state(
            taohua_companion,
            config,
            0,
            "loadout"
        ) : absent;
        taohua_result["singletons"] = ({ singleton_state });
    }
    cleanup = ([ "enemies_removed": 1, "objects": ({}), "remaining_callbacks": ({}) ]);
    victim = taohua_target;
    if (objectp(victim)) {
        victim->remove_enemy(taohua_npc);
        victim->remove_killer(taohua_npc);
        taohua_npc->remove_enemy(victim);
        taohua_npc->remove_killer(victim);
        if (objectp(taohua_companion)) {
            victim->remove_enemy(taohua_companion);
            victim->remove_killer(taohua_companion);
            taohua_companion->remove_enemy(victim);
            taohua_companion->remove_killer(victim);
        }
        if (victim->is_fighting(taohua_npc) || taohua_npc->is_fighting(victim))
            cleanup["enemies_removed"] = 0;
    }
    foreach (item in ({ taohua_npc, taohua_companion })) {
        if (!objectp(item)) continue;
        evaluate(bind((: set_heart_beat, 0 :), item));
    }
    rows = copy(taohua_owned);
    foreach (item in all_inventory(taohua_npc))
        if (member_array(item, taohua_owned) == -1) taohua_owned += ({ item });
    if (objectp(taohua_companion))
        foreach (item in all_inventory(taohua_companion))
            if (member_array(item, taohua_owned) == -1) taohua_owned += ({ item });
    for (index = sizeof(taohua_owned) - 1; index >= 0; index--) {
        item = taohua_owned[index];
        if (!objectp(item)) continue;
        key = file_name(item);
        destruct(item);
        cleanup["objects"] += ({ ([ "object": key, "destroyed": !objectp(item) ]) });
    }
    cleanup["remaining_callbacks"] = taohua_callouts(taohua_npc);
    if (objectp(taohua_companion)) cleanup["remaining_callbacks"] += taohua_callouts(taohua_companion);
    taohua_result["cleanup"] = cleanup;
    taohua_result["destroyed"] = !objectp(taohua_npc) && !objectp(taohua_companion);
    taohua_npc = 0;
    taohua_companion = 0;
    taohua_target = 0;
    taohua_owned = ({});
    return taohua_result;
}
