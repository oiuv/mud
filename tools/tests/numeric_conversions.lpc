// Isolated master: deliberately old expressions are confined to /tests/before.
string get_root_uid() { return "Root"; }
string get_bb_uid() { return "Backbone"; }
string creator_file(string file) { return "Root"; }
int valid_read(string file, mixed user, string func) { return 1; }
int valid_write(string file, mixed user, string func) { return 0; }
int valid_socket(object ob, string func, mixed *info) { return 0; }
void log_error(string file, string text) { debug_message(text); }

void error_handler(mapping details, int caught) {
    if (!caught) {
        debug_message("FAIL: " + details["error"]);
        shutdown(1);
    }
}

void run() {
    object before, after;
    mixed *cases, *sample, *args;
    mixed expected, actual;
    int checked;

    before = load_object("/tests/before");
    after = load_object("/tests/after");
    cases = restore_variable(read_file("/tests/cases.o"));
    foreach (sample in cases) {
        args = sample[1];
        expected = call_other(before, sample[0], args...);
        actual = call_other(after, sample[0], args...);
        if (!intp(expected) || !intp(actual) || expected != actual) {
            debug_message(sprintf("FAIL: %O expected %O, got %O", sample, expected, actual));
            shutdown(1);
            return;
        }
        checked++;
    }
    debug_message(sprintf("NUMERIC PASS: %d", checked));
    shutdown(0);
}

string *epilog(int flag) {
    run();
    return ({});
}
