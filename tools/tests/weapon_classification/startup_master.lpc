// Test host only: real game sefun and objects, no live accounts or outbound services.
private int checks, failures;

string get_root_uid() { return "Root"; }
string get_bb_uid() { return "Backbone"; }
string creator_file(string file) { return "Root"; }
string author_file(string file) { return "Root"; }
string domain_file(string file) { return "Backbone"; }
int valid_read(string file, mixed user, string func) { return 1; }
int valid_write(string file, mixed user, string func) {
    return strsrch(file, "/data/") == 0 || strsrch(file, "/log/") == 0;
}
int valid_seteuid(object ob, string uid) { return 1; }
int valid_override(string file, string name, string main_file) { return 1; }
int valid_bind(object binder, object old_owner, object new_owner) { return 1; }
int valid_socket(object ob, string func, mixed *info) { return 0; }
int valid_database(object ob, string func, mixed *info) { return 0; }
int valid_external(string command) { return 0; }
object connect() { return 0; }
mixed compile_object(string file) { return VIRTUAL_D->compile_object(file); }
void log_error(string file, string text) { debug_message(text); }

void check(int ok, string label) {
    checks++;
    if (!ok) {
        failures++;
        debug_message("FAIL: " + label);
    }
}

void finish() {
    debug_message(sprintf("WEAPON_STARTUP CHECKS: %d FAILURES: %d", checks, failures));
    debug_message(failures ? "WEAPON_STARTUP FAIL" : "WEAPON_STARTUP PASS");
    shutdown(failures ? 1 : 0);
}

void error_handler(mapping details, int caught) {
    if (!caught) {
        check(0, details["error"]);
        debug_message(sprintf("TEST TRACE: %O", details["trace"]));
        finish();
    }
}

void run() {
    mixed err;

    err = catch(load_object("/tests/regression")->run());
    if (err) check(0, err);
    finish();
}

string *epilog(int flag) { call_out("run", 0); return ({}); }
