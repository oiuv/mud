#include "json.c"
#include "fluffos.c"
#include "quest_files.c"

int is_root(object ob) {
    return objectp(ob) && member_array(
        file_name(ob),
        ({
            "/tests/foundation",
            "/tests/rooms",
            "/tests/quests",
            "/tests/map_scan",
            "/tests/content",
            "/tests/admin",
            "/tests/reload",
            "/cmds/adm/illusion",
            "/adm/daemons/illusion_content_d",
            "/tests/release_scan",
            "/tests/benchmark",
            "/tests/rollback_drain"
        })
    ) >= 0;
}

void log_file(string file, string text) {}
void message_system(string text) { debug_message(text); }
// The reload regression calls update_file/update_dir, not the command parser.
string resolve_path(string cwd, string path) { error("unused test command parser\n"); }
varargs void message_vision(string text, object actor, object target) {}
mixed element_of(mixed *items) { return items[0]; }
int area_move(object area, object player, int x, int y) { return 1; }
varargs void tell_area(object area, int x, int y, string text, mixed exclude) {}
int area_environment(object first, object second) { return 1; }
int getoid(object ob) { return 123; }
