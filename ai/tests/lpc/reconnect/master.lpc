private object player;
private object npc;
private int connections;
private int failures;

string get_root_uid() { return "Root"; }
string get_bb_uid() { return "Root"; }
mixed creator_file(string file) { return "Root"; }
int valid_read(string file, mixed user, string func) { return 1; }
int valid_write(string file, mixed user, string func) { return 1; }
int valid_seteuid(object ob, string uid) { return 1; }
int valid_socket(object ob, string action, mixed *info) { return 1; }
int valid_exec(string file, object to, object from) { return 1; }
void log_error(string file, string text) { debug_message(text); }
void error_handler(mapping details, int caught) {
    if (!caught) {
        failures++;
        debug_message("FAIL: " + details["error"]);
    }
}
object query_player() { return player; }
object query_npc() { return npc; }
object connect() { return new("/tests/link"); }
string *epilog(int flag) { return ({}); }

void bind_connection(object link) {
    object old_link;

    if (!objectp(player)) {
        player = new("/tests/player");
        npc = new("/tests/actor");
        npc->configure("guide", "引路人");
    }
    old_link = player->query_temp("link_ob");
    if (interactive(player))
        remove_interactive(player);
    if (objectp(old_link))
        destruct(old_link);
    player->set_temp("link_ob", link);
    if (!exec(player, link))
        error("Test connection transfer failed.\n");
    connections++;
    player->listen(connections);
}

void finish() {
    debug_message(sprintf("AI RECONNECT connections=%d failures=%d", connections, failures));
    debug_message(failures ? "AI RECONNECT FAIL" : "AI RECONNECT PASS");
    shutdown(failures ? 1 : 0);
}
