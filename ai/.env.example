# 复制为 ai/.env，密钥只填本地 .env，不填本示例；进程环境变量优先，路径相对于 ai/。
# 高级配置：docs/architecture/ai-configuration.md；未列出的设置保持原默认值。

# 文本生成模型：NPC 问答、主 Agent、幻境文案及摘要共用。
# OPENAI_ 表示 OpenAI 兼容接口，不限于 OpenAI 的模型；密钥、地址与模型须匹配。
OPENAI_API_KEY=
# 可选：覆盖文本生成接口地址，默认使用百炼北京地域。
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-flash
# 千问附加参数；换用不接受此参数的服务商时设为 {}。
CHAT_EXTRA_BODY={"enable_thinking":false}

# 文本生成模型容量：换模型时同时核对上下文窗口和最大输出容量。
# 1M 是默认值，不代表所有模型都支持；80% 自动 compact，不是任务预算。
OPENAI_CONTEXT_WINDOW_TOKENS=1000000
# JSON Object 不发送 max_tokens，使用下值预留输出空间。
OPENAI_MODEL_MAX_OUTPUT_TOKENS=131072

# 知识库检索模型（可选）：向量与重排共用百炼密钥；留空时使用本地 BM25 检索。
# 不自动复用 OPENAI_API_KEY；使用同一百炼密钥时，两处分别填写。
DASHSCOPE_API_KEY=
# 向量：独立的 OpenAI 兼容接口地址，不跟随 OPENAI_BASE_URL。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 重排：DashScope 原生接口的完整地址，不是向量接口地址。
# RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3.7-text-rerank

# 游戏连接：须与 LPC 的 AI_SERVER_HOST / AI_SERVER_PORT 一致。
SERVER_HOST=127.0.0.1
SERVER_PORT=9999

# 主要能力：NPC 问答默认可用；主 Agent 与幻境文案按需开启。
MAIN_AGENT_ENABLED=false
WORLD_ENABLED=false
KNOWLEDGE_UPDATE_ENABLED=true
# 专业提示词与参考素材，可按游戏调整。
SKILLS_DIR=skills

# 只读当前仓库并允许必要片段交给配置模型；始终排除敏感资料。
# 关闭源码后仍可文档问答；其他 MUD 可修改根目录。
SOURCE_ENABLED=true
SOURCE_ROOT=..
# 可选 CodeGraph，需维护者先建索引；从统一 exec 使用，不开放 Shell。
CODEGRAPH_ENABLED=false
# Windows 正常安装的 codegraph.cmd 可直接使用；带空格的路径也可。
CODEGRAPH_COMMAND=codegraph
# 默认只开放 explore，避免旧配置自动扩权。按需明确授权其他查询：
# CODEGRAPH_OPERATIONS=explore,query,callers,callees,impact,node,files
# 其他获准 CLI 的可选配置及 Hook 授权见 docs/architecture/ai-cli-tools.md。
# CLI_PROGRAMS_FILE=config/cli_programs.json
