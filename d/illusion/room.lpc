inherit "/inherit/room/illusion_base";

#define WORLD_D "/adm/daemons/illusion_world_d"
private mapping identity;
private mapping facts;

varargs void create(mapping requested) {
    mapping exits;
    string dir;
    int *xy;

    set("short", "未知心魔幻境");
    set("long", "四下雾霭迷蒙，远近景物若隐若现，尚辨不清身在何处。\n");
    if (!mapp(requested)) return;
    if (!WORLD_D->instance_valid(requested["world"], requested["instance"]))
        error("illusion: expired instance.\n");
    facts = WORLD_D->query_room_facts(requested["world"], requested["x"], requested["y"]);
    if (!facts) error("illusion: inaccessible coordinate.\n");
    identity = copy(requested);
    set("illusion_world", identity["world"]);
    set("illusion_instance", identity["instance"]);
    set("maze", "maze");
    set("short", facts["name"]);
    setArea("illusion", identity["x"], identity["y"], 0);
    exits = ([]);
    foreach (dir, xy in facts["exits"])
        exits[dir] = WORLD_D->room_path(identity["world"], xy[0], xy[1], identity["instance"]);
    if (facts["out"]) {
        exits["out"] = "/d/city/wumiao2";
        set("item_desc", ([ "door": "离开(out)心魔幻境的传送门！\n" ]));
    }
    set("exits", exits);
    initialize_illusion_inventory(identity["x"], identity["y"], 0);
}

int valid_illusion_entry(object actor) {
    if (!objectp(actor) || !identity || !WORLD_D->instance_valid(
        identity["world"],
        identity["instance"]
    )) return 0;
    return !userp(actor) || WORLD_D->instance_owned_by(
        identity["world"],
        identity["instance"],
        actor
    );
}

string long() {
    if (!facts) return "四下雾霭迷蒙，远近景物若隐若现，尚辨不清身在何处。\n";
    if (!WORLD_D->instance_valid(identity["world"], identity["instance"]))
        return "幻境的景物正在消散，可输入 out 安全返回武庙。\n";
    return facts["description"] + facts["transition"] + "\n" + (facts["road"] ? "脚下有一条可辨认的旧路。\n" : "") + (facts["out"] ? "一扇闪着微光的传送门(door)立在路旁，可由此离开(out)幻境。\n" : "");
}

int leave_expired_instance() {
    if (!identity || WORLD_D->instance_valid(identity["world"], identity["instance"])) return 0;
    return this_player()->move("/d/city/wumiao2", 1);
}

void init() {
    object actor;

    actor = this_player();
    if (!identity || !objectp(actor) || environment(actor) != this_object()) return;
    if (!valid_illusion_entry(actor)) {
        if (userp(actor)) actor->move("/d/city/wumiao2", 1);
        return;
    }
    if (interactive(actor)) add_action("leave_expired_instance", "out");
    run_illusion_encounter();
}
