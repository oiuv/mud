// 普通食物共用品种；保留 /d 下物品的 Domain 身份。
#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

#define FOOD_PROGRAM "/d/items/food"
#include "food_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != FOOD_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

// 只识别已登记身份；不代表允许存放，食物仍走原拒存规则。
int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != FOOD_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, FOOD_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = food_definitions();
        return;
    }
    if (previous_object() != find_object(FOOD_PROGRAM) || !stringp(key))
        error("Ordinary food requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != FOOD_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(FOOD_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != FOOD_PROGRAM + "/" + variety)
        error("Invalid ordinary food virtual identity.\n");
    definition = FOOD_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary food variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
    }
    setup();
}
