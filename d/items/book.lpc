// 普通研读物沿用 ITEM；随机属性遵循旧 create 的蓝图/克隆生命周期。
#include <ansi.h>

inherit ITEM;

#define BOOK_PROGRAM "/d/items/book"
#include "book_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != BOOK_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != BOOK_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, BOOK_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = book_definitions();
        return;
    }
    if (previous_object() != find_object(BOOK_PROGRAM) || !stringp(key))
        error("Ordinary book requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != BOOK_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(BOOK_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key, name, skill;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != BOOK_PROGRAM + "/" + variety)
        error("Invalid ordinary book virtual identity.\n");
    definition = BOOK_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary book variety.\n");
    initialized = 1;
    // 石板原本在每次 create 都抽样，但仅蓝图保存抽中的技能。
    if (arrayp(definition["skill_choices"]))
        skill = definition["skill_choices"][random(sizeof(definition["skill_choices"]))];
    name = definition["name"];
    if (arrayp(definition["name_choices"]))
        name = definition["name_choices"][random(sizeof(definition["name_choices"]))];
    set_name(name, definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
        if (stringp(skill))
            set("skill/name", skill);
        if (definition["jing_cost_random"])
            set("skill/jing_cost", 20 + random(definition["jing_cost_random"]));
    }
    // 旧研读物没有 setup，也不具有 BOOK 的 is_book/extra_long 能力。
}
