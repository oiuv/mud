// 普通短兵器类物品共用程序，按最终虚拟身份初始化蓝图或实例。
#include <ansi.h>
#include <weapon.h>

inherit DAGGER;

#define DAGGER_PROGRAM "/d/items/dagger"
#include "dagger_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != DAGGER_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != DAGGER_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, DAGGER_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = dagger_definitions();
        return;
    }
    if (previous_object() != find_object(DAGGER_PROGRAM) || !stringp(key))
        error("Ordinary dagger requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != DAGGER_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(DAGGER_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != DAGGER_PROGRAM + "/" + variety)
        error("Invalid ordinary dagger virtual identity.\n");
    definition = DAGGER_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary dagger variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
        // init_dagger 忽略克隆：必须等驱动确认最终蓝图身份后再初始化。
        init_dagger(definition["damage"], definition["flags"]);
    }
    setup();
}
