// 普通暗器共用程序，按最终虚拟身份初始化蓝图、实例及独立数量。
#include <ansi.h>
#include <weapon.h>

inherit THROWING;

#define THROWING_PROGRAM "/d/items/throwing"
#include "throwing_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != THROWING_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != THROWING_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, THROWING_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = throwing_definitions();
        return;
    }
    if (previous_object() != find_object(THROWING_PROGRAM) || !stringp(key))
        error("Ordinary throwing requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != THROWING_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(THROWING_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != THROWING_PROGRAM + "/" + variety)
        error("Invalid ordinary throwing virtual identity.\n");
    definition = THROWING_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary throwing variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
    }
    // 数量是实例字段；在最终蓝图/默认属性就绪后，按原父类重算重量和价值。
    set_amount(definition["amount"]);
    init_throwing(definition["damage"]);
    setup();
}
