// 直接 EQUIP 防具。留在 /d 下，保持原物品的 Domain UID 和父类能力。
#include <ansi.h>

inherit EQUIP;

#define EQUIP_PROGRAM "/d/items/equip"
#include "equip_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != EQUIP_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != EQUIP_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, EQUIP_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = equip_definitions();
        return;
    }
    if (previous_object() != find_object(EQUIP_PROGRAM) || !stringp(key))
        error("Ordinary equipment requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != EQUIP_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(EQUIP_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != EQUIP_PROGRAM + "/" + variety)
        error("Invalid ordinary equipment virtual identity.\n");
    definition = EQUIP_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary equipment variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
    }
    // 原定义没有调用 setup 的品种，不补耐久或改变其穿戴结果。
    if (definition["setup"])
        setup();
}
