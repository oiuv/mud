// 普通饮具共用品种；固定属性来自蓝图，初始液体来自未修改的定义。
#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

#define LIQUID_PROGRAM "/d/items/liquid"
#include "liquid_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != LIQUID_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

// 只识别已登记身份；饮具仍走原有拒存规则。
int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != LIQUID_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, LIQUID_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = liquid_definitions();
        return;
    }
    if (previous_object() != find_object(LIQUID_PROGRAM) || !stringp(key))
        error("Ordinary liquid requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != LIQUID_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(LIQUID_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != LIQUID_PROGRAM + "/" + variety)
        error("Invalid ordinary liquid virtual identity.\n");
    definition = LIQUID_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary liquid variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (key != "liquid" && (mapp(value) || arrayp(value)))
                set(key, copy(value));
    }
    foreach (entry in definition["properties"])
        // 旧构造在蓝图分支之外设置这两项；不能继承已消耗/装水的蓝图液体。
        if (!clonep() || entry[0] == "liquid" || entry[0] == "liquid_type")
            set(entry[0], entry[1]);
    if (definition["setup"])
        setup();
}
