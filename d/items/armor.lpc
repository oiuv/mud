// 普通防具品种；沿用地图物品的 Domain UID 和 ARMOR 行为。
#include <ansi.h>
#include <armor.h>

inherit ARMOR;

#define ARMOR_PROGRAM "/d/items/armor"
#include "armor_data.h"

private nosave mapping varieties;
private nosave string variety;
private nosave int initialized;

mapping query_definition(string key) {
    if (base_name(this_object()) != ARMOR_PROGRAM || !mapp(varieties))
        return 0;
    return copy(varieties[key]);
}

int valid_variety_path(string path) {
    string key;

    if (base_name(this_object()) != ARMOR_PROGRAM || !mapp(varieties) ||
        !stringp(path) || sscanf(path, ARMOR_PROGRAM + "/%s", key) != 1)
        return 0;
    return mapp(varieties[key]);
}

void create(string key) {
    if (!clonep()) {
        varieties = armor_definitions();
        return;
    }
    // 只有 provider 内部创建；正式品种身份由驱动建立。
    if (previous_object() != find_object(ARMOR_PROGRAM) || !stringp(key))
        error("Ordinary armor requires a registered virtual variety.\n");
    variety = key;
}

object create_virtual_object(string key) {
    if (base_name(this_object()) != ARMOR_PROGRAM || clonep() ||
        !mapp(varieties) || !mapp(varieties[key]))
        return 0;
    return new(ARMOR_PROGRAM, key);
}

void virtual_start() {
    mapping definition, defaults;
    mixed *entry;
    string key;
    mixed value;

    if (initialized)
        return;
    if (!stringp(variety) || base_name(this_object()) != ARMOR_PROGRAM + "/" + variety)
        error("Invalid ordinary armor virtual identity.\n");
    definition = ARMOR_PROGRAM->query_definition(variety);
    if (!mapp(definition))
        error("Unknown ordinary armor variety.\n");
    initialized = 1;
    set_name(definition["name"], definition["ids"]);
    set_weight(definition["weight"]);
    if (clonep()) {
        set_default_object(base_name(this_object()));
        defaults = query_default_object()->query_entire_dbase();
        foreach (key, value in defaults)
            if (mapp(value) || arrayp(value))
                set(key, copy(value));
    } else {
        foreach (entry in definition["properties"])
            set(entry[0], entry[1]);
    }
    setup();
}
